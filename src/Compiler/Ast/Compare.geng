module Compiler.Ast.Compare exposing (compareModules)

{-| Position-independent AST comparison for two parsed Gren modules.

@docs compareModules
-}

import Array.Builder as Builder exposing (Builder)
import Compiler.Ast.Source as Src
import Compiler.Parse.Number as Number
import Compiler.SourcePosition as SP


{-| Compare two parsed modules for semantic equivalence. Returns `Ok {}` when
the modules agree on name, exports, imports and declarations
(ignoring source positions and parse-context comments), or `Err` with a
description of the first difference encountered.

`exports` and `imports` are compared order-independently (each side is
canonicalized by sorting before the pairwise comparison): the formatter
(`Formatter.Logical.SortSymbols`) deliberately reorders the contents of an
`exposing ( ... )` list, and reorders `import` statements within a
contiguous, blank-line/comment-free run of them -- neither order is part
of Gren's program semantics. Every other array compared here stays
positional, since those genuinely are order-sensitive (function arguments,
union constructors, declaration bodies, ...).
-}
compareModules : Src.Module -> Src.Module -> Result String {}
compareModules a b =
    chainAll
        [ compareStr (Root "module name") a.name.value b.name.value
        , compareExposing (Root "exports") a.exports b.exports
        , compareArray (Root "imports") compareImport (sortImportsForCompare a.imports) (sortImportsForCompare b.imports)
        , compareArray (Root "values") compareValueDecl a.values b.values
        , compareArray (Root "classes") compareClassDecl a.classes b.classes
        , compareArray (Root "instances") compareInstanceDecl a.instances b.instances
        , compareArray (Root "unions") compareUnionDecl a.unions b.unions
        , compareArray (Root "aliases") compareAliasDecl a.aliases b.aliases
        , compareArray (Root "prims") comparePrimDecl a.prims b.prims
        , compareArray (Root "externs") compareExternDecl a.externs b.externs
        , compareArray (Root "binops") compareBinopDecl a.binops b.binops
        ]


-- PRIMITIVES AND EXTERNS


comparePrimDecl : Src.ModuleDeclaration Src.Prim -> Src.ModuleDeclaration Src.Prim -> Result String {}
comparePrimDecl la lb =
    let
        a =
            la.value.value

        b =
            lb.value.value
    in
    chainAll
        [ compareStr (Root "prim name") a.name.value b.name.value
        , compareStr (Root ("prim '" ++ a.name.value ++ "' primitive")) a.primName.value b.primName.value
        , compareType (Root ("prim '" ++ a.name.value ++ "'")) a.signature b.signature
        ]


compareExternDecl : Src.ModuleDeclaration Src.Extern -> Src.ModuleDeclaration Src.Extern -> Result String {}
compareExternDecl la lb =
    let
        a =
            la.value.value

        b =
            lb.value.value

        describe impls =
            String.join " "
                (Array.map
                    (\impl -> (if impl.pure then "pure " else "") ++ impl.language.value ++ "(" ++ String.join "," (Array.map .value impl.names) ++ ")")
                    impls
                )
    in
    chainAll
        [ compareStr (Root "extern name") a.name.value b.name.value
        , compareStr (Root ("extern '" ++ a.name.value ++ "' implementations")) (describe a.impls) (describe b.impls)
        , compareType (Root ("extern '" ++ a.name.value ++ "'")) a.signature b.signature
        , compareMaybe
            (Root ("extern '" ++ a.name.value ++ "' definition"))
            (\da db ->
                chainAll
                    [ compareArray (Root ("extern '" ++ a.name.value ++ "' args")) comparePattern da.args db.args
                    , compareExpr (Root ("extern '" ++ a.name.value ++ "'")) da.body db.body
                    ]
            )
            a.definition
            b.definition
        ]


-- EXPOSING


compareExposing : Ctx -> Src.Exposing -> Src.Exposing -> Result String {}
compareExposing ctx a b =
    when { fst = a, snd = b } is
        { fst = Src.Open, snd = Src.Open } ->
            Ok {}

        { fst = Src.Explicit xs, snd = Src.Explicit ys } ->
            compareArray (within ctx " exposed list") compareExposed (sortExposedForCompare xs) (sortExposedForCompare ys)

        _ ->
            Err (renderCtx ctx ++ ": Open vs Explicit")


{-| Canonical order for comparing an exposing list independent of how the
formatter sorted it: operators, then types/unions, then values (mirrors
`Formatter.Logical.SortSymbols`' grouping), alphabetical by name within each
group. Only used to line the two sides up before `compareArray`'s pairwise
`compareExposed` checks content -- not a formatting decision. -}
sortExposedForCompare : Array Src.Exposed -> Array Src.Exposed
sortExposedForCompare exposed =
    Array.sortBy exposedSortKey exposed


exposedSortKey : Src.Exposed -> String
exposedSortKey exposed =
    when exposed is
        Src.ExposedOperator sp ->
            "0" ++ sp.value

        Src.ExposedUpper { name = sp } ->
            "1" ++ sp.value

        Src.ExposedLower sp ->
            "2" ++ sp.value


compareExposed : Src.Exposed -> Src.Exposed -> Result String {}
compareExposed a b =
    when { fst = a, snd = b } is
        { fst = Src.ExposedLower la, snd = Src.ExposedLower lb } ->
            compareStr (Root "exposed value") la.value lb.value

        { fst = Src.ExposedUpper ua, snd = Src.ExposedUpper ub } ->
            chainAll
                [ compareStr (Root "exposed type name") ua.name.value ub.name.value
                , comparePrivacy ua.privacy ub.privacy
                ]

        { fst = Src.ExposedOperator oa, snd = Src.ExposedOperator ob } ->
            compareStr (Root "exposed operator") oa.value ob.value

        _ ->
            Err "exposed item: different kinds"


comparePrivacy : Src.Privacy -> Src.Privacy -> Result String {}
comparePrivacy a b =
    when { fst = a, snd = b } is
        { fst = Src.Public, snd = Src.Public } ->
            Ok {}

        { fst = Src.Private, snd = Src.Private } ->
            Ok {}

        _ ->
            Err "privacy: Public vs Private"


-- IMPORTS


compareImport : SP.Located Src.Import -> SP.Located Src.Import -> Result String {}
compareImport la lb =
    let
        a =
            la.value

        b =
            lb.value
    in
    chainAll
        [ compareStr (Root "import module") a.module_.value b.module_.value
        , compareMaybeStr (Root "import alias") a.alias b.alias
        , compareExposing (Root ("import " ++ a.module_.value)) a.expose b.expose
        ]


{-| Canonical order for comparing the import list independent of how the
formatter sorted it: alphabetical by module name (mirrors
`Formatter.Logical.SortSymbols.sortImportGroups`'s sort key -- the grouping
rule itself doesn't matter here, since two ASTs are semantically equivalent
regardless of import order at all). Two imports of the same module name
(unusual, but not rejected by the parser) keep their relative order, since
`Array.sortBy` is stable and there is nothing else to break the tie on here
-- `compareArray`'s pairwise `compareImport` still catches a genuine content
difference between them either way. -}
sortImportsForCompare : Array (SP.Located Src.Import) -> Array (SP.Located Src.Import)
sortImportsForCompare imports =
    Array.sortBy (\locImport -> locImport.value.module_.value) imports


-- VALUE DECLARATIONS


compareValueDecl : Src.ModuleDeclaration Src.Value -> Src.ModuleDeclaration Src.Value -> Result String {}
compareValueDecl la lb =
    let
        a =
            la.value.value

        b =
            lb.value.value

        ctx =
            Root ("function '" ++ a.name.value ++ "'")
    in
    chainAll
        [ compareStr (Root "function name") a.name.value b.name.value
        , compareStr (within ctx " @capability") (if a.capability then "yes" else "no") (if b.capability then "yes" else "no")
        , compareStr (within ctx " @inline") (if a.inline then "yes" else "no") (if b.inline then "yes" else "no")
        , compareMaybeDocStr (within ctx " docs") (Maybe.map .value la.value.docs) (Maybe.map .value lb.value.docs)
        , compareMaybe (within ctx " signature") (\sa sb -> compareType_ ctx sa.value sb.value) (Maybe.map .type_ a.signature) (Maybe.map .type_ b.signature)
        , compareArray (within ctx " constraints") compareConstraint (constraintsOf a.signature) (constraintsOf b.signature)
        , compareArray (within ctx " args") comparePattern a.args b.args
        , compareExpr ctx a.body b.body
        ]


-- UNION TYPE DECLARATIONS


compareUnionDecl : Src.ModuleDeclaration Src.Union -> Src.ModuleDeclaration Src.Union -> Result String {}
compareUnionDecl la lb =
    let
        a =
            la.value.value

        b =
            lb.value.value

        ctx =
            Root ("type '" ++ a.name.value ++ "'")
    in
    chainAll
        [ compareStr (Root "type name") a.name.value b.name.value
        , compareMaybeDocStr (within ctx " docs") (Maybe.map .value la.value.docs) (Maybe.map .value lb.value.docs)
        , compareArray (within ctx " vars") (\la_ lb_ -> compareStr (Root "type var") la_.value lb_.value) a.vars b.vars
        , compareArray (within ctx " variants") compareVariant a.variants b.variants
        , compareArray (within ctx " derives") (\da db -> compareStr (Root "derived class") da.value db.value) a.derives b.derives
        , compareStr (within ctx " @affine") (boolText a.affine) (boolText b.affine)
        ]


-- CLASSES AND INSTANCES


{-| A constraint is part of what an annotation means, so it is compared like
one. So is a `@derive` list and every class and instance declaration: the whole
point of this module is that the formatter cannot drop something and still
pass, and a dropped instance is the one that would leave a program compiling
and wrong.
-}
compareConstraint : Src.Constraint -> Src.Constraint -> Result String {}
compareConstraint a b =
    chainAll
        [ compareMaybeStr (Root "constraint qualifier") a.qualifier b.qualifier
        , compareStr (Root "constraint class") a.class.value b.class.value
        , compareStr (Root "constraint variable") a.var.value b.var.value
        ]


constraintsOf : Maybe { start : SP.Position, constraints : Array Src.Constraint, type_ : Src.Type } -> Array Src.Constraint
constraintsOf maybeSig =
    maybeSig
        |> Maybe.map .constraints
        |> Maybe.withDefault []


compareClassDecl : Src.ModuleDeclaration Src.Class -> Src.ModuleDeclaration Src.Class -> Result String {}
compareClassDecl la lb =
    let
        a =
            la.value.value

        b =
            lb.value.value

        ctx =
            Root ("class '" ++ a.name.value ++ "'")
    in
    chainAll
        [ compareStr (Root "class name") a.name.value b.name.value
        , compareMaybeDocStr (within ctx " docs") (Maybe.map .value la.value.docs) (Maybe.map .value lb.value.docs)
        , compareStr (within ctx " variable") a.var.value b.var.value
        , compareArray (within ctx " methods") (compareClassMethod ctx) a.methods b.methods
        ]


compareClassMethod : Ctx -> SP.Located Src.ClassMethod -> SP.Located Src.ClassMethod -> Result String {}
compareClassMethod ctx la lb =
    chainAll
        [ compareStr (within ctx " method name") la.value.name.value lb.value.name.value
        , compareArray (within ctx " method constraints") compareConstraint la.value.signature.constraints lb.value.signature.constraints
        , compareType (within ctx " method type") la.value.signature.type_ lb.value.signature.type_
        ]


compareInstanceDecl : Src.ModuleDeclaration Src.Instance -> Src.ModuleDeclaration Src.Instance -> Result String {}
compareInstanceDecl la lb =
    let
        a =
            la.value.value

        b =
            lb.value.value

        ctx =
            Root "instance"
    in
    chainAll
        [ compareMaybeDocStr (within ctx " docs") (Maybe.map .value la.value.docs) (Maybe.map .value lb.value.docs)
        , compareArray (within ctx " constraints") compareConstraint a.constraints b.constraints
        , compareType (within ctx " head") a.head b.head
        , compareArray (within ctx " methods") (compareInstanceMethod ctx) a.methods b.methods
        ]


compareInstanceMethod : Ctx -> SP.Located Src.DefineRecord -> SP.Located Src.DefineRecord -> Result String {}
compareInstanceMethod ctx la lb =
    chainAll
        [ compareStr (within ctx " method name") la.value.name.value lb.value.name.value
        , compareArray (within ctx " method args") comparePattern la.value.args lb.value.args
        , compareExpr (within ctx " method body") la.value.body lb.value.body
        ]


compareVariant : SP.Located Src.UnionVariant -> SP.Located Src.UnionVariant -> Result String {}
compareVariant la lb =
    let
        a =
            la.value

        b =
            lb.value
    in
    chainAll
        [ compareStr (Root "variant name") a.name.value b.name.value
        , compareMaybe (Root "variant payload") (compareType (Root "variant payload")) a.payload b.payload
        ]


-- TYPE ALIAS DECLARATIONS


compareAliasDecl : Src.ModuleDeclaration Src.Alias -> Src.ModuleDeclaration Src.Alias -> Result String {}
compareAliasDecl la lb =
    let
        a =
            la.value.value

        b =
            lb.value.value

        ctx =
            Root ("type alias '" ++ a.name.value ++ "'")
    in
    chainAll
        [ compareStr (Root "type alias name") a.name.value b.name.value
        , compareMaybeDocStr (within ctx " docs") (Maybe.map .value la.value.docs) (Maybe.map .value lb.value.docs)
        , compareArray (within ctx " vars") (\la_ lb_ -> compareStr (Root "type var") la_.value lb_.value) a.vars b.vars
        , compareType ctx a.type_ b.type_
        ]


-- BINOP (INFIX) DECLARATIONS


compareBinopDecl : SP.Located Src.Infix -> SP.Located Src.Infix -> Result String {}
compareBinopDecl la lb =
    let
        a =
            la.value

        b =
            lb.value
    in
    chainAll
        [ compareStr (Root "binop fn") a.fn b.fn
        , compareStr (Root "binop symbol") a.symbol b.symbol
        , compareAssociativity a.associativity b.associativity
        , compareInt (Root "binop precedence") a.precedence b.precedence
        ]


compareAssociativity : Src.BinopAssociativity -> Src.BinopAssociativity -> Result String {}
compareAssociativity a b =
    when { fst = a, snd = b } is
        { fst = Src.OpALeft, snd = Src.OpALeft } ->
            Ok {}

        { fst = Src.OpANone, snd = Src.OpANone } ->
            Ok {}

        { fst = Src.OpARight, snd = Src.OpARight } ->
            Ok {}

        _ ->
            Err "binop associativity differs"


-- TYPES


compareType : Ctx -> Src.Type -> Src.Type -> Result String {}
compareType ctx a b =
    compareType_ ctx a.value b.value


compareType_ : Ctx -> Src.Type_ -> Src.Type_ -> Result String {}
compareType_ ctx a b =
    when { fst = a, snd = b } is
        { fst = Src.TVar va, snd = Src.TVar vb } ->
            compareStr (within ctx " type var") va vb

        { fst = Src.TType ta, snd = Src.TType tb } ->
            chainAll
                [ compareStr (within ctx " type name") ta.name.value tb.name.value
                , compareArray (within ctx " type args") (compareType ctx) ta.args tb.args
                ]

        { fst = Src.TTypeQual qa, snd = Src.TTypeQual qb } ->
            chainAll
                [ compareStr (within ctx " type qualifier") qa.qualifier qb.qualifier
                , compareStr (within ctx " type name") qa.name qb.name
                , compareArray (within ctx " type args") (compareType ctx) qa.args qb.args
                ]

        { fst = Src.TLambda la, snd = Src.TLambda lb } ->
            chainAll
                [ compareType (within ctx " ->from") la.from lb.from
                , compareType (within ctx " ->to") la.to lb.to
                ]

        { fst = Src.TRecord ra, snd = Src.TRecord rb } ->
            chainAll
                [ compareMaybeStr (within ctx " record extending") (Maybe.map .value ra.extending) (Maybe.map .value rb.extending)
                , compareArray (within ctx " record fields") (compareTRecordField ctx) ra.fields rb.fields
                ]

        { fst = Src.TParens ta, snd = Src.TParens tb } ->
            compareType (within ctx " (parens)") ta tb

        { fst = Src.TNamed na, snd = Src.TNamed nb } ->
            chainAll
                [ compareStr (within ctx " named type's name") na.name.value nb.name.value
                , compareStr (within ctx (" moved '" ++ na.name.value ++ "'")) (boolText (na.movedAt /= Nothing)) (boolText (nb.movedAt /= Nothing))
                , compareType (within ctx (" named '" ++ na.name.value ++ "'")) na.type_ nb.type_
                , compareMaybe (within ctx (" refinement of '" ++ na.name.value ++ "'")) (compareExpr ctx) (Maybe.map .predicate na.refinement) (Maybe.map .predicate nb.refinement)
                ]

        _ ->
            Err (renderCtx ctx ++ ": type constructors differ")


compareTRecordField : Ctx -> Src.TRecordField -> Src.TRecordField -> Result String {}
compareTRecordField ctx a b =
    chainAll
        [ compareStr (within ctx " field name") a.field.value b.field.value
        , compareType (within ctx (" field '" ++ a.field.value ++ "'")) a.signature b.signature
        ]


-- PATTERNS


comparePattern : Src.Pattern -> Src.Pattern -> Result String {}
comparePattern a b =
    comparePattern_ a.value b.value


comparePattern_ : Src.Pattern_ -> Src.Pattern_ -> Result String {}
comparePattern_ a b =
    when { fst = a, snd = b } is
        { fst = Src.PAnything _, snd = Src.PAnything _ } ->
            Ok {}

        { fst = Src.PVar va, snd = Src.PVar vb } ->
            compareStr (Root "pattern var") va vb

        { fst = Src.PRecord fa, snd = Src.PRecord fb } ->
            compareArray (Root "pattern record") comparePRecordField fa fb

        { fst = Src.PAlias aa, snd = Src.PAlias ab_ } ->
            chainAll
                [ comparePattern aa.pattern ab_.pattern
                , compareStr (Root "alias name") aa.name.value ab_.name.value
                ]

        { fst = Src.PCtor ca, snd = Src.PCtor cb } ->
            chainAll
                [ compareStr (Root "ctor name") ca.name.value cb.name.value
                , compareMaybe (Root "ctor arg") comparePattern ca.arg cb.arg
                ]

        { fst = Src.PCtorQual qa, snd = Src.PCtorQual qb } ->
            chainAll
                [ compareStr (Root "ctor module") qa.module_ qb.module_
                , compareStr (Root "ctor name") qa.name qb.name
                , compareMaybe (Root "ctor arg") comparePattern qa.arg qb.arg
                ]

        { fst = Src.PArray pa, snd = Src.PArray pb } ->
            compareArray (Root "pattern array") comparePattern pa pb

        { fst = Src.PChr ca, snd = Src.PChr cb } ->
            compareChar (Root "pattern char") ca.value cb.value

        { fst = Src.PStr sa, snd = Src.PStr sb } ->
            compareStr (Root "pattern string") sa.value sb.value

        { fst = Src.PInt ia, snd = Src.PInt ib } ->
            chainAll
                [ compareStr (Root "pattern int") ia.text ib.text
                , compareBool (Root "pattern int isHex") ia.isHex ib.isHex
                ]

        _ ->
            Err "pattern: constructors differ"


comparePRecordField : Src.PRecordField -> Src.PRecordField -> Result String {}
comparePRecordField a b =
    chainAll
        [ compareStr (Root "pattern record field") a.field.value b.field.value
        , compareMaybe (Root "pattern record field pattern") comparePattern a.pattern b.pattern
        ]


-- EXPRESSIONS


-- Parens never change an expression's meaning, so comparison must not care
-- whether either side has them, or how many layers deep. gren-format itself
-- never strips or adds a redundant paren, but a synthesized paren (e.g. one
-- added around a pattern's constructor payload) must not trip the "formatted
-- output means the same thing as the original" guard either.
stripParens : Src.Expression -> Src.Expression
stripParens expr =
    when expr.value is
        Src.Parens inner ->
            stripParens inner

        _ ->
            expr


compareExpr : Ctx -> Src.Expression -> Src.Expression -> Result String {}
compareExpr ctx a b =
    compareExpr_ ctx (stripParens a).value (stripParens b).value


compareExpr_ : Ctx -> Src.Expression_ -> Src.Expression_ -> Result String {}
compareExpr_ ctx a b =
    when { fst = a, snd = b } is
        { fst = Src.CharLiteral ca, snd = Src.CharLiteral cb } ->
            compareChar ctx ca.value cb.value

        { fst = Src.StringLiteral sa, snd = Src.StringLiteral sb } ->
            compareStr ctx sa.value sb.value

        { fst = Src.NumberLiteral na, snd = Src.NumberLiteral nb } ->
            compareNumber ctx na nb

        { fst = Src.Var va, snd = Src.Var vb } ->
            compareStr ctx va.name vb.name

        { fst = Src.VarQual qa, snd = Src.VarQual qb } ->
            chainAll
                [ compareStr (within ctx " qualifier") qa.qualifier qb.qualifier
                , compareStr (within ctx " name") qa.name qb.name
                ]

        { fst = Src.Operator oa, snd = Src.Operator ob } ->
            compareStr ctx oa ob

        { fst = Src.Negate ea, snd = Src.Negate eb } ->
            compareExpr (within ctx " negate") ea eb

        { fst = Src.Accessor sa, snd = Src.Accessor sb } ->
            compareStr (within ctx " accessor") sa sb

        { fst = Src.Access aa, snd = Src.Access ab_ } ->
            chainAll
                [ compareExpr (within ctx " .expr") aa.expression ab_.expression
                , compareStr (within ctx " .field") aa.accessor ab_.accessor
                ]

        { fst = Src.Annotated aa, snd = Src.Annotated ab_ } ->
            chainAll
                [ compareExpr (within ctx " annotated") aa.expression ab_.expression
                , compareType (within ctx " annotation") aa.annotation ab_.annotation
                ]

        { fst = Src.ArrayLiteral la, snd = Src.ArrayLiteral lb } ->
            compareArray (within ctx " []") (compareExpr ctx) la lb

        { fst = Src.Record ra, snd = Src.Record rb } ->
            compareArray (within ctx " {}") (compareRecordField ctx) ra rb

        { fst = Src.Update ua, snd = Src.Update ub } ->
            chainAll
                [ compareExpr (within ctx " update.record") ua.record ub.record
                , compareArray (within ctx " update.fields") (compareRecordField ctx) ua.newValues ub.newValues
                ]

        { fst = Src.Binops _, snd = Src.Binops _ } ->
            compareBinops ctx a b

        { fst = Src.Lambda la, snd = Src.Lambda lb } ->
            chainAll
                [ compareArray (within ctx " lambda.args") comparePattern la.patterns lb.patterns
                , compareExpr (within ctx " lambda.body") la.body lb.body
                ]

        { fst = Src.Call ca, snd = Src.Call cb } ->
            chainAll
                [ compareExpr (within ctx " call.fn") ca.fn cb.fn
                , compareArray (within ctx " call.args") (compareExpr ctx) ca.args cb.args
                ]

        { fst = Src.Let la, snd = Src.Let lb } ->
            chainAll
                [ compareArray (within ctx " let.defs") (compareLetDef ctx) la.defs lb.defs
                , compareExpr (within ctx " let.body") la.body lb.body
                ]

        { fst = Src.If ia, snd = Src.If ib } ->
            chainAll
                [ compareArray (within ctx " if.branches") (compareIfBranch ctx) ia.branches ib.branches
                , compareExpr (within ctx " else") ia.elseBranch ib.elseBranch
                ]

        { fst = Src.When wa, snd = Src.When wb } ->
            chainAll
                [ compareExpr (within ctx " when.expr") wa.expression wb.expression
                , compareArray (within ctx " when.branches") (compareWhenBranch ctx) wa.branches wb.branches
                ]

        _ ->
            Err (renderCtx ctx ++ ": expression constructors differ")


compareRecordField : Ctx -> Src.RecordField -> Src.RecordField -> Result String {}
compareRecordField ctx a b =
    chainAll
        [ compareStr (within ctx " field name") a.field.value b.field.value
        , compareExpr (within ctx ("." ++ a.field.value)) a.value b.value
        ]


compareIfBranch : Ctx -> Src.IfBranch -> Src.IfBranch -> Result String {}
compareIfBranch ctx a b =
    chainAll
        [ compareExpr (within ctx " if.test") a.test b.test
        , compareExpr (within ctx " if.body") a.body b.body
        ]


compareWhenBranch : Ctx -> Src.WhenBranch -> Src.WhenBranch -> Result String {}
compareWhenBranch ctx a b =
    chainAll
        [ comparePattern a.pattern b.pattern
        , compareExpr (within ctx " branch.body") a.body b.body
        ]


letConstraintsOf : Maybe Src.Annotation -> Array Src.Constraint
letConstraintsOf maybeAnn =
    maybeAnn
        |> Maybe.map .constraints
        |> Maybe.withDefault []


compareLetDef : Ctx -> SP.Located Src.Def -> SP.Located Src.Def -> Result String {}
compareLetDef ctx la lb =
    when { fst = la.value, snd = lb.value } is
        { fst = Src.Define da, snd = Src.Define db } ->
            chainAll
                [ compareStr (within ctx " let.def name") da.name.value db.name.value
                , compareArray (within ctx (" let." ++ da.name.value ++ ".args")) comparePattern da.args db.args
                , compareMaybe (within ctx (" let." ++ da.name.value ++ ".sig")) (compareType (within ctx " let.sig")) (Maybe.map .type_ da.typeSignature) (Maybe.map .type_ db.typeSignature)
                , compareArray (within ctx (" let." ++ da.name.value ++ ".constraints")) compareConstraint (letConstraintsOf da.typeSignature) (letConstraintsOf db.typeSignature)
                , compareExpr (within ctx (" let." ++ da.name.value ++ ".body")) da.body db.body
                ]

        { fst = Src.Destruct da, snd = Src.Destruct db } ->
            chainAll
                [ comparePattern da.pattern db.pattern
                , compareExpr (within ctx " let.destruct.body") da.body db.body
                ]

        _ ->
            Err (renderCtx ctx ++ ": let def: Define vs Destruct")


-- PRIMITIVE HELPERS


{-| Two `Binops`, compared as the recursion through `left` would, in the same
order and with the same answer, but in a loop: the parser nests a chain to the
left, one level per operator, and recursing down it overflowed node's stack at
about 2,000 operators (geng-lang m3-sweep.md §SW36).

Each side's left spine is collected, parentheses stripped as `compareExpr` strips
them, down to the depth where one side stops being a `Binops`. The expressions
there are compared first, then each level's operator and right operand from the
bottom up. A context names its depth, `binop.left*k`, where the recursion
repeated `binop.left` k times: building that for every level was quadratic.
-}
compareBinops : Ctx -> Src.Expression_ -> Src.Expression_ -> Result String {}
compareBinops ctx a b =
    let
        spineA =
            binopSpine a

        spineB =
            binopSpine b

        depth =
            min (Array.length spineA.levels) (Array.length spineB.levels)

        levelCtx level =
            if level == 0 then
                ctx

            else if level == 1 then
                within ctx " binop.left"

            else
                within ctx (" binop.left*" ++ String.fromInt level)

        exprAt spine level =
            when Array.get level spine.levels is
                Just binops ->
                    Src.Binops binops

                Nothing ->
                    spine.base
    in
    when compareExpr_ (levelCtx depth) (exprAt spineA depth) (exprAt spineB depth) is
        Err e ->
            Err e

        Ok {} ->
            compareBinopLevels levelCtx spineA.levels spineB.levels (depth - 1)


{-| `compareBinops`' levels from `level` up to the outermost, each its operator
and then its right operand, in a loop. It stops below level 0 by testing it:
`Array.get -1` is the last element, so a walk that waited for `Nothing`
compared every level twice, and each parenthesised right operand doubled the
time (geng-lang m4-refine.md §RF7.4). -}
compareBinopLevels : (Int -> Ctx) -> Array BinopLevel -> Array BinopLevel -> Int -> Result String {}
compareBinopLevels levelCtx levelsA levelsB level =
    if level < 0 then
        Ok {}

    else
        when { fst = Array.get level levelsA, snd = Array.get level levelsB } is
            { fst = Just la, snd = Just lb } ->
                when
                    chainAll
                        [ compareStr (within (levelCtx level) " binop.op") la.operator.value lb.operator.value
                        , compareExpr (within (levelCtx level) " binop.right") la.right lb.right
                        ]
                is
                    Err e ->
                        Err e

                    Ok {} ->
                        compareBinopLevels levelCtx levelsA levelsB (level - 1)

            _ ->
                Ok {}


type alias BinopLevel =
    { left : Src.Expression, operator : SP.Located String, right : Src.Expression }


{-| The `Binops` down an expression's left spine, outermost first, parentheses
stripped, and the first expression that is not one. -}
binopSpine : Src.Expression_ -> { levels : Array BinopLevel, base : Src.Expression_ }
binopSpine expr =
    binopSpineHelp expr (Builder.empty 0)


binopSpineHelp : Src.Expression_ -> Builder BinopLevel -> { levels : Array BinopLevel, base : Src.Expression_ }
binopSpineHelp expr levels =
    when expr is
        Src.Binops binops ->
            binopSpineHelp (stripParens binops.left).value (Builder.pushLast binops levels)

        _ ->
            { levels = Builder.toArray levels, base = expr }


{-| Where a comparison is, as the path from a root name down, one cell a level.
Its text is joined only for an `Err`: the comparisons that pass, all of them on
a formatter that works, built `ctx ++ " let.body"` at every level, which copies
the whole path natively, 6.86 GB on 8,192 nested lets (geng-lang
m3-closeout.md §CL27.3, D788).
-}
type Ctx
    = Root String
    | Within { parent : Ctx, part : String }


within : Ctx -> String -> Ctx
within parent part =
    Within { parent = parent, part = part }


renderCtx : Ctx -> String
renderCtx ctx =
    renderCtxHelp ctx (Builder.empty 0)


renderCtxHelp : Ctx -> Builder String -> String
renderCtxHelp ctx parts =
    when ctx is
        Root name ->
            Builder.pushLast name parts
                |> Builder.toArray
                |> Array.reverse
                |> String.join ""

        Within { parent, part } ->
            renderCtxHelp parent (Builder.pushLast part parts)


chainAll : Array (Result String {}) -> Result String {}
chainAll results =
    Array.foldl
        (\result acc ->
            when acc is
                Err e ->
                    Err e

                Ok {} ->
                    result
        )
        (Ok {})
        results


compareArray : Ctx -> (a -> a -> Result String {}) -> Array a -> Array a -> Result String {}
compareArray name cmp a_array b_array =
    let
        lenA =
            Array.length a_array

        lenB =
            Array.length b_array
    in
    if lenA /= lenB then
        Err ("Different number of " ++ renderCtx name ++ ": " ++ String.fromInt lenA ++ " vs " ++ String.fromInt lenB)

    else
        compareArrayItems cmp a_array b_array


compareArrayItems : (a -> a -> Result String {}) -> Array a -> Array a -> Result String {}
compareArrayItems cmp a_array b_array =
    compareArrayItemsFrom cmp a_array b_array 0


compareArrayItemsFrom : (a -> a -> Result String {}) -> Array a -> Array a -> Int -> Result String {}
compareArrayItemsFrom cmp a_array b_array i =
    when { fst = Array.get i a_array, snd = Array.get i b_array } is
        { fst = Just a, snd = Just b } ->
            when cmp a b is
                Err e ->
                    Err e

                Ok {} ->
                    compareArrayItemsFrom cmp a_array b_array (i + 1)

        _ ->
            Ok {}


compareMaybe : Ctx -> (a -> a -> Result String {}) -> Maybe a -> Maybe a -> Result String {}
compareMaybe ctx cmp a b =
    when a is
        Nothing ->
            when b is
                Nothing ->
                    Ok {}

                Just _ ->
                    Err (renderCtx ctx ++ ": Nothing vs Just")

        Just av ->
            when b is
                Nothing ->
                    Err (renderCtx ctx ++ ": Just vs Nothing")

                Just bv ->
                    cmp av bv


compareStr : Ctx -> String -> String -> Result String {}
compareStr ctx a b =
    if a == b then
        Ok {}

    else
        Err (renderCtx ctx ++ ": '" ++ a ++ "' vs '" ++ b ++ "'")


boolText : Bool -> String
boolText b =
    if b then
        "yes"

    else
        "no"


-- Like compareStr but normalizes trailing newlines first.
-- Doc comment formatting may add a blank line before the closing -}, which
-- changes the raw content but not the semantic meaning of the documentation.
compareDocStr : Ctx -> String -> String -> Result String {}
compareDocStr ctx a b =
    compareStr ctx (String.trimRight a) (String.trimRight b)


compareMaybeStr : Ctx -> Maybe String -> Maybe String -> Result String {}
compareMaybeStr ctx a b =
    when a is
        Nothing ->
            when b is
                Nothing ->
                    Ok {}

                Just bv ->
                    Err (renderCtx ctx ++ ": Nothing vs Just '" ++ bv ++ "'")

        Just av ->
            when b is
                Nothing ->
                    Err (renderCtx ctx ++ ": Just '" ++ av ++ "' vs Nothing")

                Just bv ->
                    compareStr ctx av bv


compareMaybeDocStr : Ctx -> Maybe String -> Maybe String -> Result String {}
compareMaybeDocStr ctx a b =
    when a is
        Nothing ->
            when b is
                Nothing ->
                    Ok {}

                Just bv ->
                    Err (renderCtx ctx ++ ": Nothing vs Just '" ++ bv ++ "'")

        Just av ->
            when b is
                Nothing ->
                    Err (renderCtx ctx ++ ": Just '" ++ av ++ "' vs Nothing")

                Just bv ->
                    compareDocStr ctx av bv


compareChar : Ctx -> Char -> Char -> Result String {}
compareChar ctx a b =
    if a == b then
        Ok {}

    else
        Err (renderCtx ctx ++ ": '" ++ String.fromChar a ++ "' vs '" ++ String.fromChar b ++ "'")


compareInt : Ctx -> Int -> Int -> Result String {}
compareInt ctx a b =
    if a == b then
        Ok {}

    else
        Err (renderCtx ctx ++ ": " ++ String.fromInt a ++ " vs " ++ String.fromInt b)


compareBool : Ctx -> Bool -> Bool -> Result String {}
compareBool ctx a b =
    if a == b then
        Ok {}

    else
        Err
            (renderCtx ctx
                ++ ": "
                ++ (if a then
                        "True"

                    else
                        "False"
                   )
                ++ " vs "
                ++ (if b then
                        "True"

                    else
                        "False"
                   )
            )


compareNumber : Ctx -> Number.Outcome -> Number.Outcome -> Result String {}
compareNumber ctx a b =
    when { fst = a, snd = b } is
        { fst = Number.Integer ia, snd = Number.Integer ib } ->
            if ia.text == ib.text then
                Ok {}

            else
                Err (renderCtx ctx ++ ": " ++ ia.text ++ " vs " ++ ib.text)

        { fst = Number.FloatingPoint fa, snd = Number.FloatingPoint fb } ->
            -- Compare both the parsed value and the original source text:
            -- the formatter preserves the author's representation (e.g. `1e5`
            -- vs `100000.0`), so AST equivalence should catch drift in either
            -- the numeric value or the visual form.
            if fa.val == fb.val && fa.text == fb.text then
                Ok {}

            else
                Err (renderCtx ctx ++ ": " ++ fa.text ++ " vs " ++ fb.text)

        { fst = Number.Hex ha, snd = Number.Hex hb } ->
            -- The text as written, as for the others: the formatter keeps a
            -- hex literal's spelling (geng-lang D602), so `0xff` and `0xFF`
            -- are two different outputs.
            if ha.text == hb.text then
                Ok {}

            else
                Err (renderCtx ctx ++ " (hex): " ++ ha.text ++ " vs " ++ hb.text)

        _ ->
            Err (renderCtx ctx ++ ": number literal kinds differ (Int/Float/Hex)")
