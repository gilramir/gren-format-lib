module Formatter.Results exposing
    ( resultConcatMap
    , resultFoldl
    , traverseResult
    )

{-|
Result-over-Array combinators, shared by both stages: the LPT builders in
`Formatter.Logical.*` and the Box renderers in `Formatter.Render.*`.

They lived in three places before — `Formatter.Strings`, `Formatter.Render.BoxOps`
and `Formatter.Logical.LPTHelpers` — none of which is about `Result`, and the
copies had drifted: one had the O(n) implementation and the note explaining why
it mattered, another had exactly the O(n^2) fold that note warns against.

-}

import Array.Builder as Builder


{-|
Traverse an Array with a Result-returning function: the first `Err`
(left-to-right, matching the short-circuit order a sequential `Result.andThen`
fold would give), or every `Ok` value in order.

One fold into a Builder sized to the input, used once per step, which stops
applying `f` at the first `Err`. `Array.pushLast` copies the array on each call,
so a fold that grew an Array was O(n^2). The two whole-array passes that
replaced it, `Array.map` then `Array.findFirst` and `Array.mapAndKeepJust`,
were linear but slower than the fold: a `when` of 16,000 branches took 5.0 s
and 960 MB through them against 3.8 s and 383 MB here, and 16,000 variants
13.4 s and 1.6 GB against 9.0 s and 590 MB (geng-lang m3-sweep.md §SW37).

-}
traverseResult : (a -> Result e b) -> Array a -> Result e (Array b)
traverseResult f items =
    Array.foldl
        (\item acc ->
            acc
                |> Result.andThen
                    (\builder ->
                        f item
                            |> Result.map (\value -> Builder.pushLast value builder)
                    )
        )
        (Ok (Builder.empty (Array.length items)))
        items
        |> Result.map Builder.toArray


{-|
Fold an Array into a single accumulator with a Result-returning step,
short-circuiting on the first `Err`.

Unlike `traverseResult` this threads the accumulator through, so each step sees
what the previous ones built. A step that only adds to the end of
an Array is `resultConcatMap`'s: with an Array accumulator, each push copies it.

-}
resultFoldl : (i -> a -> Result e a) -> a -> Array i -> Result e a
resultFoldl callback initialAcc items =
    Array.foldl
        (\item acc -> acc |> Result.andThen (callback item))
        (Ok initialAcc)
        items


{-|
Map each item to the nodes it adds, and concatenate them in order,
short-circuiting on the first `Err`.

A `resultFoldl` whose step pushes onto an Array accumulator copies it on every
step, so n items took time quadratic in n: a record or a call of 64,000 on one
row took 22 s and 69 s (geng-lang m3-sweep.md §SW37). Here the pieces go into
a Builder, used once per step.

-}
resultConcatMap : (i -> Result e (Array a)) -> Array i -> Result e (Array a)
resultConcatMap f items =
    Array.foldl
        (\item acc ->
            acc
                |> Result.andThen
                    (\builder ->
                        f item
                            |> Result.map (\added -> Builder.append added builder)
                    )
        )
        (Ok (Builder.empty 0))
        items
        |> Result.map Builder.toArray
