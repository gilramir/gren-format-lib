module Formatter.Results exposing
    ( resultFoldl
    , traverseResult
    )

{-|
Result-over-Array combinators, shared by both stages: the LPT builders in
`Formatter.Logical.*` and the Box renderers in `Formatter.Render.*`.

They lived in three places before — `Formatter.Strings`, `Formatter.Render.BoxOps`
and `Formatter.Logical.LPTHelpers` — none of which is about `Result`, and the
copies had drifted: one had the O(n) implementation and the note explaining why
it mattered, another had exactly the O(n^2) fold that note warns against.

-}


{-|
Traverse an Array with a Result-returning function: the first `Err`
(left-to-right, matching the short-circuit order a sequential `Result.andThen`
fold would give), or every `Ok` value in order.

Two whole-array passes rather than a fold that accumulates with
`Array.pushLast`. `Array.pushLast` is O(n) per call (it is `Array.toSpliced`
under the hood, a full-array copy), so building the result one element at a time
is O(n^2) — and this runs once per `RootBox` child, i.e. once per top-level
declaration in the file. `Array.map` / `Array.findFirst` are each a single
native O(n) pass.

`f` is applied to every element, including those after the first `Err`. It is
pure, so that costs work and changes nothing: the `Err` reported is still the
leftmost one.

-}
traverseResult : (a -> Result e b) -> Array a -> Result e (Array b)
traverseResult f items =
    let
        applied =
            Array.map f items

        isErr item =
            when item is
                Err _ ->
                    True

                Ok _ ->
                    False
    in
    when Array.findFirst isErr applied is
        Just { value = Err e } ->
            Err e

        _ ->
            Ok
                (Array.mapAndKeepJust
                    (\item ->
                        when item is
                            Ok value ->
                                Just value

                            Err _ ->
                                Nothing
                    )
                    applied
                )


{-|
Fold an Array into a single accumulator with a Result-returning step,
short-circuiting on the first `Err`.

Unlike `traverseResult` this threads the accumulator through, so each step sees
what the previous ones built and there is nothing to collect — no `pushLast`,
and no reason to prefer a two-pass shape.

-}
resultFoldl : (i -> a -> Result e a) -> a -> Array i -> Result e a
resultFoldl callback initialAcc items =
    Array.foldl
        (\item acc -> acc |> Result.andThen (callback item))
        (Ok initialAcc)
        items
