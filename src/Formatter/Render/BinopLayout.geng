module Formatter.Render.BinopLayout exposing
    ( assembleBinopBox
    , commentBreaksBinopChain
    , flattenBinopNodes
    , isChainBreakingOperandShape
    , opText
    )

{-| Pure layout assembly for binary-operator chains (operand boxes + operator texts -> Box).
-}

import Array.Builder as Builder
import Formatter.Logical.BinopPrecedence exposing (binopPrecedence)
import Formatter.Logical.LogicalPrintingTree exposing (CommentRole(..))
import Formatter.Render.Box as B exposing (Box(..))
import Formatter.Render.NodeClassify exposing
    ( commentBreaksFlowRow
    , leafValue
    )
import Formatter.RenderTree exposing
    ( RenderNode
    , RenderShape(..)
    , rnChildren
    , rnNestBinopChain
    , rnShape
    )
import Formatter.Results exposing (traverseResult)


{-| A `Binop`'s children as its operands and operators: the first operand, then
one per `OpAndRhs`, each a flow (array of nodes).

A chain holds one `OpAndRhs` per operator, in a row (geng-lang m3-sweep.md
§SW36), and is read as it stands. Anything else, which only a comment past the
chain makes, is read as the nested chain was (`flattenNestedBinopNodes`), so a
chain whose last child is not an `OpAndRhs` is one operand.
-}
flattenBinopNodes : Array RenderNode -> { operands : Array (Array RenderNode), ops : Array RenderNode }
flattenBinopNodes children =
    let
        isLink node =
            when rnShape node is
                OpAndRhs ->
                    not (Array.isEmpty (rnChildren node))

                _ ->
                    False

        firstLink =
            Array.findFirst isLink children
                |> Maybe.map .index
                |> Maybe.withDefault (Array.length children)

        links =
            Array.dropFirst firstLink children
    in
    if not (Array.isEmpty links) && Array.all isLink links then
        { operands = Array.pushFirst (Array.takeFirst firstLink children) (Array.map (\link -> Array.dropFirst 1 (rnChildren link)) links)
        , ops = Array.mapAndKeepJust (\link -> Array.first (rnChildren link)) links
        }

    else
        flattenNestedBinopNodes (rnNestBinopChain children)


{-| Flatten the nested `Binop`/`OpAndRhs` tree into a flat operand + operator
list. Each operand is itself a flow (array of nodes). -}
flattenNestedBinopNodes : Array RenderNode -> { operands : Array (Array RenderNode), ops : Array RenderNode }
flattenNestedBinopNodes children =
    when Array.popLast children is
        Nothing ->
            { operands = [], ops = [] }

        Just { last = lastNode, initial = operandNodes } ->
            when rnShape lastNode is
                OpAndRhs ->
                    when Array.popFirst (rnChildren lastNode) is
                        Just { first = opNode, rest = restChildren } ->
                            let
                                inner =
                                    flattenNestedBinopNodes restChildren
                            in
                            { operands = [ operandNodes ] ++ inner.operands
                            , ops = [ opNode ] ++ inner.ops
                            }

                        Nothing ->
                            { operands = [ operandNodes ], ops = [] }

                _ ->
                    { operands = [ children ], ops = [] }


{-| True when a comment inside the chain ends its line and more of the CHAIN
follows it, so the chain cannot stay on one row.

`commentBreaksFlowRow` asks that of one flow, and this asks it of the chain by
interleaving the operators back between the operands. Asking it of each operand
separately — which is what `makeBinopBox` used to do — misses the comment
written at the END of a non-last operand (`one + two -- c` / `* three`): nothing
follows it *within that operand*, but the next operator does follow it in the
chain. That chain then stayed off the vertical path and rendered as a generic
flow, which breaks wherever the comment sits — at `*` here, gluing across the
LOOSER `+` so the line reads as `(one + two) * three`. Precedence decides the
break point for a chain with a comment in it exactly as it does for one without.
-}
commentBreaksBinopChain : { operands : Array (Array RenderNode), ops : Array RenderNode } -> Bool
commentBreaksBinopChain flat =
    when Array.popFirst flat.operands is
        Nothing ->
            False

        Just { first = operand0, rest = restOperands } ->
            Array.map2 (\op operandNodes -> [ op ] ++ operandNodes) flat.ops restOperands
                |> Array.flatten
                |> (\tailNodes -> operand0 ++ tailNodes)
                |> commentBreaksFlowRow


opText : RenderNode -> String
opText node =
    Maybe.withDefault "" (leafValue node)


{-| Operand shape kinds whose multi-line form breaks a binop chain vertically: a
bracket literal (record / array / record update) or a parenthesized expression
(`(a\n+ b)`). A `MultilineString` is deliberately absent — elm-format keeps a
multi-line string operand glued inline, and gren matches. -}
isChainBreakingOperandShape : RenderShape -> Bool
isChainBreakingOperandShape shape =
    when shape is
        AllAcrossOrAllVertical _ ->
            True

        AlwaysVertical _ ->
            True

        RecordUpdate _ ->
            True

        ParenBlock _ ->
            True

        _ ->
            False


-- Render an operator-precedence group (parts joined inline by higher-precedence
-- operators) to a single Box. A lone part is returned as-is (it may be
-- multi-line); two or more parts must all be single-line to inline-join.
renderBinopGroup : Array { op : String, box : Box } -> Result String Box
renderBinopGroup parts =
    when Array.popFirst parts is
        Nothing ->
            Err "box: empty binop group"

        Just { first = p0, rest } ->
            if Array.isEmpty rest then
                Ok p0.box

            else
                when B.isLine p0.box is
                    Err _ ->
                        Err "box: multi-line operand joined inline"

                    Ok l0 ->
                        traverseResult
                            (\p ->
                                when B.isLine p.box is
                                    Ok l ->
                                        Ok [ B.space, B.literal p.op, B.space, l ]

                                    Err _ ->
                                        Err "box: multi-line operand joined inline"
                            )
                            rest
                            |> Result.map (\segs -> B.line (B.row (Array.flatten ([ [ l0 ] ] ++ segs))))


{-| Assemble the operand boxes + operator texts into the INLINE layout (the whole
chain on one line). `ops[k]` sits between `operandBoxes[k]` and
`operandBoxes[k+1]`. Groups break at operators whose precedence == `minPrec`;
tighter operators join inline within a group — the grouping only matters for the
trailing-operand case. A forced-vertical chain never comes here (it renders
precedence-grouped via `verticalBinopChainBox`). -}
assembleBinopBox : Int -> Array Box -> Array String -> Result String Box
assembleBinopBox minPrec operandBoxes ops =
    let
        firstBox =
            Maybe.withDefault (B.line (B.literal "")) (Array.first operandBoxes)

        paired =
            Array.map2 (\op nextBox -> { op = op, box = nextBox })
                ops
                (Array.dropFirst 1 operandBoxes)

        state =
            Array.foldl
                (\pair acc ->
                    if binopPrecedence pair.op == minPrec then
                        { firstGroup =
                            if acc.started then
                                acc.firstGroup

                            else
                                acc.curParts
                        , started = True
                        , segments =
                            if acc.started then
                                Builder.pushLast { op = acc.pendingOp, parts = acc.curParts } acc.segments

                            else
                                acc.segments
                        , pendingOp = pair.op
                        , curParts = [ { op = "", box = pair.box } ]
                        }

                    else
                        { acc | curParts = Array.pushLast { op = pair.op, box = pair.box } acc.curParts }
                )
                { firstGroup = [ { op = "", box = firstBox } ]
                , started = False
                -- A Builder, used once per step: pushing each segment onto an
                -- Array was quadratic in a long chain (geng-lang m3-sweep.md
                -- §SW36).
                , segments = Builder.empty 0
                , pendingOp = ""
                , curParts = [ { op = "", box = firstBox } ]
                }
                paired

        segments =
            Builder.toArray (Builder.pushLast { op = state.pendingOp, parts = state.curParts } state.segments)
    in
    renderBinopGroup state.firstGroup
        |> Result.andThen
            (\firstGroupBox ->
                traverseResult
                    (\seg -> Result.map (\b -> { op = seg.op, box = b }) (renderBinopGroup seg.parts))
                    segments
                    |> Result.andThen
                        (\segBoxes ->
                            -- Inline: the chain flows on one line. `Err` (rather
                            -- than a second fallback layout) when the first group
                            -- or a non-trailing group can't join inline — the
                            -- caller (`makeBinopBox`) falls back to the same
                            -- comment-aware flow a comment anywhere in the chain
                            -- already routes through.
                            when inlineBinopBox firstGroupBox segBoxes is
                                Just box ->
                                    Ok box

                                Nothing ->
                                    Err "box: multi-line operand in non-vertical binop"
                        )
            )


-- The chain flows on one line. Every group must be single-line EXCEPT the
-- very last operand, which may be a multi-line node whose own lines break
-- below (a `"""…"""` literal opened mid-line). elm-format keeps the whole
-- chain concatenated and lets that operand's continuation land under its
-- opening column; Box builds the single-line prefix (`"a " ++ b ++`) and
-- `B.prefix`es it onto the trailing box, padding its continuation to the
-- same column. `Nothing` when the first group or a non-trailing group is
-- itself multi-line.
inlineBinopBox : Box -> Array { op : String, box : Box } -> Maybe Box
inlineBinopBox firstGroupBox segBoxes =
    when B.isLine firstGroupBox is
        Err _ ->
            Nothing

        Ok firstLine ->
            when Array.popLast segBoxes is
                Nothing ->
                    Just (B.line firstLine)

                Just { last = lastSeg, initial = initSegs } ->
                    let
                        -- Each group but the last as `op line`, where it is one
                        -- line. A map, where a fold pushing each onto an Array
                        -- was quadratic in a long chain (geng-lang m3-sweep.md
                        -- §SW36).
                        singleLineParts =
                            Array.mapAndKeepJust
                                (\seg ->
                                    when B.isLine seg.box is
                                        Ok l ->
                                            Just [ B.space, B.literal seg.op, B.space, l ]

                                        Err _ ->
                                            Nothing
                                )
                                initSegs

                        allSingleLine =
                            if Array.length singleLineParts == Array.length initSegs then
                                Just singleLineParts

                            else
                                Nothing
                    in
                    allSingleLine
                        |> Maybe.map
                            (\initParts ->
                                when B.isLine lastSeg.box is
                                    Ok lastLine ->
                                        -- All single-line: the whole chain on one row.
                                        B.line (B.row (Array.flatten ([ [ firstLine ] ] ++ initParts ++ [ [ B.space, B.literal lastSeg.op, B.space, lastLine ] ])))

                                    Err _ ->
                                        -- Trailing operand is multi-line: glue the
                                        -- single-line prefix onto its first line and
                                        -- pad its continuation to align.
                                        let
                                            prefixRow =
                                                B.row (Array.flatten ([ [ firstLine ] ] ++ initParts ++ [ [ B.space, B.literal lastSeg.op, B.space ] ]))
                                        in
                                        B.prefix prefixRow lastSeg.box
                            )
