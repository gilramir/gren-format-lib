module Formatter.Render.FlowAssembly exposing (FlowItem, SoftGlueAlignment(..), assembleBrokenCall, assembleBrokenWithComments, bracketPunc, gluedExposingBox, isCommentItem, pairLeadingComments, parenInnerIsAlignCarrying, softBlockChildForcesVerticalBox, softGlueAlignment, trySoftGlueFlow, verticalExposingBox)

{-| Flow-assembly support: the `FlowItem`/`SoftGlueAlignment` types and the pure helpers that lay pre-rendered flow items out into a `Box`.
-}

import Formatter.Logical.LogicalPrintingTree exposing (CommentRole(..), LPBox(..), LPNode, ListBrackets(..), commentGluesToPrevious, commentRole, lpnBox, lpnChildren, lpnMaxRow, roleGlues)
import Formatter.Render.Box as B exposing (Box(..))
import Formatter.Render.BoxOps exposing (applyIndent, glueCommentSuffix, isSingleLine, joinInline, nodesShareStartRow, traverseResult)
import Formatter.Render.FlowPolicy as FP
import Formatter.Render.NodeClassify exposing (isEmptyLine)


-- `exposing` stays glued to the header. Inline list: `header (a, b, c)` on one
-- line. Vertical list: header on line 1, list indented +4 beneath it. The
-- header is pre-rendered by the caller: a plain leaf line for a `module` /
-- `import` header, or the flowed `effect module … where { … } exposing` line for
-- an effect module. It must be a single line — a header that rendered multi-line
-- (e.g. a broken effect-module `where` block) errors so the caller falls back to
-- the generic flow.
gluedExposingBox : Bool -> Box -> Box -> Result String Box
gluedExposingBox forceVertical headerBox listBox =
    when B.isLine headerBox is
        Err _ ->
            Err "box: exposing header rendered multi-line"

        Ok headerLine ->
            if forceVertical then
                Ok (B.stack1 [ B.line headerLine, B.indent listBox ])

            else
                when B.isLine listBox is
                    Ok listLine ->
                        Ok (B.line (B.row [ headerLine, B.space, listLine ]))

                    Err _ ->
                        Err "box: inline exposing list rendered multi-line"


verticalExposingBox : Array B.Line -> Box
verticalExposingBox itemLines =
    when Array.popFirst itemLines is
        Just { first, rest } ->
            B.stack1
                ([ B.prefix (B.row [ B.punc "(", B.space ]) (B.line first) ]
                    ++ Array.map (\l -> B.prefix (B.row [ B.punc ",", B.space ]) (B.line l)) rest
                    ++ [ B.line (B.punc ")") ]
                )

        Nothing ->
            B.line (B.punc "()")


{-| The opening and closing punctuation for a bracket kind. Total: `ListBrackets`
has exactly these three constructors, so there is no "no punctuation" case. It
returned a `Maybe` until 2026-08-02, which cost three call sites an impossible
`Nothing` branch each, all three carrying the same copied comment explaining that
it could not happen. -}
bracketPunc : ListBrackets -> { left : String, right : String }
bracketPunc bracket =
    when bracket is
        ListCurly ->
            { left = "{", right = "}" }

        ListSquare ->
            { left = "[", right = "]" }

        ListParen ->
            -- A parenthesized exposing list reached via the general list path
            -- rather than `makeExposingLineBox` — i.e. a module/import line
            -- whose header carries a comment, so `makeExposingLineBox` fell back
            -- to the flow. It renders TIGHT (`(a, b)`), like the coupled path
            -- and like elm-format: `makeLiteralBox` passes
            -- `innerSpaces = bracket /= ListParen`, and `ListParen` is
            -- exclusively an exposing list (`MakeLogical.exposingListBox` is its
            -- only builder), so no record or array is affected.
            --
            -- This was padded (`( a, b )`) until 2026-07-25. Tightening it was
            -- tried once before and reverted, because a comment trailing past
            -- the close was then idempotent only at the padded column —
            -- tightening shifted the reparse so the comment was absorbed inside
            -- the parens. The elastic close removed that constraint: a comment
            -- after the last name is now read as the list's and pinned above the
            -- `)` at any column, so the column no longer decides anything.
            { left = "(", right = ")" }


{-| One rendered flow child.

`lambdaBodyBox` is set only for a `ParenBlock` whose second child is an
`IndentedBlock` — a lambda whose body the author wrote on a later row. It is
that block's own box, taken from the very render that produced `box`, and it is
exactly `buildFlowBox 0 (lpnChildren bodyNode)` (`makePBox IndentedBlock` *is*
that call). Two consumers need the body separately from the head to build the
`… (\x ->` / body / `)` layouts — `makeMultilineLambdaArgBox` and
`directOperandLambdaSplit` — and both used to render it a second time, which
made a lambda nested through its own body cost 2^depth. Carrying it here is what
makes them free.
-}
type alias FlowItem =
    { node : LPNode
    , box : Box
    , isBlock : Bool
    , comment : Maybe { box : Box, isLineComment : Bool, multiLine : Bool }
    , lambdaBodyBox : Maybe Box
    }


isCommentItem : FlowItem -> Bool
isCommentItem item =
    item.comment /= Nothing


{-| Assemble a broken flow (head at base, each following item at +`indent`) that
may carry comments. A comment trailing the preceding item on the same source row
glues onto that item's last line — for a single-line item, its line plus a space
is prepended onto the comment box (`B.prefix`), so a multi-line comment's body
reindents under it (`f {- multi… -}`, `+ b {- multi… -}`). A single-line block
comment that LEADS (does not glue backward) rides the next term's line
(`{- c -} nextTerm`), at any position in the flow — elm-format keeps a leading
block comment on its argument's / operand's line in a broken call and a broken
binop alike, and only that pairing is a reparse fixed point once the comment sits
on the term's row. A `--` or a multi-line `{- -}` never pairs: it stands on its
own row (nothing can follow a `--` on its line; a multi-line comment has no
single line to ride), and it poisons the rest of its run so the block comments
behind it stay own-row too rather than jumping ahead of it — pairing is
all-or-nothing over a run, as in elm-format. A leading comment whose next term
renders multi-line also stands alone — there is no single first line to ride
there either. -}
assembleBrokenWithComments : Int -> Array FlowItem -> Result String Box
assembleBrokenWithComments indent items =
    let
        -- The line of a single-line block comment that leads its neighbour —
        -- the only comment kind that can ride the next term's line.
        pairableCommentLine c =
            if not c.isLineComment && not c.multiLine then
                when B.isLine c.box is
                    Ok cl ->
                        Just cl

                    Err _ ->
                        Nothing

            else
                Nothing

        -- `acc.pending` holds the lines of leading block comments waiting for
        -- the term they ride; flushing drops each on its own row instead (next
        -- term multi-line, or the flow ended).
        flushPending acc =
            { acc | entries = acc.entries ++ Array.map B.line acc.pending, pending = [] }

        -- Pairing is all-or-nothing over a comment RUN: once a comment in the
        -- current run has gone to its own row (a `--`, a multi-line `{- -}`),
        -- the run is poisoned and the block comments after it stay own-row too
        -- rather than jumping ahead of it onto the term. elm-format's rule,
        -- verified: `-- first` / `{- c -}` / `w` keeps both comments own-row.
        -- Reset by any real term, which ends the run.
        ownRow c acc =
            let
                flushed =
                    flushPending acc
            in
            { flushed
                | entries = Array.pushLast c.box flushed.entries
                , lastRow = -1
                , poisoned = True
            }

        step item accResult =
            accResult
                |> Result.andThen
                    (\acc ->
                        when item.comment is
                            Just c ->
                                when Array.popLast acc.entries is
                                    Just { last = lastBox, initial } ->
                                        if commentGluesToPrevious item.node && acc.lastRow >= 0 && Array.isEmpty acc.pending then
                                            -- Glue the comment onto the item's last
                                            -- line; the item may itself be multi-line
                                            -- (`glueCommentSuffix` joins its last line).
                                            -- `acc.lastRow >= 0` still guards "the
                                            -- previous entry is real content" (it
                                            -- resets to -1 after a comment).
                                            -- `pending` must be empty or the glue
                                            -- would reorder this comment before the
                                            -- ones already waiting.
                                            Ok { acc | entries = Array.pushLast (glueCommentSuffix c.box lastBox) initial }

                                        else
                                            when pairableCommentLine c is
                                                Just cl ->
                                                    if acc.poisoned then
                                                        Ok (ownRow c acc)

                                                    else
                                                        Ok { acc | pending = Array.pushLast cl acc.pending }

                                                Nothing ->
                                                    -- Own row, with the next item
                                                    -- starting on a fresh line.
                                                    -- After a comment nothing
                                                    -- row-glues (the policy is
                                                    -- AlreadyTerminated), so
                                                    -- `lastRow` resets.
                                                    Ok (ownRow c acc)

                                    Nothing ->
                                        when pairableCommentLine c is
                                            Just cl ->
                                                if acc.poisoned then
                                                    Ok (ownRow c acc)

                                                else
                                                    Ok { acc | pending = Array.pushLast cl acc.pending }

                                            Nothing ->
                                                -- First-position `--` / multi-line
                                                -- comment: its own first entry.
                                                Ok (ownRow c acc)

                            Nothing ->
                                if not (Array.isEmpty acc.pending) && isSingleLine item.box then
                                    -- The waiting comments ride this term's line:
                                    -- `{- c -} term`. `lastRow` advances like a
                                    -- plain term's — a comment trailing the term
                                    -- must still glue on, or its own-row form
                                    -- would re-pair FORWARD on reparse and
                                    -- oscillate.
                                    let
                                        prefixRow =
                                            B.row (Array.flatten (Array.map (\cl -> [ cl, B.space ]) acc.pending))
                                    in
                                    Ok
                                        { acc
                                            | entries = Array.pushLast (B.prefix prefixRow item.box) acc.entries
                                            , lastRow = lpnMaxRow item.node
                                            , pending = []
                                            , poisoned = False
                                        }

                                else
                                    flushPending acc
                                        |> (\a ->
                                                Ok
                                                    { a
                                                        | entries = Array.pushLast item.box a.entries
                                                        , lastRow = lpnMaxRow item.node
                                                        , poisoned = False
                                                    }
                                           )
                    )
    in
    Array.foldl step (Ok { entries = [], lastRow = -1, pending = [], poisoned = False }) items
        |> Result.map flushPending
        |> Result.andThen
            (\acc ->
                when Array.popFirst acc.entries is
                    Nothing ->
                        Err "box: empty broken flow"

                    Just { first = head, rest } ->
                        Ok (B.stack1 ([ head ] ++ Array.map (applyIndent indent) rest))
            )


{-| A function application forced across lines — elm-format's
`ElmStructure.application`. The first argument stays glued to the function on
the opening line only when both are single-line and share a source row;
otherwise the function stands alone. Every non-glued argument drops to its own
line at +`indent`. -}
assembleBrokenCall : Int -> Array FlowItem -> Result String Box
assembleBrokenCall indent items =
    let
        -- The fn+arg0 glue survives comments AFTER arg0 (`String.join " "
        -- -- c` keeps `" "` on the opening line, comments drop below with the
        -- args) and comments BETWEEN the two, which ride the opening line with
        -- them (`String.join {- sep -} " "` / args below).
        --
        -- The in-between run used to block the glue, on the stated grounds that
        -- it matched elm-format's `ElmStructure.application` gates. It does not:
        -- elm attaches such a comment to the ARGUMENT, so its arg0 is still an
        -- argument and still glues. Refusing here also contradicted gren's own
        -- rule — the glue is gated on `nodesShareStartRow fn arg0`, and writing a
        -- comment between them moves neither token's row, so nothing about the
        -- author's layout changed and nothing about ours should have.
        --
        -- Only comments that can share the line ride it: a single-line `{- -}`
        -- the classifier tagged as gluing. A `--` runs to end of line and a
        -- multi-line `{- … -}` brings its own newlines, so either one still
        -- stands the function up alone, as before.
        { leading, rest = afterLeading } =
            spanRidingComments (Array.dropFirst 1 items)

        glueHead =
            when { fn = Array.first items, arg0 = Array.first afterLeading } is
                { fn = Just fnItem, arg0 = Just arg0Item } ->
                    if not (isCommentItem fnItem) && not (isCommentItem arg0Item) && shouldGlueBox fnItem arg0Item then
                        joinInline
                            ([ fnItem.box ]
                                ++ Array.mapAndKeepJust (\c -> Maybe.map .box c.comment) leading
                                ++ [ arg0Item.box ]
                            )

                    else
                        Nothing

                _ ->
                    Nothing
    in
    when glueHead is
        Just glueLine ->
            let
                rest =
                    Array.dropFirst (Array.length leading + 2) items
            in
            if Array.isEmpty rest then
                -- Just `fn arg0` — nothing forces a break after all.
                Ok glueLine

            else
                -- The rest (args and comments alike) assembles as a broken flow
                -- at +0 and the whole block shifts to +indent under the glued
                -- line.
                assembleBrokenWithComments 0 rest
                    |> Result.map (\restBox -> B.stack1 [ glueLine, applyIndent indent restBox ])

        Nothing ->
            -- No glue: head at the base column, every later item (and any
            -- same-row/own-line comment) per the broken-flow fold.
            assembleBrokenWithComments indent items


-- The leading run of comment items that can share the line they are on: a
-- single-line `{- -}` the classifier tagged as gluing. Stops at the first item
-- that is not one, so the caller gets `{ leading = comments, rest = the item
-- they precede }`.
spanRidingComments : Array FlowItem -> { leading : Array FlowItem, rest : Array FlowItem }
spanRidingComments items =
    let
        rides item =
            when item.comment is
                Just c ->
                    not c.isLineComment && not c.multiLine && commentGluesToPrevious item.node

                Nothing ->
                    False

        n =
            (Array.foldl
                (\item acc ->
                    if acc.stopped || not (rides item) then
                        { acc | stopped = True }

                    else
                        { acc | i = acc.i + 1 }
                )
                { i = 0, stopped = False }
                items
            ).i
    in
    { leading = Array.slice 0 n items, rest = Array.dropFirst n items }


-- Both single-line and on the same source row → keep glued on the opening line.
shouldGlueBox : FlowItem -> FlowItem -> Bool
shouldGlueBox fnItem arg0Item =
    isSingleLine fnItem.box
        && isSingleLine arg0Item.box
        && nodesShareStartRow fnItem.node arg0Item.node


{-| Which indent discipline a multi-line box's continuation lines carry —
the static per-box-type alignment table (CutoverScope.md "Item 4 design"),
verified against elm-format's layout, not curve-fit. It decides which
primitive materializes a soft glue (elm-format's flow separator flattens to a
space, so the item's first line joins the running line and its continuation
lines land per the item's own alignment):

  - `AlignCarrying` — elm-format anchors these continuation lines at the item's
    printed start column: bracket literals and multiline strings. Glue with
    `B.prefix`, which pads every continuation line by the glued prefix's exact
    character width. This is only sound because these boxes' continuation lines
    are punctuation- or verbatim-prefixed (`, item`, `}`, string content) — NOT
    `Tab`-indented.
  - `AlignCarryingTabbed` — `RecordUpdate`: align-carrying too (anchored at the
    item's start column), but its Box continuation lines
    carry `Tab`s, which a bare `B.prefix`'s space padding would quantize to the
    next multiple of 4 (the census's "per-row exact-space indent" hard class).
    `B.freezeTabs` first rewrites those `Tab`s to the literal spaces they render
    to at their standalone columns, so the following `B.prefix` shifts every
    line by the prefix's exact width — matching the align anchor.
  - `NestCarrying` — nested relative to the flow's base, not the glue column:
    `AcrossOrVertical` (the flow fold / broken call at +grenIndent), `OpAndRhs`
    / `Glue` / `PrefixGlue` (inline flows at +0), and pipelines (steps at
    +grenIndent). Glue first-line-only: the continuation lines already carry the
    item's own indent relative to the flow base, which the flow's final
    `applyIndent flowIndent` (its outer nest) completes.
  - `UnclassifiedCarrying` — everything else must stay an `Err` fallback:
    guessing produces a Box-only layout, the exact divergence class the
    shared FlowPolicy core exists to prevent.

LOAD-BEARING invariant: any new align-carrying builder must update this table.
-}
type SoftGlueAlignment
    = AlignCarrying
    | AlignCarryingTabbed
    | NestCarrying
    | UnclassifiedCarrying


{-| True when a paren's content leads with an align-carrying node (a bracket
literal / record / record update) — the shapes whose continuation lines anchor
at their own start column, so wrapping them in `(` must pad every line (not just
the first) to keep `,`/`}` under the opening bracket. Leading single-line block
comments are skipped (they ride on the `(`-line). -}
parenInnerIsAlignCarrying : Array LPNode -> Bool
parenInnerIsAlignCarrying children =
    when Array.popFirst children is
        Just { first, rest } ->
            when lpnBox first is
                BlockComment _ ->
                    parenInnerIsAlignCarrying rest

                SingleLineComment _ ->
                    parenInnerIsAlignCarrying rest

                _ ->
                    when softGlueAlignment first is
                        AlignCarrying ->
                            True

                        AlignCarryingTabbed ->
                            True

                        _ ->
                            False

        Nothing ->
            False


softGlueAlignment : LPNode -> SoftGlueAlignment
softGlueAlignment node =
    when lpnBox node is
        AlwaysVertical _ ->
            AlignCarrying

        AllAcrossOrAllVertical _ ->
            AlignCarrying

        MultilineString _ ->
            AlignCarrying

        RecordUpdate _ ->
            AlignCarryingTabbed

        AcrossOrVertical _ ->
            NestCarrying

        OpAndRhs ->
            NestCarrying

        Glue ->
            NestCarrying

        PrefixGlue _ ->
            NestCarrying

        Pipeline _ ->
            NestCarrying

        _ ->
            UnclassifiedCarrying


-- True for a flow item whose node is a bracket LITERAL (record / array / record
-- update) — the align-carrying shapes, so a `B.prefix` glue of their first line
-- pads continuation lines to stay aligned under the opening bracket.
isSoftGlueLiteral : FlowItem -> Bool
isSoftGlueLiteral item =
    when lpnBox item.node is
        AlwaysVertical _ ->
            True

        AllAcrossOrAllVertical _ ->
            True

        RecordUpdate _ ->
            True

        _ ->
            False


{-| Soft-glue a flow whose ONLY multi-line item is a bracket literal (elm-format
glues every item and lets the literal break internally): the single-line prefix
items glue to the literal's first line, its continuation pads to align under the
bracket (`B.prefix`), and any single-line suffix items (a trailing `=`) glue onto
its last line (`B.addSuffix`). Covers a multi-line record/array *pattern* function
argument (`multilineRecord { alpha\n, beta\n} =`), which `assembleFlowImpl`'s
flat stacker would instead drop to its own line. Returns Nothing (→ general
assembler) unless the shape matches exactly: no comments/blank lines/hard blocks,
a non-empty single-line prefix, exactly one multi-line item, and it is a bracket
literal. Only reached from `assembleFlow` (the gluing flow path) — a call whose
record arg *drops* goes through `assembleBrokenCall` instead. -}
-- Render a prefix/suffix flow item to the single inline `Line` it contributes to
-- a soft-glue flow. A plain item uses its box (which must be single-line); a
-- single-line block-comment item (`{- c -}`) uses its rendered comment box, so a
-- trailing comment (`… exposing (..) {- c -}`) glues onto the soft literal's last
-- line. A `--` line comment or a multi-line block comment can't glue inline, so it
-- Errs — dropping the whole flow back to the general assembler.
flowItemInlineLine : FlowItem -> Result String B.Line
flowItemInlineLine item =
    let
        asLine box =
            when B.isLine box is
                Ok l ->
                    Ok l

                Err _ ->
                    Err "box: multi-line item in soft-glue flow"
    in
    when item.comment is
        Just c ->
            if c.isLineComment || c.multiLine then
                Err "box: non-inline comment in soft-glue flow"

            else
                asLine c.box

        Nothing ->
            asLine item.box


trySoftGlueFlow : Array FlowItem -> Maybe Box
trySoftGlueFlow items =
    if Array.any (\it -> isEmptyLine it.node) items then
        Nothing

    else
        let
            multiIdxs =
                Array.foldl
                    (\it acc ->
                        { i = acc.i + 1
                        , idxs =
                            if isSingleLine it.box then
                                acc.idxs

                            else
                                Array.pushLast acc.i acc.idxs
                        }
                    )
                    { i = 0, idxs = [] }
                    items
        in
        when multiIdxs.idxs is
            [ idx ] ->
                let
                    softItem =
                        Array.get idx items

                    prefix =
                        Array.takeFirst idx items

                    suffix =
                        Array.dropFirst (idx + 1) items
                in
                when { s = softItem, pl = traverseResult flowItemInlineLine prefix, sl = traverseResult flowItemInlineLine suffix } is
                    { s = Just soft, pl = Ok prefixLines, sl = Ok suffixLines } ->
                        -- Require BOTH a non-empty single-line prefix AND a
                        -- non-empty single-line suffix. The suffix (a trailing
                        -- synthesized `=`) is what marks a funcDecl/`let`
                        -- destructuring HEADER — where the flow glues the pattern
                        -- and appends `=` — apart from a call argument
                        -- (`fn { record }`, no trailing token) where the
                        -- record instead DROPS to its own line (via the pipeline
                        -- trigger / broken-call path). Without this gate a
                        -- multi-line record call arg would be wrongly glued.
                        --
                        -- A multi-line TYPE record after a real head is the
                        -- policy's DropBlock (the type-record drop) — the fold
                        -- must handle it, not this glue: a trailing comment
                        -- item (`} {- c -}`) would otherwise satisfy the
                        -- non-empty-suffix gate and wrongly glue a signature
                        -- segment's dropping record.
                        if isSoftGlueLiteral soft && not (Array.isEmpty prefixLines) && not (Array.isEmpty suffixLines) && not (FP.isTypeRecordLiteral soft.node) then
                            let
                                prefixLine =
                                    B.row (Array.intersperse B.space prefixLines)

                                glued =
                                    B.prefix (B.row [ prefixLine, B.space ]) soft.box
                            in
                            Just (B.addSuffix (B.row ([ B.space ] ++ Array.intersperse B.space suffixLines)) glued)

                        else
                            Nothing

                    _ ->
                        Nothing

            _ ->
                Nothing


{-| Pair each single-line block-comment item with an immediately following item
that will DROP to its own line, removing the comment from the item list and
attaching it to that item's entry. `assembleFlowImpl`'s fold then either drops
the pair together (the comment stacked directly above the item, at the drop
indent) or replays the plain unpaired steps.

Two followers pair:

  - a **type-record literal** — the `DropBlock` rule. Flows containing an arrow
    (a function type's segments) pair too: the drop's reparse fixed point is
    guaranteed by `makeSignatureBox` folding `segmentHasDroppingRecordBox` into
    the signature's own `forceVertical` decision (the idempotency rule).

  - a **`SoftIndentedBlock` that rendered multi-line** — a lambda body the
    author started on the `->` row that turned out to wrap, so
    `BlockJoin SoftIndentedRule`'s materializer drops it to its own line at +4.
    Without the pairing the comment stays glued to the `->` row while its body
    drops below it (`\item -> {- c -}` / `body`); reparsed, the comment is no
    longer on the body's row, so `insertLambda` picks `IndentedBlock` and
    `Comments.gren` redirects the comment INTO it, rendering it on its own line
    — the file oscillates. Dropping the comment WITH the body from the first
    format lands on the shape every later reparse settles on. Note the trigger
    is a *rendered* fact (`isSingleLine`): what forces the wrap can be a comment
    buried in the body (a trailing `--` on the last operand), which no AST-level
    predicate in `InsertExpressions` can see.

Only a non-gluing comment pairs with the soft block: a `TrailsPrevious` /
`RidesInline` comment belongs to the token before it and must stay on that line.
-}
pairLeadingComments : Array FlowItem -> Array { item : FlowItem, leading : Maybe FlowItem }
pairLeadingComments items =
    let
        pairableComment it =
            when it.comment is
                Just c ->
                    not c.isLineComment && not c.multiLine

                Nothing ->
                    False

        -- NB Gren's `Array.get -1` wraps to the LAST element: without this guard,
        -- a record at index 0 would pair with a comment TRAILING the flow and
        -- duplicate it.
        at i =
            if i < 0 then
                Nothing

            else
                Array.get i items

        -- `items[i]` is a comment consumed by `items[i + 1]`. One predicate
        -- answers both directions, so the "drop this entry" pass and the
        -- "attach as leading" pass can never disagree and duplicate or lose it.
        pairsAt i =
            when at i is
                Nothing ->
                    False

                Just it ->
                    pairableComment it
                        && (when at (i + 1) is
                                Nothing ->
                                    False

                                Just next ->
                                    FP.isTypeRecordLiteral next.node
                                        || (commentDoesNotGlue it && softBlockDropsBox next)
                           )
    in
    items
        |> Array.indexedMap (\i it -> { i = i, it = it })
        |> Array.mapAndKeepJust
            (\{ i, it } ->
                if pairsAt i then
                    -- Consumed: attached to the item that follows.
                    Nothing

                else
                    Just
                        { item = it
                        , leading =
                            if pairsAt (i - 1) then
                                at (i - 1)

                            else
                                Nothing
                        }
            )


-- A comment item the flow must not glue onto the preceding line: its stored
-- `CommentRole` is any of the non-gluing ones, so it leads its own line, leads
-- the item after it, or stands alone.
--
-- NOT the same test as `MakeRenderBox.commentLeadsOwnLine`, which is `role ==
-- LeadsOwnLine` exactly. This one is the complement of `roleGlues`, so it also
-- covers `LeadsNext` / `TrailsHead` / `LeadsInline` / `Standalone`. The two wore
-- the same name until 2026-08-02.
commentDoesNotGlue : FlowItem -> Bool
commentDoesNotGlue item =
    when commentRole (lpnBox item.node) is
        Just role ->
            not (roleGlues role)

        Nothing ->
            False


-- A `SoftIndentedBlock` whose box rendered multi-line: `BlockJoin
-- SoftIndentedRule` drops it to its own line at +4 rather than gluing it onto
-- the running line.
softBlockDropsBox : FlowItem -> Bool
softBlockDropsBox item =
    when lpnBox item.node is
        SoftIndentedBlock ->
            not (isSingleLine item.box)

        _ ->
            False


-- A `SoftIndentedBlock` whose SOLE child is a bracket literal (record, record
-- update, or array) that renders vertical switches from the soft glue to the
-- hard indented drop. The structural test is on the LPNode; the verticality
-- fact comes from this renderer's own box (single-line ⇔ the sole child is
-- single-line, since it is the block's only content).
softBlockChildForcesVerticalBox : FlowItem -> Bool
softBlockChildForcesVerticalBox item =
    when Array.popFirst (lpnChildren item.node) is
        Just { first = only, rest } ->
            if not (Array.isEmpty rest) then
                False

            else
                let
                    isBracketLiteral =
                        when lpnBox only is
                            AlwaysVertical _ ->
                                True

                            AllAcrossOrAllVertical _ ->
                                True

                            RecordUpdate _ ->
                                True

                            _ ->
                                False
                in
                isBracketLiteral && not (isSingleLine item.box)

        Nothing ->
            False
