-- `exposing` stays glued to the header. Inline list: `header (a, b, c)` on one
-- line. Vertical list: header on line 1, list indented +4 beneath it. The
-- header is pre-rendered by the caller: a plain leaf line for a `module` /
-- `import` header, or the flowed `effect module … where { … } exposing` line for
-- an effect module.
--
-- Only the INLINE form needs the header to be one line, because there the list
-- has to join the header's own row. The vertical form merely stacks. Refusing a
-- multi-line header there was not a safeguard: the caller's fallback is the
-- generic flow, which glues the list's FIRST ITEM onto the header's last row,
-- and for a one-item list that erases the only evidence a reparse has that the
-- list was vertical (`MakeLogical.exposedStartsBelowHeader` has nothing below
-- the header to see). The derived `)` then collapses back onto that row and a
-- comment pinned above it falls outside the list and detaches to column 1.
--
-- The hoist branch in `makeExposingLineBox` applies the same relaxation, and
-- must: the two are reachable from each other's output, so while both refused a
-- multi-line header they agreed by falling back together, and relaxing one alone
-- makes a header comment alternate between the two layouts for ever.
gluedExposingBox : Bool -> Box -> Box -> Result String Box
gluedExposingBox forceVertical headerBox listBox =
    if forceVertical then
        Ok (B.stack1 [ headerBox, B.indent listBox ])

    else
        when B.isLine headerBox is
            Err _ ->
                Err "box: exposing header rendered multi-line"

            Ok headerLine ->
                when B.isLine listBox is
                    Ok listLine ->
                        Ok (B.line (B.row [ headerLine, B.space, listLine ]))

                    Err _ ->
                        Err "box: inline exposing list rendered multi-line"


verticalExposingBox : Array B.Line -> Box
verticalExposingBox itemLines =
    when Array.popFirst itemLines is
        Just { first, rest } ->
            B.stack1
                ([ B.prefix (B.row [ B.punc "(", B.space ]) (B.line first) ]
                    ++ Array.map (\l -> B.prefix (B.row [ B.punc ",", B.space ]) (B.line l)) rest
                    ++ [ B.line (B.punc ")") ]
                )

        Nothing ->
            B.line (B.punc "()")


{-| The opening and closing punctuation for a bracket kind. Total: `ListBrackets`
has exactly these three constructors, so there is no "no punctuation" case. It
returned a `Maybe` until 2026-08-02, which cost three call sites an impossible
`Nothing` branch each, all three carrying the same copied comment explaining that
it could not happen. -}
bracketPunc : ListBrackets -> { left : String, right : String }
bracketPunc bracket =
    when bracket is
        ListCurly _ ->
            { left = "{", right = "}" }

        ListSquare ->
            { left = "[", right = "]" }

        ListParen ->
            -- A parenthesized exposing list reached via the general list path
            -- rather than `makeExposingLineBox` — i.e. a module/import line
            -- whose header carries a comment, so `makeExposingLineBox` fell back
            -- to the flow. It renders TIGHT (`(a, b)`), like the coupled path
            -- and like elm-format: `makeLiteralBox` passes
            -- `innerSpaces = bracket /= ListParen`, and `ListParen` is
            -- exclusively an exposing list (`MakeLogical.exposingListShape` is its
            -- only builder), so no record or array is affected.
            --
            -- This was padded (`( a, b )`) until 2026-07-25. Tightening it was
            -- tried once before and reverted, because a comment trailing past
            -- the close was then idempotent only at the padded column —
            -- tightening shifted the reparse so the comment was absorbed inside
            -- the parens. The elastic close removed that constraint: a comment
            -- after the last name is now read as the list's and pinned above the
            -- `)` at any column, so the column no longer decides anything.
            { left = "(", right = ")" }


{-| One rendered flow child.

`lambdaBodyBox` is set only for a `ParenBlock` whose second child is an
`IndentedBlock` — a lambda whose body the author wrote on a later row. It is
that block's own box, taken from the very render that produced `box`, and it is
exactly `buildFlowBox 0 (lpnChildren bodyNode)` (`makePBox IndentedBlock` *is*
that call). Two consumers need the body separately from the head to build the
`… (\x ->` / body / `)` layouts — `makeMultilineLambdaArgBox` and
`directOperandLambdaSplit` — and both used to render it a second time, which
made a lambda nested through its own body cost 2^depth. Carrying it here is what
makes them free.
-}
type alias FlowItem =
    { node : LPNode
    , box : Box
    , isBlock : Bool
    , comment : Maybe { box : Box, isLineComment : Bool, multiLine : Bool }
    , lambdaBodyBox : Maybe Box
    }


{-| What `assembleFlowMeasured` reports for one placed flow item: the item, and
how many rows the assembled box grew by when it was placed. See
`typeContentSpansRows` for the one question these answer. -}
type alias FlowMeasure =
    { node : LPNode
    , box : Box
    , rowsAdded : Int
    }


{-| Did the TYPE's own content come back spread over more than one row, in the
box the assembler actually built?

This is the question `makeSignatureBox` / `makeTypeAliasBody` must answer before
choosing between the inline flow and the per-segment layout, and it is the
comment-bearing twin of the rule the no-comment arm already uses ("the flow came
back multi-line, so a break the author wrote survived rendering"). A type that
came back on one row keeps the inline layout; one that did not takes the
per-segment shape, which for a single-segment type is simply the whole type
dropped below the header.

It is asked of the **rendered box**, not of the nodes. The predicate it replaces
(`commentSplitsType`) hand-predicted which comment would break which row and was
mis-scoped three times in one day, because a prediction can disagree with the
renderer; a measurement cannot. It also has to be right for two separate
reasons, and asking the box gets both at once:

  - **layout.** elm-format drops a type below `name :` as soon as something
    breaks it open, and so did gren before, via this predicate.
  - **stability.** `NodeClassify.signatureForceVertical` asks of the *source*
    rows whether a later `->` segment starts below the previous one, so an
    inline format that let a comment push a segment down is read back as
    author-broken and re-rendered per-segment: the file oscillates. A type whose
    content stayed on one row cannot have moved a segment, so committing to the
    inline layout exactly there is what makes it a fixed point.

Two details make the measured rows the right ones:

  - **the header is skipped** — everything up to and including a top-level `:`
    leaf. A signature has exactly one (a record field's `:` is a child of the
    record node, never a flow sibling of the type); an alias body has none, and
    drops nothing.
  - **comments are skipped**, exactly as `segFirstRow`/`segLastRow` skip them.
    That is what keeps `foo : -- c` ⏎ `Int -> Int` inline: the comment brings a
    row of its own, but the *type* is still on one row, and pulling it below the
    header would be re-laying-out code the comment only moved. The same skip at
    the other end keeps `foo : Int -> String {- x` ⏎ `y -}` inline. Those two
    ends were `commentSplitsType`'s "content before and after" guards, each
    learned by getting it wrong; here they are not a rule, just the consequence
    of measuring content. -}
typeContentSpansRows : Array FlowMeasure -> Bool
typeContentSpansRows measures =
    let
        -- Running the row additions up gives each item's last row; its own
        -- height gives back its first.
        placed =
            (Array.foldl
                (\m acc ->
                    let
                        endRow =
                            acc.total + m.rowsAdded - 1
                    in
                    { total = acc.total + m.rowsAdded
                    , out =
                        Array.pushLast
                            { node = m.node
                            , firstRow = endRow - (B.height m.box - 1)
                            , lastRow = endRow
                            }
                            acc.out
                    }
                )
                { total = 0, out = [] }
                measures
            ).out

        afterColon =
            when Array.findFirst (\p -> isColonLeaf p.node) placed is
                Just found ->
                    Array.dropFirst (found.index + 1) placed

                Nothing ->
                    placed

        content =
            Array.keepIf (\p -> not (nodeIsComment p.node)) afterColon
    in
    when { first = Array.first content, last = Array.last content } is
        { first = Just f, last = Just l } ->
            l.lastRow > f.firstRow

        _ ->
            False


isCommentItem : FlowItem -> Bool
isCommentItem item =
    item.comment /= Nothing


{-| The single line of a comment that can ride its neighbour's row: a
single-line block comment that rendered to exactly one `Line`. A `--` runs to
end of line and a multi-line `{- … -}` brings its own newlines, so neither can
ride — both give `Nothing`.

Takes a `FlowItem`'s `comment` payload, so both the broken-flow assembler here
and the binop-chain splitter in `MakeRenderBox` ask it the same way; the latter
had a copy of this body, whose docstring said it was "literally the
`pairableCommentLine` rule". -}
pairableCommentLine : { box : Box, isLineComment : Bool, multiLine : Bool } -> Maybe B.Line
pairableCommentLine c =
    if not c.isLineComment && not c.multiLine then
        when B.isLine c.box is
            Ok cl ->
                Just cl

            Err _ ->
                Nothing

    else
        Nothing


{-| Assemble a broken flow (head at base, each following item at +`indent`) that
may carry comments.

**This is the comment-placement policy for a flow the caller has already
committed to breaking**, and it is the second such policy in `Render/` —
`FlowPolicy.decide` is the one for a flow that may still glue, and nothing here
calls it. Its `pending` / `poisoned` / `lastRow` accumulator plays the part
`decide`'s separator states play there. The two agree on how a comment is
*classified* (the stored `CommentRole`, `commentGluesToPrevious`,
`pairableCommentLine` are shared) and differ on assembly, which is the finding
that stopped the migration between them. See `FlowPolicy`'s module doc for the
division.

A comment trailing the preceding item on the same source row
glues onto that item's last line — for a single-line item, its line plus a space
is prepended onto the comment box (`B.prefix`), so a multi-line comment's body
reindents under it (`f {- multi… -}`, `+ b {- multi… -}`). A single-line block
comment that LEADS (does not glue backward) rides the next term's line
(`{- c -} nextTerm`), at any position in the flow — elm-format keeps a leading
block comment on its argument's / operand's line in a broken call and a broken
binop alike, and only that pairing is a reparse fixed point once the comment sits
on the term's row. A `--` or a multi-line `{- -}` never pairs: it stands on its
own row (nothing can follow a `--` on its line; a multi-line comment has no
single line to ride), and it poisons the rest of its run so the block comments
behind it stay own-row too rather than jumping ahead of it — pairing is
all-or-nothing over a run, as in elm-format. A leading comment whose next term
renders multi-line also stands alone — there is no single first line to ride
there either. -}
assembleBrokenWithComments : Int -> Array FlowItem -> Result String Box
assembleBrokenWithComments indent items =
    let
        -- `acc.pending` holds the leading comment run waiting for the term it
        -- rides, grouped into the ROWS THE AUTHOR WROTE IT ON: a member whose
        -- stored role glues (`RidesInline` / `TrailsPrevious`) joins the row
        -- before it, one that leads its own row starts a new one. **gren never
        -- moves a comment between rows**, so that grouping survives whatever
        -- happens to the run afterwards -- riding the term, or stacking above it.
        --
        -- Flushing gives up on the ride and emits one row per AUTHORED row.
        -- Emitting one row per MEMBER (as this did until 2026-08-08) split a run
        -- written on one row and disagreed with the riding arm below, which has
        -- always space-joined; joining every member into ONE row instead is the
        -- opposite error and merges rows the author kept apart.
        flushPending acc =
            { acc
                | entries = acc.entries ++ Array.map (\row -> B.line (commentRunLine row)) acc.pending
                , pending = []
            }

        -- Add a pairable comment to the run, on the previous member's row when
        -- the author wrote it there and on a row of its own otherwise.
        addPending glues cl acc =
            when Array.popLast acc.pending is
                Just { last = row, initial } ->
                    if glues then
                        { acc | pending = Array.pushLast (Array.pushLast cl row) initial }

                    else
                        { acc | pending = Array.pushLast [ cl ] acc.pending }

                Nothing ->
                    { acc | pending = [ [ cl ] ] }

        -- Pairing is all-or-nothing over a comment RUN: once a comment in the
        -- current run has gone to its own row (a `--`, a multi-line `{- -}`),
        -- the run is poisoned and the block comments after it stay own-row too
        -- rather than jumping ahead of it onto the term. elm-format's rule,
        -- verified: `-- first` / `{- c -}` / `w` keeps both comments own-row.
        -- Reset by any real term, which ends the run.
        --
        -- A member the author wrote ON the run's current row still stays there,
        -- `--` included: `{- a -} {- b -} -- c` keeps all three on one row and
        -- the term goes below. `poisoned` then says two things at once, both
        -- true of that row — nothing further may join it, and it can no longer
        -- ride a term (gluing onto a line ending in a `--` would land inside the
        -- comment). Only a single-line box can join; a multi-line `{- .. -}`
        -- brings rows of its own and takes the stacking path below.
        ownRow glues c acc =
            let
                stacked =
                    let
                        flushed =
                            flushPending acc
                    in
                    { flushed
                        | entries = Array.pushLast c.box flushed.entries
                        , lastRow = -1
                        , poisoned = True
                    }
            in
            when { rows = Array.popLast acc.pending, line = B.isLine c.box } is
                { rows = Just { last = row, initial = rowsAbove }, line = Ok cl } ->
                    if glues then
                        { acc
                            | pending = Array.pushLast (Array.pushLast cl row) rowsAbove
                            , lastRow = -1
                            , poisoned = True
                        }

                    else
                        stacked

                _ ->
                    stacked

        step item accResult =
            accResult
                |> Result.andThen
                    (\acc ->
                        when item.comment is
                            Just c ->
                                when Array.popLast acc.entries is
                                    Just { last = lastBox, initial } ->
                                        if commentGluesToPrevious item.node && acc.lastRow >= 0 && Array.isEmpty acc.pending then
                                            -- Glue the comment onto the item's last
                                            -- line; the item may itself be multi-line
                                            -- (`glueCommentSuffix` joins its last line).
                                            -- `acc.lastRow >= 0` still guards "the
                                            -- previous entry is real content" (it
                                            -- resets to -1 after a comment).
                                            -- `pending` must be empty or the glue
                                            -- would reorder this comment before the
                                            -- ones already waiting.
                                            Ok { acc | entries = Array.pushLast (glueCommentSuffix c.box lastBox) initial }

                                        else
                                            when pairableCommentLine c is
                                                Just cl ->
                                                    if acc.poisoned then
                                                        Ok (ownRow (commentGluesToPrevious item.node) c acc)

                                                    else
                                                        Ok (addPending (commentGluesToPrevious item.node) cl acc)

                                                Nothing ->
                                                    -- Own row, with the next item
                                                    -- starting on a fresh line.
                                                    -- After a comment nothing
                                                    -- row-glues (the policy is
                                                    -- AlreadyTerminated), so
                                                    -- `lastRow` resets.
                                                    Ok (ownRow (commentGluesToPrevious item.node) c acc)

                                    Nothing ->
                                        when pairableCommentLine c is
                                            Just cl ->
                                                if acc.poisoned then
                                                    Ok (ownRow (commentGluesToPrevious item.node) c acc)

                                                else
                                                    Ok (addPending (commentGluesToPrevious item.node) cl acc)

                                            Nothing ->
                                                -- First-position `--` / multi-line
                                                -- comment: its own first entry.
                                                Ok (ownRow (commentGluesToPrevious item.node) c acc)

                            Nothing ->
                                if not (Array.isEmpty acc.pending) && not acc.poisoned && isSingleLine item.box then
                                    -- The waiting comments ride this term's line:
                                    -- `{- c -} term`. `lastRow` advances like a
                                    -- plain term's — a comment trailing the term
                                    -- must still glue on, or its own-row form
                                    -- would re-pair FORWARD on reparse and
                                    -- oscillate.
                                    --
                                    -- Only the run's LAST authored row rides; any
                                    -- row the author wrote above it stays above
                                    -- it, since the ride must not pull a comment
                                    -- up out of the row it was written on.
                                    when Array.popLast acc.pending is
                                        Nothing ->
                                            Ok acc

                                        Just { last = rideRow, initial = rowsAbove } ->
                                            let
                                                stacked =
                                                    flushPending { acc | pending = rowsAbove }

                                                prefixRow =
                                                    B.row [ commentRunLine rideRow, B.space ]
                                            in
                                            Ok
                                                { stacked
                                                    | entries = Array.pushLast (B.prefix prefixRow item.box) stacked.entries
                                                    , lastRow = lpnMaxRow item.node
                                                    , pending = []
                                                    , poisoned = False
                                                }

                                else
                                    flushPending acc
                                        |> (\a ->
                                                Ok
                                                    { a
                                                        | entries = Array.pushLast item.box a.entries
                                                        , lastRow = lpnMaxRow item.node
                                                        , poisoned = False
                                                    }
                                           )
                    )
    in
    Array.foldl step (Ok { entries = [], lastRow = -1, pending = [], poisoned = False }) items
        |> Result.map flushPending
        |> Result.andThen
            (\acc ->
                when Array.popFirst acc.entries is
                    Nothing ->
                        Err "box: empty broken flow"

                    Just { first = head, rest } ->
                        Ok (B.stack1 ([ head ] ++ Array.map (applyIndent indent) rest))
            )


{-| A function application forced across lines — elm-format's
`ElmStructure.application`. The first argument stays glued to the function on
the opening line only when both are single-line and share a source row;
otherwise the function stands alone. Every non-glued argument drops to its own
line at +`indent`. -}
assembleBrokenCall : Int -> Array FlowItem -> Result String Box
assembleBrokenCall indent items =
    let
        -- The fn+arg0 glue survives comments AFTER arg0 (`String.join " "
        -- -- c` keeps `" "` on the opening line, comments drop below with the
        -- args) and comments BETWEEN the two, which ride the opening line with
        -- them (`String.join {- sep -} " "` / args below).
        --
        -- The in-between run used to block the glue, on the stated grounds that
        -- it matched elm-format's `ElmStructure.application` gates. It does not:
        -- elm attaches such a comment to the ARGUMENT, so its arg0 is still an
        -- argument and still glues. Refusing here also contradicted gren's own
        -- rule — the glue is gated on `nodesShareStartRow fn arg0`, and writing a
        -- comment between them moves neither token's row, so nothing about the
        -- author's layout changed and nothing about ours should have.
        --
        -- Only comments that can share the line ride it: a single-line `{- -}`
        -- the classifier tagged as gluing. A `--` runs to end of line and a
        -- multi-line `{- … -}` brings its own newlines, so either one still
        -- stands the function up alone, as before.
        { leading, rest = afterLeading } =
            spanRidingComments (Array.dropFirst 1 items)

        glueHead =
            when { fn = Array.first items, arg0 = Array.first afterLeading } is
                { fn = Just fnItem, arg0 = Just arg0Item } ->
                    if not (isCommentItem fnItem) && not (isCommentItem arg0Item) && shouldGlueBox fnItem arg0Item then
                        joinInline
                            ([ fnItem.box ]
                                ++ Array.mapAndKeepJust (\c -> Maybe.map .box c.comment) leading
                                ++ [ arg0Item.box ]
                            )

                    else
                        Nothing

                _ ->
                    Nothing
    in
    when glueHead is
        Just glueLine ->
            let
                rest =
                    Array.dropFirst (Array.length leading + 2) items
            in
            if Array.isEmpty rest then
                -- Just `fn arg0` — nothing forces a break after all.
                Ok glueLine

            else
                -- The rest (args and comments alike) assembles as a broken flow
                -- at +0 and the whole block shifts to +indent under the glued
                -- line.
                assembleBrokenWithComments 0 rest
                    |> Result.map (\restBox -> B.stack1 [ glueLine, applyIndent indent restBox ])

        Nothing ->
            -- No glue: head at the base column, every later item (and any
            -- same-row/line-leading comment) per the broken-flow fold.
            assembleBrokenWithComments indent items


-- The leading run of comment items that can share the line they are on: a
-- single-line `{- -}` the classifier tagged as gluing. Stops at the first item
-- that is not one, so the caller gets `{ leading = comments, rest = the item
-- they precede }`.
spanRidingComments : Array FlowItem -> { leading : Array FlowItem, rest : Array FlowItem }
spanRidingComments items =
    let
        rides item =
            when item.comment is
                Just c ->
                    not c.isLineComment && not c.multiLine && commentGluesToPrevious item.node

                Nothing ->
                    False

        n =
            (Array.foldl
                (\item acc ->
                    if acc.stopped || not (rides item) then
                        { acc | stopped = True }

                    else
                        { acc | i = acc.i + 1 }
                )
                { i = 0, stopped = False }
                items
            ).i
    in
    { leading = Array.slice 0 n items, rest = Array.dropFirst n items }


-- Both single-line and on the same source row → keep glued on the opening line.
shouldGlueBox : FlowItem -> FlowItem -> Bool
shouldGlueBox fnItem arg0Item =
    isSingleLine fnItem.box
        && isSingleLine arg0Item.box
        && nodesShareStartRow fnItem.node arg0Item.node


{-| Which indent discipline a multi-line box's continuation lines carry —
the static per-box-type alignment table (CutoverScope.md "Item 4 design"),
verified against elm-format's layout, not curve-fit. It decides which
primitive materializes a soft glue (elm-format's flow separator flattens to a
space, so the item's first line joins the running line and its continuation
lines land per the item's own alignment):

  - `AlignCarrying` — elm-format anchors these continuation lines at the item's
    printed start column: bracket literals and multiline strings. Glue with
    `B.prefix`, which pads every continuation line by the glued prefix's exact
    character width. This is only sound because these boxes' continuation lines
    are punctuation- or verbatim-prefixed (`, item`, `}`, string content) — NOT
    `Tab`-indented.
  - `AlignCarryingTabbed` — `RecordUpdate`: align-carrying too (anchored at the
    item's start column), but its Box continuation lines
    carry `Tab`s, which a bare `B.prefix`'s space padding would quantize to the
    next multiple of 4 (the census's "per-row exact-space indent" hard class).
    `B.freezeTabs` first rewrites those `Tab`s to the literal spaces they render
    to at their standalone columns, so the following `B.prefix` shifts every
    line by the prefix's exact width — matching the align anchor.
  - `NestCarrying` — nested relative to the flow's base, not the glue column:
    `AcrossOrVertical` (the flow fold / broken call at +grenIndent), `OpAndRhs`
    / `Glue` / `PrefixGlue` (inline flows at +0), and pipelines (steps at
    +grenIndent). Glue first-line-only: the continuation lines already carry the
    item's own indent relative to the flow base, which the flow's final
    `applyIndent flowIndent` (its outer nest) completes.
  - `UnclassifiedCarrying` — everything else must stay an `Err` fallback:
    guessing produces a Box-only layout, the exact divergence class the
    shared FlowPolicy core exists to prevent.

LOAD-BEARING invariant: any new align-carrying builder must update this table.
-}
type SoftGlueAlignment
    = AlignCarrying
    | AlignCarryingTabbed
    | NestCarrying
    | UnclassifiedCarrying


{-| True when a paren's content leads with an align-carrying node (a bracket
literal / record / record update) — the shapes whose continuation lines anchor
at their own start column, so wrapping them in `(` must pad every line (not just
the first) to keep `,`/`}` under the opening bracket. Leading single-line block
comments are skipped (they ride on the `(`-line). -}
parenInnerIsAlignCarrying : Array LPNode -> Bool
parenInnerIsAlignCarrying children =
    when Array.popFirst children is
        Just { first, rest } ->
            when lpnShape first is
                BlockComment _ ->
                    parenInnerIsAlignCarrying rest

                SingleLineComment _ ->
                    parenInnerIsAlignCarrying rest

                _ ->
                    when softGlueAlignment first is
                        AlignCarrying ->
                            True

                        AlignCarryingTabbed ->
                            True

                        _ ->
                            False

        Nothing ->
            False


softGlueAlignment : LPNode -> SoftGlueAlignment
softGlueAlignment node =
    if subtreeEndsWithMultilineBlockComment node then
        -- A multi-line `{- … -}` glued onto the box's last row pads its own
        -- continuation lines with literal spaces, so the body hangs under the
        -- comment's `{-`. That is an ALIGN anchor, no matter what the node type
        -- says: the box's tail is no longer nested relative to the flow base.
        -- Gluing it first-line-only (`NestCarrying`) leaves the comment's body
        -- short by the glued prefix's width, which is how a binop operand with
        -- a trailing multi-line comment ended up with its second row one column
        -- past the comment's opener instead of three.
        AlignCarrying

    else
        softGlueAlignmentByType node


softGlueAlignmentByType : LPNode -> SoftGlueAlignment
softGlueAlignmentByType node =
    when lpnShape node is
        AlwaysVertical _ ->
            AlignCarrying

        AllAcrossOrAllVertical _ ->
            AlignCarrying

        MultilineString _ ->
            AlignCarrying

        RecordUpdate _ ->
            AlignCarryingTabbed

        AcrossOrVertical _ ->
            NestCarrying

        OpAndRhs ->
            NestCarrying

        Glue ->
            NestCarrying

        PrefixGlue _ ->
            NestCarrying

        Pipeline _ ->
            NestCarrying

        _ ->
            UnclassifiedCarrying


-- True for a flow item whose node is a bracket LITERAL (record / array / record
-- update) — the align-carrying shapes, so a `B.prefix` glue of their first line
-- pads continuation lines to stay aligned under the opening bracket.
isSoftGlueLiteral : FlowItem -> Bool
isSoftGlueLiteral item =
    when lpnShape item.node is
        AlwaysVertical _ ->
            True

        AllAcrossOrAllVertical _ ->
            True

        RecordUpdate _ ->
            True

        _ ->
            False


{-| Soft-glue a flow whose ONLY multi-line item is a bracket literal (elm-format
glues every item and lets the literal break internally): the single-line prefix
items glue to the literal's first line, its continuation pads to align under the
bracket (`B.prefix`), and any single-line suffix items (a trailing `=`) glue onto
its last line (`B.addSuffix`). Covers a multi-line record/array *pattern* function
argument (`multilineRecord { alpha\n, beta\n} =`), which `assembleFlowImpl`'s
flat stacker would instead drop to its own line. Returns Nothing (→ general
assembler) unless the shape matches exactly: no comments/blank lines/hard blocks,
a non-empty single-line prefix, exactly one multi-line item, and it is a bracket
literal. Only reached from `assembleFlow` (the gluing flow path) — a call whose
record arg *drops* goes through `assembleBrokenCall` instead. -}
-- Render a prefix/suffix flow item to the single inline `Line` it contributes to
-- a soft-glue flow. A plain item uses its box (which must be single-line); a
-- single-line block-comment item (`{- c -}`) uses its rendered comment box, so a
-- trailing comment (`… exposing (..) {- c -}`) glues onto the soft literal's last
-- line. A `--` line comment or a multi-line block comment can't glue inline, so it
-- Errs — dropping the whole flow back to the general assembler.
--
-- **Shape is not enough: the comment's stored ROLE decides too.** This asked only
-- `isLineComment || multiLine` until 2026-08-09, which is `commentTextCanRide`'s
-- question (can these bytes share a row) and not this one (may this comment share
-- a row). A `LeadsLine` comment in front of a multi-line bracket PATTERN was
-- glued onto the pattern's first row, and a `let` binding that is not the first
-- cannot begin with a comment on its row at all — `{- k -} { kind` ⏎ `, value` ⏎
-- `} = 0` is refused by compiler-common AND by `gren make`, so the formatter was
-- turning a legal file into one that does not compile. The general assembler
-- stacks the comment above, which is what the same comment in front of a
-- single-line pattern has always got.
--
-- The docstring's own use case is untouched: a TRAILING comment glues, because
-- `TrailsPrevious`/`RidesInline` are exactly the roles `roleGlues` admits.
flowItemInlineLine : FlowItem -> Result String B.Line
flowItemInlineLine item =
    let
        asLine box =
            when B.isLine box is
                Ok l ->
                    Ok l

                Err _ ->
                    Err "box: multi-line item in soft-glue flow"
    in
    when item.comment is
        Just c ->
            if c.isLineComment || c.multiLine || commentDoesNotGlue item then
                Err "box: non-inline comment in soft-glue flow"

            else
                asLine c.box

        Nothing ->
            asLine item.box


trySoftGlueFlow : Array FlowItem -> Maybe Box
trySoftGlueFlow items =
    if Array.any (\it -> isEmptyLine it.node) items then
        Nothing

    else
        let
            multiIdxs =
                Array.foldl
                    (\it acc ->
                        { i = acc.i + 1
                        , idxs =
                            if isSingleLine it.box then
                                acc.idxs

                            else
                                Array.pushLast acc.i acc.idxs
                        }
                    )
                    { i = 0, idxs = [] }
                    items
        in
        when multiIdxs.idxs is
            [ idx ] ->
                let
                    softItem =
                        Array.get idx items

                    prefix =
                        Array.takeFirst idx items

                    suffix =
                        Array.dropFirst (idx + 1) items
                in
                when { s = softItem, pl = traverseResult flowItemInlineLine prefix, sl = traverseResult flowItemInlineLine suffix } is
                    { s = Just soft, pl = Ok prefixLines, sl = Ok suffixLines } ->
                        -- Require BOTH a non-empty single-line prefix AND a
                        -- non-empty single-line suffix. The suffix (a trailing
                        -- synthesized `=`) is what marks a funcDecl/`let`
                        -- destructuring HEADER — where the flow glues the pattern
                        -- and appends `=` — apart from a call argument
                        -- (`fn { record }`, no trailing token) where the
                        -- record instead DROPS to its own line (via the pipeline
                        -- trigger / broken-call path). Without this gate a
                        -- multi-line record call arg would be wrongly glued.
                        --
                        -- A multi-line TYPE record after a real head is the
                        -- policy's DropBlock (the type-record drop) — the fold
                        -- must handle it, not this glue: a trailing comment
                        -- item (`} {- c -}`) would otherwise satisfy the
                        -- non-empty-suffix gate and wrongly glue a signature
                        -- segment's dropping record.
                        if isSoftGlueLiteral soft && not (Array.isEmpty prefixLines) && not (Array.isEmpty suffixLines) && not (isTypeRecordLiteral soft.node) then
                            let
                                prefixLine =
                                    B.row (Array.intersperse B.space prefixLines)

                                glued =
                                    B.prefix (B.row [ prefixLine, B.space ]) soft.box
                            in
                            Just (B.addSuffix (B.row ([ B.space ] ++ Array.intersperse B.space suffixLines)) glued)

                        else
                            Nothing

                    _ ->
                        Nothing

            _ ->
                Nothing


{-| Pair each single-line block-comment item with an immediately following item
that will DROP to its own line, removing the comment from the item list and
attaching it to that item's entry. `assembleFlowImpl`'s fold then either drops
the pair together (the comment stacked directly above the item, at the drop
indent) or replays the plain unpaired steps.

Two followers pair:

  - a **type-record literal** — the `DropBlock` rule. Flows containing an arrow
    (a function type's segments) pair too: the drop's reparse fixed point is
    guaranteed by `makeSignatureBox` folding `segmentHasDroppingRecordBox` into
    the signature's own `forceVertical` decision (the idempotency rule).

  - a **`SoftIndentedBlock` that rendered multi-line** — a lambda body the
    author started on the `->` row that turned out to wrap, so
    `BlockJoin SoftIndentedRule`'s materializer drops it to its own line at +4.
    Without the pairing the comment stays glued to the `->` row while its body
    drops below it (`\item -> {- c -}` / `body`); reparsed, the comment is no
    longer on the body's row, so `insertLambda` picks `IndentedBlock` and
    `Comments.gren` redirects the comment INTO it, rendering it on its own line
    — the file oscillates. Dropping the comment WITH the body from the first
    format lands on the shape every later reparse settles on. Note the trigger
    is a *rendered* fact (`isSingleLine`): what forces the wrap can be a comment
    buried in the body (a trailing `--` on the last operand), which no AST-level
    predicate in `InsertExpressions` can see.

Only a non-gluing comment pairs with the soft block: a `TrailsPrevious` /
`RidesInline` comment belongs to the token before it and must stay on that line.
-}
pairLeadingComments : Array FlowItem -> Array { item : FlowItem, leading : Array FlowItem }
pairLeadingComments items =
    let
        pairableComment it =
            when it.comment is
                Just c ->
                    not c.isLineComment && not c.multiLine

                Nothing ->
                    False

        -- NB Gren's `Array.get -1` wraps to the LAST element: without this guard,
        -- a record at index 0 would pair with a comment TRAILING the flow and
        -- duplicate it.
        at i =
            if i < 0 then
                Nothing

            else
                Array.get i items

        -- The first item at or after `i` that is not itself a pairable comment
        -- — i.e. what a RUN of them leads. Looking only at `i + 1` (as this did
        -- until 2026-08-07) can only ever see a run of ONE: put a second comment
        -- in the gap and the first one's successor is a comment, no pairing
        -- happens, and the whole run falls back into the flow and glues onto the
        -- preceding row. `\q -> {- a -} {- b -} (fn one` ⏎ `two)` came out with
        -- both comments on the `->` row on the first format and each on its own
        -- row on the second, where a SINGLE comment there has always dropped to
        -- its own row above the body. 27 cells of the run axis, one per
        -- construct.
        target i =
            when at i is
                Nothing ->
                    Nothing

                Just it ->
                    if pairableComment it then
                        target (i + 1)

                    else
                        Just it

        -- The first member of the comment run `i` belongs to. The glue question
        -- is asked of IT, not of `i`: a later member's role is `RidesInline`
        -- *relative to the member before it*, which says nothing about whether
        -- the run may stay on the preceding line. Only the leader answers that,
        -- and C3 makes it the whole run's answer.
        runLeader i =
            if
                i > 0
                    && (when at (i - 1) is
                            Just prev ->
                                pairableComment prev

                            Nothing ->
                                False
                       )
            then
                runLeader (i - 1)

            else
                i

        -- `items[i]` is a comment consumed by the item its run leads. One
        -- predicate answers both directions, so the "drop this entry" pass and
        -- the "attach as leading" pass can never disagree and duplicate or lose
        -- it.
        pairsAt i =
            when at i is
                Nothing ->
                    False

                Just it ->
                    pairableComment it
                        && (when target (i + 1) is
                                Nothing ->
                                    False

                                Just next ->
                                    isTypeRecordLiteral next.node
                                        || ((when at (runLeader i) is
                                                Just leader ->
                                                    commentDoesNotGlue leader

                                                Nothing ->
                                                    False
                                            )
                                                && softBlockDropsBox next
                                           )
                           )

        -- Every member of the run immediately before `i`, in source order.
        leadingFor i =
            Array.slice 0 i items
                |> Array.indexedMap (\j _ -> j)
                |> Array.foldr
                    (\j acc ->
                        if acc.done || not (pairsAt j) then
                            { acc | done = True }

                        else
                            { acc | run = Array.pushFirst j acc.run }
                    )
                    { run = [], done = False }
                |> .run
                |> Array.mapAndKeepJust at
    in
    items
        |> Array.indexedMap (\i it -> { i = i, it = it })
        |> Array.mapAndKeepJust
            (\{ i, it } ->
                if pairsAt i then
                    -- Consumed: attached to the item its run leads.
                    Nothing

                else
                    Just { item = it, leading = leadingFor i }
            )


-- A comment item the flow must not glue onto the preceding line: its stored
-- `CommentRole` is any of the non-gluing ones, so it leads its own line, leads
-- the item after it, or stands alone.
--
-- NOT the same test as `NodeClassify.commentLeadsLine`, which is `role ==
-- LeadsLine` exactly. This one is the complement of `roleGlues`, so it also
-- covers `LeadsNext` / `TrailsHead` / `LeadsInline` / `Standalone`. The two wore
-- the same name until 2026-08-02.
commentDoesNotGlue : FlowItem -> Bool
commentDoesNotGlue item =
    when commentRole (lpnShape item.node) is
        Just role ->
            not (roleGlues role)

        Nothing ->
            False


-- A `SoftIndentedBlock` whose box rendered multi-line: `BlockJoin
-- SoftIndentedRule` drops it to its own line at +4 rather than gluing it onto
-- the running line.
softBlockDropsBox : FlowItem -> Bool
softBlockDropsBox item =
    when lpnShape item.node is
        SoftIndentedBlock ->
            not (isSingleLine item.box)

        _ ->
            False


-- A `SoftIndentedBlock` whose SOLE child is a bracket literal (record, record
-- update, or array) that renders vertical switches from the soft glue to the
-- hard indented drop. The structural test is on the LPNode; the verticality
-- fact comes from this renderer's own box (single-line ⇔ the sole child is
-- single-line, since it is the block's only content).
softBlockChildForcesVerticalBox : FlowItem -> Bool
softBlockChildForcesVerticalBox item =
    when Array.popFirst (lpnChildren item.node) is
        Just { first = only, rest } ->
            if not (Array.isEmpty rest) then
                False

            else
                let
                    isBracketLiteral =
                        when lpnShape only is
                            AlwaysVertical _ ->
                                True

                            AllAcrossOrAllVertical _ ->
                                True

                            RecordUpdate _ ->
                                True

                            _ ->
                                False
                in
                isBracketLiteral && not (isSingleLine item.box)

        Nothing ->
            False


{-| The flow item for a node whose box the caller already has. The generic arm of
`renderFlowItem`, minus the render — valid for any node kind that arm handles
(everything but a comment and a `ParenBlock`, which carry extra parts). -}
flowItemFromBox : LPNode -> Box -> FlowItem
flowItemFromBox node box =
    { node = node
    , box = box
    , isBlock = isBlockNode node box
    , comment = Nothing
    , lambdaBodyBox = Nothing
    }


{-| True when the operand is a single chain-breaking node (comments skipped)
whose ALREADY-rendered box is multi-line, so the whole chain must break
vertically — elm-format breaks a chain around any multi-line operand.

Decided from the operand's own rendered box, which is a reparse-stable function
of the operand subtree: an `if`/`when`/`let`, a multi-field record, an
author-broken paren, or a `--` forcing the `)` down each renders multi-line in
BOTH the flat and the re-broken input, so the chain breaks consistently. The
pure `bracketOperandForcesVertical` predicate this replaced could only
approximate it — it modelled neither `if`/`when`/`let` nor a paren's content, so
a paren-wrapped multi-line operand (`0 ++ (if …)`) glued on the flat format and
broke on reparse, oscillating for ever.

Reads the box `makeBinopBox` rendered once, rather than re-rendering the
subtree: deciding by throwaway render and then re-rendering in the chosen layout
is what cost O(2^depth) on nested operands. -}
operandItemsRenderMultiline : Array FlowItem -> Bool
operandItemsRenderMultiline items =
    when Array.popFirst (Array.keepIf (\it -> not (nodeIsComment it.node)) items) is
        Just { first = it, rest = rest } ->
            Array.isEmpty rest
                && isChainBreakingOperandShape (lpnShape it.node)
                && not (isSingleLine it.box)

        Nothing ->
            False


{-| One group of a vertical binop chain past the first: the operator that leads
it, the box its content rendered to, and the run of line-leading comment items
peeled off its end. -}
type alias BinopChainSegment =
    { op : String, operandBox : Box, ownLine : Array FlowItem }


{-| A paired leading comment RUN as one box per row THE AUTHOR WROTE IT ON: a
member whose stored role glues joins the row before it, one that leads its own
row starts a new box.

**gren never moves a comment between rows**, so the run that travels down with a
dropping block keeps its own shape while it travels. Emitting one box per member
(as this did until 2026-08-08) split `{- a -} {- b -}` onto two rows in exactly
the shapes where the block drops -- a lambda body, a multi-line record value --
while the same run in a flow that does not drop stayed on one row.

`glueCommentSuffix` does the joining, so a multi-line member glues onto the row's
last line with its body padded under itself, the same as every other same-row
trailing-comment site. -}
leadingRunRowBoxes : Array FlowItem -> Array Box
leadingRunRowBoxes items =
    Array.foldl
        (\li acc ->
            when li.comment is
                Nothing ->
                    acc

                Just lc ->
                    when Array.popLast acc is
                        Just { last = prevRow, initial } ->
                            if commentGluesToPrevious li.node then
                                Array.pushLast (glueCommentSuffix lc.box prevRow) initial

                            else
                                Array.pushLast lc.box acc

                        Nothing ->
                            [ lc.box ]
        )
        []
        items


{-| The line of a single-line block-comment item — the only comment kind that
can ride the operator line that follows it. Literally the `pairableCommentLine`
rule `assembleBrokenWithComments` uses for a broken call, over the same
`FlowItem.comment` record, so a broken call and a broken binop chain pair the
same comments. A `--` can have nothing after it on its row and a multi-line
`{- -}` has no single line to ride, so neither pairs. -}
-- `FlowAssembly.pairableCommentLine` for a whole flow item: `Nothing` unless the
-- item is a comment that can ride its neighbour's row.
pairableCommentItemLine : FlowItem -> Maybe B.Line
pairableCommentItemLine item =
    Maybe.andThen pairableCommentLine item.comment


{-| Decide a group's line-leading comment run: either the WHOLE run rides the next
group's operator line, or none of it does and every comment stands on its own
row.

All-or-nothing, not a trailing peel — that is elm-format's rule, verified
directly: `-- first` / `{- c -}` / `+ b` keeps *both* comments on their own rows
there, and so does a multi-line `{- -}` followed by a single-line one. Splitting
the run instead (pair the pairable suffix, stack the rest) would leave the two
halves of one authored run laid out differently. -}
splitPairingCommentItems : Array FlowItem -> { stacked : Array FlowItem, pairing : Array B.Line }
splitPairingCommentItems items =
    let
        pairable =
            Array.mapAndKeepJust pairableCommentItemLine items
    in
    if not (Array.isEmpty items) && Array.length pairable == Array.length items then
        { stacked = [], pairing = pairable }

    else
        { stacked = items, pairing = [] }


{-| Group a flattened binop chain by precedence for the vertical layout: break
at the chain's lowest-precedence operators, keeping tighter-binding operators
(and their operands) glued inline within a group. Returns the first group's
items (rendered at the flow base) and, for each following group, the
min-precedence operator that leads it plus the group's items.

Breaks at exactly the same `binopMinPrecedence` tier as
`InsertExpressions.binopForceVertical`, so the render grouping and the
force-vertical decision stay in lockstep. -}
groupBinopByPrecedence :
    Array (Array FlowItem)
    -> Array { text : String, item : FlowItem }
    -> { firstGroup : Array FlowItem, rest : Array { op : String, items : Array FlowItem } }
groupBinopByPrecedence operands ops =
    when Array.popFirst operands is
        Nothing ->
            { firstGroup = [], rest = [] }

        Just { first = operand0, rest = restOperands } ->
            let
                minPrec =
                    binopMinPrecedence (Array.map .text ops)

                paired =
                    Array.map2 (\op operandItems -> { op = op, operand = operandItems }) ops restOperands

                final =
                    Array.foldl
                        (\pair acc ->
                            if binopPrecedence pair.op.text == minPrec then
                                -- A lowest-precedence operator: close the current group
                                -- and start a new one led by this operator.
                                { groups = Array.pushLast { op = acc.curOp, items = acc.curItems } acc.groups
                                , curOp = pair.op.text
                                , curItems = pair.operand
                                }

                            else
                                -- A tighter operator: glue its leaf + operand inline
                                -- into the current group.
                                { acc | curItems = acc.curItems ++ [ pair.op.item ] ++ pair.operand }
                        )
                        { groups = [], curOp = "", curItems = operand0 }
                        paired

                allGroups =
                    Array.pushLast { op = final.curOp, items = final.curItems } final.groups
            in
            when Array.popFirst allGroups is
                Just { first = fg, rest = rg } ->
                    { firstGroup = fg.items, rest = rg }

                Nothing ->
                    { firstGroup = operand0, rest = [] }


{-| Split a pipeline step's ALREADY-RENDERED items at the step's *trigger* — the
first node that breaks onto its own line: a multi-line lambda-argument paren, a
multi-line content paren, or any other multi-line-forcing node such as a record
argument. A left-to-right split matching elm-format, including the
direct-operand-lambda exclusion (`|> (\x -> …)` stays glued to the operator).
`Nothing` = no trigger.

Every verticality question here is answered from `item.box`, the box the caller
already rendered. Asking the node instead (`makePBox` just to test
`isSingleLine`) meant the guard rendered a subtree that the preamble/trigger
render then rendered again — two to four full renders of the same subtree per
nesting level, which is why a nested `0 |> g ( 0 |> g ( … ))` cost 2^depth and a
nested direct-operand pipeline lambda ~4^depth. -}
splitStepTriggerItems : Array FlowItem -> Maybe { preamble : Array FlowItem, trigger : FlowItem, suffix : Array FlowItem }
splitStepTriggerItems stepItems =
    (Array.foldl
        (\item acc ->
            when acc.split is
                Just s ->
                    { acc | split = Just { s | suffix = Array.pushLast item s.suffix } }

                Nothing ->
                    let
                        -- A multi-line paren block, a multi-line bracket
                        -- container (array / record / update), or a bare lambda,
                        -- written directly after `|>` (nothing but the operator
                        -- in the preamble) glues to the operator like
                        -- elm-format's `|> (if …` / `|> [ 1`. Keeping it out of
                        -- the trigger split leaves it in the preamble, where
                        -- `buildFlowBoxInline` glues it; otherwise the relocation
                        -- branch strands `|>` on its own line with the operand
                        -- dropped +4 below.
                        -- (`acc.preamble` holds the step's OPERANDS only — the
                        -- operator is a prefix applied by `stepBodyBox`, not an
                        -- item — so "nothing before it" is an empty preamble.)
                        --
                        -- The two BARE operands were what this list was missing,
                        -- and the stranded `|>` they produced was a shape
                        -- gren-format emitted NOWHERE else. Their parenthesized
                        -- twins `|> (\x -> …)` and `|> (if …)` were excluded from
                        -- the day this split was written, so the two spellings of
                        -- one operand disagreed; all four now glue, which is also
                        -- what `>>`, `++` and a user-defined operator do with a
                        -- bare lambda or a bare block (measured), and what `<|`
                        -- does with a bare lambda as of R1.
                        isDirectGluedOperand =
                            Array.isEmpty acc.preamble
                                && (itemIsMultilineParenBlock item
                                        || itemIsMultilineBracketContainer item
                                        || isBareLambdaOperand item.node
                                        || isBareBlockOperand item.node
                                   )
                    in
                    if
                        not isDirectGluedOperand
                            && (isMultilineLambdaParenBlockBox item.node
                                    || itemForcesFlowVertical item
                               )
                    then
                        { acc | split = Just { preamble = acc.preamble, trigger = item, suffix = [] } }

                    else
                        { acc | preamble = Array.pushLast item acc.preamble }
        )
        { preamble = [], split = Nothing }
        stepItems
    ).split


itemIsMultilineParenBlock : FlowItem -> Bool
itemIsMultilineParenBlock item =
    when lpnShape item.node is
        ParenBlock _ ->
            not (isSingleLine item.box)

        _ ->
            False


itemIsMultilineBracketContainer : FlowItem -> Bool
itemIsMultilineBracketContainer item =
    (when lpnShape item.node is
        AllAcrossOrAllVertical _ ->
            True

        AlwaysVertical _ ->
            True

        RecordUpdate _ ->
            True

        _ ->
            False
    )
        && not (isSingleLine item.box)


itemForcesFlowVertical : FlowItem -> Bool
itemForcesFlowVertical item =
    not (nodeIsComment item.node) && not (isSingleLine item.box)


{-| Split a trigger-less step at its first multi-line item, when that item is not
the last one: `|> (\y -> …) 5` — the paren is a direct-glued operand, so it never
becomes a trigger, but `5` still follows something that broke.

`Nothing` when nothing breaks, or when the breaking item is last (the common
case, and the layout that was always right). A trailing comment run does not
count as "after it" — the split's purpose is the one-argument-per-line rule, and
a comment is not an argument (`stepSuffixBox`); left in the flow, it glues onto
the operand's last row the way a plain call's does. -}
splitAfterGluedOperand : Array FlowItem -> Maybe { glued : Array FlowItem, suffix : Array FlowItem }
splitAfterGluedOperand items =
    let
        lastArgIndex =
            (Array.foldl
                (\item acc ->
                    { i = acc.i + 1
                    , found =
                        if isCommentItem item then
                            acc.found

                        else
                            acc.i
                    }
                )
                { i = 0, found = -1 }
                items
            ).found

        breakIndex =
            (Array.foldl
                (\item acc ->
                    if acc.found /= -1 || isSingleLine item.box then
                        { acc | i = acc.i + 1 }

                    else
                        { i = acc.i + 1, found = acc.i }
                )
                { i = 0, found = -1 }
                items
            ).found
    in
    if breakIndex < 0 || breakIndex >= lastArgIndex then
        Nothing

    else
        Just
            { glued = Array.slice 0 (breakIndex + 1) items
            , suffix = Array.dropFirst (breakIndex + 1) items
            }


{-| The second direct child is an `IndentedBlock` (a lambda body on a separate
row — always multi-line), or a `SoftIndentedBlock` whose sole child is a bracket
literal that renders vertical.

Both facts come from the item that was already rendered:
`softBlockChildForcesVerticalBox` keeps the same structural test as before and
reads verticality off `item.box` (a soft block is single-line exactly when its
sole child is), rather than rendering that child a second time. -}
parenLambdaMultilineItems : Array FlowItem -> Bool
parenLambdaMultilineItems items =
    when Array.get 1 items is
        Just second ->
            when lpnShape second.node is
                IndentedBlock ->
                    True

                SoftIndentedBlock ->
                    softBlockChildForcesVerticalBox second

                _ ->
                    False

        Nothing ->
            False
