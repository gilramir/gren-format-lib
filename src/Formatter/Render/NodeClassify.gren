module Formatter.Render.NodeClassify exposing
    ( commentBreaksFlowRow
    , commentEndsItsLine
    , commentTextCanRide
    , fieldValueDropsToOwnLine
    , isBackwardContinuation
    , isBareBlockOperand
    , isBareLambdaOperand
    , isColonLeaf
    , isDroppingSignatureRecordNode
    , isEmptyLine
    , isGluedLambdaField
    , isMultilineLambdaParenBlockBox
    , isOpAndRhsNode
    , isPipelineStepNode
    , isTypeRecordLiteral
    , lambdaOperandSplit
    , lambdaParenIsHeadAndBodyOnly
    , leafLineRow
    , leafValue
    , literalCommentsRideFlatLine
    , nodeIsComment
    , nodesLeadWithComment
    , parenContentIsLambdaHead
    , splitOffLambdaHead
    , splitSignatureSegments
    , stepBrokeItsRows
    , stepOperatorText
    , subtreeEndsWithMultilineBlockComment
    , subtreeHasComment
    , valueNodeIsHardBlock
    )

{-| Boolean predicates and small structural queries over render-tree nodes.

Everything here reads a node's `LPShape`, its children, or its comment text.
Nothing here can read a source row: the render layer's `RenderNode`
(`Formatter.RenderTree`) has no position fields on it, which is what makes the
"placement is decided in `Comments.gren`, never re-derived at render time"
barrier a compile error rather than a convention.
-}

import Formatter.Logical.LogicalPrintingTree exposing
    ( CommentRole(..)
    , LPShape(..)
    , ListBrackets(..)
    , PrefixKind(..)
    , RecordKind(..)
    , commentRole
    , shapeIsComment
    )
import Formatter.Render.Box as B
import Formatter.RenderTree exposing
    ( RenderNode
    , rnChildren
    , rnHasComment
    , rnShape
    )


nodeIsComment : RenderNode -> Bool
nodeIsComment node =
    shapeIsComment (rnShape node)


{-| True when a flow's first node is a comment — the one arrangement under which
a flow's `FlowStart` changes its box at all. `InlineStart` keeps such a comment
on the line the caller has already begun, `OwnStart` drops it to its own; with
any other first node the two assemblies produce the same box, so the caller has
nothing to choose between.

Structural: reads the first child's shape, no rows and no rendered text.
-}
nodesLeadWithComment : Array RenderNode -> Bool
nodesLeadWithComment nodes =
    when Array.first nodes is
        Just first ->
            nodeIsComment first

        Nothing ->
            False


-- True when `node` or any descendant is a comment. Used to route a
-- comment-bearing construct to its comment-aware fallback rather than a
-- comment-oblivious layout.
--
-- O(1): the answer is cached on the node by `lpnNode`, alongside the position
-- bounds and for the same reason -- the renderer asks it at several levels of
-- one descent, and walking the subtree per level made it O(size x depth).
subtreeHasComment : RenderNode -> Bool
subtreeHasComment =
    rnHasComment


{-| True when the subtree's last descendant is a **multi-line** `{- … -}`.

Such a comment is glued onto the running row with `B.prefix`, which pads its
continuation lines with literal spaces so the body hangs under the comment's own
opening delimiter. That makes the whole box **align-carrying** — anchored at an absolute
column — whatever its node type would otherwise say, which is what
`FlowAssembly.softGlueAlignment` needs to know: gluing such a box first-line-only
leaves its continuation short by the glued prefix's width.

Descends the right spine reading LPT shape and the comment's own TEXT only — no
rendered output, no source rows — so it is render-invariant safe. It stops at the
bracket / paren container boxes, whose rendered last line is a synthesized
closing delimiter emitted after the last child: the comment inside is not what
the next glue lands on. (The `--` twin of this predicate is gone — a `--` leaves
a mark on the rendered box itself, so `B.endsOpen` answers that one without a
walk. This one cannot follow: a multi-line `{- … -}` leaves a box whose extra
rows are indistinguishable from any other multi-row box's.) -}
subtreeEndsWithMultilineBlockComment : RenderNode -> Bool
subtreeEndsWithMultilineBlockComment node =
    when rnShape node is
        BlockComment { loc } ->
            String.contains "\n" loc.value

        AllAcrossOrAllVertical _ ->
            False

        AlwaysVertical _ ->
            False

        RecordUpdate _ ->
            False

        ParenBlock _ ->
            False

        EmptyBracketed _ ->
            False

        _ ->
            when Array.last (rnChildren node) is
                Just child ->
                    subtreeEndsWithMultilineBlockComment child

                Nothing ->
                    False


{-| True when a comment ends the row it sits on — a `--`, which runs to end of
line, or a block comment that carries its own newlines. A single-line `{- … -}`
does not, which is exactly why it can ride a flat line. Shared by every "does
this comment force a break" question so they cannot drift apart. -}
commentEndsItsLine : RenderNode -> Bool
commentEndsItsLine node =
    when rnShape node is
        SingleLineComment _ ->
            True

        BlockComment { loc } ->
            String.contains "\n" loc.value

        DocComment loc ->
            String.contains "\n" loc.value

        _ ->
            False


{-| True when a comment among these flow siblings pushes a LATER sibling onto a
new row — so the flow cannot render on one line no matter what its
`forceVertical` flag says.

This exists to keep a row-derived `forceVertical` honest. `insertCall` /
`insertBinops` set that flag from the AST's source rows, and the AST has no
comments in it, so a construct the author wrote on one row is flagged
`forceVertical = False` even when a comment inside it will force a break. The
first format then renders the flat layout, the break happens anyway, and the
REPARSE sees the later sibling on a later row — `forceVertical = True` — and
renders the broken layout instead. The file oscillates. Folding this predicate
into the same decision makes the first format commit to the shape the reparse
will agree with.

Which comments break, from `FlowPolicy.decide` (this must track it):

  - a `--` always does: it runs to end of line, so `LineCommentItem` leaves
    `AlreadyTerminated` and the next item starts a fresh line.
  - a MULTI-LINE `{- … -}` always does: it leaves `TerminatedByBlockComment`.
  - a single-line `{- … -}` mid-flow does NOT: it stays inline and leaves
    `FlowSep`, which is exactly why `fn a {- c -} b` is one line.

…and only when a real item actually follows: a comment at the END of a flow
(`foo bar -- c`) breaks nothing, which is the long-standing fixed point for that
shape and must stay one.

Reads LPT shape kinds only — no source rows, no rendered text — so it is
render-invariant safe.
-}
commentBreaksFlowRow : Array RenderNode -> Bool
commentBreaksFlowRow children =
    let
        step node acc =
            if nodeIsComment node then
                { acc | pending = acc.pending || commentEndsItsLine node }

            else
                -- A real item after a line-ending comment starts a new row.
                { broke = acc.broke || acc.pending, pending = False }
    in
    (Array.foldl step { broke = False, pending = False } children).broke


{-| True when every comment among a bracketed literal's direct children can ride
the flat form's single line: a `{- … -}` written on one source row, trailing an
item on that same row.

Three kinds of comment cannot, and keep the literal on the comment-aware
vertical path (`commentBracketListBox`): a `--` comment, which ends its line; a
multi-line `{- … -}`, which brings its own newlines; and any comment the author
put on its own row, whose placement the flat form cannot carry.

A `{-| … -}` is top-level only — the parser rejects one inside a literal, an
exposing list, or a union body — so it never reaches here. Excluding it anyway
costs nothing and keeps the rule right if that ever changes.

A comment that can ride the flat line is either a `RidesInline` one — the
classifier's bracket branch tags a single-line `{- -}` trailing an item on its
row that way — or a `LeadsNext` one whose text fits on a row. `LeadsNext` is the
comment the author wrote across an unrecorded `,`/`|`, which rule C2 hands to
the item *after* the separator (`[ 1, {- c -} 2 ]`); by rule C3 that must not be
a reason to break the literal open, so it rides too when its own text can.
-}
literalCommentsRideFlatLine : Array RenderNode -> Bool
literalCommentsRideFlatLine children =
    not
        (Array.any
            (\node ->
                when commentRole (rnShape node) is
                    Just RidesInline ->
                        False

                    Just LeadsNext ->
                        not (commentTextCanRide node)

                    Just _ ->
                        True

                    Nothing ->
                        False
            )
            children
        )


{-| True when a comment's own TEXT can share a line with code beside it: a
`{- … -}` the author wrote on one row. A `--` runs to end of line and a
multi-line `{- … -}` brings its own newlines, so neither can.

This asks about the comment's shape, never its position — the position question
is settled by the stored `CommentRole` before the renderer sees the node.
`RidesInline` bundles both answers (single-line block AND written on the previous
item's row); a `LeadsNext` comment has its side already decided by the role and
only this half left to ask. -}
commentTextCanRide : RenderNode -> Bool
commentTextCanRide node =
    when rnShape node is
        BlockComment { loc } ->
            not (String.contains "\n" loc.value)

        _ ->
            False


-- ═══ BINOPS ═══


isOpAndRhsNode : RenderNode -> Bool
isOpAndRhsNode node =
    when rnShape node is
        OpAndRhs ->
            True

        _ ->
            False


-- ═══ PIPELINES ═══


isPipelineStepNode : RenderNode -> Bool
isPipelineStepNode node =
    when rnShape node is
        PipelineStep _ ->
            True

        _ ->
            False


{-| A ParenBlock holding a multi-line LAMBDA: the author wrote the body on a
later row (second child is an `IndentedBlock`) and the content really is a lambda
head.

`parenContentIsLambdaHead` is not optional. A paren-`if`/`when` has a block as
its SECOND child too — its first branch — so without it this reports
`(if c then a else b)` as a lambda, and the callers that split a lambda into
`[head, body]` drop every later branch, `else` included.
-}
isMultilineLambdaParenBlockBox : RenderNode -> Bool
isMultilineLambdaParenBlockBox node =
    when rnShape node is
        ParenBlock _ ->
            parenContentIsLambdaHead node
                && (when Array.get 1 (rnChildren node) is
                        Just secondChild ->
                            when rnShape secondChild is
                                IndentedBlock ->
                                    True

                                _ ->
                                    False

                        Nothing ->
                            False
                   )

        _ ->
            False


-- True when a ParenBlock's content is a lambda (`(\x -> …)`) rather than an
-- `if`/`when`/`let` — identified by the first child's box (matching
-- `makeParenBlockBox`'s content dispatch). Guards the direct-operand lambda split
-- against mangling a paren-`if`/`when` (whose branches are also blocks).
parenContentIsLambdaHead : RenderNode -> Bool
parenContentIsLambdaHead node =
    when Array.first (rnChildren node) is
        Just headNode ->
            not (isBlockKeywordHead headNode)

        Nothing ->
            False


-- The head of a block construct: `if`, `when`, or `let`. Three shapes because
-- that is how the three arrive — an `if`'s condition flow and a `when`'s
-- scrutinee flow are nodes of their own, while `let` opens with the keyword as a
-- plain leaf. Anything else heads a lambda or an ordinary expression.
--
-- Asking for the keyword text is a comparison against LANGUAGE SYNTAX, which is
-- the one thing a layout change cannot move (see `leafValue`).
isBlockKeywordHead : RenderNode -> Bool
isBlockKeywordHead headNode =
    when rnShape headNode is
        IfCondition _ ->
            True

        WhenFlow _ ->
            True

        UnbreakableText loc ->
            loc.value == "let"

        _ ->
            False


{-| Did the AUTHOR break this step's own flow — `|> fn one` / `two`?

The step carries it (`PipelineStep`'s `forceVertical`) because the call node that
recorded it is unwrapped into the step's children at build time. Everything else
about a step's layout is read off the rendered boxes; this one fact cannot be,
the rows being exactly what the unwrap spent.
-}
stepBrokeItsRows : RenderNode -> Bool
stepBrokeItsRows stepNode =
    when rnShape stepNode is
        PipelineStep step ->
            step.forceVertical

        _ ->
            False


{-| Is this operand a **bare** (unparenthesized) `if`, `when` or `let`?

The block twin of `isBareLambdaOperand`, and its caller is the same: a bare block
written straight after `|>` glues its head to the operator's row rather than
stranding the operator on a row of its own. `>>`, `++` and user-defined
operators already glue one, and so does `|> (if …)`, the parenthesized spelling
of this very operand.

A `when` arrives as a `WhenFlow` in its own right; an `if` and a `let` arrive
wrapped in a `BodyBlock`, so they are recognised by what heads that block — the
same question `parenContentIsLambdaHead` asks one level down.
-}
isBareBlockOperand : RenderNode -> Bool
isBareBlockOperand operandNode =
    when rnShape operandNode is
        WhenFlow _ ->
            True

        BodyBlock ->
            when Array.first (Array.keepIf (\n -> not (nodeIsComment n)) (rnChildren operandNode)) is
                Just headNode ->
                    isBlockKeywordHead headNode

                Nothing ->
                    False

        _ ->
            False


{-| True when a record-update field's value is forced onto its own line(s) by a
comment among the field's children (e.g. `gamma = {- c -} 3`). `buildFlowBox`
drops such a value below `= `, so it composes with the field's `| `/`, `
prefix — unlike a soft broken-call/binop value, which stays glued (elm-format). -}
fieldValueDropsToOwnLine : RenderNode -> Bool
fieldValueDropsToOwnLine node =
    Array.any nodeIsComment (rnChildren node)


{-| The literal text of a leaf node (`UnbreakableText` / `SynthesizedText`), or
Nothing for any structured node. Tranche-2 signatures handle only flat leaf
signatures; a nested type (record/paren/…) yields Nothing and falls back.

Also what the predicates below use to ask what a token IS. Those predicates (`isColonLeaf`, `isArrowLeaf`, `stepOperatorText`, and
`parenContentIsLambdaHead`'s `"let"` test) compare against **language syntax** —
glyphs and keywords Gren's grammar fixes, which the formatter cannot choose and
a future layout change cannot move. That is a different thing from asking a
rendered string what a construct MEANS: `isTypeRecordLiteral` used to decide
type-vs-value by scanning a record's fields for a `SynthesizedText ":"`, and
that fact is now carried on the box (`ListCurly RecordKind`) because it is known
at construction and nothing about the separator's spelling should be load-bearing
for it. Comment PLACEMENT is the third case, and the strictest: it is decided
once in `Comments.gren` and stored as a `CommentRole`, and
`check-render-invariant.py` fails the build if anything here re-derives it. -}
leafValue : RenderNode -> Maybe String
leafValue node =
    when rnShape node is
        UnbreakableText locs ->
            Just locs.value

        SynthesizedText s ->
            Just s

        _ ->
            Nothing


isArrowLeaf : RenderNode -> Bool
isArrowLeaf node =
    leafValue node == Just "->"


isColonLeaf : RenderNode -> Bool
isColonLeaf node =
    leafValue node == Just ":"


{-| Split a signature's type nodes at each top-level `->`: the first segment is
the leading type; each later one begins with its `->`.

This is the position-free half of what used to be four functions here. The other
half -- `segFirstRow` / `segLastRow` / `signatureForceVertical`, which asked
whether the AUTHOR broke the type at one of these boundaries -- read source rows,
so it moved to `Formatter.RenderTree` and arrives as the precomputed
`rnTypeSegmentsBroken` flag. The split itself stays: the renderer still lays out
one segment per line, and that needs no rows. -}
splitSignatureSegments : Array RenderNode -> Array (Array RenderNode)
splitSignatureSegments nodes =
    Array.foldl
        (\node acc ->
            if isArrowLeaf node then
                Array.pushLast [ node ] acc

            else
                when Array.popLast acc is
                    Just { last = seg, initial = front } ->
                        Array.pushLast (Array.pushLast node seg) front

                    Nothing ->
                        [ [ node ] ]
        )
        []
        nodes


{-| True when `node` is a curly-bracket *type* record literal (`{ a : T, … }`),
as opposed to an *expression* record (`{ a = v }`), a record update, an array,
or a pattern. The discriminator is the field separator: a type field is built
with `SynthesizedText ":"`, an expression field with `SynthesizedText "="`.

Used to decide whether a multi-line record child in a flow drops to its own
line (elm-format's application rule for type applications / type field values)
without disturbing the many *expression* flows that share the fold and must
keep their records/arrays/patterns inline.
-}
isTypeRecordLiteral : RenderNode -> Bool
isTypeRecordLiteral node =
    when rnShape node is
        AlwaysVertical (ListCurly RecordType) ->
            True

        AllAcrossOrAllVertical (ListCurly RecordType) ->
            True

        _ ->
            False


{-| True for a node that renders as a multi-line record TYPE — either a plain
record literal (`isTypeRecordLiteral`, `{ a : Int }`) or an extensible
record type, which reuses the `RecordUpdate` box the same way a record-update
EXPRESSION does (`{ r | a : Int }`; see `LogicalPrintingTree.gren`'s
`RecordUpdate` doc). Treating any `RecordUpdate` found here as a type is safe
only because every call site restricts `node` to a signature's TYPE position,
where `RecordUpdate` can never mean an update expression. -}
isDroppingSignatureRecordNode : RenderNode -> Bool
isDroppingSignatureRecordNode node =
    isTypeRecordLiteral node
        || (when rnShape node is
                RecordUpdate _ ->
                    True

                _ ->
                    False
           )


-- The `Line` (not boxed) of the given leaf nodes joined by single spaces. Only
-- valid for all-leaf node arrays (caller must have checked `headerAllLeaves`);
-- a non-leaf renders as "".
leafLineRow : Array RenderNode -> B.Line
leafLineRow nodes =
    B.row
        (Array.intersperse B.space
            (Array.map (\n -> B.literal (Maybe.withDefault "" (leafValue n))) nodes)
        )


-- ═══ MODULE & IMPORT LINES ═══


isEmptyLine : RenderNode -> Bool
isEmptyLine node =
    when rnShape node is
        EmptyLine ->
            True

        _ ->
            False


{-| Whether a lambda `ParenBlock` holds nothing but its head and its body — the
precondition `makeMultilineLambdaArgBox` is written to.

That renderer reads the first child and the second and **silently discards the
rest**, and a comment written past the lambda body's last token is exactly such a
child: a `{- x -}` on its own row before the `)` of a pipeline step's lambda
argument was lost outright. Nothing downstream could see it — a dropped comment
leaves an AST-equivalent output that is its own fixed point, so `--show` passes;
only a non-canonical *input* made a fuzzer notice, because the comment then
survived the first format and vanished on the second.

A paren with more children relocates through the generic paren box instead, which
renders all of them — and puts the trailing comment one column past the `(`,
which is both what gren already does for the identical paren in a plain call and
what elm-format prints for both. -}
lambdaParenIsHeadAndBodyOnly : RenderNode -> Bool
lambdaParenIsHeadAndBodyOnly node =
    Array.length (rnChildren node) <= 2


-- The `|>` / `<|` leaf a pipeline step starts with. Anything else (a step whose
-- children were rewritten, a leading comment left in place) is not an operator
-- and keeps the whole child array on the flow path.
stepOperatorText : RenderNode -> Maybe String
stepOperatorText node =
    when leafValue node is
        Just v ->
            if v == "|>" || v == "<|" then
                Just v

            else
                Nothing

        Nothing ->
            Nothing


{-| True when a record field's value node is a hard block (`if`/`when`/`let`/
lambda body, …). A hard-block value already drops after `=` through its own
block box, so the soft-value drop rule (`dropFieldValueBoxWithBox`) never
applies to it — callers short-circuit on this before rendering the value. -}
valueNodeIsHardBlock : RenderNode -> Bool
valueNodeIsHardBlock valueNode =
    when rnShape valueNode is
        BodyBlock ->
            True

        IndentedBlock ->
            True

        SoftIndentedBlock ->
            True

        WhenBranch ->
            True

        PipelineStep _ ->
            True

        EmptyLine ->
            True

        _ ->
            False


{-| A record field holding a lambda that `folderInsertRecordField` decided to
keep GLUED on the `= ` line — the `IndentedBlock` container it builds in that one
branch (`{ fld = \q -> body }`). Every other field shape is a `plainAcross`
flow, so this identifies the glued-lambda case exactly.

The glue is chosen when the lambda is expected to render on one line. That
expectation is an AST-level guess (`lambdaValueNodesAreBroken || exprAlwaysBreaks`)
and it is under-approximate in both directions that matter: it cannot see a
comment (the AST has none), and it does not model an author-broken record body.
Either makes the lambda render multi-line while still glued — and the reparse
then sees the body on a later row, flips to the drop form, and the file
oscillates. `renderGluedLambdaField` settles it by observing the rendered box
instead of predicting it. -}
isGluedLambdaField : RenderNode -> RenderNode -> Bool
isGluedLambdaField field valueNode =
    when { f = rnShape field, v = rnShape valueNode } is
        { f = IndentedBlock, v = SoftIndentedBlock } ->
            True

        _ ->
            False


{-| Split a glued-lambda field's head nodes at the lambda's own `\q ->` head —
the LAST node that is not a comment. What precedes it is the field head
(`fld =`), what follows is the lambda head and any comment written between it and
the body, which drops with it. `Nothing` when there is no non-comment node at
all, which the container's shape rules out. -}
splitOffLambdaHead : Array RenderNode -> Maybe { fieldHead : Array RenderNode, lambdaNodes : Array RenderNode }
splitOffLambdaHead nodes =
    Array.foldl
        (\node acc ->
            { i = acc.i + 1
            , found =
                if nodeIsComment node then
                    acc.found

                else
                    Just acc.i
            }
        )
        { i = 0, found = Nothing }
        nodes
        |> .found
        |> Maybe.map
            (\i ->
                { fieldHead = Array.takeFirst i nodes
                , lambdaNodes = Array.dropFirst i nodes
                }
            )


{-| Split a backward-pipeline step's operand into a lambda head and a lambda
body, when the operand IS a lambda. This is the shape **R1** glues onto the
`<|`'s row (`docs/settledDecisions.md`): everything up to and including the `->`
stays with the operator, and only the body moves.

`bodyOnHeadRow` is the author's choice of where the lambda body sits, carried on
the LPT by which block wraps it: `SoftIndentedBlock` is the body the author put
on the `->` row, `IndentedBlock` the body they put on a row of its own. That is
the one thing R1 does not overrule — a one-row lambda comes back on one row.

The operand must be a lone `BodyBlock` of a lambda head and its body, which rules
out the other block operands -- they reach this module wearing similar shapes: an
`if` is a `BodyBlock` of four children, a `let` a `BodyBlock` whose last child is
a `BodyBlock`, and a `when` a `WhenFlow`.

**Comments between the head and the body come back as part of the body**, since
that is exactly where the renderer puts them: the `->` carries no position, so a
comment written beside it snaps to the body's side (divergences #16 / #22), and
the body is the slot a reparse reads it back into. Refusing the split over them
instead -- which this did until 2026-08-20 -- made the step DECLINE R1 on the
first format and accept it on the second, because format 1 moved the comment
below the `->` and so handed format 2 the two-child shape it had just refused.
`\[ 1 ] {- c -} -> [ 0` / `, 1 ]` oscillated for ever between the staircase and
the glued form.

A comment there also means the body cannot ride the `->`'s row, whatever block
wraps it, so `bodyOnHeadRow` is False as soon as one is present.
-}
lambdaOperandSplit : Array RenderNode -> Maybe { head : RenderNode, body : Array RenderNode, bodyOnHeadRow : Bool }
lambdaOperandSplit operandNodes =
    when operandNodes is
        [ only ] ->
            when rnShape only is
                BodyBlock ->
                    when Array.popFirst (rnChildren only) is
                        Just { first = headNode, rest = afterHead } ->
                            if isLambdaHeadNode headNode then
                                lambdaBodySplit headNode afterHead

                            else
                                Nothing

                        Nothing ->
                            Nothing

                _ ->
                    Nothing

        _ ->
            Nothing


-- What follows a lambda's head inside the operand: the body block, with any
-- comments the author wrote between the two in front of it. Anything else there
-- (a second non-comment node) is not a shape R1 can place, so it declines.
lambdaBodySplit : RenderNode -> Array RenderNode -> Maybe { head : RenderNode, body : Array RenderNode, bodyOnHeadRow : Bool }
lambdaBodySplit headNode afterHead =
    when Array.popLast afterHead is
        Just { last = bodyNode, initial = between } ->
            if not (Array.all nodeIsComment between) then
                Nothing

            else
                let
                    body =
                        between ++ rnChildren bodyNode

                    onHeadRow =
                        Array.isEmpty between
                in
                when rnShape bodyNode is
                    SoftIndentedBlock ->
                        Just { head = headNode, body = body, bodyOnHeadRow = onHeadRow }

                    IndentedBlock ->
                        Just { head = headNode, body = body, bodyOnHeadRow = False }

                    _ ->
                        Nothing

        Nothing ->
            Nothing


-- A lambda's head flow, identified by the `\` it opens with. `PrefixLambdaHead`
-- is the LPT's own record of what that glyph is for, so this asks the tree
-- rather than the rendered text (`parenContentIsLambdaHead`, one node up, has to
-- ask the shape instead because it is handed the whole content). A comment
-- written in front of the `\` does not stop it being a lambda head; it renders
-- inside the head flow either way.
isLambdaHeadNode : RenderNode -> Bool
isLambdaHeadNode node =
    when Array.first (Array.keepIf (\n -> not (nodeIsComment n)) (rnChildren node)) is
        Just firstChild ->
            when rnShape firstChild is
                PrefixGlue loc ->
                    loc.value == PrefixLambdaHead

                _ ->
                    False

        Nothing ->
            False


{-| **R2**'s membership test: is this lambda body the next step of the chain,
rather than the value the chain produces? A continuation is a lambda handed
*straight* to a single-step `<|` run — `seed <| \p -> …` — and it starts at the
chain's base column; every other body starts at base + 4.

The three cases the Gren lead settled all fall out of asking exactly that, of
the body's **top node** (`docs/settledDecisions.md`, "Which bodies are continuations"):

  - a multi-step run (`withRetries 3 <| Task.mapError toReport <| \a -> …`) is
    not one, because the lambda is not handed to the seed — **Case 1**, +4;
  - a continuation whose own body fits on the `->` row still is one, because
    the shape is the same `seed <| lambda` — **Case 2**, +0;
  - a *parenthesized* continuation is not one, because the top node is then a
    `ParenBlock` — **Case 3**, +4. Do not "fix" this to look through the
    parens; the author wrote them to mark a value.

Comments are ignored throughout, which is the difference between this and
`lambdaOperandSplit` — that one has to glue a head onto a row and so declines
anything it cannot place, while this one only asks what the step *is*. A comment
in the step must not move the column every row below it sits at (rule C4); all
it can cost is the head glue for the step it is written in.
-}
isBackwardContinuation : Array RenderNode -> Bool
isBackwardContinuation bodyNodes =
    when Array.keepIf (\n -> not (nodeIsComment n)) bodyNodes is
        [ only ] ->
            when rnShape only is
                Pipeline p ->
                    if p.op /= "<|" then
                        False

                    else
                        when Array.keepIf isPipelineStepNode (rnChildren only) is
                            [ step ] ->
                                when Array.keepIf (\n -> not (nodeIsComment n)) (rnChildren step) is
                                    [ opNode, operandNode ] ->
                                        (leafValue opNode == Just "<|")
                                            && isBareLambdaOperand operandNode

                                    _ ->
                                        False

                            _ ->
                                False

                _ ->
                    False

        _ ->
            False


{-| `lambdaOperandSplit`'s question with the comments taken out and the split
thrown away: is this operand a **bare** (unparenthesized) lambda?

Two callers, and the answer decides something different for each.
`isBackwardContinuation` uses it to pick a column. `splitStepTriggerItems` uses
it to keep such an operand OUT of a `|>` step's trigger split, so the lambda
stays glued to the operator's row instead of stranding it — the same exclusion a
parenthesized lambda has always had, which is why `|> (\x -> …)` looked right
and `|> \x -> …` did not.
-}
isBareLambdaOperand : RenderNode -> Bool
isBareLambdaOperand operandNode =
    when rnShape operandNode is
        BodyBlock ->
            when Array.keepIf (\n -> not (nodeIsComment n)) (rnChildren operandNode) is
                [ headNode, bodyNode ] ->
                    isLambdaHeadNode headNode
                        && (when rnShape bodyNode is
                                SoftIndentedBlock ->
                                    True

                                IndentedBlock ->
                                    True

                                _ ->
                                    False
                           )

                _ ->
                    False

        _ ->
            False
