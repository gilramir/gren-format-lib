module Formatter.Render.CommentBox exposing
    ( commentForcesBracketOpen
    , commentNodeBox
    , emptyBracketedCommentLine
    , glueLeadBoxes
    , glueLeadingCommentRun
    , glueTrailingComments
    , leadCommentRunBoxes
    , makeCommentLineBox
    , multiLineBlockCommentBox
    , operatorPrefixedOperandBox
    , pairInlineComments
    , peelLeadingInlineComments
    , peelTrailingCommentNodes
    , runStartsOnOperatorRow
    , spanLeadingComments
    , spanOperandLeadingComments
    , spanOperatorRowComments
