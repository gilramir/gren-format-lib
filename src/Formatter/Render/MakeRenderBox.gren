module Formatter.Render.MakeRenderBox exposing (makePBox, makePrettyLineBox)

{-| Box-model renderer — the sole backend. It renders an LPT node to
elm-format's `Box` (Tab + prefix arithmetic), returning `Err` for any construct
it cannot render (the caller, `Formatter.Render`'s private `makePrettyLine`,
surfaces that `Err` — there is no fallback renderer, so it fails the whole
file).

It handles every top-level definition kind: leaves, record / array literals,
flows and nested flows, blocks, pipelines, binops, `when`/`if`/`let`,
signatures, and comments — each laid out to match elm-format.
-}

import Formatter.Logical.BinopPrecedence exposing (binopMinPrecedence, binopPrecedence)
import Formatter.Logical.LogicalPrintingTree exposing (CommentRole(..), LPBox(..), LPNode, ListBrackets(..), SyntaxType(..), commentRole, firstRowInSubtree, lpnBox, lpnChildren, lpnLastBracketEnd, lpnLastPos, lpnMaxRow, prefixGlyph)
import Formatter.Render.BinopLayout exposing (assembleBinopBox, commentBreaksBinopChain, flattenBinopNodes, isChainBreakingOperandBox, opText, splitTrailingOwnLineComments)
import Formatter.Render.Box as B exposing (Box(..))
import Formatter.Render.BoxOps exposing (applyIndent, blockIndentSpaces, boxLine, glueCommentSuffix, glueLeadingCommentPrefix, grenIndent, isBlockNode, isSingleLine, joinInline, prefixOperator, spaceJoinLines, stackWithBlanks, traverseResult, wrapParenVerticalPadded)
import Formatter.Render.CommentBox exposing (commentNodeBox, commentNodeToBox, emptyBracketedCommentLine, glueTrailingComments, makeCommentLineBox, multiLineBlockCommentBox, peelTrailingCommentNodes, spanLeadingComments, spanTrailingComments, spanTrailingOwnLineComments)
import Formatter.Render.ElmStructure as E
import Formatter.Render.FlowAssembly exposing (FlowItem, SoftGlueAlignment(..), assembleBrokenCall, assembleBrokenWithComments, bracketPunc, gluedExposingBox, isCommentItem, pairLeadingComments, parenInnerIsAlignCarrying, softBlockChildForcesVerticalBox, softGlueAlignment, trySoftGlueFlow, verticalExposingBox)
import Formatter.Render.FlowPolicy as FP
import Formatter.Render.NodeClassify exposing (commentBreaksFlowRow, commentTextCanRide, fieldValueDropsToOwnLine, isColonLeaf, isDroppingSignatureRecordNode, isMultilineLambdaParenBlockBox, isOpAndRhsNode, isPipelineStepNode, leafLineRow, leafValue, literalCommentsRideFlatLine, nodeIsComment, parenContentIsLambdaHead, rowsSpanMultiple, signatureForceVertical, splitSignatureSegments, subtreeEndsWithLineComment, subtreeHasComment, typeHasCommentBracket)


{-| Entry point: render one top-level root child to a Box, or `Err` if it
can't be rendered — there is no fallback, so an `Err` here fails the format
for the whole file. -}
makePrettyLineBox : LPNode -> Result String Box
makePrettyLineBox node =
    when lpnBox node is
        OriginalRows { stype = stype } ->
            let
                { leading, rest } =
                    peelLeadingInlineComments (lpnChildren node)
            in
            if Array.isEmpty leading then
                makeDeclBodyBox stype (lpnChildren node)

            else
                -- A `LeadsInline` block comment the author glued to the front of
                -- this declaration's line (`{- c -} import Qux`): render the
                -- declaration from the remaining children, then glue each leading
                -- comment onto its first line (right-to-left so the comments keep
                -- source order). See `CommentRole.LeadsInline`.
                Result.andThen
                    (\declBox ->
                        traverseResult commentNodeToBox leading
                            |> Result.map
                                (\commentBoxes ->
                                    Array.foldr glueLeadingCommentPrefix declBox commentBoxes
                                )
                    )
                    (makeDeclBodyBox stype rest)

        EmptyLine ->
            -- A top-level blank separator. `B.blankLine` is `SingleLine (literal
            -- "")`, which renders to "" after the join's trimRight.
            Ok B.blankLine

        _ ->
            Err "box: root child not an OriginalRows funcDecl"


{-| Peel any leading `LeadsInline` block-comment children off the front of a
declaration's child list, returning them (in source order) and the remainder. -}
peelLeadingInlineComments : Array LPNode -> { leading : Array LPNode, rest : Array LPNode }
peelLeadingInlineComments children =
    Array.foldl
        (\child acc ->
            if acc.stopped then
                { acc | rest = Array.pushLast child acc.rest }

            else if commentRole (lpnBox child) == Just LeadsInline then
                { acc | leading = Array.pushLast child acc.leading }

            else
                { acc | rest = Array.pushLast child acc.rest, stopped = True }
        )
        { leading = [], rest = [], stopped = False }
        children
        |> (\acc -> { leading = acc.leading, rest = acc.rest })


{-| Render a declaration's body (its children, minus any leading glued comment)
via the renderer for its `SyntaxType`. -}
makeDeclBodyBox : SyntaxType -> Array LPNode -> Result String Box
makeDeclBodyBox stype children =
    when stype is
        StFunctionDeclaration ->
            -- `buildFlowBox`'s comment machinery places inline,
            -- standalone, and multi-line comments in a funcDecl body
            -- directly. Anything it can't handle returns Err from within
            -- the flow, which propagates to the caller.
            buildFlowBox grenIndent children

        StFunctionSignature ->
            makeSignatureBox children

        StPort ->
            makeSignatureBox children

        StTypeAlias ->
            renderHeaderIndentedBody makeTypeAliasBody children

        StTypeUnion ->
            renderHeaderIndentedBody makeUnionBodyBox children

        StSingleLineComment ->
            makeCommentLineBox children

        StBlockComment ->
            makeCommentLineBox children

        StDocComment ->
            makeCommentLineBox children

        StModule ->
            makeExposingLineBox StModule children

        StImport ->
            makeExposingLineBox StImport children

        StInfixDecl ->
            -- `infix left 6 (+) = add` — a flat single-line leaf flow,
            -- same shape as a funcDecl (both render via `buildFlowBox`).
            buildFlowBox grenIndent children


{-| Render a binary-operator chain. Groups break at minimum-precedence
operators (tighter operators join inline within a group); the author's row
layout picks inline vs one-group-per-line (+4, operator-led) — matching
elm-format.

A multi-line operand (e.g. a `(when …)` paren-block) is supported in the
forced-vertical, one-group-per-line layout: its group is composed via
`B.prefix (op ++ " ")`, which pads the operand's continuation lines by the
operator width so they align under where the operand's first char lands. Any
multi-line operand joined *inline* to a higher-precedence sibling, and any
multi-line operand in a non-vertical chain, still returns Err. -}
makeBinopBox : Bool -> Array LPNode -> Result String Box
makeBinopBox forceVerticalArg children =
    let
        flat =
            flattenBinopNodes children
    in
    -- Render every operand node exactly ONCE, up front: the multiline decision
    -- reads these boxes, and both layout paths consume the same items, so no
    -- operand subtree is rendered twice. Deciding via a throwaway render
    -- (`anyOperandRendersMultiline`) and then re-rendering in the chosen
    -- layout made nested paren/bracket operands (`1 + (1 + (…))`) cost
    -- O(2^depth) — the same failure class as the nested record-literal hang.
    when traverseResult renderFlowItems flat.operands is
        Err _ ->
            -- An operand refused to render: replay the legacy dispatch so each
            -- layout path reaches its own fallback for the failing node (the
            -- old decision treated an unrenderable operand as not-forcing).
            makeBinopBoxLegacy forceVerticalArg children

        Ok operandItems ->
            let
                forceVertical =
                    forceVerticalArg
                        || Array.any operandItemsRenderMultiline operandItems
                        -- Same reason as the call arm: `forceVerticalArg` is a
                        -- source-row fact and the AST has no comments in it, so a
                        -- comment that pushes an operand onto a new row would flip
                        -- the chain to broken only on reparse. Asked of the whole
                        -- chain, not of each operand alone, so the break lands
                        -- where precedence puts it — see `commentBreaksBinopChain`.
                        || commentBreaksBinopChain flat
            in
            if forceVertical then
                verticalBinopChainBoxFromItems flat.ops operandItems
                    |> Result.onError (\_ -> buildFlowBoxBroken grenIndent children)

            else if Array.any subtreeHasComment children then
                buildFlowBox grenIndent children

            else
                precedenceBinopBoxFromItems flat.ops operandItems
                    |> Result.onError (\_ -> buildFlowBox grenIndent children)


{-| The pre-threading dispatch, kept ONLY as `makeBinopBox`'s fallback for the
case where an operand refuses to render up front: each layout path here
carries its own per-node fallback, preserving the old error behavior exactly.
On this path operands can be rendered twice (decision + layout) — acceptable,
because a failing render aborts or falls back rather than recursing deeper. -}
makeBinopBoxLegacy : Bool -> Array LPNode -> Result String Box
makeBinopBoxLegacy forceVerticalArg children =
    let
        forceVertical =
            forceVerticalArg
                || anyOperandRendersMultiline children
    in
    if forceVertical then
        -- A forced-vertical chain — whether or not it carries a comment — renders
        -- with EVERY operator on its own line (`verticalBinopChainBox`), one
        -- comment-aware operand per segment. One renderer for both cases, so
        -- adding or removing a comment can never reflow the chain (the invariant
        -- the old two-path split risked). gren keeps a comment TRAILING the operand
        -- the author wrote it on (`++ beta {- c -}`) — a deliberate divergence from
        -- elm-format, which re-homes it to lead the next operator (`{- c -} ++ b`).
        verticalBinopChainBox children
            |> Result.onError (\_ -> buildFlowBoxBroken grenIndent children)

    else if Array.any subtreeHasComment children then
        buildFlowBox grenIndent children

    else
        precedenceBinopBox children
            |> Result.onError (\_ -> buildFlowBox grenIndent children)


{-| True when any chain-breaking operand (a bracket literal or a parenthesized
expression) RENDERS multi-line, so the whole chain must break vertically —
elm-format breaks a chain around any multi-line operand.

Decided from the operand's own rendered box (`isSingleLine`), which is a
reparse-stable function of the operand subtree: an `if`/`when`/`let`, a
multi-field record, an author-broken paren, or a `--` comment forcing the `)`
down each renders multi-line in BOTH the flat and the re-broken input, so the
chain breaks consistently (a fixed point). This is the exact signal the pure
`bracketOperandForcesVertical` predicate could only approximate — it does not
model `if`/`when`/`let` or a paren's content, so a paren-wrapped multi-line
operand (`0 ++ (if …)`, `0 ++ ({ y | … })`) glued on the flat format and broke
on reparse, oscillating forever. An unrenderable operand (`Err`) counts as
not-forcing, matching the pre-existing "can't decide, leave it" behavior. -}
anyOperandRendersMultiline : Array LPNode -> Bool
anyOperandRendersMultiline children =
    (flattenBinopNodes children).operands
        |> Array.any operandBoxIsMultiline


operandBoxIsMultiline : Array LPNode -> Bool
operandBoxIsMultiline operand =
    -- Skip a comment riding the operator so the sole operand node is found.
    when Array.popFirst (Array.keepIf (\n -> not (nodeIsComment n)) operand) is
        Just { first = node, rest = rest } ->
            Array.isEmpty rest
                && isChainBreakingOperandBox (lpnBox node)
                && (when makePBox (lpnBox node) (lpnChildren node) is
                        Ok b ->
                            not (isSingleLine b)

                        Err _ ->
                            False
                   )

        Nothing ->
            False


{-| Item-level mirror of `operandBoxIsMultiline`: True when the operand is a
single chain-breaking node (comments skipped) whose ALREADY-rendered box is
multi-line. Reads the box rendered once by `makeBinopBox` instead of
re-rendering the subtree. -}
operandItemsRenderMultiline : Array FlowItem -> Bool
operandItemsRenderMultiline items =
    when Array.popFirst (Array.keepIf (\it -> not (nodeIsComment it.node)) items) is
        Just { first = it, rest = rest } ->
            Array.isEmpty rest
                && isChainBreakingOperandBox (lpnBox it.node)
                && not (isSingleLine it.box)

        Nothing ->
            False


{-| `BinopLayout.splitTrailingOwnLineComments` over pre-rendered items: peel
the trailing run of `LeadsOwnLine` comment items off an operand group. -}
splitTrailingOwnLineCommentItems : Array FlowItem -> { content : Array FlowItem, ownLine : Array FlowItem }
splitTrailingOwnLineCommentItems items =
    let
        isOwnLineComment it =
            commentRole (lpnBox it.node) == Just LeadsOwnLine

        peeled =
            Array.foldr
                (\it acc ->
                    if acc.peeling && isOwnLineComment it then
                        { peeling = True, content = acc.content, ownLine = [ it ] ++ acc.ownLine }

                    else
                        { peeling = False, content = [ it ] ++ acc.content, ownLine = acc.ownLine }
                )
                { peeling = True, content = [], ownLine = [] }
                items
    in
    { content = peeled.content, ownLine = peeled.ownLine }


{-| One group of a vertical binop chain past the first: the operator that leads
it, the box its content rendered to, and the run of own-line comment items
peeled off its end. -}
type alias BinopChainSegment =
    { op : String, operandBox : Box, ownLine : Array FlowItem }


{-| The line of a single-line block-comment item — the only comment kind that
can ride the operator line that follows it. Literally the `pairableCommentLine`
rule `assembleBrokenWithComments` uses for a broken call, over the same
`FlowItem.comment` record, so a broken call and a broken binop chain pair the
same comments. A `--` can have nothing after it on its row and a multi-line
`{- -}` has no single line to ride, so neither pairs. -}
pairableCommentItemLine : FlowItem -> Maybe B.Line
pairableCommentItemLine item =
    when item.comment is
        Just c ->
            if not c.isLineComment && not c.multiLine then
                when B.isLine c.box is
                    Ok cl ->
                        Just cl

                    Err _ ->
                        Nothing

            else
                Nothing

        Nothing ->
            Nothing


{-| Decide a group's own-line comment run: either the WHOLE run rides the next
group's operator line, or none of it does and every comment stands on its own
row.

All-or-nothing, not a trailing peel — that is elm-format's rule, verified
directly: `-- first` / `{- c -}` / `+ b` keeps *both* comments on their own rows
there, and so does a multi-line `{- -}` followed by a single-line one. Splitting
the run instead (pair the pairable suffix, stack the rest) would leave the two
halves of one authored run laid out differently. -}
splitPairingCommentItems : Array FlowItem -> { stacked : Array FlowItem, pairing : Array B.Line }
splitPairingCommentItems items =
    let
        pairable =
            Array.mapAndKeepJust pairableCommentItemLine items
    in
    if not (Array.isEmpty items) && Array.length pairable == Array.length items then
        { stacked = [], pairing = pairable }

    else
        { stacked = items, pairing = [] }


{-| The indented body of a vertical binop chain: each group's operator line,
with the own-line comments between groups placed around them.

A trailing run of single-line block comments in a group's own-line split does
NOT stack on its own row — it rides the next group's operator line
(`{- c -} + b`), which is what elm-format does with a leading block comment in a
broken chain, and mirrors `assembleBrokenWithComments`'s `pending` for a broken
call. Both authorings converge on it: written on its own row the comment pairs
after one format, and written inline it stays paired, so the paired form is the
only fixed point (the classifier tags the comment `LeadsOwnLine` either way, so
the two authorings reparse to the same tree).

The pairing is off in the three cases where there is no line to ride: the
operator line rendered multi-line (conservative — only its first line would be
ridden, but start narrow and widen on fuzzer evidence), the run contains a `--`
or a multi-line `{- -}` (`splitPairingCommentItems` offers nothing then), or the
run trails the LAST group and no operator line follows. Each of those keeps
today's own-row layout, which reparses to itself.

Shared by both chain renderers — `verticalBinopChainBoxFromItems` (live) and
`verticalBinopChainBox` (the legacy fallback), which are documented as identical
layout. Comment placement lives here once so the two cannot drift. -}
binopChainIndentedLines : Array FlowItem -> Array BinopChainSegment -> Result String (Array Box)
binopChainIndentedLines firstOwnLine segments =
    let
        -- Own-row comment items to their own boxes (`buildFlowBox 0 [ c ]`
        -- with the item already rendered).
        renderOwnRows items =
            traverseResult (\c -> assembleFlow False 0 [ c ]) items

        step seg accResult =
            accResult
                |> Result.andThen
                    (\acc ->
                        let
                            opLine =
                                prefixOperator seg.op seg.operandBox

                            segSplit =
                                splitPairingCommentItems seg.ownLine

                            opLines =
                                if Array.isEmpty acc.pairing then
                                    [ opLine ]

                                else if isSingleLine opLine then
                                    [ B.prefix
                                        (B.row (Array.flatten (Array.map (\cl -> [ cl, B.space ]) acc.pairing)))
                                        opLine
                                    ]

                                else
                                    -- Nothing single-line to ride: the waiting
                                    -- comments fall back to their own rows,
                                    -- ahead of the operator line.
                                    Array.map B.line acc.pairing ++ [ opLine ]
                        in
                        renderOwnRows segSplit.stacked
                            |> Result.map
                                (\stackedBoxes ->
                                    { lines = acc.lines ++ opLines ++ stackedBoxes
                                    , pairing = segSplit.pairing
                                    }
                                )
                    )

        firstSplit =
            splitPairingCommentItems firstOwnLine
    in
    renderOwnRows firstSplit.stacked
        |> Result.andThen
            (\stacked0 ->
                Array.foldl step (Ok { lines = stacked0, pairing = firstSplit.pairing }) segments
                    -- A run trailing the last group has no operator line to ride.
                    |> Result.map (\acc -> acc.lines ++ Array.map B.line acc.pairing)
            )


{-| `verticalBinopChainBox` over pre-rendered operand items: identical layout —
each group is assembled with the same `assembleFlow` calls that
`buildFlowBoxInline` / `buildFlowBox` wrap, and `renderFlowItems (a ++ b)` is
`renderFlowItems a ++ renderFlowItems b`, so concatenating item groups equals
concatenating node groups — but every operand box comes from the single
up-front render in `makeBinopBox`. Only the operator leaves are rendered here
(cheap, childless). -}
verticalBinopChainBoxFromItems : Array LPNode -> Array (Array FlowItem) -> Result String Box
verticalBinopChainBoxFromItems ops operandItems =
    let
        -- Assemble a group's content: `assembleFlow True 0` (the
        -- `buildFlowBoxInline 0` assembly) keeps a LEADING block comment glued
        -- on-line (`{- c -} 100`) rather than dropping the operand to its own
        -- row, matching how the operator segment should read.
        renderOperandContent items =
            assembleFlow True 0 items
    in
    when Array.popFirst operandItems is
        Just _ ->
            traverseResult renderFlowItem ops
                |> Result.andThen
                    (\opItems ->
                        let
                            grouped =
                                groupBinopItemsByPrecedence
                                    operandItems
                                    (Array.map2 (\opNode opItem -> { text = opText opNode, item = opItem }) ops opItems)

                            op0 =
                                splitTrailingOwnLineCommentItems grouped.firstGroup

                            segData =
                                Array.map
                                    (\g -> { op = g.op, split = splitTrailingOwnLineCommentItems g.items })
                                    grouped.rest
                        in
                        renderOperandContent op0.content
                            |> Result.andThen
                                (\firstBox ->
                                    traverseResult
                                        (\seg ->
                                            renderOperandContent seg.split.content
                                                |> Result.map
                                                    (\operandBox ->
                                                        { op = seg.op, operandBox = operandBox, ownLine = seg.split.ownLine }
                                                    )
                                        )
                                        segData
                                        |> Result.andThen (binopChainIndentedLines op0.ownLine)
                                        |> Result.map
                                            (\indentedLines ->
                                                -- Every operator line + every own-line comment
                                                -- sits at +grenIndent; `firstBox` (operand0) at the base.
                                                B.stack1 ([ firstBox ] ++ Array.map B.indent indentedLines)
                                            )
                                )
                    )

        Nothing ->
            Err "box: empty binop chain"


{-| `groupBinopByPrecedence` over pre-rendered items — the same fold, glueing a
tighter operator's item + operand items inline into the current group. -}
groupBinopItemsByPrecedence :
    Array (Array FlowItem)
    -> Array { text : String, item : FlowItem }
    -> { firstGroup : Array FlowItem, rest : Array { op : String, items : Array FlowItem } }
groupBinopItemsByPrecedence operands ops =
    when Array.popFirst operands is
        Nothing ->
            { firstGroup = [], rest = [] }

        Just { first = operand0, rest = restOperands } ->
            let
                minPrec =
                    binopMinPrecedence (Array.map .text ops)

                paired =
                    Array.map2 (\op operandItems -> { op = op, operand = operandItems }) ops restOperands

                final =
                    Array.foldl
                        (\pair acc ->
                            if binopPrecedence pair.op.text == minPrec then
                                -- A lowest-precedence operator: close the current group
                                -- and start a new one led by this operator.
                                { groups = Array.pushLast { op = acc.curOp, items = acc.curItems } acc.groups
                                , curOp = pair.op.text
                                , curItems = pair.operand
                                }

                            else
                                -- A tighter operator: glue its leaf + operand inline
                                -- into the current group.
                                { acc | curItems = acc.curItems ++ [ pair.op.item ] ++ pair.operand }
                        )
                        { groups = [], curOp = "", curItems = operand0 }
                        paired

                allGroups =
                    Array.pushLast { op = final.curOp, items = final.curItems } final.groups
            in
            when Array.popFirst allGroups is
                Just { first = fg, rest = rg } ->
                    { firstGroup = fg.items, rest = rg }

                Nothing ->
                    { firstGroup = operand0, rest = [] }


{-| `precedenceBinopBox` over pre-rendered operand items: same assembly, but
each operand box is `assembleFlow` over the items rendered once up front
(exactly what `buildFlowBox 0` produced after its own render). -}
precedenceBinopBoxFromItems : Array LPNode -> Array (Array FlowItem) -> Result String Box
precedenceBinopBoxFromItems ops operandItems =
    when Array.popFirst operandItems is
        Nothing ->
            Err "box: empty binop"

        Just { first = operand0, rest = _ } ->
            if Array.isEmpty ops then
                assembleFlow False 0 operand0

            else
                traverseResult (assembleFlow False 0) operandItems
                    |> Result.andThen
                        (\operandBoxes ->
                            assembleBinopBox
                                (binopMinPrecedence (Array.map opText ops))
                                operandBoxes
                                (Array.map opText ops)
                        )


-- The comment-aware flow: `buildFlowBox grenIndent` when inline,
{-| A forced-vertical binop chain, laid out **precedence-aware**: the chain
breaks only at its lowest-precedence operators, and tighter-binding operators
(with their operands) stay glued inline within a group — `baseScore` /
`+ bonusPoints * multiplier` / `- penaltyAmount`, not one operator per line. This
mirrors the still-precedence-aware force-vertical decision in
`InsertExpressions.binopForceVertical`, which groups the operand *ranges* at the
same `binopMinPrecedence` tier to decide the chain went across rows. It is a
deliberate divergence from elm-format (which splits every operator) — see the
README "Binary operators" section.

The first group renders at the flow base and each following group's leading
(min-precedence) operator is indented +grenIndent. Each group renders comment-aware
(`buildFlowBoxInline`), so a block comment inside a group stays glued
(`bbb {- c -} * ccc`) and a comment trailing an operand rides its group's line
(`++ beta {- c -}`) — gren's uniform "a comment sticks to what it trails" rule.
Both comment-free and comment-bearing chains use this one renderer, so adding or
removing a comment never reflows the chain (the invariant the pre-2026-07-12
two-path split — precedence renderer for comment-free, generic flow for
comment-bearing — used to break). -}
verticalBinopChainBox : Array LPNode -> Result String Box
verticalBinopChainBox children =
    let
        flat =
            flattenBinopNodes children

        -- Render a group's content: `buildFlowBoxInline` keeps a LEADING block
        -- comment glued on-line (`{- c -} 100`) rather than dropping the operand to
        -- its own row, matching how the operator segment should read.
        renderOperandContent nodes =
            buildFlowBoxInline 0 nodes
    in
    when Array.popFirst flat.operands is
        Just _ ->
            let
                grouped =
                    groupBinopByPrecedence flat.operands flat.ops

                op0 =
                    splitTrailingOwnLineComments grouped.firstGroup

                segData =
                    Array.map
                        (\g -> { op = g.op, split = splitTrailingOwnLineComments g.nodes })
                        grouped.rest
            in
            renderOperandContent op0.content
                |> Result.andThen
                    (\firstBox ->
                        -- The own-line comment runs go through `renderFlowItems`
                        -- so `binopChainIndentedLines` — the SAME function the
                        -- live item path uses — decides their placement here too.
                        -- Rendering a comment leaf to an item is what
                        -- `buildFlowBox 0 [ c ]` did internally anyway.
                        renderFlowItems op0.ownLine
                            |> Result.andThen
                                (\op0Items ->
                                    traverseResult
                                        (\seg ->
                                            renderOperandContent seg.split.content
                                                |> Result.andThen
                                                    (\operandBox ->
                                                        renderFlowItems seg.split.ownLine
                                                            |> Result.map
                                                                (\ownLineItems ->
                                                                    { op = seg.op, operandBox = operandBox, ownLine = ownLineItems }
                                                                )
                                                    )
                                        )
                                        segData
                                        |> Result.andThen (binopChainIndentedLines op0Items)
                                        |> Result.map
                                            (\indentedLines ->
                                                -- Every operator line + every own-line comment
                                                -- sits at +grenIndent; `firstBox` (operand0) at the base.
                                                B.stack1 ([ firstBox ] ++ Array.map B.indent indentedLines)
                                            )
                                )
                    )

        Nothing ->
            Err "box: empty binop chain"


{-| Group a flattened binop chain by precedence for the vertical layout: break at
the chain's lowest-precedence operators, keeping tighter-binding operators (and
their operands) glued inline within a group. Returns the first group's node
sequence (rendered at the flow base) and, for each following group, the
min-precedence operator that leads it plus the group's node sequence. Within a
group the operand nodes and the tighter operator leaves are concatenated back
into one flow (`bonusPoints * multiplier`) so `buildFlowBoxInline` renders them
inline, comment-aware.

Breaks at exactly the same `binopMinPrecedence` tier as
`InsertExpressions.binopForceVertical`, so the render grouping and the
force-vertical decision stay in lockstep. -}
groupBinopByPrecedence :
    Array (Array LPNode)
    -> Array LPNode
    -> { firstGroup : Array LPNode, rest : Array { op : String, nodes : Array LPNode } }
groupBinopByPrecedence operands ops =
    when Array.popFirst operands is
        Nothing ->
            { firstGroup = [], rest = [] }

        Just { first = operand0, rest = restOperands } ->
            let
                minPrec =
                    binopMinPrecedence (Array.map opText ops)

                paired =
                    Array.map2 (\op operandNodes -> { op = op, operand = operandNodes }) ops restOperands

                final =
                    Array.foldl
                        (\pair acc ->
                            if binopPrecedence (opText pair.op) == minPrec then
                                -- A lowest-precedence operator: close the current group
                                -- and start a new one led by this operator.
                                { groups = Array.pushLast { op = acc.curOp, nodes = acc.curNodes } acc.groups
                                , curOp = opText pair.op
                                , curNodes = pair.operand
                                }

                            else
                                -- A tighter operator: glue its leaf + operand inline
                                -- into the current group.
                                { acc | curNodes = acc.curNodes ++ [ pair.op ] ++ pair.operand }
                        )
                        { groups = [], curOp = "", curNodes = operand0 }
                        paired

                allGroups =
                    Array.pushLast { op = final.curOp, nodes = final.curNodes } final.groups
            in
            when Array.popFirst allGroups is
                Just { first = fg, rest = rg } ->
                    { firstGroup = fg.nodes, rest = rg }

                Nothing ->
                    { firstGroup = operand0, rest = [] }


-- The inline layout: the whole chain on one line (`inlineBinopBox`), with a
-- multi-line trailing operand allowed to break below its opening column. `Err`
-- when a non-trailing operand is multi-line — `makeBinopBox` catches that and
-- falls back to the comment-aware flow. (Forced-vertical chains never reach here;
-- they render one-operator-per-line via `verticalBinopChainBox`.)
precedenceBinopBox : Array LPNode -> Result String Box
precedenceBinopBox children =
    let
        flat =
            flattenBinopNodes children
    in
    when Array.popFirst flat.operands is
        Nothing ->
            Err "box: empty binop"

        Just { first = operand0, rest = _ } ->
            if Array.isEmpty flat.ops then
                buildFlowBox 0 operand0

            else
                -- Render every operand to a Box (multi-line allowed).
                traverseResult (buildFlowBox 0) flat.operands
                    |> Result.andThen
                        (\operandBoxes ->
                            assembleBinopBox
                                (binopMinPrecedence (Array.map opText flat.ops))
                                operandBoxes
                                (Array.map opText flat.ops)
                        )


{-| Render an `OpAndRhs` node (`op` + the right-hand side flow). Reached only
from the comment-bearing binop flow (the comment-free path flattens `OpAndRhs`
via `flattenBinopNodes` instead). -}
makeOpAndRhsBox : Array LPNode -> Result String Box
makeOpAndRhsBox children =
    when Array.popFirst children is
        Nothing ->
            Err "box: empty OpAndRhs"

        Just { first = opNode, rest = rhsNodes } ->
            when leafValue opNode is
                Just op ->
                    -- Inline-start flow: a leading `{- c -}` in the rhs stays on
                    -- the operator's line (`* {- c -} 100`), via
                    -- `buildFlowBoxInline 0`. `prefixOperator` glues `op ` onto
                    -- the rhs — its first line for a single-line rhs, or (via
                    -- `B.prefix`, padding continuation by the operator width) the
                    -- first line of a multi-line rhs such as an operand with a
                    -- trailing multi-line comment (`+ b {- multi… -}`).
                    --
                    -- A rhs that also carries a NESTED `OpAndRhs` (a lower-precedence
                    -- continuation operand, `+ b {- mlbc -} * 2`) can't use `B.prefix`:
                    -- the comment body must shift with the operator while the nested
                    -- operand must stay at the operator's base column — a per-line
                    -- mix of align vs ambient nest the uniform prefix can't produce.
                    -- The FOLD can, though: render the operator as the flow's own
                    -- first item — the glued comment commits as its own
                    -- prefix-padded row (align preserved) and the nested group
                    -- lands on a fresh row.
                    --
                    -- That row is indented `grenIndent`, the same continuation
                    -- indent every other broken chain uses (`one` ⏎ `····+ two`).
                    -- The break here is one a comment forced — the chain's own
                    -- precedence split would have kept the tighter operator inline
                    -- — but a forced break is still a break, and it was landing at
                    -- the flow's ambient column, flush under the seed:
                    -- `one + two -- c` ⏎ `* three`.
                    buildFlowBoxInline 0 rhsNodes
                        |> Result.andThen
                            (\rhsBox ->
                                if not (isSingleLine rhsBox) && Array.any isOpAndRhsNode rhsNodes then
                                    buildFlowBoxInline grenIndent ([ opNode ] ++ rhsNodes)

                                else
                                    Ok (prefixOperator op rhsBox)
                            )

                Nothing ->
                    Err "box: OpAndRhs op is not a text leaf"


-- ═══ COMMENT LINES ═══


{-| Header + indented body: `type alias Name =` / body, `type Name` / variants —
header inline, body dropped +4 (elm-format). -}
renderHeaderIndentedBody : (Array LPNode -> Result String Box) -> Array LPNode -> Result String Box
renderHeaderIndentedBody bodyRenderer children =
    when Array.popLast children is
        Nothing ->
            Err "box: empty declaration"

        Just { initial = header, last = bodyBlock } ->
            buildFlowBox 0 header
                |> Result.andThen
                    (\headerBox ->
                        bodyRenderer (lpnChildren bodyBlock)
                            |> Result.map (\bodyBox -> B.stack1 [ headerBox, B.indent bodyBox ])
                    )


-- A type-alias body: a single type node (record, or a plain `= Int`-style
-- type) renders inline. A multi-line function type (`->` segments) the author
-- wrote across rows renders one segment per row instead, matching a function
-- signature's multi-line body -- but with no "name :" header line to glue the
-- first segment to, every segment (including the first) sits at the SAME
-- column, since `renderHeaderIndentedBody` already supplies the body's one
-- +4 from `type alias Foo =`.
makeTypeAliasBody : Array LPNode -> Result String Box
makeTypeAliasBody nodes =
    let
        segments =
            splitSignatureSegments nodes

        -- Same second trigger `makeSignatureBox` uses: a segment carrying a
        -- record type that renders multi-line must commit the whole type to the
        -- broken layout up front, because a multi-line record type in a flow
        -- DROPS (FlowPolicy's `DropBlock`) rather than gluing -- so leaving the
        -- decision to the flow would keep `} -> Int` on the record's closing
        -- line. Gated on `not hasComment` for the same reason as there: a
        -- comment-bearing type has its own handling in the flow.
        hasComment =
            Array.any subtreeHasComment nodes

        forceVertical =
            signatureForceVertical segments
                || (not hasComment
                        && Array.any (segmentHasDroppingRecordBox True) segments
                   )
    in
    if forceVertical then
        traverseResult (buildFlowBox 0) segments
            |> Result.map B.stack1

    else
        buildFlowBox 0 nodes


{-| A union body: each variant (`= A`, `| B`) on its own line when the author
wrote them across rows, or inline `= A | B | C` when on one line. A comment only
forces the vertical form when it cannot ride the inline one. -}
makeUnionBodyBox : Array LPNode -> Result String Box
makeUnionBodyBox nodes =
    let
        variantNodes =
            Array.keepIf (\n -> not (nodeIsComment n)) nodes

        authorVertical =
            rowsSpanMultiple (Array.map firstRowInSubtree variantNodes)

        vertical =
            authorVertical || commentForcesBracketOpen False nodes
    in
    if vertical then
        makeUnionBodyVerticalBox nodes

    else
        -- Fold over `nodes`, not `variantNodes`: `pairInlineComments` glues each
        -- comment onto the variant it trails, so `joinInline` still sees one box
        -- per variant.
        pairInlineComments (\n -> buildFlowBox 0 (lpnChildren n)) nodes
            |> Result.andThen
                (\variantBoxes ->
                    when joinInline variantBoxes is
                        Just l ->
                            Ok l

                        Nothing ->
                            -- A variant's payload is inherently multi-line (a
                            -- record type spread across rows) even though every
                            -- `|` sits on the same source row. Fall back to the
                            -- already-correct vertical (one-variant-per-line)
                            -- rendering, which handles a multi-line variant box
                            -- fine via B.stack1/B.prefix.
                            makeUnionBodyVerticalBox nodes
                )


{-| Always-vertical union body with comment siblings: one variant per line; a
comment on the same row as the variant it trails is appended inline
(`B.addSuffix`), one on its own
row renders on its own line. A variant's "last row" is `max(lpnLastPos,
lpnLastBracketEnd)` — NOT `lpnMaxRow`, which a multi-line block comment inside the
variant would widen, shifting a trailing comment to its own line (non-idempotent).
A multi-line block-comment SIBLING (rare) falls back. -}
makeUnionBodyVerticalBox : Array LPNode -> Result String Box
makeUnionBodyVerticalBox nodes =
    let
        -- Same-row (role `TrailsPrevious`/`RidesInline`): glue onto the preceding
        -- variant's last line (multi-line comments padded under their start by
        -- `glueCommentSuffix`). Own row (`LeadsOwnLine`): the comment box stands
        -- on its own line. The glue call is the stored role, not a row test.
        placeComment acc node commentBox =
            when Array.popLast acc.boxes is
                Just { last = lastBox, initial } ->
                    if commentTrailsRole node then
                        { acc | boxes = Array.pushLast (glueCommentSuffix commentBox lastBox) initial }

                    else
                        { acc | boxes = Array.pushLast commentBox acc.boxes }

                Nothing ->
                    { acc | boxes = [ commentBox ] }
    in
    Array.foldl
        (\node accResult ->
            accResult
                |> Result.andThen
                    (\acc ->
                        when lpnBox node is
                            SingleLineComment _ ->
                                commentNodeBox node
                                    |> Result.map (\cbox -> placeComment acc node cbox)

                            BlockComment _ ->
                                commentNodeBox node
                                    |> Result.map (\cbox -> placeComment acc node cbox)

                            _ ->
                                buildFlowBox 0 (lpnChildren node)
                                    |> Result.map
                                        (\childBox ->
                                            { acc | boxes = Array.pushLast childBox acc.boxes }
                                        )
                    )
        )
        (Ok { boxes = [] })
        nodes
        |> Result.andThen
            (\acc ->
                when Array.first acc.boxes is
                    Nothing ->
                        Err "box: union has no variants"

                    Just _ ->
                        Ok (B.stack1 acc.boxes)
            )


{-| Render a forward (`|>`) pipeline: seed then each `|> step` on its own line
at +4, or inline `seed |> a |> b` when the author kept it on one row and nothing
in it forces a break. Backward (`<|`) pipelines have their own path.

The inline attempt runs for comment-bearing and comment-free chains alike: an
inline comment the flat line can carry RIDES that line (`seed |> f x {- c -} |> g`)
rather than breaking the pipeline, the same rule `++` / `&&` / `<|` chains already
follow. `|>` was the one chain kind that still broke, because `PipelineStepItem`
is the only flow item with no inline placement — so a comment reaching the fold
below could never come back inline, and adding one silently reflowed the whole
pipeline.

A `--` line comment renders as a `MustBreakBox`, so `joinInline` rejects it and
the chain still breaks — which it must, or the `--` would swallow the rest of it.

When the chain does break, a comment-bearing one still routes through the generic
fold, where the per-step comment handling (leading peel, trailing glue,
blank-before-commented-step) lives. Everything is rendered ONCE and the layout
chosen from the boxes: re-rendering to try a second shape would cost 2^depth on
nested pipelines (see the Box.gren renderRowState hang). -}
makePipelineBox : Bool -> String -> Array LPNode -> Result String Box
makePipelineBox forceVertical op children =
    if op == "<|" then
        makeBackwardPipelineBox forceVertical children

    else if op /= "|>" then
        -- unreachable: Pipeline.op is only ever constructed as "|>" or "<|"
        -- (InsertExpressions.gren), and "<|" is handled by the branch above.
        Err "unreachable: pipeline operator"

    else
        let
            hasComment =
                Array.any subtreeHasComment children

            seedNodes =
                Array.keepIf (\n -> not (isPipelineStepNode n)) children

            stepNodes =
                Array.keepIf isPipelineStepNode children
        in
        buildFlowBox 0 seedNodes
            |> Result.andThen
                (\seedBox ->
                    traverseResult renderPipelineStepInline stepNodes
                        |> Result.andThen
                            (\stepBoxes ->
                                when
                                    (if forceVertical then
                                        Nothing

                                     else
                                        joinInline ([ seedBox ] ++ stepBoxes)
                                    )
                                is
                                    Just l ->
                                        Ok l

                                    Nothing ->
                                        if hasComment then
                                            -- The chain breaks and carries a comment:
                                            -- the generic fold owns per-step comment
                                            -- placement.
                                            buildFlowBox 0 children

                                        else if forceVertical then
                                            Ok (B.stack1 ([ seedBox ] ++ Array.map B.indent stepBoxes))

                                        else
                                            -- A step is inherently multi-line (a
                                            -- multi-line string/record argument, or a
                                            -- `when`/`if`/`let`) even though the author
                                            -- kept the pipeline itself on one row. Fall
                                            -- back to the exact same comment-aware flow
                                            -- a comment-bearing chain routes through
                                            -- above, rather than a second layout of our
                                            -- own that could disagree with it (the binop
                                            -- fallback took the shortcut of reproducing
                                            -- that layout locally and it silently
                                            -- diverged under a comment — see
                                            -- commentAwareBinopBox).
                                            buildFlowBox 0 children
                            )
                )


-- ═══ pipeline-step trigger classification ═══
--
-- One `|> step`. Rendered via `buildFlowBox grenIndent`: the operator + function
-- stay inline (`|> f`) and a multi-line block argument (a record / array /
-- `when` / `if` / `let` that forces vertical) relocates to the next line at +4.
-- A single-line step renders identically at any flow indent.
--
-- A multi-line step whose argument is a `ParenBlock` (a multi-line lambda `\x ->`,
-- a parens-with-multiline-content, or a direct `|> (\x -> …)` operand) gets
-- elm-format-specific relocation (`makeMultilineLambdaArgBox` /
-- `makeMultilineParenArgBox`, or stays glued) that `assembleFlow`'s generic block
-- drop doesn't reproduce — so those take the trigger-split path. A single-line
-- ParenBlock argument (`|> f (g x)`) is fine (it renders inline).


{-| Split a pipeline step's ALREADY-RENDERED items at the step's *trigger* — the
first node that breaks onto its own line: a multi-line lambda-argument paren, a
multi-line content paren, or any other multi-line-forcing node such as a record
argument. A left-to-right split matching elm-format, including the
direct-operand-lambda exclusion (`|> (\x -> …)` stays glued to the operator).
`Nothing` = no trigger.

Every verticality question here is answered from `item.box`, the box the caller
already rendered. Asking the node instead (`makePBox` just to test
`isSingleLine`) meant the guard rendered a subtree that the preamble/trigger
render then rendered again — two to four full renders of the same subtree per
nesting level, which is why a nested `0 |> g ( 0 |> g ( … ))` cost 2^depth and a
nested direct-operand pipeline lambda ~4^depth. -}
splitStepTriggerItems : Array FlowItem -> Maybe { preamble : Array FlowItem, trigger : FlowItem, suffix : Array FlowItem }
splitStepTriggerItems stepItems =
    (Array.foldl
        (\item acc ->
            when acc.split is
                Just s ->
                    { acc | split = Just { s | suffix = Array.pushLast item s.suffix } }

                Nothing ->
                    let
                        -- A multi-line paren block OR a multi-line bracket
                        -- container (array / record / update) written directly
                        -- after `|>` (nothing but the operator in the preamble)
                        -- glues to the operator like elm-format's `|> (if …` /
                        -- `|> [ 1`. Keeping it out of the trigger split leaves it
                        -- in the preamble, where `buildFlowBoxInline` glues it;
                        -- otherwise the relocation branch strands `|>` on its own
                        -- line with the operand dropped +4 below.
                        -- (`acc.preamble` holds the step's OPERANDS only — the
                        -- operator is a prefix applied by `stepBodyBox`, not an
                        -- item — so "nothing before it" is an empty preamble.)
                        isDirectGluedOperand =
                            Array.isEmpty acc.preamble
                                && (itemIsMultilineParenBlock item
                                        || itemIsMultilineBracketContainer item
                                   )
                    in
                    if
                        not isDirectGluedOperand
                            && (isMultilineLambdaParenBlockBox item.node
                                    || itemForcesFlowVertical item
                               )
                    then
                        { acc | split = Just { preamble = acc.preamble, trigger = item, suffix = [] } }

                    else
                        { acc | preamble = Array.pushLast item acc.preamble }
        )
        { preamble = [], split = Nothing }
        stepItems
    ).split


-- The three `splitStepTriggerItems` predicates, each the item-box form of the
-- node-rendering one it replaced (`isMultilineLambdaParenBlockAnyBodyBox`,
-- `isMultilineBracketContainerBox`, `flowChildForcesVerticalBox`). The structural
-- half is unchanged; only the verticality half moved from "render it again" to
-- "read the box we have". A comment item's `box` is `B.blankLine` (single-line),
-- so the explicit comment guard below is belt-and-braces, matching the original.


itemIsMultilineParenBlock : FlowItem -> Bool
itemIsMultilineParenBlock item =
    when lpnBox item.node is
        ParenBlock _ ->
            not (isSingleLine item.box)

        _ ->
            False


itemIsMultilineBracketContainer : FlowItem -> Bool
itemIsMultilineBracketContainer item =
    (when lpnBox item.node is
        AllAcrossOrAllVertical _ ->
            True

        AlwaysVertical _ ->
            True

        RecordUpdate _ ->
            True

        _ ->
            False
    )
        && not (isSingleLine item.box)


itemForcesFlowVertical : FlowItem -> Bool
itemForcesFlowVertical item =
    not (nodeIsComment item.node) && not (isSingleLine item.box)


{-| Render a relocated multi-line lambda argument `(\args ->` … `)` — head glued
to `(`, body at `(` + grenIndent, `)` on its own line at the `(` column
(elm-format). elm-format anchors everything at the `(` column; here the box's
own origin IS that column (the caller drops the trigger box at its indent), so
plain stacking reproduces it. The `(` glue is FIRST-LINE-ONLY: the head flow's
own breaks (an own-line comment between lambda params) land at the align
level — the `(` COLUMN, one left of the head's first character — so the
head box's continuation rows must stay at the box origin, not be padded by
the `(` width (`B.prefix` put them one column deep — KitchenComments'
destructuring-lambda-head comment). Align-carrying content INSIDE the head
(a multi-line pattern literal) already carries its own prefix-padding from
the head's inner fold, which survives the first-line glue untouched.

`bodyBoxFromItem` is the paren's `FlowItem.lambdaBodyBox` — the body box the
caller's own render already produced. Rendering it here instead cost a second
full render of the body per nesting level, which is 2^depth for a lambda nested
through its own body. `Nothing` (the paren was not rendered through a
`renderFlowItem`) falls back to rendering it. -}
makeMultilineLambdaArgBox : Maybe Box -> Array LPNode -> Result String Box
makeMultilineLambdaArgBox bodyBoxFromItem children =
    let
        glueParen headBox =
            B.mapFirstLine (\l -> B.row [ B.punc "(", l ]) identity headBox
    in
    when Array.popFirst children is
        Nothing ->
            Err "box: multiline lambda paren: no children"

        Just { first = headNode, rest = afterHead } ->
            buildFlowBoxInline 0 (lpnChildren headNode)
                |> Result.andThen
                    (\headBox ->
                        when Array.first afterHead is
                            Nothing ->
                                Ok (B.addSuffix (B.punc ")") (glueParen headBox))

                            Just bodyNode ->
                                (when bodyBoxFromItem is
                                    Just b ->
                                        Ok b

                                    Nothing ->
                                        buildFlowBox 0 (lpnChildren bodyNode)
                                )
                                    |> Result.map
                                        (\bodyBox ->
                                            B.stack1
                                                [ glueParen headBox
                                                , applyIndent grenIndent bodyBox
                                                , B.line (B.punc ")")
                                                ]
                                        )
                    )


{-| Split a direct-operand multi-line lambda ParenBlock (`(\x -> body)`) into its
head line (`\x ->`) and rendered body box, for the soft-glue direct-operand
render. `Nothing` if it isn't a multi-line lambda paren, has a multi-line head
(a comment among the params), or fails to render — those fall back.

Takes the caller's `FlowItem`, not the bare node: the "is this paren multi-line"
gate reads `item.box` and the body comes from `item.lambdaBodyBox` — both
already rendered by the flow. Re-deriving them here was two of the four renders
per level behind the ~4^depth nested-pipeline-lambda hang. The head IS still
rendered here: it must go through `buildFlowBoxInline` (a leading block comment
among the parameters stays on-line), which is not how an item is rendered, and
a parameter list cannot contain the nesting. -}
directOperandLambdaSplit : FlowItem -> Maybe { headLine : B.Line, bodyBox : Box }
directOperandLambdaSplit item =
    let
        node =
            item.node

        -- "A multi-line ParenBlock" only says the SECOND child is a block, which
        -- is also true for a paren-`if`/`when` (its first branch is a block) —
        -- splitting one as `[head, body]` would drop the remaining branches.
        -- Require the FIRST child to be a lambda head (not an `if`/`when`/`let`),
        -- matching `makeParenBlockBox`'s content dispatch.
        isMultilineParen =
            when lpnBox node is
                ParenBlock _ ->
                    not (isSingleLine item.box)

                _ ->
                    False
    in
    if not isMultilineParen || not (parenContentIsLambdaHead node) then
        Nothing

    else
        when Array.popFirst (lpnChildren node) is
            Just { first = headNode, rest = afterHead } ->
                when Array.first afterHead is
                    Just bodyNode ->
                        when
                            { h = buildFlowBoxInline 0 (lpnChildren headNode)
                            , b =
                                when item.lambdaBodyBox is
                                    Just b ->
                                        Ok b

                                    Nothing ->
                                        buildFlowBox 0 (lpnChildren bodyNode)
                            }
                        is
                            { h = Ok headBox, b = Ok bodyBox } ->
                                when B.isLine headBox is
                                    Ok headLine ->
                                        Just { headLine = headLine, bodyBox = bodyBox }

                                    Err _ ->
                                        Nothing

                            _ ->
                                Nothing

                    Nothing ->
                        Nothing

            Nothing ->
                Nothing


-- One `|> step`. A step with a *trigger* (see `splitStepTrigger`) relocates it:
-- the preamble (`|> fn …`) glues inline, the trigger drops to its own line at
-- +grenIndent (relative to the step's own base — the pipeline assembler adds
-- the step's +4 from the seed), and any suffix args land below it at the same
-- indent. The trigger box dispatch: the two ParenBlock kinds get the paren-arg
-- reshaping, everything else its normal box. A multi-line step with NO trigger
-- (a direct-operand lambda paren that must stay glued to `|>`, or a
-- comment-bearing step needing comment-peeling) falls back.
{-| Render a pipeline step's children: peel ALL leading comments (each on its
own line above the `|>`, at the step's own column — the caller's step wrap
indents the whole box), peel trailing inline comments off the END
(`peelTrailingCommentNodes`, glued onto the step's last line with a space),
then render the remaining children via the trigger split. Mid-flow comments
stay in the body and flow through the preamble/suffix folds. -}
renderPipelineStepChildren : Array LPNode -> Result String Box
renderPipelineStepChildren allChildren =
    renderPipelineStepChildrenWith False allChildren


{-| A step rendered for the one-line pipeline form, where leading comments GLUE
onto the `|>` line (`{- c -} |> Array.sort`) instead of stacking above it. The
comment the author wrote between the seed and the first `|>` lands as that step's
leading child (`people {- c -} |> sort` — see Comments.gren), so stacking it would
make the step box multi-line and break a pipeline the flat line can carry.

Scoped to the inline attempt: the BROKEN layout keeps its own-line comments,
stacked above the `|>` with no blank line between (an own-line comment is part of
one expression, so no blank separates it from the step — see `FlowPolicy`).
Falls back to the stack when the glue can't be single-line — which is also what
keeps a `--` line comment out: it renders as a `MustBreakBox`, `joinInline`
rejects it, and the pipeline breaks as it must. -}
renderPipelineStepInline : LPNode -> Result String Box
renderPipelineStepInline stepNode =
    renderPipelineStepChildrenWith True (lpnChildren stepNode)


renderPipelineStepChildrenWith : Bool -> Array LPNode -> Result String Box
renderPipelineStepChildrenWith glueLeading allChildren =
    let
        { leading, rest } =
            spanLeadingComments allChildren

        { bodyNodes, trailing } =
            peelTrailingCommentNodes rest
    in
    traverseResult commentNodeBox leading
        |> Result.andThen
            (\leadingBoxes ->
                stepBodyBox bodyNodes
                    |> Result.andThen (\bodyBox -> glueTrailingComments bodyBox trailing)
                    |> Result.map
                        (\withTrailing ->
                            let
                                boxes =
                                    leadingBoxes ++ [ withTrailing ]
                            in
                            if glueLeading then
                                joinInline boxes
                                    |> Maybe.withDefault (B.stack1 boxes)

                            else
                                B.stack1 boxes
                        )
            )


-- The comment-free core of a pipeline step: the trigger split over the body
-- children (leading/trailing comments already peeled by
-- `renderPipelineStepChildren`).
stepBodyBox : Array LPNode -> Result String Box
stepBodyBox children =
    -- The operator is a PREFIX, not a flow item — exactly as `makeOpAndRhsBox`
    -- treats a binop's operator. `B.prefix` pads the operand's continuation rows
    -- by the operator's own width, so anything that drops below the operator
    -- lands in the column it would have occupied on the operator's line:
    --
    --     seed              a                  a
    --         |> -- c           + -- c             ++ -- c
    --            step             b                   b
    --
    -- Treating `|>` as the flow's first item instead indented the continuation a
    -- flat +4, one column past the operand column for `|>`/`<|` (and level with
    -- the operator itself for the `<|` step body, so an argument stopped looking
    -- like an argument). `+` and `++` were already right, via the binop path —
    -- this is the same rule, applied by the same helper.
    --
    -- A `Tab` inside the operand box still snaps to an absolute multiple of 4
    -- after the padding (`B.prefix` does not freeze tabs), so a broken call's
    -- arguments keep the +4 they had before.
    when Array.popFirst children is
        Just { first = opNode, rest = operandNodes } ->
            when stepOperatorText opNode is
                Just op ->
                    operatorPrefixedOperandBox stepOperandBox op operandNodes

                Nothing ->
                    stepOperandBox children

        Nothing ->
            stepOperandBox children


{-| `op ` glued in front of the operand that follows it, with any comment run
written between the two glued onto the operand's front — the same treatment
`makeOpAndRhsBox` gives a binop's right-hand side, and the same run rule
`glueLeadingCommentRun` applies inside a bracket. Shared by the forward
(`stepBodyBox`) and backward (`renderCommentedBackwardStep`) pipeline renderers
so the two cannot drift.

The comment run is peeled here rather than left to the flow because a flow's
`flowIndent` is a single nest over every continuation row: it has to be +4 so a
broken call's ARGUMENTS land under the operand, which would also push an operand
that merely dropped below a `--` out to +4. The operand belongs at the operator's
own width, and only the argument wrap belongs at +4:

    seed
        |> -- c
           fn arg1
               arg2
-}
operatorPrefixedOperandBox : (Array LPNode -> Result String Box) -> String -> Array LPNode -> Result String Box
operatorPrefixedOperandBox renderOperand op operandNodes =
    let
        { leading, rest } =
            spanLeadingComments operandNodes
    in
    if Array.isEmpty leading || Array.isEmpty rest then
        renderOperand operandNodes
            |> Result.map (prefixOperator op)

    else
        traverseResult
            (\node ->
                commentNodeBox node
                    |> Result.map (\box -> { box = box, inline = commentFitsOnOneLine node })
            )
            leading
            |> Result.andThen
                (\lead ->
                    renderOperand rest
                        |> Result.map
                            (\body ->
                                let
                                    -- The operand can only share the run's last
                                    -- row when it fits on one line; a multi-line
                                    -- operand starts a row of its own and leaves
                                    -- the comments above it.
                                    withComments =
                                        glueLeadingCommentRun (isSingleLine body) lead body
                                in
                                if runStartsOnOperatorRow leading then
                                    prefixOperator op withComments

                                else
                                    -- The author put the run on a row of its own
                                    -- BELOW the operator. Hoisting its first row
                                    -- up onto the operator is not a fixed point:
                                    -- reparsed, the comment now shares the
                                    -- operator's row, is classified `RidesInline`
                                    -- there, and pulls the operand up with it —
                                    -- so the next format joins what this one
                                    -- split. Leave the operator alone on its row,
                                    -- with the run below it at the operator's own
                                    -- column — indenting it instead would push the
                                    -- operand level with the NEXT step of a `<|`
                                    -- chain and flatten the staircase
                                    -- (`BackwardPipeCommentNesting`).
                                    B.stack1 [ B.line (B.literal op), withComments ]
                            )
                )


-- True when the comment run between an operator and its operand was written on
-- the OPERATOR's row (`|> -- c`) rather than on a row below it. Only the first
-- comment of the run decides: the ones after it follow wherever it went.
runStartsOnOperatorRow : Array LPNode -> Bool
runStartsOnOperatorRow leading =
    when Array.first leading is
        Just node ->
            commentRole (lpnBox node) /= Just LeadsOwnLine

        Nothing ->
            True


-- True when this comment can share a row with code that follows it: a
-- single-line `{- … -}`. A `--` runs to end of line and a multi-line `{- … -}`
-- brings its own newlines. Unlike `commentRidesInline` this asks about the
-- comment's SHAPE, not the role it was given, so it also holds for one the
-- author put on its own row — that comment still takes the operand onto its row
-- (`<|` ⏎ `{- c -} "?"`, which is elm-format's layout too).
commentFitsOnOneLine : LPNode -> Bool
commentFitsOnOneLine node =
    when lpnBox node is
        BlockComment { loc } ->
            not (String.contains "\n" loc.value)

        _ ->
            False


-- The `|>` / `<|` leaf a pipeline step starts with. Anything else (a step whose
-- children were rewritten, a leading comment left in place) is not an operator
-- and keeps the whole child array on the flow path.
stepOperatorText : LPNode -> Maybe String
stepOperatorText node =
    when leafValue node is
        Just v ->
            if v == "|>" || v == "<|" then
                Just v

            else
                Nothing

        Nothing ->
            Nothing


stepOperandBox : Array LPNode -> Result String Box
stepOperandBox children =
    -- Render the children ONCE, up front, and drive everything below off those
    -- items: the trigger split's verticality tests, the preamble assembly
    -- (`assembleFlow True 0` IS `buildFlowBoxInline 0`), the suffix, and — for
    -- every trigger but the relocated lambda — the trigger box itself. Each of
    -- those used to re-render its own subtree.
    renderFlowItems children
        |> Result.andThen
            (\items ->
                when splitStepTriggerItems items is
                    Nothing ->
                        -- No relocatable trigger arg. There can still be a
                        -- direct-GLUED multi-line operand (`|> (\y -> …)`, kept
                        -- in the preamble on purpose so it stays on the `|>`
                        -- line) carrying further arguments after it — those obey
                        -- the same own-line rule as a relocated trigger's suffix.
                        -- Otherwise render the step body as a plain flow: it can
                        -- be multi-line for other reasons (a block comment among
                        -- the tokens, as in `|> {- … -} Array.foldl (+) 0`) with
                        -- nothing to relocate or stack.
                        when splitAfterGluedOperand items is
                            Just { glued, suffix } ->
                                assembleFlow False grenIndent glued
                                    |> Result.andThen
                                        (\gluedBox ->
                                            stepSuffixBox suffix
                                                |> Result.map
                                                    (\suffixBox ->
                                                        B.stack1 [ gluedBox, applyIndent grenIndent suffixBox ]
                                                    )
                                        )

                            Nothing ->
                                assembleFlow False grenIndent items

                    Just { preamble, trigger, suffix } ->
                        let
                            triggerBoxResult =
                                if isMultilineLambdaParenBlockBox trigger.node then
                                    makeMultilineLambdaArgBox trigger.lambdaBodyBox (lpnChildren trigger.node)

                                else
                                    -- A multi-line non-lambda paren (or a bracket
                                    -- container) relocates via its own box — which
                                    -- is exactly the box already rendered for it
                                    -- (`makeParenBlockBox`'s vertical form is
                                    -- `wrapParenVerticalPadded (buildFlowBoxInline
                                    -- 0 …)`, byte-identical to the former
                                    -- `makeMultilineParenArgBox` special case).
                                    Ok trigger.box
                        in
                        stepPreambleBox preamble
                            |> Result.andThen
                                (\preambleBox ->
                                    triggerBoxResult
                                        |> Result.andThen
                                            (\triggerBox ->
                                                if Array.isEmpty suffix then
                                                    Ok (B.stack1 [ preambleBox, applyIndent grenIndent triggerBox ])

                                                else
                                                    -- Suffix args land one per line
                                                    -- below the relocated trigger,
                                                    -- like a broken call's — see
                                                    -- `stepSuffixBox`.
                                                    stepSuffixBox suffix
                                                        |> Result.map
                                                            (\suffixBox ->
                                                                B.stack1
                                                                    [ preambleBox
                                                                    , applyIndent grenIndent triggerBox
                                                                    , applyIndent grenIndent suffixBox
                                                                    ]
                                                            )
                                            )
                                )
            )


{-| Split a trigger-less step at its first multi-line item, when that item is not
the last one: `|> (\y -> …) 5` — the paren is a direct-glued operand, so it never
becomes a trigger, but `5` still follows something that broke.

`Nothing` when nothing breaks, or when the breaking item is last (the common
case, and the layout that was always right). -}
splitAfterGluedOperand : Array FlowItem -> Maybe { glued : Array FlowItem, suffix : Array FlowItem }
splitAfterGluedOperand items =
    let
        breakIndex =
            (Array.foldl
                (\item acc ->
                    if acc.found /= -1 || isSingleLine item.box then
                        { acc | i = acc.i + 1 }

                    else
                        { i = acc.i + 1, found = acc.i }
                )
                { i = 0, found = -1 }
                items
            ).found
    in
    if breakIndex < 0 || breakIndex >= Array.length items - 1 then
        Nothing

    else
        Just
            { glued = Array.slice 0 (breakIndex + 1) items
            , suffix = Array.dropFirst (breakIndex + 1) items
            }


{-| A pipeline step's preamble — everything before its relocated trigger.

`|> fn` stays on the operator's line; any further arguments in front of the
trigger stack one per line at +4, under the same rule as the trigger's suffix and
as a plain broken call. `foo |> f z { … }` was rendering `|> f z` glued, while
the identical `f z { … }` as a plain call put `z` on its own line and elm-format
puts it on its own line in both.

One item or fewer is `|> fn` with nothing to stack (or a direct-glued operand,
`|> (\y -> …)`, which is deliberately kept on the operator's line). A preamble
carrying a comment keeps the old flow assembly untouched — comment placement in a
step is its own machinery and has nothing to gain here.

The counts are OPERANDS: the operator itself is a prefix applied by
`stepBodyBox`, not a preamble item. -}
stepPreambleBox : Array FlowItem -> Result String Box
stepPreambleBox preamble =
    if Array.isEmpty preamble then
        -- The trigger IS the first operand, so nothing shares the operator's
        -- row: `|> ` prefixes a blank line (rendered as a bare `|>`, since
        -- `render` right-trims) and the trigger drops below it at one tab stop —
        -- the same dangling-operator shape this produced when the operator was
        -- itself the preamble's only item. Reached by a bare multi-line lambda
        -- operand (`|> \d -> …`); a paren or bracket operand is excluded from
        -- the split by `isDirectGluedOperand` and stays glued instead.
        Ok B.blankLine

    else if Array.length preamble <= 1 || Array.any isCommentItem preamble then
        assembleFlow True 0 preamble

    else
        assembleFlow True 0 (Array.slice 0 1 preamble)
            |> Result.andThen
                (\headBox ->
                    stepSuffixBox (Array.dropFirst 1 preamble)
                        |> Result.map
                            (\argsBox -> B.stack1 [ headBox, applyIndent grenIndent argsBox ])
                )


{-| The arguments a pipeline step carries AFTER its relocated trigger.

`formatterRules.md` ("Pipelines"): once an argument breaks, every argument after
it lands on its own line. A plain call gets that from `assembleBrokenCall`, but a
pipeline step has no call container left to route through —
`InsertExpressions.gren` unwraps the call's `AcrossOrVertical` into the step's
children, deliberately, to avoid a second +4 — so the suffix went through the
generic flow instead, whose soft glue joins a single-line item onto the preceding
block's last line. `)` ⏎ `z` came out as `) z` and `}` ⏎ `z` as `} z`, while the
identical arguments in a plain call each got their own line. elm-format puts each
on its own line (verified via `elm-format --stdin`).

The stacking is `assembleBrokenWithComments 0` — the same broken-flow assembler a
plain call's arguments go through — so the two lay comments out identically too:
a leading `{- c -}` rides its argument's line, a trailing one glues onto the
argument before it, and a `--` stands on its own row.

One item is the common case and needs no stacking: the flow renders it exactly as
before, so the single-suffix layout is untouched. -}
stepSuffixBox : Array FlowItem -> Result String Box
stepSuffixBox suffix =
    if Array.length suffix <= 1 then
        assembleFlow False 0 suffix

    else
        assembleBrokenWithComments 0 suffix


{-| Render a backward (`<|`) pipeline: the `<|` trails the seed (or previous step
body), and the next body drops to the line below at +4 (inline when the author
kept the whole chain on one row and every part is single-line). A multi-line
seed glues its `<|` onto its own last line; a multi-line body forces the +4 drop
even when the author kept `<|` on the seed row. A lambda step body (`\x -> …`
authored across rows) breaks with the head at +4 and its body at +8. A boundary
comment or a mixed `|>`/`<|` chain routes to the operator-leading fallbacks. -}
makeBackwardPipelineBox : Bool -> Array LPNode -> Result String Box
makeBackwardPipelineBox forceVertical children =
    let
        stepNodes =
            Array.keepIf isPipelineStepNode children

        seedNodes =
            Array.keepIf (\n -> not (isPipelineStepNode n)) children

        -- A step needs the operator-LEADING commented layout when it carries a
        -- comment the flat assembler cannot place inline. Two kinds:
        --
        --   1. Its FIRST child is a comment — a genuine own-line comment BEFORE
        --      the `<|` (`foo`⏎`{- c -}`⏎`<| bar`). The flat assembler pops the
        --      first child as the operator, so a leading comment must route here.
        --   2. It contains a `--` line comment or a MULTI-LINE block comment
        --      anywhere — neither can ride a single flat line (a `--` runs to EOL,
        --      a multi-line `{- … -}` brings its own newlines).
        --
        -- A SINGLE-LINE block comment in the body (leading it right after `<|`,
        -- trailing it, or inline) is NOT a trigger: `buildBackwardBodyBox` renders
        -- the body with `inlineStart = True`, so such a comment rides the body's
        -- line, and on a multi-line body it lands own-line above the body — both
        -- fixed points under the flat layout. (The former test keyed off whether
        -- every comment shared an inline content row, which flipped to the
        -- commented path on reparse once a multi-line body pushed its leading
        -- comment own-line — reintroducing the +4 ↔ operator-leading oscillation.)
        stepNeedsCommentedLayout stepNode =
            let
                kids =
                    lpnChildren stepNode

                firstIsComment =
                    when Array.first kids is
                        Just firstChild ->
                            nodeIsComment firstChild

                        Nothing ->
                            False

                hasNonRidingComment =
                    Array.any
                        (\n ->
                            when lpnBox n is
                                SingleLineComment _ ->
                                    True

                                BlockComment { loc } ->
                                    String.contains "\n" loc.value

                                DocComment _ ->
                                    True

                                _ ->
                                    False
                        )
                        kids

                -- NOTE: `kids` is the step's DIRECT children only, so a `--`
                -- buried deeper in a composite step body would not be seen and
                -- would be swallowed by the `" <|"` suffix. Believed unreachable
                -- today: the parser left-nests `<|`, so every non-last step body
                -- is a single atom. A hazard if the grammar grows -- make this
                -- recursive (`subtreeEndsWithLineComment`-style) at that point.
            in
            firstIsComment || hasNonRidingComment

        hasBoundaryComment =
            (Array.any nodeIsComment seedNodes
                && not (literalCommentsRideFlatLine seedNodes)
            )
                || Array.any stepNeedsCommentedLayout stepNodes
                -- A `--` line comment buried at the end of the seed's own
                -- subtree (e.g. a nested binop's `"""…""" -- c` operand) is
                -- invisible to the shallow `nodeIsComment seedNodes` scan above,
                -- but the trailing-operator path would `B.addSuffix " <|"` onto
                -- the seed's `-- c` line and swallow the `<|`. Route to the
                -- comment-aware layout, which stacks `<| body` on its own line.
                || Array.any subtreeEndsWithLineComment seedNodes

        -- The operator is the first NON-comment child (a step may lead with an
        -- own-line comment before `<|`).
        stepOpIsBackward stepNode =
            when Array.first (Array.keepIf (\n -> not (nodeIsComment n)) (lpnChildren stepNode)) is
                Just opNode ->
                    leafValue opNode == Just "<|"

                Nothing ->
                    False

        allBackward =
            Array.all stepOpIsBackward stepNodes
    in
    if not allBackward then
        -- A mixed `|>`/`<|` chain (flattenPipeline merges them into one flat
        -- array tagged by the outermost op) renders operator-LEADING via the
        -- generic flow fold (`buildFlowBox 0 children`) for the same
        -- `not allStepsBackward` case.
        buildFlowBox 0 children

    else if hasBoundaryComment then
        -- A comment at a step boundary (own-line leading comment before `<|`, or a
        -- trailing comment after a step body) switches to operator-LEADING layout:
        -- seed on its own line, then each step at +4 as `<| body` with leading
        -- comments own-line above it and trailing comments glued to the body's
        -- last line.
        makeBackwardCommentedPipeline seedNodes stepNodes

    else
        buildFlowBox 0 seedNodes
            |> Result.andThen
                (\seedBox ->
                    -- The seed is kept as a Box (not collapsed to a Line): a
                    -- multi-line seed (a broken record/array/parenthesized binop)
                    -- glues ` <|` onto its LAST line via `B.addSuffix`, so the
                    -- trailing-operator style extends to a multi-line seed the
                    -- same way it works for a single-line one.
                    traverseResult
                        (\stepNode ->
                            when Array.popFirst (lpnChildren stepNode) is
                                Just { rest = bodyNodes } ->
                                    Ok bodyNodes

                                Nothing ->
                                    Err "box: backward pipeline step has no children"
                        )
                        stepNodes
                        |> Result.andThen (assembleBackwardPipeline forceVertical seedBox)
                )


{-| Render a comment-bearing backward (`<|`) pipeline in operator-LEADING layout:
the seed on its own line, then each step nested one tab stop deeper than the one
before it. A step renders as its leading comments (own line) stacked above
`<| body`, with trailing comments glued onto the body's last line.

The operator-leading style is forced by the comment — a `--` cannot have the next
step's `<|` glued after it — but the NESTING must be the same cumulative
staircase `backwardMultiStep` produces, or adding a comment anywhere in a chain
silently reflows every step below it. (It did: this path applied a uniform
`grenIndent` to every step and was not updated when `6f06b66` made the plain path
cumulative, so `a <| b <| c <| d` was a staircase until you wrote a comment in
it, then went flat.) -}
makeBackwardCommentedPipeline : Array LPNode -> Array LPNode -> Result String Box
makeBackwardCommentedPipeline seedNodes stepNodes =
    buildFlowBox 0 seedNodes
        |> Result.andThen
            (\seedBox ->
                traverseResult renderCommentedBackwardStep stepNodes
                    |> Result.map
                        (\stepBoxLists ->
                            B.stack1
                                ([ seedBox ]
                                    ++ Array.flatten
                                        (Array.indexedMap
                                            (\i boxes ->
                                                Array.map (applyIndent ((i + 1) * grenIndent)) boxes
                                            )
                                            stepBoxLists
                                        )
                                )
                        )
            )


renderCommentedBackwardStep : LPNode -> Result String (Array Box)
renderCommentedBackwardStep stepNode =
    let
        { leading, rest } =
            spanLeadingComments (lpnChildren stepNode)

        { body, trailing } =
            spanTrailingComments rest
    in
    traverseResult commentNodeBox leading
        |> Result.andThen
            (\leadingBoxes ->
                backwardStepBodyBox body
                    |> Result.andThen
                        (\bodyBox ->
                            glueTrailingComments bodyBox trailing
                                |> Result.map (\bodyWithTrailing -> leadingBoxes ++ [ bodyWithTrailing ])
                        )
            )


-- One `<| operand` line of the commented backward layout. The `<|` is a PREFIX
-- over the operand, exactly as it is for a `|>` step (`stepBodyBox`) and for a
-- binop's operator (`makeOpAndRhsBox`), so anything that drops below it lands at
-- the operand's own column rather than back at the `<|`.
backwardStepBodyBox : Array LPNode -> Result String Box
backwardStepBodyBox body =
    when Array.popFirst body is
        Just { first = opNode, rest = operandNodes } ->
            when stepOperatorText opNode is
                Just op ->
                    operatorPrefixedOperandBox (buildFlowBox grenIndent) op operandNodes

                Nothing ->
                    buildFlowBox 0 body

        Nothing ->
            buildFlowBox 0 body


assembleBackwardPipeline : Bool -> Box -> Array (Array LPNode) -> Result String Box
assembleBackwardPipeline forceVertical seedBox stepBodies =
    when stepBodies is
        [ bodyNodes ] ->
            backwardSingleStep forceVertical seedBox bodyNodes

        _ ->
            backwardMultiStep forceVertical seedBox stepBodies


-- A single `seed <| body` step. A plain body drops to +4 (or stays inline when
-- the chain isn't forced vertical) via `buildBackwardBodyBox`, which reaches
-- `assembleBrokenCall` for the layout.
--
-- The `IndentedBlock` arm below reads as the across-rows-lambda case (`\head` at
-- +4, its body at +8), but it is believed UNREACHABLE: `insertBinops` wraps every
-- multi-node step body in a `BodyBlock`, not an `IndentedBlock` (verified via
-- `--lpt` for lambdas), so the `_` arm is what actually renders a broken lambda
-- body. Kept rather than deleted because "believed unreachable" is not proven
-- unreachable; if you make it fire, the layout it produces is untested.
backwardSingleStep : Bool -> Box -> Array LPNode -> Result String Box
backwardSingleStep forceVertical seedBox bodyNodes =
    when Array.popLast bodyNodes is
        Nothing ->
            Err "box: backward pipeline empty body"

        Just { last = lastNode, initial = headNodes } ->
            when lpnBox lastNode is
                IndentedBlock ->
                    -- Lambda authored across rows: seed <| \n head+4 \n body+8.
                    Result.map2
                        (\headBox bodyBox ->
                            B.stack1
                                [ B.addSuffix (B.literal " <|") seedBox
                                , B.indent headBox
                                , applyIndent (2 * grenIndent) bodyBox
                                ]
                        )
                        (buildFlowBox 0 headNodes)
                        (buildFlowBox 0 (lpnChildren lastNode))

                _ ->
                    -- Any inline body, including an inline lambda whose body
                    -- starts on the `->` row (a `SoftIndentedBlock`): render the
                    -- whole body flow and glue it after `<| ` (or, if forced
                    -- vertical, drop it +4 under `seed <|`). Only an
                    -- across-rows lambda (`IndentedBlock`, above) needs the
                    -- head/body split.
                    buildBackwardBodyBox bodyNodes
                        |> Result.andThen
                            (\{ box = bodyBox } ->
                                -- A multi-line body drops to +4 under `seed <|`
                                -- exactly as the author-broken (`forceVertical`)
                                -- case does — elm-format breaks the pipeline the
                                -- moment the body spans rows, even when the author
                                -- kept `<|` glued to the seed row.
                                if forceVertical || not (isSingleLine bodyBox) then
                                    Ok
                                        (B.stack1
                                            [ B.addSuffix (B.literal " <|") seedBox
                                            , B.indent bodyBox
                                            ]
                                        )

                                else
                                    boxLine bodyBox
                                        |> Result.map (\bl -> B.addSuffix (B.row [ B.literal " <| ", bl ]) seedBox)
                            )


{-| Render a `<|` step body: a body that is a call with a child that renders
multi-line (e.g. a record argument) is a broken call whose arguments land at +4
under the function name — not a plain flow (which would drop them at +0).

`isBrokenCall` tells `backwardMultiStep` whether this body took that path: a
relocated call's trailing `<|` (leading into the NEXT step) belongs on its own
line at the call's own indent, not glued onto the last argument's line —
matching elm-format's break for a multi-line application. A body that stayed
on the plain-flow path (a lambda/`if`/`when` body, or anything else
`assembleFlow` already handles) keeps the trailing `<|` glued to its last
line, unaffected. -}
buildBackwardBodyBox : Array LPNode -> Result String { box : Box, isBrokenCall : Bool }
buildBackwardBodyBox bodyNodes =
    renderFlowItems bodyNodes
        |> Result.andThen
            (\allItems ->
                let
                    -- A comment LEADING the body is not the head of a call, and
                    -- `assembleBrokenCall` would treat it as one: item 0 on the
                    -- opening row, everything after it at +4. That is right for
                    -- `fn` + its arguments and wrong here — the comment's own
                    -- operand is not its argument — so the body landed one level
                    -- deeper than the identical body with no comment:
                    --
                    --     gn <|              gn <|
                    --         { a = 1            {- c -}
                    --         }                      { a = 1
                    --                                }
                    --
                    -- Peel those comments off, lay the real body out on its own,
                    -- and stack them above it at the body's own column. Note this
                    -- changes only the INDENT: the comment already occupied a row
                    -- of its own here, and still does, so the reparse sees the
                    -- same row structure and the `inlineStart` / operator-leading
                    -- oscillations guarded against below are untouched.
                    --
                    -- Only a single-line block comment can reach this point with a
                    -- leading position — `stepNeedsCommentedLayout` routes a `--`,
                    -- a multi-line `{- … -}`, and a comment before the `<|` itself
                    -- to the operator-leading path instead.
                    nLeading =
                        Array.foldl
                            (\item acc ->
                                if acc.done then
                                    acc

                                else if isCommentItem item then
                                    { acc | n = acc.n + 1 }

                                else
                                    { acc | done = True }
                            )
                            { n = 0, done = False }
                            allItems
                            |> .n

                    leading =
                        Array.takeFirst nLeading allItems

                    items =
                        Array.dropFirst nLeading allItems

                    stackLeading box =
                        if Array.isEmpty leading then
                            box

                        else
                            B.stack1
                                (Array.mapAndKeepJust (\c -> Maybe.map .box c.comment) leading
                                    ++ [ box ]
                                )
                in
                if Array.isEmpty items then
                    -- Comments and nothing else: there is no body to align to.
                    assembleFlow True 0 allItems
                        |> Result.map (\box -> { box = box, isBrokenCall = False })

                else if Array.any .isBlock items then
                    assembleBrokenCall grenIndent items
                        |> Result.map (\box -> { box = stackLeading box, isBrokenCall = True })

                else
                    -- `inlineStart = True`: the body is glued right after `<| `,
                    -- so a leading single-line block comment (`<| {- c -} body`)
                    -- stays inline instead of dropping to its own line. Rendering
                    -- it own-line (`inlineStart = False`) made an otherwise
                    -- single-line body multi-line, forcing the `<|` to break onto
                    -- the seed's continuation — which reparses (comment now on its
                    -- own row) into the operator-leading commented layout and
                    -- oscillates. This is the same "continues a line the caller
                    -- emitted" case `buildFlowBoxInline` names.
                    --
                    -- The leading comments are put back here rather than peeled:
                    -- a single-line body is exactly the case they are meant to
                    -- ride, and `assembleFlow True` is what keeps them on its row.
                    assembleFlow True 0 allItems
                        |> Result.map (\box -> { box = box, isBrokenCall = False })
            )


-- Two or more `<|` steps. Inline `seed <| b0 <| b1 …` when the author kept it on
-- one row AND every body is single-line; otherwise `seed <|` then each body at
-- +4, the `<|` trailing the previous body. A multi-line body forces the vertical
-- form (elm-format breaks the chain the moment any body spans rows), and each
-- body is kept as a Box so a multi-line one glues its trailing `<|` onto its own
-- last line via `B.addSuffix` — UNLESS that body is a relocated (broken-call)
-- shape, in which case the trailing `<|` goes on its own line at the body's own
-- indent instead of gluing to the last argument (`isBrokenCall`, matching
-- elm-format's break for a multi-line application).
backwardMultiStep : Bool -> Box -> Array (Array LPNode) -> Result String Box
backwardMultiStep forceVertical seedBox stepBodies =
    traverseResult buildBackwardBodyBox stepBodies
        |> Result.andThen
            (\bodyBoxes ->
                let
                    effectiveVertical =
                        forceVertical || Array.any (\b -> not (isSingleLine b.box)) bodyBoxes
                in
                if not effectiveVertical then
                    -- Every body is single-line here, so `boxLine` cannot fail.
                    traverseResult (\b -> boxLine b.box) bodyBoxes
                        |> Result.map
                            (\bodyLines ->
                                B.addSuffix
                                    (B.row
                                        (Array.flatten
                                            (Array.map (\bl -> [ B.literal " <| ", bl ]) bodyLines)
                                        )
                                    )
                                    seedBox
                            )

                else
                    let
                        n =
                            Array.length bodyBoxes
                    in
                    Ok
                        (B.stack1
                            ([ B.addSuffix (B.literal " <|") seedBox ]
                                ++ Array.indexedMap
                                    (\i { box = bodyBox, isBrokenCall } ->
                                        -- Each step nests one MORE tab stop than
                                        -- the previous, cumulatively — elm-format
                                        -- treats a vertical `<|` chain as nested
                                        -- applications, not a flat list of
                                        -- same-depth steps, so step i sits at
                                        -- (i+1) tab stops regardless of whether
                                        -- THAT particular step is what forced the
                                        -- chain vertical.
                                        applyIndent ((i + 1) * grenIndent)
                                            (if i < n - 1 && isBrokenCall then
                                                B.stack1 [ bodyBox, B.line (B.literal "<|") ]

                                             else if i < n - 1 then
                                                B.addSuffix (B.literal " <|") bodyBox

                                             else
                                                bodyBox
                                            )
                                    )
                                    bodyBoxes
                            )
                        )
            )


-- ═══ IF ═══


{-| Render an `if`/`else if` condition header: `if <cond> then` inline, or when
the author broke it, `if` / cond +4 / `then`. The branch bodies and `else`
keyword are siblings in the enclosing flow (an `if` is not a single node — see
the flat `IfCondition`/`IndentedBlock`/`EmptyLine`/`else` sequence), assembled
by `assembleFlow`. -}
makeIfConditionBox : Bool -> Array LPNode -> Result String Box
makeIfConditionBox forceVertical children =
    when Array.popFirst children is
        Nothing ->
            Err "box: if-condition empty"

        Just { first = ifNode, rest = afterIf } ->
            when Array.popLast afterIf is
                Nothing ->
                    Err "box: if-condition missing then"

                Just { initial = condNodes, last = thenNode } ->
                    makePBox (lpnBox ifNode) (lpnChildren ifNode)
                        |> Result.andThen
                            (\ifBox ->
                                -- Arm split: the author-broken form renders the
                                -- condition as a standalone flow; the inline form
                                -- continues the `if `-line, so a leading
                                -- single-line block comment stays inline
                                -- (`if {- c -} tertiaryBoolValue then`).
                                (if forceVertical then
                                    buildFlowBox 0 condNodes

                                 else
                                    buildFlowBoxInline 0 condNodes
                                )
                                    |> Result.andThen
                                        (\condBox ->
                                            makePBox (lpnBox thenNode) (lpnChildren thenNode)
                                                |> Result.andThen
                                                    (\thenBox ->
                                                        if forceVertical then
                                                            Ok (B.stack1 [ ifBox, B.indent condBox, thenBox ])

                                                        else
                                                            when joinInline [ ifBox, condBox, thenBox ] is
                                                                Just l ->
                                                                    Ok l

                                                                Nothing ->
                                                                    -- The condition is inherently multi-line (a
                                                                    -- record/array/string literal spanning rows)
                                                                    -- even though it starts on the same row as
                                                                    -- `if`. Fall back to the same layout used for
                                                                    -- an authored-vertical condition, which
                                                                    -- handles a multi-line condBox fine via
                                                                    -- B.indent.
                                                                    Ok (B.stack1 [ ifBox, B.indent condBox, thenBox ])
                                                    )
                                        )
                            )


-- ═══ RECORD UPDATE ═══


{-| True when a record field's value node is a hard block (`if`/`when`/`let`/
lambda body, …). A hard-block value already drops after `=` through its own
block box, so the soft-value drop rule (`dropFieldValueBoxWithBox`) never
applies to it — callers short-circuit on this before rendering the value. -}
valueNodeIsHardBlock : LPNode -> Bool
valueNodeIsHardBlock valueNode =
    when lpnBox valueNode is
        BodyBlock ->
            True

        IndentedBlock ->
            True

        SoftIndentedBlock ->
            True

        WhenBranch ->
            True

        PipelineStep ->
            True

        EmptyLine ->
            True

        _ ->
            False


{-| elm-format's `equalsPair` drop for a record field whose value is a soft
multi-line node: render `name =` on its own line and stack the value at
+grenIndent below it. The value's own box supplies its internal layout, so a
broken call `Array.map (\…) xs` becomes `name =` / `Array.map` / args.

Takes the value's *already-rendered* box: the caller renders the value exactly
once per level, using the same box for the drop decision (`isSingleLine`) and
for this layout. Re-rendering it here (as a deleted `dropFieldValueBox`
wrapper once did) made nesting depth `d` cost `O(2^d)`, the same failure class
as the historical `Box.gren` render hang.

A comment authored between `=` and the value (`name = {- c -} 31 >> 0`) is
peeled off the head (`spanTrailingComments`) and stacked on its own line
*above* the value inside the dropped block — matching elm-format:

    name =
        {- c -}
        31
            >> 0

Keeping it on the head line (`name = {- c -}`) would leave the multi-line value
to glue after it in the flow assembler, which has no rule for a raw `Binop`
sibling and crashed ("unreachable soft-glue item"). -}
dropFieldValueBoxWithBox : Array LPNode -> Box -> Result String Box
dropFieldValueBoxWithBox headNodes valueBox =
    let
        split =
            spanTrailingComments headNodes
    in
    Result.map2
        (\headBox commentBoxes ->
            B.stack1
                [ headBox
                , applyIndent grenIndent
                    (B.stack1 (Array.pushLast valueBox commentBoxes))
                ]
        )
        (buildFlowBox 0 split.body)
        (traverseResult commentNodeBox split.trailing)


{-| A record field holding a lambda that `folderInsertRecordField` decided to
keep GLUED on the `= ` line — the `IndentedBlock` container it builds in that one
branch (`{ fld = \q -> body }`). Every other field shape is a `plainAcross`
flow, so this identifies the glued-lambda case exactly.

The glue is chosen when the lambda is expected to render on one line. That
expectation is an AST-level guess (`lambdaValueNodesAreBroken || exprAlwaysBreaks`)
and it is under-approximate in both directions that matter: it cannot see a
comment (the AST has none), and it does not model an author-broken record body.
Either makes the lambda render multi-line while still glued — and the reparse
then sees the body on a later row, flips to the drop form, and the file
oscillates. `renderGluedLambdaField` settles it by observing the rendered box
instead of predicting it. -}
isGluedLambdaField : LPNode -> LPNode -> Bool
isGluedLambdaField field valueNode =
    when { f = lpnBox field, v = lpnBox valueNode } is
        { f = IndentedBlock, v = SoftIndentedBlock } ->
            True

        _ ->
            False


{-| The glued-lambda field, decided from the lambda body's OWN rendered box.

Single-line body → the lambda fits on the `= ` line, so render the field as one
flow (what `makePBox IndentedBlock` does, with the body item supplied instead of
re-derived). Multi-line body → the lambda drops whole below `field =`, which is
what this formatter does with a lambda in every other position and what
elm-format does here.

The flow's continuation indent is `grenIndent`, matching
`renderFieldFlowWithValueBox` — the field is rendered as a bracket-list ITEM, so
its own box has to carry the +4; nothing indents it from outside. (It read
`assembleFlow False 0` until 2026-08-01, copied from `makePBox`'s `IndentedBlock`
arm, where the 0 is right because there the *parent* applies the indent. A
single-line body never uses the continuation indent, so the two agreed on every
comment-free input — a comment in the head is the only thing that breaks this
flow, and it landed the lambda 2 columns left of where every other field value
goes.)

The body is rendered ONCE and the box reused down both paths. Re-rendering the
field to test it would double the cost at every nesting level — exponential in
depth, the hang that `renderRecordFieldBox`'s own doc warns about. -}
renderGluedLambdaField : Array LPNode -> LPNode -> Result String Box
renderGluedLambdaField headNodes bodyNode =
    makePBox (lpnBox bodyNode) (lpnChildren bodyNode)
        |> Result.andThen
            (\bodyBox ->
                let
                    bodyItem =
                        { node = bodyNode
                        , box = bodyBox
                        , isBlock = isBlockNode bodyNode bodyBox
                        , comment = Nothing
                        , lambdaBodyBox = Nothing
                        }
                in
                if isSingleLine bodyBox then
                    renderFlowItems headNodes
                        |> Result.andThen
                            (\headItems -> assembleFlow False grenIndent (Array.pushLast bodyItem headItems))

                else
                    -- `headNodes` is `[ name, =, lambdaHead ]`; the lambda drops as
                    -- a unit, so split the field head off and rebuild the lambda
                    -- (its own `\q ->` head plus the body) as the dropped value.
                    when Array.popLast headNodes is
                        Just { last = lambdaHead, initial = fieldHead } ->
                            renderFlowItems [ lambdaHead ]
                                |> Result.andThen
                                    (\lambdaHeadItems ->
                                        assembleFlow False 0 (Array.pushLast bodyItem lambdaHeadItems)
                                    )
                                |> Result.andThen (dropFieldValueBoxWithBox fieldHead)

                        Nothing ->
                            -- Unreachable: the container is built as
                            -- `[ name, =, lambdaHead, body ]`, so popping the body
                            -- always leaves three nodes.
                            Err "box: glued lambda field has no head"
            )


{-| Render one record `name = value` field to a box: a soft multi-line value
drops onto its own line (`dropFieldValueBoxWithBox`); everything else renders as
the plain `name = value` node. Shared by record *updates* and record *literals* —
a literal field has the same `name = value` shape, so both must apply
elm-format's `equalsPair` drop identically. (Rendering a literal field through
bare `makePBox` instead sent a multi-line soft value — e.g. a binop chain — into
the flow assembler, which has no drop rule and hit an "unreachable" arm.)

The value is rendered once (`valueNodeIsHardBlock` short-circuits before ever
rendering it) and that same box is reused for the drop decision and, however it
resolves, the final layout — see `dropFieldValueBoxWithBox` and
`renderFieldFlowWithValueBox`. Re-deriving the value's box a second time (either
here, by falling through to plain `makePBox (lpnBox field) …`, or in
`dropFieldValueBoxWithBox`) doubles the render cost at every nesting level,
which is exponential in depth — this is what made deeply nested record literals
(e.g. `{ a = { a = { a = … } } }`) hang. -}
renderRecordFieldBox : LPNode -> Result String Box
renderRecordFieldBox field =
    when Array.popLast (lpnChildren field) is
        Nothing ->
            makePBox (lpnBox field) (lpnChildren field)

        Just { last = valueNode, initial = headNodes } ->
            if isGluedLambdaField field valueNode then
                renderGluedLambdaField headNodes valueNode

            else if valueNodeIsHardBlock valueNode then
                makePBox (lpnBox field) (lpnChildren field)

            else
                makePBox (lpnBox valueNode) (lpnChildren valueNode)
                    |> Result.andThen
                        (\valueBox ->
                            if isSingleLine valueBox then
                                renderFieldFlowWithValueBox field valueNode headNodes valueBox

                            else
                                dropFieldValueBoxWithBox headNodes valueBox
                        )


{-| Render a field's `AcrossOrVertical` flow (`name = value`) reusing an
already-rendered value box for the last item, instead of `makePBox (lpnBox
field) (lpnChildren field)` — which would re-render the value from scratch via
`renderFlowItems`. Mirrors `makePBox`'s own `AcrossOrVertical` arm exactly, just
with the last flow item supplied instead of derived. -}
renderFieldFlowWithValueBox : LPNode -> LPNode -> Array LPNode -> Box -> Result String Box
renderFieldFlowWithValueBox field valueNode headNodes valueBox =
    when lpnBox field is
        AcrossOrVertical { forceVertical, checkContentVertical } ->
            renderFlowItems headNodes
                |> Result.map
                    (\headItems ->
                        Array.pushLast
                            { node = valueNode
                            , box = valueBox
                            , isBlock = isBlockNode valueNode valueBox
                            , comment = Nothing
                            , lambdaBodyBox = Nothing
                            }
                            headItems
                    )
                |> Result.andThen
                    (\items ->
                        if forceVertical || (checkContentVertical && Array.any .isBlock items) then
                            assembleBrokenCall grenIndent items

                        else
                            assembleFlow False grenIndent items
                    )

        _ ->
            -- Not a flow field — shouldn't happen for a `name = value` node,
            -- but fall back to the generic renderer rather than crash.
            makePBox (lpnBox field) (lpnChildren field)


{-| Pick the per-item renderer for a bracketed literal. A record (`ListCurly`)
renders each `name = value` field with the drop rule (`renderRecordFieldBox`);
every other bracket (array / tuple / paren) holds plain expressions, rendered
straight through `makePBox`. Used by both the comment-free (`makeLiteralBox`) and
comment-bearing (`commentBracketListBox`) literal paths so the two can't drift. -}
literalItemRenderer : ListBrackets -> (LPNode -> Result String Box)
literalItemRenderer bracket =
    when bracket is
        ListCurly ->
            renderRecordFieldBox

        _ ->
            \node -> makePBox (lpnBox node) (lpnChildren node)


{-| Render a record update `{ base | f = v, … }` via elm's `extensionGroup`.
Each field node renders to a `name = value` box; the update expands (base on its
own line, `| `/`, `-prefixed fields at +4, closing `}`) when the author broke it
across rows or any field renders multi-line — matching elm-format for
`if`/`let`/`when`/simple/multi-field cases. A lambda-valued field drops the
`\arg ->` head like elm-format. -}
makeRecordUpdateBox : String -> Bool -> Array LPNode -> Result String Box
makeRecordUpdateBox baseName forceVertical children =
    let
        { opener, baseTrail, rest } =
            splitOpenerComments children
    in
    updateBaseBox baseName opener baseTrail
        |> Result.andThen
            (\baseBox ->
                if
                    commentForcesBracketOpen forceVertical rest
                        || not (Array.isEmpty baseTrail)
                        || not (isSingleLine baseBox)
                then
                    -- A comment that can't ride the flat line forces the update
                    -- vertical: comment children render own-line at +4 (no
                    -- `| `/`, ` prefix), the actual fields keep their prefixes.
                    -- A multi-line BASE (a `--` glued to the `{`) forces it the
                    -- same way — the fields can no longer share that row.
                    --
                    -- So does a `TrailsHead` comment, which is only ever a `--` or
                    -- a multi-line `{- … -}` (a single-line one in that slot is
                    -- `LeadsNext`, rule C2). It is already glued onto `baseBox`'s
                    -- line, so no comment child is left to trip
                    -- `commentForcesBracketOpen` — and a `--` there would swallow
                    -- the whole flat form's `| a = 1 }`.
                    makeRecordUpdateVerticalBox baseBox rest

                else
                    -- No comment, or only comments that ride the flat line the
                    -- author wrote; `pairInlineComments` glues each onto the
                    -- field it trails, or (rule C2, `LeadsNext`) onto the one
                    -- after it.
                    pairInlineComments renderRecordFieldBox rest
                        |> Result.andThen
                            (\fieldBoxes ->
                                when Array.popFirst fieldBoxes is
                                    Nothing ->
                                        Ok (B.line (B.literal ("{ " ++ baseName ++ " }")))

                                    Just { first = firstField, rest = restFields } ->
                                        let
                                            contentVertical =
                                                Array.any (\b -> not (isSingleLine b)) fieldBoxes
                                        in
                                        Ok
                                            (E.extensionGroup
                                                (forceVertical || contentVertical)
                                                baseBox
                                                firstField
                                                restFields
                                            )
                            )
            )


{-| Split a record update's children into the comments that belong to its base
name and everything else.

Two slots sit around the base, and the stored role tells them apart with no
row-reading here:

  - **`opener`** — written between the `{` and the base name
    (`{ {- c -} rec | a = 1 }`). Everything in the leading comment run whose role
    is none of the three below; glued in FRONT of the base.
  - **`baseTrail`** — `TrailsHead`, written after the base on its row
    (`{ rec -- c` ⏎ `| a = 1 }`). Glued onto the END of the base's line.

The rest of the leading run is not the base's: `LeadsNext` is a comment rule C2
hands to the field after the unrecorded `|`, and `LeadsOwnLine` one the author
put on a row of its own. Both render among the fields. -}
splitOpenerComments : Array LPNode -> { opener : Array LPNode, baseTrail : Array LPNode, rest : Array LPNode }
splitOpenerComments children =
    let
        n =
            (Array.foldl
                (\node acc ->
                    if acc.stopped then
                        acc

                    else if nodeIsComment node && not (commentLeadsOwnLine node) && not (commentLeadsNext node) then
                        { acc | i = acc.i + 1 }

                    else
                        { acc | stopped = True }
                )
                { i = 0, stopped = False }
                children
            ).i

        run =
            Array.slice 0 n children
    in
    { opener = Array.keepIf (\node -> not (commentTrailsHead node)) run
    , baseTrail = Array.keepIf commentTrailsHead run
    , rest = Array.dropFirst n children
    }


commentTrailsHead : LPNode -> Bool
commentTrailsHead node =
    commentRole (lpnBox node) == Just TrailsHead


commentLeadsOwnLine : LPNode -> Bool
commentLeadsOwnLine node =
    commentRole (lpnBox node) == Just LeadsOwnLine


commentLeadsNext : LPNode -> Bool
commentLeadsNext node =
    commentRole (lpnBox node) == Just LeadsNext


-- `{ base`, with any opener comments glued in front of the base name the way
-- `[ {- c -} 1` glues them in front of a list's first item — same helper, same
-- all-or-nothing run rule — and any `TrailsHead` comment glued onto the end of
-- its line, the way one glues onto the item it trails. The `{ ` itself is
-- supplied by the caller.
updateBaseBox : String -> Array LPNode -> Array LPNode -> Result String Box
updateBaseBox baseName opener baseTrail =
    let
        headBox =
            if Array.isEmpty opener then
                Ok (B.line (B.literal baseName))

            else
                leadCommentRunBoxes opener
                    |> Result.map
                        (\lead -> glueLeadingCommentRun True lead (B.line (B.literal baseName)))
    in
    Array.foldl
        (\node acc ->
            acc
                |> Result.andThen
                    (\box ->
                        commentNodeBox node
                            |> Result.map (\cbox -> glueCommentSuffix cbox box)
                    )
        )
        headBox
        baseTrail


{-| Render a run of comments that leads the box after it, as the
`{ box, inline }` pairs `glueLeadingCommentRun` consumes. `inline` is the
comment's own shape (`commentTextCanRide`) — whether it belongs in front of what
follows is already settled by its `CommentRole`, so all that is left to ask here
is whether it fits on a row. -}
leadCommentRunBoxes : Array LPNode -> Result String (Array { box : Box, inline : Bool })
leadCommentRunBoxes nodes =
    traverseResult
        (\node ->
            commentNodeBox node
                |> Result.map (\box -> { box = box, inline = commentTextCanRide node })
        )
        nodes


makeRecordUpdateVerticalBox : Box -> Array LPNode -> Result String Box
makeRecordUpdateVerticalBox baseBox children =
    let
        step node accResult =
            accResult
                |> Result.andThen
                    (\acc ->
                        if nodeIsComment node then
                            -- Same-row (role `TrailsPrevious`/`RidesInline`): glue
                            -- onto the preceding FIELD's box — but only a real
                            -- field, never a preceding comment (`acc.lastWasField`
                            -- mirrors `commentBracketListBox`'s `pending`, which
                            -- resets to Nothing after placing a comment: two
                            -- RidesInline comments in a row, e.g. flanking `|`,
                            -- each stand on their own line rather than chaining
                            -- onto each other — only `makeUnionBodyVerticalBox`'s
                            -- simpler always-glue-onto-last approach would merge
                            -- them). Own row (`LeadsOwnLine`): stands on its own
                            -- line regardless. Before this fix every comment here
                            -- landed on its own line unconditionally, disagreeing
                            -- with the role `Comments.gren` had already assigned
                            -- and oscillating once the update was reformatted
                            -- across rows.
                            commentNodeBox node
                                |> Result.map
                                    (\cbox ->
                                        if commentLeadsNext node then
                                            -- Rule C2: written across the unrecorded
                                            -- `|` (or a `,` between fields), so it
                                            -- belongs to the field AFTER it. Held in
                                            -- `lead` until that field renders, where
                                            -- gluing it on before the `| `/`, `
                                            -- prefix puts it after the separator and
                                            -- pads whatever drops below by the
                                            -- prefix's width — `| -- c` ⏎ `  a = 1`.
                                            { acc
                                                | lead = Array.pushLast { box = cbox, inline = commentTextCanRide node } acc.lead
                                                , lastWasField = False
                                            }

                                        else if commentTrailsRole node && acc.lastWasField then
                                            when Array.popLast acc.lines is
                                                Just { last = lastBox, initial } ->
                                                    { acc | lines = Array.pushLast (glueCommentSuffix cbox lastBox) initial, lastWasField = False }

                                                Nothing ->
                                                    { acc | lines = [ cbox ], lastWasField = False }

                                        else
                                            { acc | lines = Array.pushLast cbox acc.lines, lastWasField = False }
                                    )

                        else
                            -- Build the field's `name = value` box exactly as the
                            -- non-comment path does (`renderRecordFieldBox`: a soft
                            -- broken-call/binop value drops via
                            -- `dropFieldValueBoxWithBox` — peeling a leading comment
                            -- onto its own line above the value, since the flow
                            -- assembler has no rule for a raw multi-line `Binop`
                            -- sibling and crashed ("unreachable soft-glue item") —
                            -- everything else — single-line, `if`/`let`/`when`, or a
                            -- lambda whose `\arg ->` head drops — renders via
                            -- `makePBox`). The one exception is a comment WITHIN the
                            -- field (`gamma = {- c -} 3`) whose value renders
                            -- single-line: `makePBox` can't place it, so that value
                            -- flows through `buildFlowBox`, which drops it below
                            -- `= `. Either way the resulting box has the
                            -- `name =`-headed shape that the `| `/`, ` prefix pads
                            -- correctly, so no field value is unrenderable here.
                            --
                            -- The branching mirrors `renderRecordFieldBox`'s
                            -- single-render rule: the value is rendered ONCE and that
                            -- box serves both the drop decision (`isSingleLine`) and
                            -- the drop layout. Deciding via a separate render (the
                            -- old `recordFieldValueDrops` call) and then re-rendering
                            -- made nesting depth `d` cost O(2^d) — the same failure
                            -- class as the nested record-literal hang.
                            let
                                fieldFlowIndent =
                                    when lpnBox node is
                                        IndentedBlock ->
                                            0

                                        _ ->
                                            grenIndent

                                fieldBoxResult =
                                    when Array.popLast (lpnChildren node) is
                                        Nothing ->
                                            makePBox (lpnBox node) (lpnChildren node)

                                        Just { last = valueNode, initial = headNodes } ->
                                            if valueNodeIsHardBlock valueNode then
                                                if fieldValueDropsToOwnLine node then
                                                    buildFlowBox fieldFlowIndent (lpnChildren node)

                                                else
                                                    makePBox (lpnBox node) (lpnChildren node)

                                            else
                                                makePBox (lpnBox valueNode) (lpnChildren valueNode)
                                                    |> Result.andThen
                                                        (\valueBox ->
                                                            if not (isSingleLine valueBox) then
                                                                dropFieldValueBoxWithBox headNodes valueBox

                                                            else if fieldValueDropsToOwnLine node then
                                                                buildFlowBox fieldFlowIndent (lpnChildren node)

                                                            else
                                                                renderFieldFlowWithValueBox node valueNode headNodes valueBox
                                                        )
                            in
                            fieldBoxResult
                                |> Result.map
                                    (\fieldBox ->
                                        let
                                            pref =
                                                if acc.seenField then
                                                    B.row [ B.punc ",", B.space ]

                                                else
                                                    B.row [ B.punc "|", B.space ]
                                        in
                                        { lines = Array.pushLast (B.prefix pref (glueLeadingCommentRun True acc.lead fieldBox)) acc.lines
                                        , seenField = True
                                        , lastWasField = True
                                        , lead = []
                                        }
                                    )
                    )
    in
    Array.foldl step (Ok { lines = [], seenField = False, lastWasField = False, lead = [] }) children
        |> Result.map
            (\acc ->
                B.stack1
                    [ B.prefix (B.row [ B.punc "{", B.space ]) baseBox
                    -- A `lead` run with no field left to lead cannot arise from
                    -- the classifier (it only assigns `LeadsNext` when an item
                    -- follows), but dropping it would silently delete a comment,
                    -- so it falls back to its own line.
                    , B.indent (B.stack1 (acc.lines ++ Array.map .box acc.lead))
                    , B.line (B.punc "}")
                    ]
            )


-- ═══ WHEN ═══


{-| Render a `when … is` expression. Header `when <subject> is` stays inline
unless the author broke it across rows (then `when` / subject +4 / `is`); each
branch sits at +4 (`branchNest`), blank-line separated (elm-format). -}
makeWhenFlowBox : Bool -> Array LPNode -> Result String Box
makeWhenFlowBox forceVertical children =
    when Array.popLast children is
        Nothing ->
            Err "box: when has no children"

        Just { last = branchesBlock, initial = withoutBranches } ->
            when Array.popLast withoutBranches is
                Nothing ->
                    Err "box: when missing is"

                Just { initial = headerNodes } ->
                    when Array.popFirst headerNodes is
                        Nothing ->
                            Err "box: when missing when"

                        Just { rest = scrutineeNodes } ->
                            let
                                headerResult =
                                    if forceVertical then
                                        buildFlowBox 0 scrutineeNodes
                                            |> Result.map
                                                (\scrut ->
                                                    B.stack1
                                                        [ B.line (B.keyword "when")
                                                        , B.indent scrut
                                                        , B.line (B.keyword "is")
                                                        ]
                                                )

                                    else
                                        buildFlowBox 0 withoutBranches

                                branchesResult =
                                    renderWhenBranchesBox (lpnChildren branchesBlock)
                            in
                            Result.map2
                                (\hdr brs -> B.stack1 [ hdr, B.indent brs ])
                                headerResult
                                branchesResult


{-| One `when` branch: `<pattern> ->` then the body indented +4. -}
makeWhenBranchBox : Array LPNode -> Result String Box
makeWhenBranchBox children =
    when Array.popFirst children is
        Just { first = patNode, rest = afterPat } ->
            when afterPat is
                [ bodyNode ] ->
                    Result.map2
                        (\patBox bodyBox -> B.stack1 [ patBox, B.indent bodyBox ])
                        (makePBox (lpnBox patNode) (lpnChildren patNode))
                        (makePBox (lpnBox bodyNode) (lpnChildren bodyNode))

                _ ->
                    -- unreachable: a WhenBranch node is always built with exactly
                    -- two children (pattern, body) by folderInsertWhenBranch.
                    Err "unreachable: when-branch shape"

        Nothing ->
            Err "box: empty when-branch"


{-| A `when` branch pattern, rendered as `<pattern> ->`. A multi-line pattern (a
record/array pattern the author spread across rows) gets ` ->` appended to its
last line via `B.addSuffix`, which appends to the last line for single- and
multi-line boxes alike. -}
makeWhenBranchPatternBox : Array LPNode -> Result String Box
makeWhenBranchPatternBox children =
    buildFlowBox grenIndent children
        |> Result.map (\box -> B.addSuffix (B.literal " ->") box)


{-| Render a `when`'s branch block — the `WhenBranch` children stacked with a
blank line between each. A comment sibling that trails the previous branch's last
line (same source row) is appended onto it via `B.addSuffix`. A comment on its
own row LEADS the following branch: it is held in `pending` and stacked directly
above that branch (no blank line between comment and its pattern), matching
elm-format. Single-line and multi-line block comments alike are supported (the
latter via `commentNodeBox`'s reindent stack). A same-row multi-line comment
(can't glue onto a last line), or a comment after the last branch (no branch to
lead), still fall back. -}
renderWhenBranchesBox : Array LPNode -> Result String Box
renderWhenBranchesBox children =
    let
        handleComment acc node =
            -- Trails the previous branch on its last line when the classifier
            -- tagged it `TrailsPrevious`/`RidesInline` — but only while not
            -- already accumulating own-line comments that LEAD the next branch
            -- (`pending`), so a same-row run leading a branch stays together
            -- rather than the second gluing back onto the previous branch.
            if commentTrailsRole node && not (Array.isEmpty acc.boxes) && Array.isEmpty acc.pending then
                commentNodeBox node
                    |> Result.andThen
                        (\cbox ->
                            when Array.popLast acc.boxes is
                                Just { last = lastBox, initial } ->
                                    Ok
                                        { acc | boxes = Array.pushLast (glueCommentSuffix cbox lastBox) initial }

                                Nothing ->
                                    -- unreachable: guarded by `not (Array.isEmpty acc.boxes)`.
                                    Err "unreachable: comment before first when-branch"
                        )

            else
                -- Own line: this comment leads the next branch.
                commentNodeBox node
                    |> Result.map (\cbox -> { acc | pending = Array.pushLast cbox acc.pending })
    in
    Array.foldl
        (\child accResult ->
            accResult
                |> Result.andThen
                    (\acc ->
                        when lpnBox child is
                            WhenBranch ->
                                makeWhenBranchBox (lpnChildren child)
                                    |> Result.map
                                        (\bx ->
                                            let
                                                combined =
                                                    if Array.isEmpty acc.pending then
                                                        bx

                                                    else
                                                        B.stack1 (Array.pushLast bx acc.pending)
                                            in
                                            { boxes = Array.pushLast combined acc.boxes, pending = [] }
                                        )

                            SingleLineComment _ ->
                                handleComment acc child

                            BlockComment _ ->
                                handleComment acc child

                            EmptyLine ->
                                -- The blank-line marker that precedes an own-line
                                -- comment leading the next branch ([WB, EmptyLine,
                                -- comment, WB]). The one blank line between branch
                                -- boxes is supplied by `stackWithBlanks`, so the
                                -- marker is a no-op here. `lastRow` resets so
                                -- nothing glues across the blank. Any other
                                -- position (leading, or after a pending comment)
                                -- falls back.
                                if Array.isEmpty acc.pending && not (Array.isEmpty acc.boxes) then
                                    Ok acc

                                else
                                    Err "box: unexpected blank line among when-branches"

                            _ ->
                                Err "box: unexpected node among when-branches"
                    )
        )
        (Ok { boxes = [], pending = [] })
        children
        |> Result.andThen
            (\acc ->
                if not (Array.isEmpty acc.pending) then
                    -- unreachable: `pending` holds own-line comments that LEAD the
                    -- next branch, and is drained by each `WhenBranch`. A comment
                    -- after the LAST branch never lands in the when's branch
                    -- children — Comments.gren attaches a trailing own-line comment
                    -- as a following sibling `OriginalRows`, outside the `WhenFlow`
                    -- — so `pending` is always empty here.
                    Err "unreachable: comment left pending after the last when-branch"

                else
                    when Array.popFirst acc.boxes is
                        Nothing ->
                            Err "box: when has no branches"

                        Just _ ->
                            Ok (stackWithBlanks acc.boxes)
            )


-- ═══ SIGNATURES ═══


{-| True when a signature segment contains a multi-line type record in a
non-head position — the type-record drop will fire inside it, so the whole
signature must commit to the broken layout. Verticality comes from this
renderer's own box (`isSingleLine`; an unrenderable node counts as not-forcing,
i.e. `Err -> False`). The head position (`i == 0`) is included only when
`includeHead` is `True` — a multi-segment type already gets head-position
coverage from `signatureForceVertical` (the row-break-between-segments check),
but a single-segment type (no `->` at all) has no such fallback, so its sole
segment must be checked at `i == 0` too. -}
segmentHasDroppingRecordBox : Bool -> Array LPNode -> Bool
segmentHasDroppingRecordBox includeHead segment =
    segment
        |> Array.indexedMap (\i n -> { i = i, n = n })
        |> Array.any
            (\{ i, n } ->
                (i > 0 || includeHead)
                    && isDroppingSignatureRecordNode n
                    && (when makePBox (lpnBox n) (lpnChildren n) is
                            Ok b ->
                                not (isSingleLine b)

                            Err _ ->
                                False
                       )
            )


{-| Render a function/port signature. Inline (header + type on one line) when the
author kept it on one line; header on line 1 with one `->` segment per line at +4
when the author broke it at an arrow boundary. The header and each segment render
via `buildFlowBox 0`, so nested types (records, parens, function types) are
handled — anything `buildFlowBox` can't render Errs.

Comments: an inline signature that carries a comment renders via the
comment-aware flow (`buildFlowBox grenIndent`), NOT a flat group — a comment's
break points have no stable inline anchor (elm-format). A signature the author
broke at a `->` renders per-segment either way, and `buildFlowBox` places the
segment's inline comments. -}
makeSignatureBox : Array LPNode -> Result String Box
makeSignatureBox children =
    let
        colonSplit =
            Array.foldl
                (\node acc ->
                    if acc.afterColon then
                        { acc | typeNodes = Array.pushLast node acc.typeNodes }

                    else if isColonLeaf node then
                        { acc | header = Array.pushLast node acc.header, afterColon = True }

                    else
                        { acc | header = Array.pushLast node acc.header }
                )
                { header = [], typeNodes = [], afterColon = False }
                children
    in
    if not colonSplit.afterColon then
        Err "box: signature has no colon"

    else
        let
            segments =
                splitSignatureSegments colonSplit.typeNodes

            hasComment =
                Array.any subtreeHasComment children

            -- A multi-segment type whose segment carries a dropping record
            -- commits to the fully-broken layout up front
            -- (`segmentHasDroppingRecordBox`), so the drop's extra rows can't
            -- flip the boundary-break decision on reparse (the idempotency
            -- fixed-point rule). The head position (`i == 0`) is checked too
            -- (`includeHead = True`): a multi-line record can sit at the head of
            -- a segment while the `->` stays on the record's closing `}` line
            -- (`{ a : Int, b : Msg } -> X` written with the record broken but
            -- the arrow un-broken). Then no `->`-boundary row break exists for
            -- `signatureForceVertical` to see, yet elm-format still commits the
            -- whole signature to the broken layout (record stays broken, `-> X`
            -- drops to its own line). Without the head check the flow renders
            -- multi-line while `forceVertical` is `False`, hitting the
            -- "inline signature segment unexpectedly broke" Err. Gated on
            -- `not hasComment` because a comment-bearing type already has its
            -- own dedicated handling below (the `hasComment &&
            -- typeHasCommentBracket` branch / the generic comment flow), which
            -- must run instead of being preempted here.
            forceVertical =
                signatureForceVertical segments
                    || (not hasComment
                            && Array.any (segmentHasDroppingRecordBox True) segments
                       )
        in
        if not forceVertical && hasComment && Array.any typeHasCommentBracket colonSplit.typeNodes then
            -- A comment INSIDE a record/bracket type (`foo : { a : Int {- c -} }`)
            -- renders that type multi-line. elm-format keeps it glued inline after
            -- `:` (its `}` aligns under the `{`). When the whole type is exactly
            -- that one record/bracket node, `B.prefix` glues it after the header
            -- and pads its continuation by the header's width — so the record's
            -- alignment holds and `}` lands under `{`. A multi-node type
            -- (`{ … } -> …`) goes through the generic comment-flow path below
            -- (see the `_` arm).
            when colonSplit.typeNodes is
                [ single ] ->
                    buildFlowBox 0 colonSplit.header
                        |> Result.andThen
                            (\headerBox ->
                                when B.isLine headerBox is
                                    Ok headerLine ->
                                        buildFlowBox 0 colonSplit.typeNodes
                                            |> Result.map
                                                (\typeBox ->
                                                    -- A multi-line type RECORD drops below the
                                                    -- header at +4 — elm-format drops every
                                                    -- multi-line record type below its head/`:`.
                                                    -- Other bracket types (parens, extensible
                                                    -- records) keep the inline glue.
                                                    if FP.isTypeRecordLiteral single && not (isSingleLine typeBox) then
                                                        B.stack1 [ B.line headerLine, B.indent typeBox ]

                                                    else
                                                        B.prefix (B.row [ headerLine, B.space ]) typeBox
                                                )

                                    Err _ ->
                                        -- unreachable: colonSplit.header is always
                                        -- exactly [name, colon], two single-row
                                        -- leaves, so buildFlowBox can never return
                                        -- a multi-line headerBox here.
                                        Err "unreachable: multi-line signature header"
                            )

                _ ->
                    buildFlowBox grenIndent children

        else if
            -- A multi-node comment-bearing type (`{ … } -> …`) renders
            -- via the same generic comment-flow the `else if …
            -- hasComment` arm below uses (`buildFlowBox grenIndent`).
            -- (This was previously an `Err`; the earlier "breaks
            -- idempotency" concern was about a *different*, reverted
            -- layout, not this one — the shipped output here is a proven
            -- fixed point.)
            not forceVertical && hasComment
        then
            -- Inline signature carrying a comment: render via the comment-aware
            -- flow (`buildFlowBox grenIndent`), NOT a flat group, because a
            -- comment's break points have no stable inline anchor (elm-format);
            -- a `--`/own-line comment that forces a continuation is indented +4
            -- by `assembleFlow`.
            buildFlowBox grenIndent children

        else if not forceVertical then
            -- Inline, no comment: the whole signature on one line (one flow over
            -- all children). elm-format flattens a segment the author broke
            -- inside a record type or parens (a break not at a `->` boundary)
            -- back onto the line; Box has no flatten, so if the flow comes back
            -- multi-line we Err rather than emit the (wrong) broken form.
            buildFlowBox 0 children
                |> Result.andThen
                    (\box ->
                        when B.isLine box is
                            Ok _ ->
                                Ok box

                            Err _ ->
                                Err "box: inline signature segment unexpectedly broke across lines"
                    )

        else
            -- Author broke at a `->`: header on line 1, one segment per line at
            -- +4. `buildFlowBox 0` renders each segment, placing any inline
            -- comment it carries.
            buildFlowBox 0 colonSplit.header
                |> Result.andThen
                    (\headerBox ->
                        traverseResult (buildFlowBox 0) segments
                            |> Result.map
                                (\segBoxes ->
                                    B.stack1 ([ headerBox ] ++ Array.map B.indent segBoxes)
                                )
                    )


{-| Render a `module …` / `import …` line. When it ends in an `exposing ( … )`
list and the header before the list is all plain leaf tokens, render the list as
a coupled all-or-nothing group; otherwise (a `(..)` wildcard, an effect-module
`where` block, a comment in the header) fall back to the generic flow.

For BOTH `module` and `import` lines, `exposing` stays glued to the header even
when the list goes vertical (list indented +4). gren-format deliberately does
not drop an import's `exposing` to its own line the way elm-format does. -}
makeExposingLineBox : SyntaxType -> Array LPNode -> Result String Box
makeExposingLineBox stype children =
    when Array.popLast children is
        Just { last = lastNode, initial = headerNodes } ->
            let
                -- The exposing list's author-layout decision is carried by its
                -- box type: `AllAcrossOrAllVertical ListParen` = written inline,
                -- `AlwaysVertical ListParen` = across rows. Anything else means
                -- the last node isn't a paren list (`(..)` wildcard, etc.).
                exposingForceVertical =
                    when lpnBox lastNode is
                        AllAcrossOrAllVertical ListParen ->
                            Just False

                        AlwaysVertical ListParen ->
                            Just True

                        _ ->
                            Nothing

                headerAllLeaves =
                    Array.all (\n -> leafValue n /= Nothing) headerNodes

                -- An effect module's `where { … }` block is a non-leaf header
                -- node, so `headerAllLeaves` is False and the plain leaf-line
                -- header doesn't apply; flow it instead. A header comment also
                -- trips `headerAllLeaves`, but its placement is owned by the flow
                -- path, so it stays there (below).
                headerHasComment =
                    Array.any nodeIsComment headerNodes

                -- A header comment the author wrote on the header's own row
                -- (`module M exposing {- c -}`, `module {- c -} M exposing`) is
                -- rendered by the flow *within* the header line and does not
                -- stop the coupled layout — only an OWN-LINE one does, since
                -- that has to sit between the header and the `(` at +4, which
                -- is the `SortSymbols` hoist's shape (handled below).
                headerHasOwnLineComment =
                    Array.any (\n -> commentRole (lpnBox n) == Just LeadsOwnLine) headerNodes

                headerBoxResult =
                    if headerAllLeaves then
                        Ok (B.line (leafLineRow headerNodes))

                    else
                        buildFlowBox grenIndent headerNodes
            in
            when exposingForceVertical is
                Just forceVertical ->
                    let
                        listChildren =
                            lpnChildren lastNode

                        -- Only a comment that can't ride the flat line forces
                        -- the list vertical; a short `{- … -}` beside a name
                        -- stays on the line the author wrote, which is what
                        -- elm-format does here too.
                        commentForcesOpen =
                            commentForcesBracketOpen forceVertical listChildren

                        -- The list renders vertical either because the author
                        -- wrote it that way or because a comment forces it open.
                        -- Both erase the same reparse evidence when the fallback
                        -- glues the list onto the header row, so both must keep
                        -- the coupled layout.
                        effectiveFV =
                            forceVertical || commentForcesOpen

                        -- The `( … )` comment form is structurally the same
                        -- always-vertical list as a curly/square literal, so
                        -- reuse `commentBracketListBox` with `ListParen` (its
                        -- `( `/`, `/`)` prefixes match `listBoxesWithBrackets`).
                        listBoxResult =
                            if commentForcesOpen then
                                commentBracketListBox ListParen listChildren

                            else
                                makeExposingListBox forceVertical listChildren
                    in
                    if not (Array.isEmpty headerNodes) && (not headerHasComment || (not headerHasOwnLineComment && effectiveFV)) then
                        -- A header comment normally routes the whole line
                        -- through the generic flow, which glues the list's box
                        -- onto the header line so the FIRST ITEM lands on the
                        -- header's own row. For a vertical list that erases the
                        -- only evidence a reparse has that the author wrote it
                        -- vertical — decisively so for a ONE-item list, which
                        -- then has no item below the header and no second item
                        -- to compare against (see
                        -- `MakeLogical.exposedStartsBelowHeader`). The derived
                        -- `)` collapses back onto the header row and a comment
                        -- pinned above it escapes: non-idempotent, found by
                        -- `fuzz-idempotency.py` inserting a comment into a
                        -- header gap. So an inline header comment keeps the
                        -- coupled layout (header line, list at +4) — the flow
                        -- still renders the comment inside the header line, and
                        -- `gluedExposingBox` falls back on its own if that came
                        -- out multi-line. A FLAT list has no such evidence to
                        -- lose, so it stays on the old path.
                        --
                        -- Both `module` and `import` keep `exposing` glued to
                        -- the header (list at +4); gren-format does not drop an
                        -- import's `exposing` to its own line the way elm-format
                        -- does.
                        headerBoxResult
                            |> Result.andThen
                                (\headerBox ->
                                    listBoxResult
                                        |> Result.andThen
                                            (\listBox ->
                                                gluedExposingBox effectiveFV headerBox listBox
                                            )
                                )
                            -- A header that rendered multi-line (a broken
                            -- effect-module `where` block) can't take the
                            -- coupled path; fall back to the generic flow.
                            |> Result.onError (\_ -> exposingLineFallback children)

                    else
                        -- A comment sits between the leaf header (`… exposing`)
                        -- and the list — the `SortSymbols` hoist puts a comment
                        -- whose exposed name sorted to first place here (out of
                        -- the bracket, since the parser never keeps a pre-first-
                        -- item comment inside). Render the comment(s) on their
                        -- own line(s) at +4, list below at +4, matching the
                        -- bracket-first-child form the sort produced pre-hoist so
                        -- the two are byte-identical.
                        when spanTrailingOwnLineComments headerNodes is
                            { body = leafHeader, trailing = leadComments } ->
                                if not (Array.isEmpty leadComments) && not (Array.isEmpty leafHeader) then
                                    let
                                        -- The header body may itself carry an INLINE
                                        -- comment among its leaf tokens (`module
                                        -- {- x -} Foo exposing`), which is not a
                                        -- leaf — flow it, exactly as the coupled
                                        -- branch above does. This shape needs the
                                        -- header on ONE row (own-line comments at +4
                                        -- beneath it, list at +4 below those), so
                                        -- apply the same single-line test
                                        -- `gluedExposingBox` applies and fall back to
                                        -- the generic flow only if it fails.
                                        hoistHeaderBoxResult =
                                            if Array.all (\n -> leafValue n /= Nothing) leafHeader then
                                                Ok (B.line (leafLineRow leafHeader))

                                            else
                                                buildFlowBox grenIndent leafHeader
                                                    |> Result.andThen
                                                        (\hb ->
                                                            when B.isLine hb is
                                                                Ok headerLine ->
                                                                    Ok (B.line headerLine)

                                                                Err _ ->
                                                                    Err "box: exposing header rendered multi-line"
                                                        )
                                    in
                                    when hoistHeaderBoxResult is
                                        Err _ ->
                                            exposingLineFallback children

                                        Ok headerBox ->
                                            listBoxResult
                                                |> Result.andThen
                                                    (\listBox ->
                                                        traverseResult commentNodeBox leadComments
                                                            |> Result.map
                                                                (\commentBoxes ->
                                                                    B.stack1
                                                                        ([ headerBox ]
                                                                            ++ Array.map B.indent commentBoxes
                                                                            ++ [ B.indent listBox ]
                                                                        )
                                                                )
                                                    )

                                else
                                    exposingLineFallback children

                Nothing ->
                    exposingLineFallback children

        Nothing ->
            exposingLineFallback children


-- The fallback path for a module/import line that isn't a plain leaf-header +
-- paren-list (a `(..)` wildcard, an effect-module `where` block, or a
-- comment-bearing header): renders via the comment-aware flow
-- (`buildFlowBox grenIndent`). A header the author broke across rows (a `--` line
-- comment before the list, a multi-line `{- -}`, or an effect-module `where`
-- block that wraps) indents its continuation +4, which `assembleFlow` does for
-- an inline item on a fresh line after a comment/break.
exposingLineFallback : Array LPNode -> Result String Box
exposingLineFallback children =
    buildFlowBox grenIndent children


{-| Render an exposing list's `( … )` body (no leading glue). Items are the
already-sorted exposed names (leaves). Inline: `(a, b, c)`. Vertical:

    ( a
    , b
    )

The comment-free exposing-list path. -}
makeExposingListBox : Bool -> Array LPNode -> Result String Box
makeExposingListBox forceVertical children =
    pairInlineComments (\n -> makePBox (lpnBox n) (lpnChildren n)) children
        |> Result.andThen
            (\itemBoxes ->
                when B.allSingles itemBoxes is
                    Err _ ->
                        -- unreachable: every exposed item is built as a single
                        -- UnbreakableText leaf (MakeLogical.gren's processExposed),
                        -- and the only comment `pairInlineComments` can glue on
                        -- here is a single-line one, so itemBoxes are always
                        -- single-line and B.allSingles can never fail.
                        Err "unreachable: multi-line exposing item"

                    Ok itemLines ->
                        if Array.isEmpty itemLines then
                            Ok (B.line (B.punc "()"))

                        else if forceVertical then
                            Ok (verticalExposingBox itemLines)

                        else
                            Ok
                                (B.line
                                    (B.row
                                        ([ B.punc "(" ]
                                            ++ Array.intersperse (B.row [ B.punc ",", B.space ]) itemLines
                                            ++ [ B.punc ")" ]
                                        )
                                    )
                                )
            )


{-| Render one LPT box to a Box. Err for unported constructs. -}
makePBox : LPBox -> Array LPNode -> Result String Box
makePBox box children =
    when box is
        UnbreakableText locs ->
            Ok (B.line (B.literal locs.value))

        SynthesizedText s ->
            Ok (B.line (B.literal s))

        AcrossOrVertical { forceVertical, checkContentVertical } ->
            renderFlowItems children
                |> Result.andThen
                    (\items ->
                        if
                            forceVertical
                                -- `forceVertical` came from the AST's source rows,
                                -- which cannot see a comment. A comment that pushes
                                -- a later item onto a new row makes the reparse
                                -- read this call as broken, so commit to broken now
                                -- rather than flip on the second format.
                                --
                                -- Behind `checkContentVertical` for the reason that
                                -- flag exists: `AcrossOrVertical` is also a decl /
                                -- lambda HEAD (`decl x =`, `\q ->`), where the
                                -- trailing `=` / `->` must stay glued to the last
                                -- item and must not be pushed onto its own line
                                -- just because an earlier item broke the row.
                                || (checkContentVertical
                                        && (Array.any .isBlock items || commentBreaksFlowRow children)
                                   )
                        then
                            -- A function application that must break: elm-format's
                            -- `ElmStructure.application`.
                            assembleBrokenCall grenIndent items

                        else
                            assembleFlow False grenIndent items
                    )

        BodyBlock ->
            buildFlowBox 0 children

        IndentedBlock ->
            buildFlowBox 0 children

        SoftIndentedBlock ->
            -- A lambda body: rendered inline when single-line, dropped +4 when
            -- multi-line — the enclosing flow decides, via isBlockNode.
            buildFlowBox 0 children

        PrefixGlue prefix ->
            -- Glue a prefix onto its inner with no space: `\x`/`\[ … ]` (lambda
            -- args), `-x` (unary negation). `B.prefix` prepends the prefix to the
            -- inner's first line AND pads every continuation line by the prefix's
            -- width — matching the alignment the inner (a multi-line array/record
            -- pattern) carries, so a lambda whose arg pattern spans rows
            -- (`\[ a {- c -}\n, b\n] -> …`) aligns under the opening bracket.
            -- `buildFlowBoxInline` keeps a leading comment in the inner on-line.
            buildFlowBoxInline 0 children
                |> Result.map (\inner -> B.prefix (B.literal (prefixGlyph prefix.value)) inner)

        AllAcrossOrAllVertical bracket ->
            makeLiteralBox False bracket children

        AlwaysVertical bracket ->
            makeLiteralBox True bracket children

        EmptyBracketed loc ->
            when bracketPunc loc.value is
                Just { left, right } ->
                    if Array.isEmpty children then
                        Ok (B.line (B.row [ B.punc left, B.punc right ]))

                    else
                        -- A bracket whose only content is a comment (`{ {- c -} }`,
                        -- `[ {- c -} ]`): the open punc, a space, the comments
                        -- space-joined, a space, the close punc — all on one line.
                        -- Only a single-line block comment fits this inline form;
                        -- a multi-line block comment or a `--` line comment can't
                        -- glue onto the one-line bracket, so it falls back to a
                        -- vertical layout (open punc, each comment indented on
                        -- its own line via the full comment Box, close punc) —
                        -- dropping the comment would lose source content.
                        when traverseResult emptyBracketedCommentLine children is
                            Ok commentLines ->
                                Ok
                                    (B.line
                                        (B.row
                                            (Array.flatten
                                                [ [ B.punc left, B.space ]
                                                , spaceJoinLines commentLines
                                                , [ B.space, B.punc right ]
                                                ]
                                            )
                                        )
                                    )

                            Err _ ->
                                traverseResult commentNodeBox children
                                    |> Result.map
                                        (\commentBoxes ->
                                            B.stack1
                                                ([ B.line (B.punc left) ]
                                                    ++ Array.map B.indent commentBoxes
                                                    ++ [ B.line (B.punc right) ]
                                                )
                                        )

                Nothing ->
                    -- unreachable: ListBrackets has exactly 3 constructors
                    -- (ListParen/ListCurly/ListSquare); bracketPunc matches
                    -- all of them and always returns Just.
                    Err "unreachable: bracket kind"

        Binop { forceVertical } ->
            makeBinopBox forceVertical children

        OpAndRhs ->
            makeOpAndRhsBox children

        RecordUpdate { name, forceVertical } ->
            makeRecordUpdateBox name.value forceVertical children

        IfCondition { forceVertical } ->
            makeIfConditionBox forceVertical children

        Pipeline { forceVertical, op } ->
            makePipelineBox forceVertical op children

        EmptyLine ->
            Ok B.blankLine

        WhenFlow { forceVertical } ->
            makeWhenFlowBox forceVertical children

        WhenBranch ->
            makeWhenBranchBox children

        WhenBranchPattern ->
            makeWhenBranchPatternBox children

        ParenBlock { forceVertical, checkContentVertical } ->
            makeParenBlockBox { forceVertical = forceVertical, checkContentVertical = checkContentVertical } children

        MultilineString loc ->
            -- A `"""…"""` literal: opening `"""`, one line per content element,
            -- closing `"""`, stacked. Box stacking aligns to the box's column
            -- intrinsically when the flow indents it, so continuation lines land
            -- at the opening `"""`'s column. A content line's *trailing*
            -- whitespace is significant string data (the parser strips only the
            -- leading block indentation, never the trailing run), so such a line
            -- is emitted as `B.noTrim` to exempt it from `render`'s per-line
            -- right-trim. A content line with no significant trailing whitespace
            -- (including a blank line) stays a plain `Text`, so its Tab-expanded
            -- indentation is trimmed away rather than left as a run of spaces.
            let
                quote =
                    B.line (B.literal "\"\"\"")

                contentLine s =
                    if String.trimRight s /= s then
                        B.line (B.noTrim s)

                    else
                        B.line (B.literal s)

                contentLines =
                    Array.map contentLine loc.value
            in
            Ok (B.stack1 ([ quote ] ++ contentLines ++ [ quote ]))

        Glue ->
            makeGlueBox children

        SingleLineComment _ ->
            -- unreachable: a comment node is handled before `makePBox` — as its
            -- own top-level `OriginalRows` (via `commentNodeToBox`), and as a flow
            -- child by `renderFlowItem`'s own `SingleLineComment`/`BlockComment`
            -- arms. Only its `_ ->` arm calls `makePBox`, so a comment never
            -- reaches here.
            Err "unreachable: SingleLineComment never reaches makePBox"

        BlockComment _ ->
            -- unreachable: same as SingleLineComment above.
            Err "unreachable: BlockComment never reaches makePBox"

        DocComment _ ->
            -- unreachable: a DocComment is only ever the sole child of its own
            -- OriginalRows (MakeLogical.gren), dispatched through
            -- makeCommentLineBox / commentNodeToBox — never through makePBox.
            Err "unreachable: DocComment never reaches makePBox"

        PipelineStep ->
            -- A `|> step` inside the generic fold (a comment-bearing pipeline
            -- routed to `buildFlowBox 0`). The step's own leading/trailing
            -- comments are peeled inside; the fold's PipelineStepItem placement
            -- supplies the +grenIndent step wrap and the blank-before-commented-
            -- step.
            renderPipelineStepChildren children

        AlignedFlow ->
            -- unreachable: no code path in InsertExpressions/InsertPatterns/
            -- InsertTypes/MakeLogical ever constructs an AlignedFlow box —
            -- it's a defined-but-unused LPBox constructor.
            Err "unreachable: AlignedFlow is never constructed"

        RootBox ->
            -- unreachable: RootBox is the singular tree root; it is never
            -- passed to makePBox as a child.
            Err "unreachable: RootBox never reaches makePBox"

        OriginalRows _ ->
            -- unreachable: OriginalRows is always a direct child of RootBox,
            -- rendered by makePrettyLineBox — never passed to makePBox.
            Err "unreachable: OriginalRows never reaches makePBox"


{-| Render a `Glue`: children concatenated with no separator — a postfix accessor
(`.field`) glued after a bracketed base (`(f 1).value`, `{ a = 1 }.a`). The base
(first child) may be multi-line — the accessor glues onto its last line via
`B.addSuffix` — but every following child (the `.field` accessors) must be
single-line. -}
makeGlueBox : Array LPNode -> Result String Box
makeGlueBox children =
    -- A trailing comment on a postfix access (`(x).name {- c -}`, `(x).name -- c`)
    -- rides the glued line with a space; it must not go through `makePBox` (a bare
    -- comment node has no makePBox arm — it hit "comment never reaches makePBox").
    -- Peel it off first, glue the tokens with no space, then append the comment(s).
    let
        split =
            spanTrailingComments children
    in
    when Array.popFirst split.body is
        Nothing ->
            Err "box: empty glue"

        Just { first, rest } ->
            makePBox (lpnBox first) (lpnChildren first)
                |> Result.andThen
                    (\baseBox ->
                        Array.foldl
                            (\child accR ->
                                accR
                                    |> Result.andThen
                                        (\acc ->
                                            makePBox (lpnBox child) (lpnChildren child)
                                                |> Result.andThen
                                                    (\childBox ->
                                                        when B.isLine childBox is
                                                            Ok l ->
                                                                Ok (B.addSuffix l acc)

                                                            Err _ ->
                                                                -- unreachable: every non-base, non-comment
                                                                -- Glue child is a freshly built plain-text
                                                                -- ".field" leaf (InsertExpressions.gren's
                                                                -- insertAccess), always single-line.
                                                                Err "unreachable: multi-line glue suffix"
                                                    )
                                        )
                            )
                            (Ok baseBox)
                            rest
                    )
                |> Result.andThen (\glued -> glueTrailingComments glued split.trailing)


{-| Render a `ParenBlock`: inline `(inner)`, the generic vertical form
`(inner` … `)` with the closing paren on its own line, and the block shapes.
A `when`/`if`/`let` directly inside the parens uses elm-format's paren-block
indentation (keyword at `(`+1, bodies at `(`+2 or `(`+4, `)` at the `(` column),
via `makeWhenInParenBox` / `makeBlockInParenBox`.

The vertical form anchors continuation lines and the closing `)` to the `(`
column. Box stacking is intrinsically that anchor: the wrapped box's lines are
all relative to its own origin, which becomes the `(` column once the enclosing
flow indents it. -}
makeParenBlockBox : { forceVertical : Bool, checkContentVertical : Bool } -> Array LPNode -> Result String Box
makeParenBlockBox flags children =
    makeParenBlockBoxWithParts flags children
        |> Result.map .box


{-| `makeParenBlockBox`, plus the paren's lambda-body box when it has one (see
`FlowItem.lambdaBodyBox`). Only the generic-fallback arm can produce one; the
block arms (`when` / `if` / `let` in parens) are not lambdas. Every paren is
rendered through here — `makePBox` keeps `.box`, `renderFlowItem` keeps both —
so there is one paren renderer, not a renderer and a look-alike. -}
makeParenBlockBoxWithParts :
    { forceVertical : Bool, checkContentVertical : Bool }
    -> Array LPNode
    -> Result String { box : Box, lambdaBodyBox : Maybe Box }
makeParenBlockBoxWithParts flags children =
    let
        noParts =
            Result.map (\box -> { box = box, lambdaBodyBox = Nothing })
    in
    when Array.first children is
        Nothing ->
            Ok { box = B.line (B.punc "()"), lambdaBodyBox = Nothing }

        Just first ->
            when lpnBox first is
                WhenFlow _ ->
                    -- The `when` renders through its ordinary builder, so the
                    -- paren cannot change its internal shape.
                    makePBox (lpnBox first) (lpnChildren first)
                        |> Result.map wrapParenVerticalPadded
                        |> noParts

                IfCondition _ ->
                    noParts (blockInParenBox children)

                UnbreakableText loc ->
                    if loc.value == "let" then
                        noParts (blockInParenBox children)

                    else
                        parenGenericFallbackBox flags children

                _ ->
                    parenGenericFallbackBox flags children


{-| An `if`/`let` directly inside parens. The children are the flattened pieces
(an `IfCondition`/`let` head, `IndentedBlock` bodies, `SynthesizedText`
keywords, `EmptyLine` blanks) — exactly what a bare `if`/`let` renders through,
so `buildFlowBox 0` lays them out identically to the unparenthesized form.

`wrapParenVerticalPadded` then glues `(` onto the first line and pads every
continuation by the `(`'s width, placing the whole block at `(`+1. Its own `Tab`
indents therefore advance from the keyword's column, which is exactly
elm-format's rule: a branch body sits at the next tab stop after the `if`.

The offsets are emergent, not chosen. Measured against elm-format, a body lands
at `(`+2 after a `+ `, `(`+3 after a `-`, `(`+4 when the `(` starts its line,
and `(`+5 after a `++ `/`&& `/`|> ` — one Tab from the keyword in every case.

An earlier version hard-coded `(`+2, or `(`+4 for a call argument (behind an
`isCallArgument` flag on the box, since removed). Both values were real: `(`+4
is what the rule yields when `(` starts a line, `(`+2 what it yields after a
1-character operator, and each was verified against elm-format in that one
shape. The bug was generalizing two samples into a rule — the offset is not a
property of the syntactic role (call argument vs operand), it is a property of
the column the `(` happens to land in.
-}
blockInParenBox : Array LPNode -> Result String Box
blockInParenBox children =
    buildFlowBox 0 children
        |> Result.map wrapParenVerticalPadded


{-| The non-block ParenBlock shapes: inline, or a generic vertical `(…\n)`. The
vertical form triggers on either verticality signal or a multi-line lambda body
(second child an `IndentedBlock`, or a `SoftIndentedBlock` that renders vertical
— see `parenLambdaMultilineItems`).

The content is rendered ONCE, as flow items, and everything downstream reads
those: `innerBox` is `assembleFlow True 0` over them (exactly what
`buildFlowBoxInline 0 children` produced), and the lambda-body test reads the
second item's own box instead of re-rendering the subtree. Rendering it twice
made a nested `(\x -> [ … ])` chain cost 2^depth — depth 22 took over a minute.
Inline-start (`assembleFlow True`): the content continues the `(`-line, so a
leading single-line block comment stays inline (`({- c -} expr)`).
-}
parenGenericFallbackBox :
    { forceVertical : Bool, checkContentVertical : Bool }
    -> Array LPNode
    -> Result String { box : Box, lambdaBodyBox : Maybe Box }
parenGenericFallbackBox flags children =
    renderFlowItems children
        |> Result.andThen
            (\items ->
                let
                    -- The lambda body, if this paren has one: the second child's
                    -- own box, straight out of the render above. `makePBox
                    -- IndentedBlock children` IS `buildFlowBox 0 children`, so
                    -- this is byte-for-byte what the two consumers used to
                    -- compute for themselves. The HEAD is deliberately not
                    -- carried: they render it with `inlineStart = True` while an
                    -- item is rendered without, and the head is a parameter list
                    -- -- it cannot contain the nesting, so re-rendering it is
                    -- O(1) per level.
                    lambdaBodyBox =
                        when Array.get 1 items is
                            Just second ->
                                when lpnBox second.node is
                                    IndentedBlock ->
                                        Just second.box

                                    _ ->
                                        Nothing

                            Nothing ->
                                Nothing
                in
                assembleFlow True 0 items
                    |> Result.map
                        (\innerBox ->
                            let
                                contentForcesVertical =
                                    flags.checkContentVertical && not (isSingleLine innerBox)

                                -- Nothing can follow a `--` on its line, so a
                                -- paren whose content ENDS in one cannot use the
                                -- inline form -- its `)` would be glued after the
                                -- comment and swallowed (`(Int -> Int -- c)`,
                                -- which does not reparse). The rendered box does
                                -- not say so on its own: a trailing line comment
                                -- glues onto the running row and leaves a
                                -- one-row box, so `isSingleLine` is True.
                                contentEndsWithLineComment =
                                    when Array.last children is
                                        Just lastChild ->
                                            subtreeEndsWithLineComment lastChild

                                        Nothing ->
                                            False

                                goVertical =
                                    flags.forceVertical
                                        || contentForcesVertical
                                        || contentEndsWithLineComment
                                        || parenLambdaMultilineItems items

                                parenBox =
                                    if goVertical then
                                        -- One expression, deliberately. This used to be a
                                        -- three-way branch on
                                        -- `parenContentLeadsWithMultilinePrefixGlue` (an
                                        -- align-carrying `(\{ … } …)` parameter) and on
                                        -- "a comment forced the break", whose bodies were
                                        -- all byte-identical `wrapParenVerticalPadded`
                                        -- calls — so the two predicates decided nothing
                                        -- while each rendering a subtree to decide it.
                                        -- The `(`-width padding those arms described is
                                        -- what `wrapParenVerticalPadded` does in every
                                        -- case; there was never an unpadded exclusion.
                                        wrapParenVerticalPadded innerBox

                                    else
                                        when B.isLine innerBox is
                                            Ok l ->
                                                B.line (B.row [ B.punc "(", l, B.punc ")" ])

                                            Err _ ->
                                                -- A formatter-synthesized wrap (`checkContentVertical
                                                -- = False`) around content a comment forced
                                                -- multi-line: elm-format's inline form is a plain
                                                -- `( inner )`, `)` glued onto the inner's last line.
                                                -- When the inner is align-carrying (a bracket literal
                                                -- / record — its continuation lines anchor at its own
                                                -- start column), the `(` width must ride along on
                                                -- every continuation line (`B.prefix`) so the inner's
                                                -- `,`/`}` stay under the opening bracket, not the `(`.
                                                -- Otherwise (a nest-carrying inner) the continuation
                                                -- lines belong at the ambient column, so only the
                                                -- first line gets the `(` (`B.mapFirstLine`).
                                                if parenInnerIsAlignCarrying children then
                                                    B.addSuffix (B.punc ")") (B.prefix (B.punc "(") innerBox)

                                                else
                                                    B.addSuffix (B.punc ")") (B.mapFirstLine (\l -> B.row [ B.punc "(", l ]) identity innerBox)
                            in
                            { box = parenBox, lambdaBodyBox = lambdaBodyBox }
                        )
            )


{-| The second direct child is an `IndentedBlock` (a lambda body on a separate
row — always multi-line), or a `SoftIndentedBlock` whose sole child is a bracket
literal that renders vertical.

Both facts come from the item that was already rendered:
`softBlockChildForcesVerticalBox` keeps the same structural test as before and
reads verticality off `item.box` (a soft block is single-line exactly when its
sole child is), rather than rendering that child a second time. -}
parenLambdaMultilineItems : Array FlowItem -> Bool
parenLambdaMultilineItems items =
    when Array.get 1 items is
        Just second ->
            when lpnBox second.node is
                IndentedBlock ->
                    True

                SoftIndentedBlock ->
                    softBlockChildForcesVerticalBox second

                _ ->
                    False

        Nothing ->
            False


{-| A record / array literal via elm's `group'`. `AllAcrossOrAllVertical`
(author wrote it inline) passes `forceMultiline = False` — `group'` still
expands if a child is multi-line; `AlwaysVertical` (2+-field record, or author
across rows) passes `forceMultiline = True`. -}
makeLiteralBox : Bool -> ListBrackets -> Array LPNode -> Result String Box
makeLiteralBox forceMultiline bracket children =
    if commentForcesBracketOpen forceMultiline children then
        commentBracketListBox bracket children

    else
        -- No comment, or only comments that ride the flat line the author
        -- wrote; `pairInlineComments` glues those onto the item each trails.
        -- A record literal (`ListCurly`) renders each `name = value` field with
        -- the same drop rule as a record update (`renderRecordFieldBox`), so a
        -- soft multi-line value (a binop chain, a broken call) drops below `= `
        -- instead of being handed to the flow assembler, which has no drop rule.
        -- Array / tuple / paren items are plain expressions, not fields, so they
        -- stay on the generic `makePBox` path.
        pairInlineComments (literalItemRenderer bracket) children
            |> Result.andThen
                (\itemBoxes ->
                    when bracketPunc bracket is
                        Just { left, right } ->
                            Ok (E.groupBox (bracket /= ListParen) left "," right forceMultiline itemBoxes)

                        Nothing ->
                            -- unreachable: ListBrackets has exactly 3 constructors
                            -- (ListParen/ListCurly/ListSquare); bracketPunc matches
                            -- all of them and always returns Just.
                            Err "unreachable: bracket kind"
                )


{-| True when a comment among a bracketed construct's children forces it open.

Three ways that happens. Some *direct* comment child cannot ride a flat line
(see `literalCommentsRideFlatLine`); or the author already broke the construct
across rows, in which case the comment-aware vertical path owns comment
placement and the flat path never runs; or some item's own subtree ENDS in a
`--`, which is the nested case the first two miss.

That third clause is not a refinement — without it the formatter emitted source
that does not parse. The first two clauses look only at direct children, so a
`--` buried inside an item (`[ lower + margin -- inclusive` / `]`: the comment
is a `TrailsPrevious` child of the item's `OpAndRhs`, not of the list) left the
list on the flat path, which renders `[ item ]` on one line — putting the
synthesized `]` after a `--` that runs to end of line, so it was swallowed and
the output failed to reparse. `subtreeEndsWithLineComment` is the same predicate
the binop/pipeline assemblers consult before gluing onto an operand's last line,
and it already stops at bracket/paren containers (whose own last line is a
closing delimiter, safe to glue after) so it does not over-trigger on a nested
list that merely contains a `--`.

`Array.any`, not "the last child": a `--` in a MIDDLE item swallows the `, ` and
everything after it just as surely as one in the last item swallows the close.
-}
commentForcesBracketOpen : Bool -> Array LPNode -> Bool
commentForcesBracketOpen forceVertical children =
    (Array.any nodeIsComment children
        && (forceVertical || not (literalCommentsRideFlatLine children))
    )
        || Array.any subtreeEndsWithLineComment children


{-| Render a bracketed construct's children with `renderItem`, gluing each
comment child onto the box of the item it trails.

This is what lets the flat path carry a comment at all: the LPT makes a comment
a sibling of the real items, so a group would put a `, ` in front of it and
render it as an element. Callers must have cleared `commentForcesBracketOpen`
first. With no comments among the children this is exactly
`traverseResult renderItem` — the same one function serves the comment-free and
comment-bearing cases, so the two cannot drift apart.
-}
pairInlineComments : (LPNode -> Result String Box) -> Array LPNode -> Result String (Array Box)
pairInlineComments renderItem children =
    Array.foldl
        (\node accResult ->
            accResult
                |> Result.andThen
                    (\acc ->
                        if nodeIsComment node then
                            commentNodeBox node
                                |> Result.andThen
                                    (\cbox ->
                                        if commentLeadsNext node then
                                            -- Rule C2: written across the unrecorded
                                            -- `,` between two items, so it belongs to
                                            -- the item AFTER it (`[ 1, {- c -} 2 ]`).
                                            -- Held with the opener run in `lead`.
                                            Ok { acc | lead = Array.pushLast cbox acc.lead }

                                        else
                                            when Array.popLast acc.boxes is
                                                Just { last, initial } ->
                                                    Ok { acc | boxes = Array.pushLast (glueCommentSuffix cbox last) initial }

                                                Nothing ->
                                                    -- No item yet: the comment was written
                                                    -- just after the opening bracket
                                                    -- (`[ {- c -} 1, 2 ]`), so it leads the
                                                    -- FIRST item instead of trailing a
                                                    -- previous one. Held until that item
                                                    -- renders — see `lead`.
                                                    Ok { acc | lead = Array.pushLast cbox acc.lead }
                                    )

                        else
                            renderItem node
                                |> Result.map
                                    (\box ->
                                        { boxes = Array.pushLast (glueLeadBoxes acc.lead box) acc.boxes
                                        , lead = []
                                        }
                                    )
                    )
        )
        (Ok { boxes = [], lead = [] })
        children
        -- A `lead` run with no item left to lead cannot arise from the
        -- classifier (an opener always has a first item, and `LeadsNext` is only
        -- assigned when an item follows), but dropping it would silently delete a
        -- comment, so it falls back to a box of its own.
        |> Result.map (\acc -> acc.boxes ++ acc.lead)


{-| Glue held leading comment boxes onto the front of the first item's box, in
source order (`{- a -} {- b -} 1`). Each is a single-line `{- … -}` — the only
kind that reaches here, since anything else fails `literalCommentsRideFlatLine`
and routes to `commentBracketListBox` instead. -}
glueLeadBoxes : Array Box -> Box -> Box
glueLeadBoxes lead box =
    Array.foldr glueLeadingCommentPrefix box lead


{-| Render a bracketed literal that contains a comment child, as an always-
vertical list. Each item is on its own line prefixed `{ `/`[ ` (first) or `, `
(rest); a comment on the same source row as the preceding item trails it with a
space, a comment on its own row gets its own line at the bracket column; the
closing bracket sits on its own line. Box stacking supplies the alignment
(elm-format). The uniform record-array coupling (a whole-list flat/expanded
choice) is NOT reproduced — those fall back. -}
-- True when a comment glues onto the previous bracket-list item (rather than
-- standing on its own line): the stored `CommentRole` is `TrailsPrevious` or
-- `RidesInline`. Decided once in `Comments.gren`, not from source rows here.
commentTrailsRole : LPNode -> Bool
commentTrailsRole node =
    when commentRole (lpnBox node) is
        Just TrailsPrevious ->
            True

        Just RidesInline ->
            True

        _ ->
            False


-- True when this comment can share a line with the code after it: a
-- single-line `{- … -}`, which the classifier tags `RidesInline`. A `--` runs
-- to end of line and a multi-line `{- … -}` brings its own newlines, so both
-- are `TrailsPrevious` and must break instead.
commentRidesInline : LPNode -> Bool
commentRidesInline node =
    commentRole (lpnBox node) == Just RidesInline


{-| Glue a run of comments onto the front of the box that follows them, in
source order — the mirror of `glueCommentSuffix`, which glues a trailing comment
onto the box before it. Two callers, one rule: the comments written just after an
opening bracket (`[ {- a -} {- b -} 1`, with the caller's `[ ` prefix supplying
the bracket) and those written between a pipeline step's operator and its
operand (`|> {- c -} step`, with `prefixOperator` supplying the `|> `).

**Once the run breaks, it stays broken.** If any comment in it cannot share a
line — a `--`, a multi-line `{- … -}`, or one the author put on its own row —
then every comment of the run stands on its own row, and so does the body:

    [ {- 1 a          NOT   [ {- 1 a
         1 b                     1 b
         1 c -}                  1 c -} {- x -}
      {- x -}                  1
      1

Letting the later ones jump ahead onto the item's line is not a fixed point: on
reparse `{- x -}` sits on the item's row rather than the run's, so the next
format drops it back to its own row and the file never settles. This is the same
all-or-nothing rule `assembleBrokenWithComments` and `renderWhenBranchesBox`
apply to a comment run, and the one elm-format applies here.

`bodyMayRide` is the caller's separate question of whether the *body* can share
the run's last row at all. A bracket item can (it is the row's whole content); a
pipeline operand can only when it renders on one line, since a multi-line operand
starts a row of its own and leaves the comments above it. -}
glueLeadingCommentRun : Bool -> Array { box : Box, inline : Bool } -> Box -> Box
glueLeadingCommentRun bodyMayRide lead box =
    let
        -- Index of the first comment that cannot share a line; the length of the
        -- run when every comment can.
        firstBreak =
            (Array.foldl
                (\c acc ->
                    if acc.found >= 0 || c.inline then
                        { acc | i = acc.i + 1 }

                    else
                        { i = acc.i + 1, found = acc.i }
                )
                { i = 0, found = -1 }
                lead
            )
                |> (\acc ->
                        if acc.found < 0 then
                            acc.i

                        else
                            acc.found
                   )

        riding =
            Array.map .box (Array.slice 0 firstBreak lead)

        broken =
            Array.map .box (Array.dropFirst firstBreak lead)

        -- The riding comments joined onto the front of one row.
        joinOnto base =
            Array.foldr glueLeadingCommentPrefix base riding
    in
    if not (Array.isEmpty broken) then
        B.stack1 (riding ++ broken ++ [ box ])

    else if bodyMayRide then
        joinOnto box

    else
        when Array.popLast riding is
            Just { last = lastRiding, initial } ->
                B.stack1 [ Array.foldr glueLeadingCommentPrefix lastRiding initial, box ]

            Nothing ->
                box


commentBracketListBox : ListBrackets -> Array LPNode -> Result String Box
commentBracketListBox bracket nodes =
    when bracketPunc bracket is
        Nothing ->
            -- unreachable: ListBrackets has exactly 3 constructors
            -- (ListParen/ListCurly/ListSquare); bracketPunc matches
            -- all of them and always returns Just.
            Err "unreachable: bracket kind"

        Just { left, right } ->
            let
                -- Nothing has been emitted yet, so a comment here was written
                -- just after the opening bracket and leads the FIRST item
                -- (`[ {- c -} 1` / `, 2`) rather than trailing anything. Held in
                -- `lead` until that item renders.
                atOpener acc =
                    Array.isEmpty acc.entries && acc.pending == Nothing

                placeComment node acc =
                    commentNodeBox node
                        |> Result.andThen
                            (\cbox ->
                                if atOpener acc then
                                    Ok
                                        { acc
                                            | lead =
                                                Array.pushLast
                                                    { box = cbox, inline = commentRidesInline node }
                                                    acc.lead
                                        }

                                else if commentLeadsNext node then
                                    -- Rule C2: written across the unrecorded `,`
                                    -- between two items, so it leads the item AFTER
                                    -- it (`, {- c -} 2`). Flush the item it followed,
                                    -- then hold it in `lead` exactly as an opener
                                    -- comment is held for the first item.
                                    Ok
                                        { acc
                                            | entries =
                                                when acc.pending is
                                                    Nothing ->
                                                        acc.entries

                                                    Just e ->
                                                        Array.pushLast e acc.entries
                                            , pending = Nothing
                                            , lead =
                                                Array.pushLast
                                                    { box = cbox, inline = commentTextCanRide node }
                                                    acc.lead
                                        }

                                else if commentTrailsRole node then
                                    -- Trailing the preceding item: attach with a
                                    -- single space (layout is author-driven, not
                                    -- width-driven). A multi-line trailing comment
                                    -- pads under its start via `glueCommentSuffix`.
                                    -- Whether it trails is the stored `CommentRole`
                                    -- (`TrailsPrevious`/`RidesInline`), not a row test.
                                    when acc.pending is
                                        Nothing ->
                                            -- The item was already flushed because a
                                            -- comment glued onto it. A second trailing
                                            -- comment (`{- … -} -- c`) glues onto that
                                            -- one's last line rather than dropping to
                                            -- its own — which is where its role says it
                                            -- belongs, and where a reparse re-derives
                                            -- the same role from.
                                            when Array.popLast acc.entries is
                                                Just { last = e, initial } ->
                                                    Ok
                                                        { acc
                                                            | entries = Array.pushLast { e | box = glueCommentSuffix cbox e.box } initial
                                                        }

                                                Nothing ->
                                                    Ok
                                                        { acc
                                                            | entries = Array.pushLast { box = cbox, isComment = True } acc.entries
                                                            , pending = Nothing
                                                        }

                                        Just e ->
                                            Ok
                                                { acc
                                                    | entries = Array.pushLast { box = glueCommentSuffix cbox e.box, isComment = False } acc.entries
                                                    , pending = Nothing
                                                }

                                else
                                    let
                                        flushed =
                                            when acc.pending is
                                                Nothing ->
                                                    acc.entries

                                                Just e ->
                                                    Array.pushLast e acc.entries
                                    in
                                    Ok
                                        { acc
                                            | entries = Array.pushLast { box = cbox, isComment = True } flushed
                                            , pending = Nothing
                                        }
                            )

                step node accResult =
                    when accResult is
                        Err e ->
                            Err e

                        Ok acc ->
                            when lpnBox node is
                                SingleLineComment _ ->
                                    placeComment node acc

                                BlockComment _ ->
                                    placeComment node acc

                                _ ->
                                    literalItemRenderer bracket node
                                        |> Result.andThen
                                            (\box ->
                                                let
                                                    flushed =
                                                        when acc.pending is
                                                            Nothing ->
                                                                acc.entries

                                                            Just e ->
                                                                Array.pushLast e acc.entries
                                                in
                                                Ok
                                                    { entries = flushed
                                                    , pending = Just { box = glueLeadingCommentRun True acc.lead box, isComment = False }
                                                    , lead = []
                                                    }
                                            )
            in
            Array.foldl step (Ok { entries = [], pending = Nothing, lead = [] }) nodes
                |> Result.map
                    (\state ->
                        let
                            flushedPending =
                                when state.pending is
                                    Nothing ->
                                        state.entries

                                    Just e ->
                                        Array.pushLast e state.entries

                            -- A held `lead` run with no item left to lead cannot
                            -- arise from the classifier (`LeadsNext` is only
                            -- assigned when an item follows), but dropping it would
                            -- silently delete a comment, so it falls back to its
                            -- own line.
                            allEntries =
                                flushedPending
                                    ++ Array.map (\c -> { box = c.box, isComment = True }) state.lead

                            assembled =
                                Array.foldl
                                    (\entry acc ->
                                        if entry.isComment then
                                            { acc | boxes = Array.pushLast entry.box acc.boxes }

                                        else
                                            let
                                                pref =
                                                    if acc.seenText then
                                                        B.row [ B.punc ",", B.space ]

                                                    else
                                                        B.row [ B.punc left, B.space ]
                                            in
                                            { boxes = Array.pushLast (B.prefix pref entry.box) acc.boxes
                                            , seenText = True
                                            }
                                    )
                                    { boxes = [], seenText = False }
                                    allEntries
                        in
                        B.stack1 (Array.pushLast (B.line (B.punc right)) assembled.boxes)
                    )


-- Render each flow node to a Box (Err if any is unported), tagging whether it
-- occupies its own block line, its start row, and — for a comment — the rendered
-- comment box so `assembleFlowImpl` can place it by row.
renderFlowItems : Array LPNode -> Result String (Array FlowItem)
renderFlowItems nodes =
    traverseResult renderFlowItem nodes


renderFlowItem : LPNode -> Result String FlowItem
renderFlowItem node =
    when lpnBox node is
        SingleLineComment { loc } ->
            Ok
                { node = node
                , box = B.blankLine
                , isBlock = False
                , comment = Just { box = B.line (B.literal ("--" ++ loc.value)), isLineComment = True, multiLine = False }
                , lambdaBodyBox = Nothing
                }

        BlockComment { loc } ->
            if String.contains "\n" loc.value then
                multiLineBlockCommentBox loc.value
                    |> Result.map
                        (\cbox ->
                            { node = node
                            , box = B.blankLine
                            , isBlock = False
                            , comment = Just { box = cbox, isLineComment = False, multiLine = True }
                            , lambdaBodyBox = Nothing
                            }
                        )

            else
                Ok
                    { node = node
                    , box = B.blankLine
                    , isBlock = False
                    , comment = Just { box = B.line (B.literal ("{-" ++ loc.value ++ "-}")), isLineComment = False, multiLine = False }
                    , lambdaBodyBox = Nothing
                    }

        ParenBlock { forceVertical, checkContentVertical } ->
            -- The one node kind rendered through a with-parts entry point, so
            -- the paren's own lambda-body box can ride along on the item instead
            -- of being re-derived by a second render downstream. `makePBox`'s
            -- ParenBlock arm calls the same function and keeps only `.box`, so
            -- the two can never disagree.
            makeParenBlockBoxWithParts
                { forceVertical = forceVertical, checkContentVertical = checkContentVertical }
                (lpnChildren node)
                |> Result.map
                    (\parts ->
                        { node = node
                        , box = parts.box
                        , isBlock = isBlockNode node parts.box
                        , comment = Nothing
                        , lambdaBodyBox = parts.lambdaBodyBox
                        }
                    )

        _ ->
            makePBox (lpnBox node) (lpnChildren node)
                |> Result.map
                    (\box ->
                        { node = node
                        , box = box
                        , isBlock = isBlockNode node box
                        , comment = Nothing
                        , lambdaBodyBox = Nothing
                        }
                    )


{-| Assemble a flow: inline nodes join on one line with single spaces; a single
trailing block node (BodyBlock / IndentedBlock / any multi-line node) drops to
its own line indented by `indent`. Shapes outside "inline* block?" are `Err` —
there is no fallback renderer, so that fails the whole file. -}
buildFlowBox : Int -> Array LPNode -> Result String Box
buildFlowBox indent nodes =
    renderFlowItems nodes
        |> Result.andThen (assembleFlow False indent)


{-| Like `buildFlowBox`, but for a flow that continues on the same line as a
token the caller already emitted (a binop/`OpAndRhs` rhs after its operator, a
`( … )` body). A leading single-line block comment there stays inline instead of
dropping to its own line (`inlineStart = True`). -}
buildFlowBoxInline : Int -> Array LPNode -> Result String Box
buildFlowBoxInline indent nodes =
    renderFlowItems nodes
        |> Result.andThen (assembleFlow True indent)


{-| Assemble a *broken* flow — every item on its own line: the first at the base
column, each remaining item at +`indent` (the `brokenFlow = True` path). Box
already renders broken function applications via `assembleBrokenCall`, so the one
caller here is the forced-vertical comment-bearing binop (`operand0` /
`op … rest` at +4). Top-level comment items ARE handled:
`assembleBrokenWithComments` places leading, gluing and own-line comments itself
(verified behaviorally — an earlier version of this doc said they fall back). -}
buildFlowBoxBroken : Int -> Array LPNode -> Result String Box
buildFlowBoxBroken indent nodes =
    renderFlowItems nodes
        |> Result.andThen (assembleBrokenWithComments indent)


assembleFlow : Bool -> Int -> Array FlowItem -> Result String Box
assembleFlow inlineStart flowIndent items =
    when trySoftGlueFlow items is
        Just box ->
            Ok box

        Nothing ->
            -- (The pre-Phase-1 "inline token gluing to a preceding block"
            -- guard is gone: the placement fold glues an inline follower onto
            -- a block's last line itself — `glueOntoLastRow`'s `B.addSuffix`
            -- — exactly where the policy decides a `SoftSep`/`GlueSpace`
            -- lands with an empty current row.)
            assembleFlowImpl inlineStart flowIndent items


{-| Assemble a flow into a Box, taking every join decision from
`FlowPolicy.decide` — the shared decision core (see CutoverScope.md "Item 4
design", Phase 1). This fold keeps NO layout policy of its own: it classifies
each item into `ItemFacts`, asks the policy for a `Placement`, and materializes
that placement with Box primitives. A placement this renderer cannot materialize
returns `Err`.

Materialization state: `curRow` is the line being assembled (single-line items
join space-separated); `rows` are the completed lines/blocks above it. The
first row sits at the flow's own column; every continuation row is indented by
`flowIndent` at the end (the outer nest wrapping the whole flow).
-}
assembleFlowImpl : Bool -> Int -> Array FlowItem -> Result String Box
assembleFlowImpl inlineStart flowIndent items =
    let
        config =
            { indent = flowIndent
            , inlineStart = inlineStart
            , brokenFlow = False
            }

        flushRow curRow rows =
            if Array.isEmpty curRow then
                rows

            else
                Array.pushLast (B.line (B.row (Array.intersperse B.space curRow))) rows

        -- Classify one flow item into the policy's fact vocabulary. The
        -- verticality facts come from this renderer's own IR (`isSingleLine`
        -- on the rendered box).
        factsFor item =
            when item.comment is
                Just c ->
                    let
                        -- The role decided once in `Comments.gren`; the renderer
                        -- reads it instead of re-deriving glue/own-line from rows.
                        role =
                            commentRole (lpnBox item.node)
                                |> Maybe.withDefault LeadsOwnLine
                    in
                    if c.isLineComment then
                        FP.LineCommentItem { role = role }

                    else
                        FP.BlockCommentItem { multiLine = c.multiLine, role = role }

                Nothing ->
                    -- Non-comment items now carry no source rows: comment
                    -- placement reads the stored `CommentRole`, so `decide` only
                    -- needs the item's structural kind. A bracket literal reports
                    -- its rendered verticality (for the type-record drop); every
                    -- block wrapper is its own fact; everything else is a plain
                    -- `LeafItem` that merely advances the separator.
                    when lpnBox item.node is
                        AllAcrossOrAllVertical _ ->
                            bracketFacts item

                        AlwaysVertical _ ->
                            bracketFacts item

                        IndentedBlock ->
                            FP.IndentedBlockItem

                        BodyBlock ->
                            FP.BodyBlockItem

                        SoftIndentedBlock ->
                            FP.SoftBlockItem { childForcesVertical = softBlockChildForcesVerticalBox item }

                        EmptyLine ->
                            FP.EmptyLineItem

                        PipelineStep ->
                            FP.PipelineStepItem

                        _ ->
                            FP.LeafItem

        bracketFacts item =
            FP.BracketLiteralItem
                { forcesVertical = not (isSingleLine item.box)
                , isTypeRecord = FP.isTypeRecordLiteral item.node
                }

        -- Glue a single line onto the last completed row's last line — the
        -- materialization of a soft-separator join whose left side is a block
        -- (the separator flattens to a space onto the running line).
        -- Covers the ex-`glueable` lambda-pattern/lambda-head followers and a
        -- same-row comment gluing onto a dropped record's `}` line.
        glueOntoLastRow acc l next =
            when Array.popLast acc.rows is
                Just { last = lastBox, initial } ->
                    Ok
                        { rows = Array.pushLast (B.addSuffix (B.row [ B.space, l ]) lastBox) initial
                        , curRow = []
                        , state = next
                        }

                Nothing ->
                    Err "box: glue with nothing before"

        -- Materialize a comment item's placement. An own-line comment (the
        -- policy leaves `AlreadyTerminated`) flushes and stands alone; an
        -- inline one joins the current row. `GlueSpace` with an empty current
        -- row means the previous item was a block (a dropped record): glue
        -- onto its last line.
        placeCommentItem acc decision c =
            let
                ownLine box =
                    Ok
                        { rows = Array.pushLast box (flushRow acc.curRow acc.rows)
                        , curRow = []
                        , state = decision.next
                        }
            in
            if c.multiLine then
                when decision.placement is
                    FP.AsFirst ->
                        -- In an inline-start flow (a PrefixGlue/paren body whose
                        -- box the caller embeds mid-line) the content following
                        -- the comment's own lines must be re-indented by the
                        -- ENCLOSING flow's nest — but this box, once embedded as a
                        -- first-row item, cannot: its continuation lines are out
                        -- of the enclosing `flowIndent`'s reach. Fall back.
                        ownLine c.box

                    FP.GlueNoSep ->
                        ownLine c.box

                    FP.OwnLine ->
                        ownLine c.box

                    FP.GlueSpace ->
                        if Array.isEmpty acc.curRow then
                            -- No current-row content: the previous item was a block
                            -- (e.g. a dropped record); glue the comment onto its
                            -- last emitted row. `glueCommentSuffix` joins that row's
                            -- last line and pads a multi-line comment's body under
                            -- its start.
                            when Array.popLast acc.rows is
                                Just { last = lastBox, initial } ->
                                    Ok
                                        { rows = Array.pushLast (glueCommentSuffix c.box lastBox) initial
                                        , curRow = []
                                        , state = decision.next
                                        }

                                Nothing ->
                                    Err "box: glue with nothing before"

                        else
                            -- The comment's first line joins the current row and
                            -- its body flows below. `B.prefix` prepends the row
                            -- (plus a space) onto the comment box's first line
                            -- AND pads every continuation line by that width, so
                            -- the reindented comment body lands aligned under
                            -- the opening `{-`.
                            let
                                prefLine =
                                    B.row (Array.pushLast B.space (Array.intersperse B.space acc.curRow))
                            in
                            Ok
                                { rows = Array.pushLast (B.prefix prefLine c.box) acc.rows
                                , curRow = []
                                , state = decision.next
                                }

                    -- unreachable (all 6 arms below): `FP.commentPlacement`
                    -- only ever yields `AsFirst`/`GlueNoSep`/`GlueSpace`/
                    -- `OwnLine` for a comment item, so a multi-line comment
                    -- never carries any other `Placement`. Listed explicitly
                    -- (no `_ ->`) so a future `Placement` constructor fails to
                    -- compile here instead of silently falling into a wildcard.
                    FP.SoftSep ->
                        Err "box: unexpected multi-line comment placement"

                    FP.OwnLineAfterBlank ->
                        Err "box: unexpected multi-line comment placement"

                    FP.IndentNoBreak ->
                        Err "box: unexpected multi-line comment placement"

                    FP.BlockJoin _ ->
                        Err "box: unexpected multi-line comment placement"

                    FP.DropBlock _ ->
                        Err "box: unexpected multi-line comment placement"

                    FP.BlankLineOnly ->
                        Err "box: unexpected multi-line comment placement"

            else
                when B.isLine c.box is
                    Err _ ->
                        Err "box: single-line comment box was multi-line"

                    Ok l ->
                        if decision.next.separator == FP.AlreadyTerminated then
                            -- Line-terminating comment (a `--`, or a block
                            -- comment the policy put on its own line).
                            when decision.placement is
                                FP.AsFirst ->
                                    ownLine (B.line l)

                                FP.GlueNoSep ->
                                    ownLine (B.line l)

                                FP.OwnLine ->
                                    ownLine (B.line l)

                                FP.GlueSpace ->
                                    -- Same-row glue; the comment still ends the
                                    -- line.
                                    if Array.isEmpty acc.curRow then
                                        glueOntoLastRow acc l decision.next

                                    else
                                        Ok
                                            { rows = flushRow (Array.pushLast l acc.curRow) acc.rows
                                            , curRow = []
                                            , state = decision.next
                                            }

                                -- unreachable (all 6 arms below) — same reasoning
                                -- as the multi-line-comment block above:
                                -- `FP.commentPlacement` only ever yields
                                -- `AsFirst`/`GlueNoSep`/`GlueSpace`/`OwnLine`.
                                FP.SoftSep ->
                                    Err "box: unexpected terminating comment placement"

                                FP.OwnLineAfterBlank ->
                                    Err "box: unexpected terminating comment placement"

                                FP.IndentNoBreak ->
                                    Err "box: unexpected terminating comment placement"

                                FP.BlockJoin _ ->
                                    Err "box: unexpected terminating comment placement"

                                FP.DropBlock _ ->
                                    Err "box: unexpected terminating comment placement"

                                FP.BlankLineOnly ->
                                    Err "box: unexpected terminating comment placement"

                        else
                            -- Inline single-line block comment: joins the flow
                            -- like a token.
                            when decision.placement is
                                FP.AsFirst ->
                                    Ok { rows = acc.rows, curRow = [ l ], state = decision.next }

                                FP.GlueSpace ->
                                    if Array.isEmpty acc.curRow then
                                        glueOntoLastRow acc l decision.next

                                    else
                                        Ok { rows = acc.rows, curRow = Array.pushLast l acc.curRow, state = decision.next }

                                FP.SoftSep ->
                                    if Array.isEmpty acc.curRow then
                                        glueOntoLastRow acc l decision.next

                                    else
                                        Ok { rows = acc.rows, curRow = Array.pushLast l acc.curRow, state = decision.next }

                                FP.OwnLine ->
                                    Ok { rows = flushRow acc.curRow acc.rows, curRow = [ l ], state = decision.next }

                                -- unreachable (all 6 arms below): none of these,
                                -- including `GlueNoSep`, is ever assigned to a
                                -- comment item that reaches this inline
                                -- (non-`AlreadyTerminated`) branch in the current
                                -- wiring (see box-err.md §3 for the traced proof).
                                FP.GlueNoSep ->
                                    Err "box: unexpected inline comment placement"

                                FP.OwnLineAfterBlank ->
                                    Err "box: unexpected inline comment placement"

                                FP.IndentNoBreak ->
                                    Err "box: unexpected inline comment placement"

                                FP.BlockJoin _ ->
                                    Err "box: unexpected inline comment placement"

                                FP.DropBlock _ ->
                                    Err "box: unexpected inline comment placement"

                                FP.BlankLineOnly ->
                                    Err "box: unexpected inline comment placement"

        -- Materialize a non-comment item's placement. `leading` carries a
        -- paired leading comment box for the type-record drop (it drops WITH
        -- the record, stacked directly above the `{` at the drop indent).
        placeNonComment acc decision leading item =
            when decision.placement is
                FP.AsFirst ->
                    -- First item of the flow: the bare item (no wrap).
                    when B.isLine item.box is
                        Ok l ->
                            Ok { rows = acc.rows, curRow = [ l ], state = decision.next }

                        Err _ ->
                            -- A multi-line first item pushes as its own block.
                            -- This used to branch on "indented flow + nest-carrying
                            -- + contains a multi-line block comment", with a long
                            -- note about the two conflicting anchors that case has
                            -- (align-padded comment body lines vs ambient content
                            -- after it) — but both branches were the same bare
                            -- push, so the split decided nothing and the
                            -- `subtreeHasMultilineBlockComment` walk of the whole
                            -- subtree was pure cost. The bare push is the proven
                            -- materialization either way (MultilineBlockComments
                            -- `#13`; broken record-pattern headers,
                            -- PatternLayoutByAuthor).
                            Ok { rows = Array.pushLast item.box acc.rows, curRow = [], state = decision.next }

                FP.GlueNoSep ->
                    -- Content begins on the fresh line the previous comment
                    -- opened (the current row is empty after the comment's
                    -- flush).
                    when B.isLine item.box is
                        Ok l ->
                            Ok { rows = acc.rows, curRow = Array.pushLast l acc.curRow, state = decision.next }

                        Err _ ->
                            Ok { rows = Array.pushLast item.box (flushRow acc.curRow acc.rows), curRow = [], state = decision.next }

                FP.SoftSep ->
                    when B.isLine item.box is
                        Ok l ->
                            if Array.isEmpty acc.curRow then
                                glueOntoLastRow acc l decision.next

                            else
                                Ok { rows = acc.rows, curRow = Array.pushLast l acc.curRow, state = decision.next }

                        Err _ ->
                            -- Soft-glue a multi-line non-block item's first line
                            -- onto the running line (the separator flattens to a
                            -- space; inner hard breaks land per the item's own
                            -- alignment — see `softGlueAlignment`, the static
                            -- alignment table).
                            if Array.isEmpty acc.curRow then
                                -- The previous item was a block, so it flushed the
                                -- running row and left it empty — there is nothing
                                -- on the line to soft-glue this multi-line item
                                -- onto, so it stacks on its own fresh row (exactly
                                -- what the `AsFirst` Err arm does for the first
                                -- block). Reached when a pipeline step's trigger
                                -- `suffix` holds two or more multi-line block
                                -- arguments (`|> f a b c` with `b` and `c` both
                                -- multi-line): `splitStepTrigger` relocates only the
                                -- first, and the rest render through this flow, so a
                                -- block genuinely can follow a block here. Each lands
                                -- on its own line at the flow's indent — elm-format's
                                -- layout for a broken multi-argument call.
                                Ok { rows = Array.pushLast item.box acc.rows, curRow = [], state = decision.next }

                            else
                                let
                                    prefLine =
                                        B.row (Array.pushLast B.space (Array.intersperse B.space acc.curRow))
                                in
                                when softGlueAlignment item.node is
                                    AlignCarrying ->
                                        Ok
                                            { rows = Array.pushLast (B.prefix prefLine item.box) acc.rows
                                            , curRow = []
                                            , state = decision.next
                                            }

                                    AlignCarryingTabbed ->
                                        -- Record update / aligned flow: the same
                                        -- align anchor as `AlignCarrying`, but the
                                        -- box's continuation lines carry `Tab`s.
                                        -- Freeze them to literal spaces first so
                                        -- `B.prefix` shifts by its exact width
                                        -- instead of the tab stops re-snapping to
                                        -- absolute multiples of 4.
                                        Ok
                                            { rows = Array.pushLast (B.prefix prefLine (B.freezeTabs item.box)) acc.rows
                                            , curRow = []
                                            , state = decision.next
                                            }

                                    NestCarrying ->
                                        Ok
                                            { rows = Array.pushLast (B.mapFirstLine (\l -> B.row [ prefLine, l ]) identity item.box) acc.rows
                                            , curRow = []
                                            , state = decision.next
                                            }

                                    UnclassifiedCarrying ->
                                        -- Direct-operand lambda `|> (\x -> …)`:
                                        -- glue `(` after the operator, body at +8
                                        -- (two Tabs — the lambda body sits at the
                                        -- operator+8 column), and `)` on its own
                                        -- line aligned under the `(` (elm-format),
                                        -- three columns past the operator.
                                        --
                                        -- Both offsets are measured FROM the
                                        -- operator, so they are only right when the
                                        -- prefix is the operator and nothing else —
                                        -- `|> ` / `<| `, three columns. Anything
                                        -- more on the running line (in practice a
                                        -- single-line `{- c -}` sitting between the
                                        -- operator and its operand) moved the `(`
                                        -- without moving the body or the `)`, so the
                                        -- paren stopped lining up with its own
                                        -- close:
                                        --
                                        --     ++ {- c -} (\q ->
                                        --             q + one
                                        --           )
                                        --
                                        -- Shifting this box uniformly does not fix
                                        -- it: the `)` would still land three past
                                        -- the prefix instead of under the `(`. So a
                                        -- wider prefix falls through to the generic
                                        -- paren arm below, which anchors every row
                                        -- at the paren's own `(` column and so
                                        -- relocates correctly — already what a
                                        -- paren-wrapped `if` / `when` / binop does
                                        -- here, so this makes the lambda agree with
                                        -- them rather than adding a rule.
                                        when
                                            (if B.lineLength 0 prefLine == 3 then
                                                directOperandLambdaSplit item

                                             else
                                                Nothing
                                            )
                                        is
                                            Just { headLine, bodyBox } ->
                                                Ok
                                                    { rows =
                                                        Array.pushLast
                                                            (B.stack1
                                                                [ B.line (B.row [ prefLine, B.punc "(", headLine ])
                                                                , B.indent (B.indent bodyBox)
                                                                , B.prefix (B.row [ B.space, B.space, B.space ]) (B.line (B.punc ")"))
                                                                ]
                                                            )
                                                            acc.rows
                                                    , curRow = []
                                                    , state = decision.next
                                                    }

                                            Nothing ->
                                                -- Any other multi-line paren
                                                -- (`|> (if … )`, a `({ … } as n)`
                                                -- pattern): the paren box already
                                                -- anchors its continuation lines
                                                -- at its own `(` column, so
                                                -- `B.prefix` glues it after the
                                                -- running line and shifts every
                                                -- row by the prefix's width.
                                                when lpnBox item.node is
                                                    ParenBlock _ ->
                                                        if parenInnerIsAlignCarrying (lpnChildren item.node) then
                                                            -- An align-carrying literal inside the
                                                            -- parens holds its `,`/`}` under its own
                                                            -- opening bracket with `Tab`s. Freeze them
                                                            -- to spaces first, so the prefix shifts by
                                                            -- its exact width instead of the tab stops
                                                            -- re-snapping to absolute multiples of 4.
                                                            Ok
                                                                { rows = Array.pushLast (B.prefix prefLine (B.freezeTabs item.box)) acc.rows
                                                                , curRow = []
                                                                , state = decision.next
                                                                }

                                                        else
                                                            -- A block paren (`(if …)`, `(when …)`,
                                                            -- `(let …)`) glued straight after the
                                                            -- operator. Its `Tab`s are deliberately NOT
                                                            -- frozen: `makeParenBlockBox` indents the
                                                            -- body one `Tab` from the keyword, so they
                                                            -- must re-snap against the column the paren
                                                            -- actually lands in. That is exactly
                                                            -- elm-format's `|> (if cond then` shape --
                                                            -- `(` after the operator, body at the next
                                                            -- tab stop, `else`/`)` under the `(`.
                                                            Ok
                                                                { rows = Array.pushLast (B.prefix prefLine item.box) acc.rows
                                                                , curRow = []
                                                                , state = decision.next
                                                                }

                                                    _ ->
                                                        -- unreachable: to reach here an item must be a
                                                        -- SoftSep (non-first, inline non-broken flow),
                                                        -- multi-line, `UnclassifiedCarrying`, and NOT a
                                                        -- `ParenBlock`. The only boxes that are both
                                                        -- `LeafItem` (the `_ ->` in `factsFor`) and
                                                        -- `UnclassifiedCarrying` are `IfCondition`,
                                                        -- `WhenFlow`, and a raw `Binop` — none of which
                                                        -- can occupy this slot: a raw `Binop` is never a
                                                        -- flow sibling (`flattenBinopNodes` turns nested
                                                        -- operators into `OpAndRhs`/`NestCarrying`), and a
                                                        -- multi-line `when`/`if` operand only ever gets
                                                        -- there by spanning source rows, which forces the
                                                        -- binop vertical and routes it to the broken
                                                        -- assembler (`assembleBrokenWithComments`), never
                                                        -- this inline `SoftSep`. A `when`/`if` following an
                                                        -- operator is wrapped `OpAndRhs` (`NestCarrying`,
                                                        -- handled above), not a bare `SoftSep` item.
                                                        Err "unreachable: multi-line non-paren unclassified soft-glue item"

                FP.OwnLine ->
                    when B.isLine item.box is
                        Ok l ->
                            Ok { rows = flushRow acc.curRow acc.rows, curRow = [ l ], state = decision.next }

                        Err _ ->
                            Ok { rows = Array.pushLast item.box (flushRow acc.curRow acc.rows), curRow = [], state = decision.next }

                FP.IndentNoBreak ->
                    -- Block after a line-terminating comment: the item lands on
                    -- the fresh line at +grenIndent, with no extra break.
                    Ok
                        { rows = Array.pushLast (applyIndent grenIndent item.box) (flushRow acc.curRow acc.rows)
                        , curRow = []
                        , state = decision.next
                        }

                FP.BlockJoin { rule } ->
                    -- A block that drops to its own line takes its paired
                    -- leading comment (`pairLeadingComments`) down WITH it,
                    -- stacked directly above at the same indent — leaving the
                    -- comment glued to the head's row while the body drops
                    -- below it oscillates on reparse (the comment is then no
                    -- longer on the body's row, so the reparse routes it into
                    -- the body's own block and renders it own-line there).
                    -- Only `SoftIndentedRule`'s *inline* arm never gets a
                    -- `leading`: `stepUnwrapped` replays those unpaired.
                    let
                        withLeading box =
                            when leading is
                                Just commentBox ->
                                    B.stack1 [ commentBox, box ]

                                Nothing ->
                                    box
                    in
                    when rule is
                        FP.IndentedRule ->
                            Ok
                                { rows = Array.pushLast (applyIndent grenIndent (withLeading item.box)) (flushRow acc.curRow acc.rows)
                                , curRow = []
                                , state = decision.next
                                }

                        FP.BodyRule ->
                            Ok
                                { rows = Array.pushLast (withLeading item.box) (flushRow acc.curRow acc.rows)
                                , curRow = []
                                , state = decision.next
                                }

                        FP.SoftIndentedRule ->
                            -- Soft wrap: flat content glues onto the current line
                            -- with a space.
                            when B.isLine item.box is
                                Ok l ->
                                    if Array.isEmpty acc.curRow then
                                        glueOntoLastRow acc l decision.next

                                    else
                                        Ok { rows = acc.rows, curRow = Array.pushLast l acc.curRow, state = decision.next }

                                Err _ ->
                                    -- A multi-line soft-block body (a lambda body
                                    -- that started on the `->` row but wraps): drop
                                    -- it to its own line at +grenIndent, like the
                                    -- IndentedRule arm above. This matches elm-format
                                    -- for a call/binop body; a triple-quoted `"""…"""`
                                    -- body drops too (elm-format keeps that one inline
                                    -- — a small divergence, but dropping every
                                    -- multi-line lambda body uniformly is consistent
                                    -- and always renders, whereas gluing the string
                                    -- inline mis-aligns once the lambda is itself
                                    -- nested in a paren/call).
                                    Ok
                                        { rows = Array.pushLast (applyIndent grenIndent (withLeading item.box)) (flushRow acc.curRow acc.rows)
                                        , curRow = []
                                        , state = decision.next
                                        }

                FP.DropBlock rule ->
                    -- The type-record drop: the record (with its paired leading
                    -- comment stacked directly above the `{`, when present)
                    -- drops below the head. IndentedRule (unnested flow) lands
                    -- it at +grenIndent; BodyRule (the flow is already nested)
                    -- at the flow's continuation column.
                    let
                        dropIndent =
                            when rule is
                                FP.IndentedRule ->
                                    grenIndent

                                _ ->
                                    0

                        droppedBox =
                            when leading is
                                Just commentBox ->
                                    B.stack1 [ commentBox, item.box ]

                                Nothing ->
                                    item.box
                    in
                    Ok
                        { rows = Array.pushLast (applyIndent dropIndent droppedBox) (flushRow acc.curRow acc.rows)
                        , curRow = []
                        , state = decision.next
                        }

                FP.BlankLineOnly ->
                    Ok
                        { rows = Array.pushLast B.blankLine (flushRow acc.curRow acc.rows)
                        , curRow = []
                        , state = decision.next
                        }

                -- unreachable (both arms below; see box-err.md §3 for the
                -- traced proof): `GlueSpace` is never assigned to a
                -- non-comment `ItemFacts` case in `FP.decide`; `OwnLineAfterBlank`
                -- is assigned only to `FP.WhenBranchItem`, which `factsFor`
                -- never constructs (`WhenBranch` nodes route through the
                -- dedicated `renderWhenBranchesBox`/`makeWhenBranchBox` path,
                -- never through this generic flow assembler).
                FP.GlueSpace ->
                    Err "box: unexpected flow placement"

                FP.OwnLineAfterBlank ->
                    Err "box: unexpected flow placement"

        step paired accResult =
            accResult |> Result.andThen (stepUnwrapped paired)

        stepUnwrapped paired acc =
            let
                item =
                    paired.item

                decision =
                    let
                        base =
                            FP.decide config acc.state (factsFor item)
                    in
                    if subtreeEndsWithLineComment item.node then
                        -- This item's rendered box ends its last line in an open
                        -- `--` (a `--` buried at the end of a multi-line operand's
                        -- subtree — e.g. a `<|`-pipeline operand whose last step is
                        -- `"""…""" -- c`). The following operator/leaf would glue
                        -- onto that line via `glueOntoLastRow`, landing inside the
                        -- comment and being swallowed. Leave the separator
                        -- `AlreadyTerminated` — the state a `--` comment ITEM
                        -- leaves, meaning "the previous line ended in a terminating
                        -- comment; the next item starts its own line, no glue".
                        { base | next = { separator = FP.AlreadyTerminated } }

                    else
                        base
            in
            when item.comment is
                Just c ->
                    placeCommentItem acc decision c

                Nothing ->
                    when paired.leading is
                        Nothing ->
                            placeNonComment acc decision Nothing item

                        Just leadItem ->
                            -- A single-line block comment paired with the
                            -- item that follows it (`pairLeadingComments`):
                            -- a type record, or a soft block that rendered
                            -- multi-line. When the placement drops that item
                            -- to its own line, the comment drops WITH it;
                            -- otherwise replay the exact unpaired steps
                            -- (comment first, then re-decide the item against
                            -- the state the comment left).
                            let
                                dropsTogether =
                                    when decision.placement is
                                        FP.DropBlock _ ->
                                            True

                                        FP.BlockJoin { rule = rule } ->
                                            -- Every block rule puts the item on
                                            -- its own line EXCEPT a soft block
                                            -- that rendered single-line, which
                                            -- glues onto the running row — its
                                            -- comment has to be replayed inline
                                            -- ahead of it instead.
                                            rule
                                                /= FP.SoftIndentedRule
                                                || not (isSingleLine item.box)

                                        _ ->
                                            False
                            in
                            if dropsTogether then
                                placeNonComment acc
                                    decision
                                    (leadItem.comment |> Maybe.map (\lc -> lc.box))
                                    item

                            else
                                when leadItem.comment is
                                    Just lc ->
                                        let
                                            leadDecision =
                                                FP.decide config acc.state (factsFor leadItem)
                                        in
                                        placeCommentItem acc leadDecision lc
                                            |> Result.andThen
                                                (\a ->
                                                    let
                                                        recDecision =
                                                            FP.decide config a.state (factsFor item)
                                                    in
                                                    placeNonComment a recDecision Nothing item
                                                )

                                    Nothing ->
                                        placeNonComment acc decision Nothing item
    in
    Array.foldl step
        (Ok { rows = [], curRow = [], state = FP.initialFlowState })
        (pairLeadingComments items)
        |> Result.andThen
            (\final ->
                let
                    allRows =
                        flushRow final.curRow final.rows
                in
                when Array.popFirst allRows is
                    Nothing ->
                        Err "box: empty flow"

                    Just { first, rest } ->
                        -- The first row sits at the flow's own column; every
                        -- continuation row is indented by `flowIndent`, the outer
                        -- nest wrapping the whole flow. Block rows already carry
                        -- their own indent (the placement applied it), so this
                        -- brings them to `flowIndent + ownIndent`.
                        Ok (B.stack1 ([ first ] ++ Array.map (applyIndent flowIndent) rest))
            )
