module Formatter.Logical.MakeLogical exposing (lptFromAst)

{-| Walk a parsed module's Abstract Syntax Tree into a raw Logical Printing
Tree — one `OriginalRows` child per top-level declaration. The finishing passes
(comments, symbol sorting, blank lines) run in `Formatter.Logical`, which is the
stage's entry point.

@docs lptFromAst
-}

import Array.Builder as Builder
import Compiler.Ast.Source as Src
import Compiler.SourcePosition exposing (Located, Position)
import Math exposing (maxSafeInteger)

import Formatter.Logical.InsertExpressions exposing (insertExpression)
import Formatter.Logical.InsertPatterns exposing (folderInsertPattern)
import Formatter.Logical.InsertTypes exposing (makeSignatureBranch)
import Formatter.Logical.LPTHelpers exposing (endOfToken, mkText, mkTextFromLocString, mkZeroWidthText, plainAcross, resultFoldl)
import Formatter.Logical.LogicalPrintingTree exposing
    ( LPBox(..)
    , LPNode(..)
    , ListBrackets(..)
    , SyntaxType(..)
    , lastRowInSubtree
    , lpnBox
    , lpnBracketNode
    , lpnChildren
    , lpnElasticBracketNode
    , lpnLeaf
    , lpnNode
    )


{-| Walk the AST and produce a root `LPNode` whose children are one
`OriginalRows` per top-level declaration.

Each `process*` step appends to a running `Array.Builder` (amortized O(1)
per append) rather than an `LPNode` rebuilt from scratch on every call —
threading the root itself as the accumulator meant every single-child
append re-copied the full children array *and* re-folded the whole array
to refresh the cached subtree bounds, making an N-declaration module
O(N^2). The builder is only converted to a real `LPNode` (one `lpnNode`
call, O(N)) once, after every declaration has been appended. Declarations
are added in declaration-kind order (values, aliases, unions, ports,
infix) rather than source order; the final `sortOriginalRows` pass
restores source order using the row ranges recorded on each
`OriginalRows` box.
-}
lptFromAst : Src.Module -> Result String LPNode
lptFromAst modAst =
    let
        builder =
            Builder.empty 0
    in
    processModuleLine modAst builder
        |> Result.map (processFunctionDoc modAst.docs)
        |> Result.andThen (processImports modAst)
        |> Result.andThen (\b -> resultFoldl processModDecl b modAst.values)
        |> Result.andThen (\b -> resultFoldl processAliasDecl b modAst.aliases)
        |> Result.andThen (\b -> resultFoldl processUnionDecl b modAst.unions)
        |> Result.andThen (processPorts modAst)
        |> Result.andThen (processInfixDecls modAst)
        |> Result.map (\b -> lpnNode RootBox (Builder.toArray b))
        |> Result.map sortOriginalRows


{-| Sort the root's children by their source-row range so declarations
appear in source order regardless of the order in which `lptFromAst`
appended them.
-}
sortOriginalRows : LPNode -> LPNode
sortOriginalRows root =
    let
        sorted =
            Array.sortWith
                (\a b ->
                    when { a = lpnBox a, b = lpnBox b } is
                        { a = OriginalRows { last = alast }, b = OriginalRows { first = bfirst } } ->
                            compare alast bfirst

                        _ ->
                            compare 0 1
                )
                (lpnChildren root)
    in
    lpnNode (lpnBox root) sorted


{-| Build an `OriginalRows` node spanning `firstRow` through the largest
positioned row found anywhere in `children`.
-}
makeOrigRows : Int -> SyntaxType -> Array LPNode -> LPNode
makeOrigRows firstRow stype children =
    let
        last =
            Array.foldl (\child acc -> max acc (lastRowInSubtree child)) -1 children
    in
    lpnNode (OriginalRows { first = firstRow, last = last, stype = stype }) children


{-| Append `child` to the running root-children builder, returning the
updated builder. Amortized O(1) — see `lptFromAst`.
-}
addRootChild : LPNode -> Builder.Builder LPNode -> Builder.Builder LPNode
addRootChild child builder =
    Builder.pushLast child builder


{-| Emit the `module ... exposing (...)` line as a single `StModule`
`OriginalRows` child of the root. Handles all three module kinds:

    module Foo exposing (a, b)
    port module Foo exposing (..)
    effect module Foo where { command = MyCmd, subscription = MySub } exposing (..)
-}
processModuleLine : Src.Module -> Builder.Builder LPNode -> Result String (Builder.Builder LPNode)
processModuleLine modAst root =
    let
        keyword =
            when modAst.effects is
                Src.Ports _ ->
                    "port module"

                Src.Manager _ ->
                    "effect module"

                Src.NoEffects ->
                    "module"

        -- Zero-width: `port module` / `effect module` are rendered as one
        -- multi-word token, but a real width would let a comment written
        -- *between* the words (`port {- c -} module`) fall inside the token's
        -- span and sort before it, escaping to before the module keyword —
        -- which does not parse. Anchored zero-width at column 1, any header
        -- comment sorts after it instead.
        --
        -- Row 1, NOT the module name's row: the keyword always renders on the
        -- module's first output row, but a header comment that itself forces
        -- a break (multi-line, or a `--` line comment) pushes the name onto a
        -- continuation row (`effect module {- … -}⏎    Name …`). A comment's
        -- *length* alone never does this — layout is author-driven, not
        -- width-driven. Anchoring at the name's row would then place the
        -- keyword *below* a comment on row 1, so the comment would sort
        -- before the keyword and escape ahead of it on reparse
        -- (non-idempotent, and unparseable).
        keywordNode =
            lpnLeaf (mkZeroWidthText { row = 1, col = 1 } keyword)

        nameNode =
            lpnLeaf (mkTextFromLocString modAst.name)

        whereNodes =
            buildWhereBlock modAst.effects

        exposingPos =
            endOfToken modAst.name.start modAst.name.value

        -- `exposing` has no position in the AST, so it is anchored at the end of
        -- the module name per the standard rule (see `mkZeroWidthText`).
        --
        -- For `effect module … where { … } exposing` the real column depends on
        -- the where-block's contents and is not tracked, so there is no honest
        -- anchor and this falls back to a position-less `SynthesizedText`.
        exposingNode =
            when modAst.effects is
                Src.Manager _ ->
                    lpnLeaf (SynthesizedText "exposing")

                _ ->
                    lpnLeaf (mkZeroWidthText exposingPos "exposing")

        exportsNode =
            when modAst.exports is
                Src.Open ->
                    -- Anchor `(..)` at the module name's end (`exposingPos`, the
                    -- same real position the synthesized `exposing` keyword uses),
                    -- so a trailing `-- c` on the header's row glues onto that row
                    -- (`TrailsPrevious`) instead of dropping to its own line, which
                    -- oscillated indented↔col-0 on reparse — a bare position-less
                    -- `SynthesizedText` gave the trailing `--` no glue row. For an
                    -- effect module the exposing area's real column depends on the
                    -- where-block contents and isn't tracked, so `exposing` itself
                    -- falls back to `SynthesizedText`; keep `(..)` position-less
                    -- there too.
                    when modAst.effects is
                        Src.Manager _ ->
                            lpnLeaf (SynthesizedText "(..)")

                        _ ->
                            lpnLeaf (mkZeroWidthText exposingPos "(..)")

                Src.Explicit exposed ->
                    let
                        itemNodes =
                            Array.map processExposed exposed

                        -- Either shape of author-written vertical list: names on
                        -- separate rows, or a single name dropped below the
                        -- header. Both decide the box AND the derived `)` row,
                        -- which have to agree or a pinned comment escapes.
                        --
                        -- "Below the header" is measured against the header's
                        -- LAST row, not the module name's. An effect module's
                        -- `where { … }` block can wrap, putting a list the
                        -- author wrote flat several rows below the name; calling
                        -- that vertical loses the flat list's comment pinning
                        -- and the header goes back to depending on the order the
                        -- names were written in.
                        -- `+ 1` for the same untracked row `moduleLineClosesBelow`
                        -- exists for: a wrapped `where { … }` puts its `}` — and
                        -- the `exposing` after it — one row below the last field,
                        -- and neither carries a position.
                        headerLastRow =
                            Array.foldl
                                (\n acc -> max acc (lastRowInSubtree n))
                                modAst.name.start.row
                                ([ nameNode ] ++ whereNodes)
                                + (if moduleLineClosesBelow modAst then
                                        1

                                   else
                                        0
                                  )

                        vertical =
                            exposedSpansRows exposed
                                || exposedStartsBelowHeader headerLastRow exposed

                        listBox =
                            exposingListBox vertical
                    in
                    when moduleExposingClose vertical exposed is
                        Just closePos ->
                            -- Elastic, not exact: the `)` is derived from the
                            -- items, so it has to move down as comments are
                            -- pinned above it. See `lpnElasticBracketNode`.
                            lpnElasticBracketNode listBox closePos itemNodes

                        Nothing ->
                            lpnNode listBox itemNodes

        -- The module line's range starts at row 1, the keyword's row (see
        -- keywordNode), NOT the module name's row. A long header comment can push the name
        -- onto row 2; if `first` were the name's row, a comment on row 1
        -- (between the keyword and the name) would fall before the module
        -- line's range and be re-attached as a top-level comment *ahead* of the
        -- module keyword on reparse — which does not parse (non-idempotent).
        base =
            makeOrigRows 1 StModule ([ keywordNode, nameNode ] ++ whereNodes ++ [ exposingNode, exportsNode ])

        -- A vertical `exposing ( … )` or `where { … }` puts its closing bracket
        -- one row below the last positioned item, so extend the module line's
        -- range to cover it (see `moduleLineClosesBelow`).
        origRow =
            if moduleLineClosesBelow modAst then
                when lpnBox base is
                    OriginalRows r ->
                        lpnNode (OriginalRows { r | last = r.last + 1 }) (lpnChildren base)

                    _ ->
                        base

            else
                base
    in
    Ok (addRootChild origRow root)


{-| For effect modules, the `where { command = …, subscription = … }` block
between the module name and `exposing`; empty for non-effect modules. The block
lists which constructors handle `command` and/or `subscription` effects; Cmd/Sub/Fx
correspond to "only commands", "only subscriptions", and "both" respectively.
-}
buildWhereBlock : Src.Effects -> Array LPNode
buildWhereBlock effects =
    when effects is
        Src.Manager manager ->
            let
                -- Each "field" of the `where { ... }` block is one
                -- list item (an AcrossOrVertical containing the
                -- `name = Ctor` tokens) so the surrounding list
                -- joins items with commas, not the inner tokens.
                --
                -- The label keyword ("command" / "subscription") and
                -- the `=` are not separate tokens in the AST, and
                -- nothing before them is either — the `where`, the
                -- `{` and the comma carry no position — so there is
                -- no real token to anchor them to. They are therefore
                -- position-less `SynthesizedText`, which is what
                -- `mkZeroWidthText`'s anchoring policy prescribes for
                -- exactly this case.
                --
                -- They used to be anchored by counting BACKWARDS from
                -- the constructor (`ctorCol - 3 - String.count label`),
                -- which is the one thing that policy forbids: it is an
                -- anchor derived from the token that FOLLOWS, so it is
                -- only correct when the author wrote `label = Ctor`
                -- with single spaces. Put a comment in that gap and the
                -- derived columns land *inside the comment's own text*,
                -- which handed a comment run one member on each side of
                -- the `{` and made the header non-idempotent (a run of
                -- two block comments in the `=` gap of every effect
                -- header in the corpus). Without positions, every
                -- comment written left of the constructor sorts before
                -- the block and collapses to the one slot between
                -- `where` and `{`, which is the rendering
                -- `AmbiguousEffectModule` already documents as
                -- canonical for this header.
                binding label locName =
                    plainAcross
                        [ lpnLeaf (SynthesizedText label)
                        , lpnLeaf (SynthesizedText "=")
                        , lpnLeaf (mkTextFromLocString locName)
                        ]

                fields =
                    when manager is
                        Src.Cmd locName ->
                            [ binding "command" locName ]

                        Src.Sub locName ->
                            [ binding "subscription" locName ]

                        Src.Fx { cmd = cmd, sub = sub } ->
                            [ binding "command" cmd
                            , binding "subscription" sub
                            ]
            in
            [ lpnLeaf (SynthesizedText "where")
            , lpnNode (AllAcrossOrAllVertical ListCurly) fields
            ]

        _ ->
            []


{-| The synthesized closing-bracket position of a module header's
`exposing ( … )` list; `Nothing` only when there are no exposed names at all.

An import hands `lpnBracketNode` its real closing position (`locImport.end` is
one column past the `)`), but the module header's `)` has no position anywhere
in the AST, so this synthesizes one. The column is always `maxSafeInteger` —
"past anything that can appear on this row" — which makes the inside/outside
call depend only on the row. The row is where the `)` would sit given the items:
one below the last for a **vertical** list, the item row itself for a **flat**
one.

Both rows are a *starting* guess, and the caller wires them up with
`lpnElasticBracketNode` rather than `lpnBracketNode` precisely because a guess
from the items alone cannot survive a comment being placed inside — the comment
pushes the real `)` down by however many rows it occupies. The elastic close
grows to follow (see `lpnElasticBracketNode`), which is what lets a whole chain
of trailing comments stay pinned above the `)` instead of the second link
falling past the list and detaching to column 1.

The flat list gets a close too, and that is a deliberate reversal of an earlier
decision. On a single row "inside the brackets" and "past the `)`" are
indistinguishable — `(a, b {- c -})` and `(a, b) {- c -}` put the comment in the
same place — so this used to return `Nothing` and let
`Formatter.Logical.Comments.commentInsideTrailingBracket`'s two-column slack
guess from the gap width. That made the output depend on whitespace the author
never thought about *and* on the order the names were typed in (the comment rode
whichever name was written last, then travelled with it through the sort). Both
readings are now the same one: the comment belongs to the list and is pinned
above the `)`. What that costs is the ability to attach a comment to the last
name of a *flat* list; a vertical list, whose `)` has a row of its own, still
tells the two apart. See `SortSymbols.unfoldLastTrailing` and the README's
"A comment past a flat list".

-}
moduleExposingClose : Bool -> Array Src.Exposed -> Maybe Position
moduleExposingClose vertical exposed =
    let
        lastItemRow =
            Array.foldl (\item acc -> max acc (exposedRow item)) 1 exposed
    in
    if Array.isEmpty exposed then
        Nothing

    else if vertical then
        Just { row = lastItemRow + 1, col = maxSafeInteger }

    else
        -- A flat list closes on the row it opened on. `col = maxSafeInteger`
        -- puts every comment on that row inside the list rather than past it:
        -- the `)` has no position, so `(a, b {- c -})` and `(a, b) {- c -}`
        -- are indistinguishable, and treating both as inside is the choice
        -- that does not depend on the order the names were written in.
        Just { row = lastItemRow, col = maxSafeInteger }


{-| True when the module line's closing bracket sits one row below its last
positioned item, so its `OriginalRows` range must be bumped by a row.

This covers the vertical effect-module `where { … }` block (only `Fx` has two
fields and can wrap): the closing `}` — and the `exposing` after it — drop below
the last field, and neither has an AST position. (The other such bracket, a
vertical `exposing ( … )` list, no longer needs the bump: `moduleExposingClose`
gives it a synthesized closing position, and `lpnBracketNode` already widens the
node's row range to cover it.)

Without the bump, VerticalSpace sees a spurious one-row gap to the first
declaration and inserts a blank line on reparse (non-idempotent). -}
moduleLineClosesBelow : Src.Module -> Bool
moduleLineClosesBelow modAst =
    when modAst.effects is
        Src.Manager (Src.Fx { cmd = cmd, sub = sub }) ->
            sub.start.row > cmd.start.row

        _ ->
            False


{-| Render a single item in an `exposing (...)` list.

    foo               -- ExposedLower
    Maybe(..)         -- ExposedUpper Public
    Maybe             -- ExposedUpper Private
    (+)               -- ExposedOperator
-}
processExposed : Src.Exposed -> LPNode
processExposed exposed =
    when exposed is
        Src.ExposedLower sp ->
            lpnLeaf (UnbreakableText sp)

        Src.ExposedUpper { name = sp, privacy = privacy } ->
            when privacy is
                Src.Public ->
                    lpnLeaf (UnbreakableText { sp | value = sp.value ++ "(..)" })

                Src.Private ->
                    lpnLeaf (UnbreakableText sp)

        Src.ExposedOperator sp ->
            lpnLeaf (UnbreakableText { sp | value = "(" ++ sp.value ++ ")" })


{-| The source row of an exposed item — used to detect whether the module
`exposing` list wrapped onto multiple rows (so its closing `)` occupies an
extra row not otherwise represented in the AST). -}
exposedRow : Src.Exposed -> Int
exposedRow exposed =
    when exposed is
        Src.ExposedLower sp ->
            sp.start.row

        Src.ExposedUpper { name = sp } ->
            sp.start.row

        Src.ExposedOperator sp ->
            sp.start.row


{-| True when the module header's `exposing ( … )` list opened on a row below
the header keyword — the author wrote it in the dropped form:

    module Foo exposing
        ( a
        )

`exposedSpansRows` cannot see this on a **one-item** list: with a single name
there is no later item to compare against, so it always answers "flat", the
derived `)` lands on the item's own row, and a comment pinned above the `)`
falls past the list and detaches on reparse. Comparing against the header row
answers for any item count. -}
exposedStartsBelowHeader : Int -> Array Src.Exposed -> Bool
exposedStartsBelowHeader headerRow exposed =
    when Array.first exposed is
        Just firstExposed ->
            exposedRow firstExposed > headerRow

        Nothing ->
            False


{-| True when the author wrote an `exposing ( … )` list across multiple rows
(its last item sits on a later row than its first). This is the author-layout
decision for an exposing list — the same role `itemsSpanRows` plays for array
and record literals. It is computed once here and carried downstream by the
box choice (`exposingListBox`), so `Formatter.Render` reads the box rather than
re-deriving the row span from the items. -}
exposedSpansRows : Array Src.Exposed -> Bool
exposedSpansRows exposed =
    when Array.popFirst exposed is
        Just { first = firstExposed, rest } ->
            when Array.last rest is
                Just lastExposed ->
                    exposedRow lastExposed > exposedRow firstExposed

                Nothing ->
                    False

        Nothing ->
            False


{-| The bracket box for an `exposing ( … )` list: `AlwaysVertical` when the
author wrote it across rows (so it stays one-item-per-line), otherwise
`AllAcrossOrAllVertical` (inline unless it carries a comment). Mirrors the
literal-vs-multiline box choice array/record literals make from
`itemsSpanRows`. -}
exposingListBox : Bool -> LPBox
exposingListBox spansRows =
    if spansRows then
        AlwaysVertical ListParen

    else
        AllAcrossOrAllVertical ListParen


processImports : Src.Module -> Builder.Builder LPNode -> Result String (Builder.Builder LPNode)
processImports modAst root =
    Ok <| Array.foldl processImport root modAst.imports


{-| Emit one `import ...` line as an `StImport` `OriginalRows`.

    import Foo
    import Foo as F
    import Foo exposing (a, b)
    import Foo as F exposing (..)
-}
processImport : Located Src.Import -> Builder.Builder LPNode -> Builder.Builder LPNode
processImport locImport root =
    let
        keywordNode =
            lpnLeaf (mkText { row = locImport.start.row, col = 1 } "import")

        moduleNode =
            lpnLeaf (mkTextFromLocString locImport.value.module_)

        -- `as`, the alias name, and `exposing` have no AST positions; only the
        -- module name and the import's overall end are recorded. Anchor the
        -- elided tokens zero-width at *real* positions (never at synthesized
        -- intermediate columns — those collided with comments sitting in the
        -- gaps and flipped sides across reformats):
        --
        --   - `as` + the alias sit at `locImport.end` (the import's true end).
        --     Every comment authored inside the import head — either side of
        --     `as`, or on its own row in a wrapped head — then sorts *before*
        --     them, giving the one canonical rendering
        --     `import Foo {- c -} as Bar`; a comment past the import still
        --     sorts after. Anchoring at the end also makes the alias leaves
        --     carry the import's true last row, so the OriginalRows range
        --     covers a multi-row `import Foo as ⏎ Bar` head with no special
        --     case.
        --   - `exposing` sits at the module name's end, so a comment in the
        --     exposing area sorts after it (canonical:
        --     `exposing {- c -} ( … )`).
        modEnd =
            locImport.value.module_.end

        aliasNodes =
            when locImport.value.alias is
                Nothing ->
                    []

                Just name ->
                    [ lpnLeaf (mkZeroWidthText locImport.end "as")
                    , lpnLeaf (mkZeroWidthText locImport.end name)
                    ]

        exposingStart =
            modEnd

        -- Emit `exposing (...)` after the module name. `Open` is the
        -- wildcard `(..)` form; `Explicit` is a list of items (an empty
        -- list means no `exposing` clause at all and is skipped).
        exposeNodes =
            when locImport.value.expose is
                Src.Open ->
                    -- Anchor `(..)` at `locImport.end` (past the `)`), exactly the
                    -- position the `Explicit` branch below uses. A bare
                    -- position-less `SynthesizedText` gave a trailing `-- c` no
                    -- glue row, so it classified `LeadsOwnLine`, dropped below the
                    -- import, then escaped the import's row range on reparse and
                    -- oscillated indented↔col-0. With a real end position the `--`
                    -- glues onto the import line (`TrailsPrevious`), matching how
                    -- `import Foo exposing (a, b) -- c` already round-trips.
                    [ lpnLeaf (mkZeroWidthText exposingStart "exposing")
                    , lpnLeaf (mkZeroWidthText locImport.end "(..)")
                    ]

                Src.Explicit xlist ->
                    when Array.popFirst xlist is
                        Just _ ->
                            [ lpnLeaf (mkZeroWidthText exposingStart "exposing")
                            -- `locImport.end` is past the closing `)`, so the
                            -- import's row range covers it. Without this, a
                            -- comment that forces the exposing list multi-line
                            -- leaves the import's last row at the last exposed
                            -- name, and the `)` line reads as a one-row gap
                            -- before the next declaration — inserting a blank
                            -- line non-idempotently.
                            , lpnBracketNode (exposingListBox (exposedSpansRows xlist)) locImport.end (Array.map processExposed xlist)
                            ]

                        Nothing ->
                            []

        allChildren =
            [ keywordNode, moduleNode ] ++ aliasNodes ++ exposeNodes

        origRow =
            makeOrigRows locImport.start.row StImport allChildren
    in
    addRootChild origRow root


processPorts : Src.Module -> Builder.Builder LPNode -> Result String (Builder.Builder LPNode)
processPorts modAst root =
    when modAst.effects is
        Src.NoEffects ->
            Ok root

        Src.Ports ports ->
            resultFoldl processPortDecl root ports

        Src.Manager _ ->
            Ok root


{-| Emit one `port name : Signature` declaration as an `StPort`
`OriginalRows`, preceded by its doc comment if any.

    port someCmd : (String -> msg) -> Sub msg
-}
processPortDecl : Src.ModuleDeclaration Src.Port -> Builder.Builder LPNode -> Result String (Builder.Builder LPNode)
processPortDecl modDecl root =
    let
        port_ =
            modDecl.value.value

        portNode =
            lpnLeaf (mkText { row = modDecl.start.row, col = 1 } "port")

        nameNode =
            lpnLeaf (mkTextFromLocString port_.name)

        colonNode =
            lpnLeaf (mkZeroWidthText port_.name.end ":")

        rootWithDoc =
            processFunctionDoc modDecl.value.docs root
    in
    makeSignatureBranch port_.signature
        |> Result.map
            (\typeNodes ->
                let
                    allChildren =
                        [ portNode, nameNode, colonNode ] ++ typeNodes

                    origRow =
                        makeOrigRows modDecl.start.row StPort allChildren
                in
                addRootChild origRow rootWithDoc
            )


{-| Emit one `type ... = Variants` declaration as an `StTypeUnion`
`OriginalRows`, preceded by its doc comment if any.

    type Maybe a
        = Nothing
        | Just a
-}
processUnionDecl : Src.ModuleDeclaration Src.Union -> Builder.Builder LPNode -> Result String (Builder.Builder LPNode)
processUnionDecl modDecl root =
    let
        union_ =
            modDecl.value.value

        typeNode =
            lpnLeaf (mkText { row = modDecl.start.row, col = 1 } "type")

        nameNode =
            lpnLeaf (mkTextFromLocString union_.name)

        varNodes =
            Array.map (\v -> lpnLeaf (mkTextFromLocString v)) union_.vars

        rootWithDoc =
            processFunctionDoc modDecl.value.docs root
    in
    resultFoldl processVariantNode [] union_.variants
        |> Result.map
            (\variantNodes ->
                let
                    variantsBlock =
                        lpnNode IndentedBlock variantNodes

                    allChildren =
                        [ typeNode, nameNode ] ++ varNodes ++ [ variantsBlock ]

                    origRow =
                        makeOrigRows modDecl.start.row StTypeUnion allChildren
                in
                addRootChild origRow rootWithDoc
            )


{-| Fold one union variant into the running array of variant nodes.

The first variant gets `=`, subsequent ones get `|`. Any payload is
wrapped in `SoftIndentedBlock` so it can drop to its own line when the
variant overflows.

    = Nothing
    | Just a
-}
processVariantNode : Located Src.UnionVariant -> Array LPNode -> Result String (Array LPNode)
processVariantNode locVariant accNodes =
    let
        isFirst =
            Array.isEmpty accNodes

        prefixNode =
            lpnLeaf
                (SynthesizedText
                    (if isFirst then
                        "="

                     else
                        "|"
                    )
                )

        nameNode =
            lpnLeaf (mkTextFromLocString locVariant.value.name)
    in
    when locVariant.value.payload is
        Nothing ->
            Ok (Array.pushLast (plainAcross [ prefixNode, nameNode ]) accNodes)

        Just payloadType ->
            makeSignatureBranch payloadType
                |> Result.map
                    (\payloadNodes ->
                        let
                            payloadBlock =
                                lpnNode SoftIndentedBlock payloadNodes
                        in
                        Array.pushLast (plainAcross [ prefixNode, nameNode, payloadBlock ]) accNodes
                    )


{-| Emit one `type alias` declaration as an `StTypeAlias`
`OriginalRows`, preceded by its doc comment if any.

    type alias Point =
        { x : Int, y : Int }
-}
processAliasDecl : Src.ModuleDeclaration Src.Alias -> Builder.Builder LPNode -> Result String (Builder.Builder LPNode)
processAliasDecl modDecl root =
    let
        alias_ =
            modDecl.value.value

        typeAliasNode =
            lpnLeaf (mkText { row = modDecl.start.row, col = 1 } "type alias")

        nameNode =
            lpnLeaf (mkTextFromLocString alias_.name)

        varNodes =
            Array.map (\v -> lpnLeaf (mkTextFromLocString v)) alias_.vars

        eqNode =
            lpnLeaf (SynthesizedText "=")

        rootWithDoc =
            processFunctionDoc modDecl.value.docs root
    in
    makeSignatureBranch alias_.type_
        |> Result.map
            (\typeNodes ->
                let
                    typeBlock =
                        lpnNode IndentedBlock typeNodes

                    allChildren =
                        [ typeAliasNode, nameNode ] ++ varNodes ++ [ eqNode, typeBlock ]

                    origRow =
                        makeOrigRows modDecl.start.row StTypeAlias allChildren
                in
                addRootChild origRow rootWithDoc
            )


{-| Emit one top-level value declaration as up to three sibling
`OriginalRows` — a `StDocComment` for the doc (if any), a
`StFunctionSignature` for the type signature (if any), and a
`StFunctionDeclaration` for the body.

    {-| optional doc -}
    foo : Int -> Int
    foo x =
        x + 1
-}
processModDecl : Src.ModuleDeclaration Src.Value -> Builder.Builder LPNode -> Result String (Builder.Builder LPNode)
processModDecl modDecl root =
    let
        rootWithDoc =
            processFunctionDoc modDecl.value.docs root
    in
    processFunctionSignature modDecl.value.value.name modDecl.value.value.signature rootWithDoc
        |> Result.andThen (processFunctionBody modDecl.value.value)


{-| Emit the value declaration's body row.

The body always drops to the next line (`BodyBlock` = forced hard
newline) — one rule for every binding body, with no inline form, however
simple the body is.

    foo x =
        x + 1

    answer =
        42
-}
processFunctionBody : Src.Value -> Builder.Builder LPNode -> Result String (Builder.Builder LPNode)
processFunctionBody modVal root =
    let
        nameNode =
            lpnLeaf (mkTextFromLocString modVal.name)

        eqNode =
            lpnLeaf (SynthesizedText "=")
    in
    resultFoldl folderInsertPattern [] modVal.args
        |> Result.andThen
            (\argsNodes ->
                insertExpression modVal.body
                    |> Result.map
                        (\bodyNodes ->
                            let
                                header =
                                    plainAcross ([ nameNode ] ++ argsNodes ++ [ eqNode ])

                                bodyWrapper =
                                    lpnNode BodyBlock bodyNodes

                                allChildren =
                                    [ header, bodyWrapper ]
                            in
                            addRootChild (makeOrigRows modVal.name.start.row StFunctionDeclaration allChildren) root
                        )
            )


{-| Maybe or maybe not insert a DocComment for this function
-}
processFunctionDoc : Maybe (Located String) -> Builder.Builder LPNode -> Builder.Builder LPNode
processFunctionDoc maybeLocString root =
    when maybeLocString is
        Just locString ->
            let
                docNode =
                    lpnLeaf (DocComment locString)

                origRow =
                    makeOrigRows locString.start.row StDocComment [ docNode ]
            in
            addRootChild origRow root

        Nothing ->
            root


{-| Maybe or maybe not insert a FunctionSignature for this function
-}
processFunctionSignature : Located String -> Maybe { start : Position, type_ : Located Src.Type_ } -> Builder.Builder LPNode -> Result String (Builder.Builder LPNode)
processFunctionSignature locName maybeType root =
    when maybeType is
        Nothing ->
            Ok root

        Just { start = sigStart, type_ = locType } ->
            makeSignatureBranch locType
                |> Result.map
                    (\typeNodes ->
                        let
                            -- `locName` is the AST's `name` location, which always
                            -- points at the *definition's* name (the second
                            -- occurrence in a `foo : T\nfoo = …` shape). Use the
                            -- signature's own `start` position for the name node
                            -- so the StFunctionSignature OriginalRows' row range
                            -- doesn't stretch all the way down to the definition
                            -- — that would suck a line comment sitting between
                            -- signature and definition into the signature row.
                            sigNameEnd =
                                endOfToken sigStart locName.value

                            nameNode =
                                lpnLeaf (UnbreakableText { start = sigStart, end = sigNameEnd, value = locName.value })

                            colonNode =
                                lpnLeaf (mkZeroWidthText sigNameEnd ":")

                            allChildren =
                                [ nameNode, colonNode ] ++ typeNodes

                            -- The signature's row range starts at the name
                            -- (`sigStart`), not the type. For a multi-line
                            -- signature (`foo :` on one row, the type below)
                            -- using the type's row would leave a phantom one-row
                            -- gap above the signature, which makes a preceding
                            -- adjacent comment look non-adjacent and the blank-line
                            -- pass non-idempotent.
                            --
                            -- The range must also extend to the type's end
                            -- (`locType.end`), which lands on the type's closing
                            -- bracket when the type ends in a record/paren. The
                            -- positioned leaves stop at the last field, so without
                            -- this a comment after that closing bracket but before
                            -- the definition falls outside the signature and lands
                            -- inconsistently across reformats.
                            childrenLast =
                                Array.foldl (\c acc -> max acc (lastRowInSubtree c)) -1 allChildren

                            origRow =
                                lpnNode
                                    (OriginalRows
                                        { first = sigStart.row
                                        , last = max childrenLast locType.end.row
                                        , stype = StFunctionSignature
                                        }
                                    )
                                    allChildren
                        in
                        addRootChild origRow root
                    )


processInfixDecls : Src.Module -> Builder.Builder LPNode -> Result String (Builder.Builder LPNode)
processInfixDecls modAst root =
    Ok <| Array.foldl processInfixDecl root modAst.binops


{-| Emit one `infix` declaration as an `StInfixDecl` `OriginalRows`.

    infix left 6 (+) = add
-}
processInfixDecl : Located Src.Infix -> Builder.Builder LPNode -> Builder.Builder LPNode
processInfixDecl locInfix root =
    let
        infix_ =
            locInfix.value

        assocStr =
            when infix_.associativity is
                Src.OpALeft ->
                    "left"

                Src.OpARight ->
                    "right"

                Src.OpANone ->
                    "non"

        keywordNode =
            lpnLeaf (mkText { row = locInfix.start.row, col = 1 } "infix")

        -- elm-format pads the associativity keyword to the width of the widest
        -- one (`right` = 5) so the precedence column lines up across all infix
        -- declarations; the flow's own single separator space then sits on top
        -- (`infix left  6`, `infix non   4`, `infix right 5`).
        assocNode =
            lpnLeaf (SynthesizedText (String.padRight 5 ' ' assocStr))

        precNode =
            lpnLeaf (SynthesizedText (String.fromInt infix_.precedence))

        opNode =
            lpnLeaf (SynthesizedText ("(" ++ infix_.symbol ++ ")"))

        eqNode =
            lpnLeaf (SynthesizedText "=")

        -- Anchor the trailing fn name zero-width at the declaration's end so
        -- the OriginalRows row range covers an input decl that wraps across
        -- rows. With every inner token synthesized, the range would otherwise
        -- collapse to the keyword's row, and the blank-line pass would see a
        -- phantom gap below a wrapped decl (a spurious blank on reformat).
        fnNode =
            lpnLeaf (mkZeroWidthText locInfix.end infix_.fn)

        allChildren =
            [ keywordNode, assocNode, precNode, opNode, eqNode, fnNode ]

        origRow =
            makeOrigRows locInfix.start.row StInfixDecl allChildren
    in
    addRootChild origRow root
