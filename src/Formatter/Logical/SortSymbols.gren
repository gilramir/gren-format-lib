module Formatter.Logical.SortSymbols exposing (sortSymbols)

{-| Two independent sorts, each governed by its own rule:

1. **Exposing lists.** The symbols named in an `exposing ( ... )` list --
   the module header's and every `import ... exposing`'s -- sort into three
   groups, matching `elm-format`: operators, then types/unions, then plain
   values, alphabetically within each group. A comment attached to a name
   (leading, on its own line, or trailing on the name's own source row)
   travels with it.

2. **Import statements.** `import` lines sort alphabetically by module
   name, but *only within a maximal run of imports that sit with zero rows
   between them*. A **blank line** is the only boundary: it never moves, and
   it splits the imports around it into independently-sorted groups.
   Comments do not break a run -- they travel with the import they belong
   to, which is the import below them for an own-line comment and the
   import on their own row for a trailing one (`import Foo -- note`). A
   comment with a blank line under it therefore stays put, being nobody's
   leading comment, and so does one written below the run's last import.

Runs *after* `Formatter.Logical.Comments` has attached every comment by its
real source position -- that ordering is load-bearing for both sorts.
Comment placement is purely positional and assumes siblings are still in
source-row order, so sorting the underlying declarations first would
scatter comments into the wrong places (see `Formatter.Logical.Comments`'s
own docs). By the time this pass runs, a comment sibling immediately before
an item is unambiguously that item's leading comment, and one immediately
after it on the item's own source row is unambiguously its trailing
comment -- so this pass only has to re-group and reorder an
already-correct flat sibling list; it never has to re-decide attachment.

@docs sortSymbols
-}

import Array
import Array.Builder as Builder
import Char
import String

import Formatter.Logical.LogicalPrintingTree exposing
    ( CommentRole(..)
    , LPBox(..)
    , LPNode(..)
    , ListBrackets(..)
    , SyntaxType(..)
    , commentRole
    , lpnBox
    , lpnBracketEndElastic
    , lpnChildren
    , lpnFirstPos
    , lpnLastPos
    , lpnReplaceChildren
    , lpnSetCommentRole
    , lpnWithBox
    )


{-| -}
sortSymbols : LPNode -> LPNode
sortSymbols root =
    root
        |> sortImportGroups
        |> sortExposingLists


-- SHARED: clustering a flat sibling list into (comments, item, comments) groups


{-| One exposed name together with the comments that travel with it: any
comment(s) on their own line(s) directly above, and any comment(s) trailing
it on its own last source row.

`origIndex` is the cluster's position before sorting. It breaks ties
between clusters whose sort key compares equal so the result is
deterministic regardless of whether the underlying sort is stable.
-}
type alias Cluster =
    { leading : Array LPNode
    , item : LPNode
    , trailing : Array LPNode
    , origIndex : Int
    }


{-| True for a comment leaf inserted directly into a container's children
(siblings of exposed items, inside an exposing-list box). -}
isSweepComment : LPNode -> Bool
isSweepComment node =
    when lpnBox node is
        SingleLineComment _ ->
            True

        BlockComment _ ->
            True

        _ ->
            False


isExposedItem : LPNode -> Bool
isExposedItem node =
    when lpnBox node is
        UnbreakableText _ ->
            True

        _ ->
            False


isImportNode : LPNode -> Bool
isImportNode node =
    when lpnBox node is
        OriginalRows { stype = StImport } ->
            True

        _ ->
            False


{-| The first/last source row spanned by a node's subtree, read from the
shared position cache (`lpnFirstPos` / `lpnLastPos`). -1 for a
position-less node (shouldn't occur for anything this module clusters).

This cache is IMMUTABLE -- `lpnWithBox` (used by `shiftOrigRows` below)
deliberately leaves it untouched when swapping a node's box. That makes
`rowSpan` correct for reading a node's TRUE original position, but wrong
for reading an `OriginalRows` node's row *after* `sortImportGroups` has
shifted it -- use `origRowsFirst` / `origRowsLast` for that instead (they
read the mutated box field directly). Mixing the two up once already
produced silently-wrong deltas that compounded across every import group
member after the first. -}
rowSpan : LPNode -> { first : Int, last : Int }
rowSpan node =
    { first = lpnFirstPos node |> Maybe.map .row |> Maybe.withDefault -1
    , last = lpnLastPos node |> Maybe.map .row |> Maybe.withDefault -1
    }


{-| An `OriginalRows` node's row range as currently stored on its own box
-- i.e. `rowSpan`'s cache-based answer BEFORE any shift, but reflects a
shift applied via `shiftOrigRows` / `lpnWithBox` afterward. Root-level
imports are always this box kind, so this is the correct accessor once
`sortImportGroups` has started reflowing a sorted group. -}
origRowsFirst : LPNode -> Int
origRowsFirst node =
    when lpnBox node is
        OriginalRows r ->
            r.first

        _ ->
            rowSpan node |> .first


origRowsLast : LPNode -> Int
origRowsLast node =
    when lpnBox node is
        OriginalRows r ->
            r.last

        _ ->
            rowSpan node |> .last


shiftOrigRows : Int -> LPNode -> LPNode
shiftOrigRows delta node =
    when lpnBox node is
        OriginalRows r ->
            lpnWithBox (OriginalRows { r | first = r.first + delta, last = r.last + delta }) node

        _ ->
            node


{-| Pop sweep-eligible comments off the front of `arr`. -}
takeLeadingComments : Array LPNode -> { pending : Array LPNode, afterPending : Array LPNode }
takeLeadingComments arr =
    when Array.popFirst arr is
        Just { first = node, rest } ->
            if isSweepComment node then
                let
                    inner =
                        takeLeadingComments rest
                in
                { pending = Array.pushFirst node inner.pending, afterPending = inner.afterPending }

            else
                { pending = [], afterPending = arr }

        Nothing ->
            { pending = [], afterPending = arr }


-- Pop comments off the front of `arr` for as long as each one starts on the last
-- row of what precedes it -- a chain of comments trailing `item` on the same
-- line.
--
-- The chain matters because a comment's own last row is not always its first. A
-- multi-line block comment trailing a name closes several rows down, and a `--`
-- written after that closing delimiter is on the closing row, not the name's:
--
--     , Mango {- mango's
--         comment -} -- and mango's trailing line comment
--
-- A reader takes the whole run as belonging to `Mango`, so the run travels with
-- `Mango` when the list sorts. Comparing each comment against the *item*'s last
-- row instead would end the run at the block comment and leave the `--` to lead
-- whatever name came next -- which, if that name sorted to the front, carried
-- the comment across the list with it.
takeSameRowTrailing : LPNode -> Array LPNode -> { trailing : Array LPNode, afterTrailing : Array LPNode }
takeSameRowTrailing item arr =
    takeSameRowTrailingFrom (rowSpan item |> .last) arr


takeSameRowTrailingFrom : Int -> Array LPNode -> { trailing : Array LPNode, afterTrailing : Array LPNode }
takeSameRowTrailingFrom prevLastRow arr =
    when Array.popFirst arr is
        Just { first = node, rest } ->
            if isSweepComment node && (rowSpan node |> .first) == prevLastRow then
                let
                    inner =
                        takeSameRowTrailingFrom (rowSpan node |> .last) rest
                in
                { trailing = Array.pushFirst node inner.trailing, afterTrailing = inner.afterTrailing }

            else
                { trailing = [], afterTrailing = arr }

        Nothing ->
            { trailing = [], afterTrailing = arr }


{-| Walk `remaining` left to right, folding runs of comments and each
"item" node (per `isItem`) into `Cluster`s. Any comments left dangling
after the last item (nothing left to lead) come back as `leftover` for the
caller to attach somewhere.

`ok = False` signals the walk hit a node that is neither a sweep-eligible
comment nor an item -- the region passed in wasn't what the caller assumed.
`sortExposedChildren` scopes its input tightly enough that this should not
happen, but "should not happen" is exactly the kind of assumption worth
failing safe on rather than trusting blindly -- `ok` lets the caller leave
the region exactly as authored instead of risking lost content. -}
clusterRegionHelp : (LPNode -> Bool) -> Array LPNode -> Array Cluster -> { clusters : Array Cluster, leftover : Array LPNode, ok : Bool }
clusterRegionHelp isItem remaining acc =
    let
        { pending, afterPending } =
            takeLeadingComments remaining
    in
    when Array.popFirst afterPending is
        Nothing ->
            { clusters = acc, leftover = pending, ok = True }

        Just { first = node, rest = afterNode } ->
            if isItem node then
                let
                    { trailing, afterTrailing } =
                        takeSameRowTrailing node afterNode

                    cluster =
                        { leading = pending, item = node, trailing = trailing, origIndex = Array.length acc }
                in
                clusterRegionHelp isItem afterTrailing (Array.pushLast cluster acc)

            else
                -- An unexpected node that is neither a sweep-eligible comment
                -- nor an item. Bail out with `ok = False` rather than
                -- continuing -- see the doc comment above.
                { clusters = acc, leftover = pending ++ [ node ] ++ afterNode, ok = False }


{-| Cluster `region` into sortable clusters, plus any trailing comments that
lead nothing -- kept SEPARATE from the clusters rather than folded into the last
one, because they belong to the end of the list rather than to whichever name
the author happened to write last. See `sortExposedChildren`.

Returns `Nothing` if the region didn't match what clustering expects (see
`clusterRegionHelp`'s `ok` flag) -- the caller should fall back to `region`
unchanged rather than trust a partial result. -}
clusterExposedRegion : (LPNode -> Bool) -> Array LPNode -> Maybe { clusters : Array Cluster, leftover : Array LPNode }
clusterExposedRegion isItem region =
    let
        { clusters, leftover, ok } =
            clusterRegionHelp isItem region []
    in
    if not ok then
        Nothing

    else
        Just { clusters = clusters, leftover = leftover }


compareClusters : (LPNode -> LPNode -> Order) -> Cluster -> Cluster -> Order
compareClusters itemCompare a b =
    when itemCompare a.item b.item is
        EQ ->
            compare a.origIndex b.origIndex

        other ->
            other


flattenClusters : Array Cluster -> Array LPNode
flattenClusters clusters =
    Array.foldl (\c acc -> acc ++ c.leading ++ [ c.item ] ++ c.trailing) [] clusters


-- IMPORT STATEMENTS


{-| One `import` statement together with the comments that travel with it:
own-line comment(s) written directly above it with no blank line between, and
any comment(s) trailing it on its own source row. -}
type alias ImportUnit =
    { leading : Array LPNode
    , item : LPNode
    , trailing : Array LPNode
    }


unitFirstRow : ImportUnit -> Int
unitFirstRow unit =
    when Array.first unit.leading is
        Just n ->
            origRowsFirst n

        Nothing ->
            origRowsFirst unit.item


unitLastRow : ImportUnit -> Int
unitLastRow unit =
    when Array.popLast unit.trailing is
        Just { last = n } ->
            origRowsLast n

        Nothing ->
            origRowsLast unit.item


{-| True for a root-level comment: an `OriginalRows` wrapping one detached
line or block comment. (A doc comment is deliberately not one of these -- it
belongs to the declaration it documents, and never travels with an import.) -}
isCommentOrigRows : LPNode -> Bool
isCommentOrigRows node =
    when lpnBox node is
        OriginalRows { stype = StSingleLineComment } ->
            True

        OriginalRows { stype = StBlockComment } ->
            True

        _ ->
            False


{-| Take the next import unit starting at index `i` of `nodes`: the own-line
comments glued above the import (each row-adjacent to what follows it), the
import itself, and the comments trailing it on its own row. `unit = Nothing`
when `nodes` does not start one at `i` -- including when a comment chain
leads to something that is not an import, in which case nothing is consumed
and the caller emits the nodes as they are.

Takes an index into the shared `nodes` array rather than a shrinking `Array
LPNode` "remaining" slice: `Array.popFirst`/`Array.dropFirst` are `slice`
under the hood (`Array.gren`), an O(n) copy per call. `nextIndex` is always
set, even on failure (to just past the whole glued-leading chain this call
scanned, not just past one node) -- `walkTop`'s fallback uses it to skip the
entire failed chain in one bulk step. Without that, retrying `takeUnit` one
node at a time would rescan the same glued-comment chain from every position
inside it: an O(chain length) scan repeated once per position in the chain is
O(n^2) on a file that's mostly stacked top-level comments with no imports
(`wide-comments-only`). -}
takeUnit : Array LPNode -> Int -> { unit : Maybe ImportUnit, nextIndex : Int }
takeUnit nodes i =
    let
        { leading, afterLeadingIndex } =
            takeGluedLeadingIdx nodes i
    in
    when Array.get afterLeadingIndex nodes is
        Just node ->
            if isImportNode node then
                let
                    { trailing, afterTrailingIndex } =
                        takeSameRowTrailingIdx node nodes (afterLeadingIndex + 1)
                in
                { unit = Just { leading = leading, item = node, trailing = trailing }
                , nextIndex = afterTrailingIndex
                }

            else
                -- Not an import: the whole glued-leading chain (and this
                -- node) is dead weight for import-sorting purposes. Skip
                -- past all of it at once.
                { unit = Nothing, nextIndex = afterLeadingIndex + 1 }

        Nothing ->
            { unit = Nothing, nextIndex = afterLeadingIndex }


{-| Take comments starting at index `i` of `nodes` for as long as each one is
followed immediately -- next row, no blank line -- by another node. The chain
stops at a comment with a gap under it, which is nobody's leading comment and
stays put. Threads an `Array.Builder` accumulator, same reasoning as
`takeUnit`'s index-based rewrite. -}
takeGluedLeadingIdx : Array LPNode -> Int -> { leading : Array LPNode, afterLeadingIndex : Int }
takeGluedLeadingIdx nodes i =
    takeGluedLeadingIdxHelp nodes i (Builder.empty 0)


takeGluedLeadingIdxHelp : Array LPNode -> Int -> Builder.Builder LPNode -> { leading : Array LPNode, afterLeadingIndex : Int }
takeGluedLeadingIdxHelp nodes i leadingAcc =
    when Array.get i nodes is
        Just node ->
            if isCommentOrigRows node && startsOnRowIdx (origRowsLast node + 1) nodes (i + 1) then
                takeGluedLeadingIdxHelp nodes (i + 1) (Builder.pushLast node leadingAcc)

            else
                { leading = Builder.toArray leadingAcc, afterLeadingIndex = i }

        Nothing ->
            { leading = Builder.toArray leadingAcc, afterLeadingIndex = i }


{-| Take sweep-eligible comments starting at index `i` of `nodes` for as long
as each one starts on the last row of what precedes it -- see
`takeSameRowTrailing`'s doc comment for why a chain, not just one comment.
Index-based twin of `takeSameRowTrailing`, used on the import path where
`nodes` is the shared, never-resliced root-children array (see `takeUnit`);
`takeSameRowTrailing` itself stays array-based for `clusterRegionHelp`'s
exposing-list clustering, where the input is already a small, freshly-scoped
region and reslicing it is not the hot path. -}
takeSameRowTrailingIdx : LPNode -> Array LPNode -> Int -> { trailing : Array LPNode, afterTrailingIndex : Int }
takeSameRowTrailingIdx item nodes i =
    takeSameRowTrailingIdxHelp (rowSpan item |> .last) nodes i (Builder.empty 0)


takeSameRowTrailingIdxHelp : Int -> Array LPNode -> Int -> Builder.Builder LPNode -> { trailing : Array LPNode, afterTrailingIndex : Int }
takeSameRowTrailingIdxHelp prevLastRow nodes i acc =
    when Array.get i nodes is
        Just node ->
            if isSweepComment node && (rowSpan node |> .first) == prevLastRow then
                takeSameRowTrailingIdxHelp (rowSpan node |> .last) nodes (i + 1) (Builder.pushLast node acc)

            else
                { trailing = Builder.toArray acc, afterTrailingIndex = i }

        Nothing ->
            { trailing = Builder.toArray acc, afterTrailingIndex = i }


-- True when the node at index `i` of `nodes` starts on `row`.
startsOnRowIdx : Int -> Array LPNode -> Int -> Bool
startsOnRowIdx row nodes i =
    when Array.get i nodes is
        Just n ->
            origRowsFirst n == row

        Nothing ->
            False


{-| Reorder `import` statements alphabetically by module name, but only
within a maximal run of import units that sit with zero rows between them --
see the module doc comment for the exact rule (a blank line is the only
boundary; comments travel with their import). Walks the root's children once,
left to right. -}
sortImportGroups : LPNode -> LPNode
sortImportGroups root =
    let
        nodes =
            lpnChildren root
    in
    lpnReplaceChildren root (walkTop nodes 0 (Builder.empty (Array.length nodes)))


{-| Walks `nodes` (the root's children, fixed -- never resliced) via an index
`i` and an `Array.Builder` accumulator, both O(1)-amortized per step, instead
of an `Array LPNode` "remaining" tail shrunk one `Array.popFirst`/`++` at a
time: either alone is O(n) per call, and this loop calls one of them once per
node, so an O(n) outer loop times an O(n) per-call cost was O(n^2) on a wide
file (thousands of top-level declarations, or of comments with few/no
imports). -}
walkTop : Array LPNode -> Int -> Builder.Builder LPNode -> Array LPNode
walkTop nodes i acc =
    let
        attempt =
            takeUnit nodes i
    in
    when attempt.unit is
        Just firstUnit ->
            let
                { units, afterIndex } =
                    collectRun nodes firstUnit attempt.nextIndex
            in
            if Array.length units >= 2 then
                walkTop nodes afterIndex (Builder.append (renderSortedRun (unitFirstRow firstUnit) units) acc)

            else
                walkTop nodes afterIndex (Builder.append (flattenUnits units) acc)

        Nothing ->
            if attempt.nextIndex > i then
                -- Bulk-emit the whole failed chain `takeUnit` just scanned
                -- (`Array.slice` is O(k) for the k nodes actually being
                -- emitted -- unavoidable, not wasted work) instead of
                -- retrying one node at a time, which would rescan it.
                walkTop nodes attempt.nextIndex (Builder.append (Array.slice i attempt.nextIndex nodes) acc)

            else
                -- No progress: `i` is already past the end of `nodes`.
                Builder.toArray acc


renderSortedRun : Int -> Array ImportUnit -> Array LPNode
renderSortedRun runFirstRow units =
    units
        |> sortUnitsStable
        |> reflowUnits runFirstRow
        |> flattenUnits


{-| Collect one run starting at `firstUnit` (whose next index into `nodes` is
`i`): keep taking import units for as long as the next one starts on the row
right after the previous one ends. A blank line leaves a gap, which ends the
run; so does anything that is not an import unit (a declaration, or a comment
chain that leads to one). -}
collectRun : Array LPNode -> ImportUnit -> Int -> { units : Array ImportUnit, afterIndex : Int }
collectRun nodes firstUnit i =
    collectRunHelp nodes firstUnit i (Builder.empty 0)


collectRunHelp : Array LPNode -> ImportUnit -> Int -> Builder.Builder ImportUnit -> { units : Array ImportUnit, afterIndex : Int }
collectRunHelp nodes unit i acc =
    let
        newAcc =
            Builder.pushLast unit acc

        attempt =
            takeUnit nodes i
    in
    when attempt.unit is
        Just nextUnit ->
            if unitFirstRow nextUnit == unitLastRow unit + 1 then
                collectRunHelp nodes nextUnit attempt.nextIndex newAcc

            else
                { units = Builder.toArray newAcc, afterIndex = i }

        Nothing ->
            { units = Builder.toArray newAcc, afterIndex = i }


sortUnitsStable : Array ImportUnit -> Array ImportUnit
sortUnitsStable units =
    Array.indexedMap (\i u -> { unit = u, origIndex = i }) units
        |> Array.sortWith compareIndexedUnits
        |> Array.map .unit


compareIndexedUnits : { unit : ImportUnit, origIndex : Int } -> { unit : ImportUnit, origIndex : Int } -> Order
compareIndexedUnits a b =
    when compare (importModuleName a.unit.item) (importModuleName b.unit.item) is
        EQ ->
            compare a.origIndex b.origIndex

        other ->
            other


{-| An import's module name -- the second *non-comment* child of its
`OriginalRows` node (`moduleNode` in `MakeLogical.processImport`), an
`UnbreakableText` leaf. Leading comment children (a `LeadsInline` block comment
glued to the front of the import) are skipped so they don't shift the index. -}
importModuleName : LPNode -> String
importModuleName item =
    let
        nonComments =
            Array.keepIf (\n -> commentRole (lpnBox n) == Nothing) (lpnChildren item)
    in
    when Array.get 1 nonComments is
        Just n ->
            when lpnBox n is
                UnbreakableText loc ->
                    loc.value

                _ ->
                    ""

        Nothing ->
            ""


{-| Shift every unit after the first so it starts exactly one row past the
previous unit's end -- row-adjacent, zero gap -- anchored so the FIRST
unit (in sorted order, whichever import that now is) starts at the run's
true original first row. Because the run's members are a permutation of
the same set with no additions or removals, and every original adjacent
pair had zero rows between them, the total height is invariant under
reordering -- the reflowed run's last row always lands back on the run's
true original last row, so (unlike the old, now-removed import-statement
sort) no separate boundary patch is needed for whatever follows the run. -}
reflowUnits : Int -> Array ImportUnit -> Array ImportUnit
reflowUnits runFirstRow units =
    Array.foldl
        (\unit acc ->
            let
                delta =
                    (acc.cursor + 1) - unitFirstRow unit

                shifted =
                    shiftUnit delta unit
            in
            { out = Builder.pushLast shifted acc.out, cursor = unitLastRow shifted }
        )
        { out = Builder.empty (Array.length units), cursor = runFirstRow - 1 }
        units
        |> .out
        |> Builder.toArray


shiftUnit : Int -> ImportUnit -> ImportUnit
shiftUnit delta unit =
    if delta == 0 then
        unit

    else
        { unit
            | leading = Array.map (shiftOrigRows delta) unit.leading
            , item = shiftOrigRows delta unit.item
            , trailing = Array.map (shiftOrigRows delta) unit.trailing
        }


flattenUnits : Array ImportUnit -> Array LPNode
flattenUnits units =
    Array.foldl
        (\u acc ->
            acc
                |> Builder.append u.leading
                |> Builder.pushLast u.item
                |> Builder.append u.trailing
        )
        (Builder.empty (Array.length units))
        units
        |> Builder.toArray


-- EXPOSING LISTS


{-| Reorder every exposing-list box in the tree (the module header's and
every import's) by walking the whole tree once. `ListParen` is used
exclusively for exposing-list boxes -- no other construct builds
`AllAcrossOrAllVertical ListParen` / `AlwaysVertical ListParen` -- so
matching on the box alone finds every exposing list unambiguously, with no
new box variant needed. -}
sortExposingLists : LPNode -> LPNode
sortExposingLists node =
    let
        recursed =
            lpnReplaceChildren node (hoistBracketLeadingComments (Array.map sortExposingLists (lpnChildren node)))
    in
    when lpnBox recursed is
        AllAcrossOrAllVertical ListParen ->
            -- Flat *and* elastic = the module header's own one-row list, the
            -- only exposing list whose closing `)` is neither recorded by the
            -- parser nor on a row of its own. See `sortExposedChildren`.
            lpnReplaceChildren
                recursed
                (sortExposedChildren
                    { pinsClosingComments = lpnBracketEndElastic recursed
                    , closeSharesLastItemRow = True
                    }
                    (lpnChildren recursed)
                )

        AlwaysVertical ListParen ->
            lpnReplaceChildren
                recursed
                (sortExposedChildren
                    { pinsClosingComments = lpnBracketEndElastic recursed
                    , closeSharesLastItemRow = False
                    }
                    (lpnChildren recursed)
                )

        _ ->
            recursed


{-| Move any comment(s) that the sort left at the *front* of an exposing-list
bracket out to become siblings *before* the bracket. When a between-items
comment's owning name sorts to first place, `sortExposedChildren` places that
comment as the bracket's first child (leading the new first item) -- a
structurally legitimate slot, but one the *parser* never produces: a comment
before a bracket's first item always reparses as a sibling ahead of the bracket
(the bracket node's range starts at its first item, so anything earlier falls
outside it -- the same is true for record/array literals). Emitting it inside
therefore guarantees non-idempotency (the bracket-first-child form renders the
comment above `(`, which reparses back out). Hoisting it here makes the sorted
tree byte-identical to what a reparse yields, so the two agree by construction.
`ListParen` is exclusively exposing lists, so this only ever fires on them.

The hoisted comment lands in a slot `Comments.gren` classifies differently from
the one it came out of, so its stored role has to be re-taken for the new
position — see `hoistedTailRole`.

Threads an `Array.Builder` accumulator rather than `Array.pushLast`/`++`: this
runs on every node's children in the whole tree (`sortExposingLists`'s walk),
including the root's — up to thousands of top-level declarations — so an
O(n)-per-call accumulation here is O(n^2) over the whole file. -}
hoistBracketLeadingComments : Array LPNode -> Array LPNode
hoistBracketLeadingComments children =
    let
        -- The one place a hoisted comment's role has to change: an effect
        -- module's header. `MakeLogical.processModuleLine` emits a
        -- position-less `SynthesizedText "exposing"` for `Src.Manager` and for
        -- nothing else (a plain module anchors the keyword at the end of its
        -- name), so this is exactly the same discriminator
        -- `Comments.pastSynthesizedExposing` uses one layer down.
        intoEffectHeaderTail =
            Array.any
                (\n ->
                    when lpnBox n is
                        SynthesizedText v ->
                            v == "exposing"

                        _ ->
                            False
                )
                children
    in
    Array.foldl
        (\child acc ->
            when lpnBox child is
                AllAcrossOrAllVertical ListParen ->
                    Builder.append (hoistOne intoEffectHeaderTail child) acc

                AlwaysVertical ListParen ->
                    Builder.append (hoistOne intoEffectHeaderTail child) acc

                _ ->
                    Builder.pushLast child acc
        )
        (Builder.empty (Array.length children))
        children
        |> Builder.toArray


{-| Split a sorted exposing-list bracket into its leading comment sibling(s)
followed by the bracket stripped of them (unchanged if it has none). -}
hoistOne : Bool -> LPNode -> Array LPNode
hoistOne intoEffectHeaderTail bracket =
    let
        { pending, afterPending } =
            takeLeadingComments (lpnChildren bracket)
    in
    if Array.isEmpty pending then
        [ bracket ]

    else
        Array.pushLast
            (lpnReplaceChildren bracket afterPending)
            (if intoEffectHeaderTail then
                Array.map hoistedTailRole pending

             else
                pending
            )


{-| Re-take a hoisted comment's role for the slot it has just been moved into.

The comment was classified inside the bracket, where it led an item; out here it
sits between the header's `exposing` and the `(`, and on an **effect** module
that is the header's position-less tail — the territory `Comments.headerTailGlue`
owns. That rule glues a single-line comment onto the header row and leaves a
multi-line `{- … -}` on its own, so a hoisted comment keeping `LeadsOwnLine`
emitted the *plain*-module shape for an effect header and every later format
re-glued it: not a fixed point.

A plain module's `exposing` is positioned, so `headerTailGlue` is False there and
`LeadsOwnLine` is already what a reparse assigns — nothing to re-take, which is
why the caller only asks for an effect header. -}
hoistedTailRole : LPNode -> LPNode
hoistedTailRole node =
    when lpnBox node is
        SingleLineComment _ ->
            lpnSetCommentRole TrailsPrevious node

        BlockComment c ->
            if String.contains "\n" c.loc.value then
                node

            else
                lpnSetCommentRole RidesInline node

        _ ->
            node


{-| Sort one exposing list's children. Every child here is already "inside the
parens", so there is no boundary to respect -- but there are two kinds of
comment inside, and they must not be treated alike:

  - one written on a NAME's own row trails that name, and travels with it
    through the sort (`takeSameRowTrailing` folds it into that name's cluster);
  - one written past the last name -- on the closing `)`'s own row -- leads
    nothing and describes the list's end, so it is **pinned after the sorted
    names**, staying above the `)`.

Pinning is what makes the result independent of the order the author wrote the
names in, which is the entire point of sorting. Folding such a comment into the
last cluster instead (what this did before) attached it to whichever name
happened to be written last, so it then rode that name to its sorted position:
`( apple, zebra ) -- c` and `( zebra, apple ) -- c` are the same module, yet the
first kept the comment above `)` and the second moved it up between the names.
The random generator's author-order oracle found this on 5% of modules.

Only a **vertical** list can tell the two apart, and only because their rows
differ. On a flat one-row list a comment past the `)` and a comment trailing the
last name are written on the same row, and the `)` has no position in the AST to
separate them (see `MakeLogical.moduleExposingClose`) -- so there it stays a
same-row trailing comment on the last authored name, and stays order-dependent.
That limitation is documented in the README under "Known limitations" ->
"A module `exposing` list's closing paren isn't recorded" -> "A comment past a
flat list". -}
sortExposedChildren : { pinsClosingComments : Bool, closeSharesLastItemRow : Bool } -> Array LPNode -> Array LPNode
sortExposedChildren opts items =
    if not (Array.any isExposedItem items) then
        items

    else
        when clusterExposedRegion isExposedItem items is
            Nothing ->
                -- Didn't match what clustering expects (see
                -- `clusterRegionHelp`). Leave it exactly as authored rather
                -- than risk losing content.
                items

            Just { clusters, leftover } ->
                let
                    sorted =
                        Array.sortWith (compareClusters compareExposedText) clusters

                    { clusters = finalClusters, pinned } =
                        if opts.pinsClosingComments && opts.closeSharesLastItemRow then
                            unfoldLastTrailing sorted

                        else
                            { clusters = sorted, pinned = [] }

                    closing =
                        pinned ++ leftover
                in
                flattenClusters finalClusters
                    ++ (if opts.pinsClosingComments then
                            Array.map pinAboveClose closing

                        else
                            closing
                       )


{-| Strip the trailing comment run off the last cluster — in **authored** order
or in **sorted** order, whichever applies (often the same cluster) — so it is
pinned above the `)` instead of riding that name through the sort.

Only correct where the closing `)` shares a row with the last item: a flat
module-header list. There `(a, b) {- c -}` and `(a, b {- c -})` put `c` in the
same place and the `)` has no position to separate them, so "past the list" and
"trails the last name" are the same bytes. A **vertical** list is untouched —
its `)` has a row of its own, so `clusterRegionHelp` has already told the two
apart.

Why both orders, and why that is the most a flat list can offer:

  - **Authored-last** is the one that matters. A comment genuinely past the `)`
    is the last thing in the list *however the names are ordered*, so pinning on
    authored-last makes `(a, b) {- c -}` and `(b, a) {- c -}` — the same module
    typed two ways — land on the same bytes. Sorted-last alone does not: in
    `(b, a) {- c -}` the comment trails `a`, which sorts first, so it would be
    left riding `a` into the middle of the list.
  - **Sorted-last** is what keeps the result a fixed point. Without it,
    `(b {- c -}, a)` — where `c` is unambiguously `b`'s, a name follows it —
    stays flat as `(a, b {- c -})`, in which `c` now *is* on the last name, so
    the next format pins it. Adding sorted-last pins on the first format
    instead, and once pinned the list renders vertical, where the comment sits
    on its own row above `)` and stays there.

What no rule can recover is the case the two readings disagree on: `c` written
after a name that is neither authored-last nor sorted-last keeps that name,
which means `(b, a {- c -})` and `(a {- c -}, b)` still differ. That is not an
oversight — in a flat list a name-owned comment and a list-owned one occupy the
same position, so treating the trailing slot as the list's necessarily treats
some name-owned comments as the list's too. The vertical form has the row to say
which, and says it. -}
unfoldLastTrailing : Array Cluster -> { clusters : Array Cluster, pinned : Array LPNode }
unfoldLastTrailing clusters =
    let
        authoredLast =
            Array.foldl (\c acc -> max acc c.origIndex) -1 clusters

        sortedLast =
            Array.length clusters - 1
    in
    Array.foldl
        (\c acc ->
            if acc.index == sortedLast || c.origIndex == authoredLast then
                { clusters = Array.pushLast { c | trailing = [] } acc.clusters
                , pinned = acc.pinned ++ c.trailing
                , index = acc.index + 1
                }

            else
                { acc
                    | clusters = Array.pushLast c acc.clusters
                    , index = acc.index + 1
                }
        )
        { clusters = [], pinned = [], index = 0 }
        clusters
        |> (\r -> { clusters = r.clusters, pinned = r.pinned })


{-| A comment pinned above the `)` leads its own line, whatever it was written
against. A chain authored on one row (`) {- a -} {- b -}`) arrives here still
carrying `TrailsPrevious` on every link but the first, which would re-glue the
run onto the last sorted name; own-line is also the shape a reparse of the
pinned output yields, so the two agree by construction. -}
pinAboveClose : LPNode -> LPNode
pinAboveClose node =
    if isSweepComment node then
        lpnSetCommentRole LeadsOwnLine node

    else
        node


compareExposedText : LPNode -> LPNode -> Order
compareExposedText a b =
    let
        ka =
            exposedSortKey a

        kb =
            exposedSortKey b
    in
    when compare ka.rank kb.rank is
        EQ ->
            compare ka.baseName kb.baseName

        other ->
            other


exposedSortKey : LPNode -> { rank : Int, baseName : String }
exposedSortKey node =
    when lpnBox node is
        UnbreakableText loc ->
            classifyExposedText loc.value

        _ ->
            { rank = 3, baseName = "" }


{-| Classify one exposed item's rendered text into elm-format's three
groups -- operators (0), types/unions (1), values (2) -- and its base name
for alphabetical comparison within the group. A closed, exhaustive match
over exactly the three shapes `MakeLogical.processExposed` ever renders
(`(op)`, `Name` / `Name(..)`, `name`); keep this in sync if that function's
output shapes ever change. -}
classifyExposedText : String -> { rank : Int, baseName : String }
classifyExposedText text =
    if String.startsWith "(" text then
        { rank = 0, baseName = text |> String.dropFirst 1 |> String.dropLast 1 }

    else if startsWithUpper text then
        { rank = 1
        , baseName =
            if String.endsWith "(..)" text then
                String.dropLast 4 text

            else
                text
        }

    else
        { rank = 2, baseName = text }


startsWithUpper : String -> Bool
startsWithUpper text =
    when Array.get 0 (String.toArray text) is
        Just c ->
            Char.isUpper c

        Nothing ->
            False
