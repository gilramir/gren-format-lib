module Formatter.Logical.LPTHelpers exposing
    ( authoredBracketList
    , endOfToken
    , fixupParensChildrenNodesAt
    , itemsSpanRows
    , mkText
    , mkTextFromLocString
    , mkZeroWidthText
    , plainAcross
    , syntheticParens
    , tryMapLastLeaf
    )

{-|
LPT construction helpers shared by every Insert* module: leaf-building,
position arithmetic, Result-aware folding, and leaf-walking utilities
used to rewrite the text on the deepest leaf of a subtree.

-}

import Compiler.SourcePosition exposing (Located, Position)

import Formatter.Logical.LogicalPrintingTree exposing
    ( LPShape(..)
    , LPNode
    , ListBrackets(..)
    , RecordKind(..)
    , lpnShape
    , lpnBracketNode
    , lpnChildren
    , lpnLeaf
    , lpnNode
    , lpnWithBracketStart
    )


mkText : Position -> String -> LPShape
mkText pos text =
    let
        end =
            { pos | col = pos.col + String.count text }
    in
    UnbreakableText
        { start = pos
        , end = end
        , value = text
        }


mkTextFromLocString : Located String -> LPShape
mkTextFromLocString ltext =
    UnbreakableText ltext


{-| The position one past the last character of a token that starts at `start`
and reads `text` — i.e. the anchor `mkZeroWidthText` wants for whatever elided
token follows it. Only for tokens the AST gives a start but no end. -}
endOfToken : Position -> String -> Position
endOfToken start text =
    { row = start.row, col = start.col + String.count text }


{-| Build an `UnbreakableText` for a synthesized (elided) token whose position
is *zero-width*: `start == end == pos`. The token still renders its full text;
the zero width matters only for comment placement. Anchoring a synthesized
keyword/punctuation at a single point (rather than giving it a fake span) keeps
it from overlapping a comment that sits at the same column, which is what makes
comment placement around elided tokens stable across reformats (idempotent).

**The anchoring policy, once, for all ~14 sites.** Gren's parser records no
position for `=` `:` `|` `,` `->` `as` `exposing` `(..)` `else if`, an effect
module's `where` labels, or a pattern's `as` — so every one of them has to be
given one here. The rule is: anchor at **the end of the last REAL token before
it**, never a column further on.

The end of a real token is a position that survives reformatting, so a comment
written in the gap after that token lies past the anchor both in the source and
in the re-parsed output, and therefore sorts to the same side twice. A `+1`
would TIE with a comment that immediately follows the token, letting it fall on
either side across reformats — the oscillation class this rule exists to
prevent. The visible trade-off is that a gap comment always renders after the
elided token; that is the deliberate canonical placement (rule C2).

Where the real column is not recoverable — an effect module's
`where { … } exposing`, whose column depends on the block's contents — there is
no honest anchor, and the site falls back to a position-less `SynthesizedText`
instead of inventing one.
-}
mkZeroWidthText : Position -> String -> LPShape
mkZeroWidthText pos text =
    UnbreakableText
        { start = pos
        , end = pos
        , value = text
        }


{-| An `AcrossOrVertical` flow with both flags off — the default token flow for
a function/lambda head, a record field, a constructor line, and anywhere else
the layout is not forced vertical and the trailing token must stay glued to the
last item. The forced-vertical / content-checking variants are spelled out at
their (few) call sites so the flags that carry information stand out. -}
plainAcross : Array LPNode -> LPNode
plainAcross children =
    lpnNode (AcrossOrVertical { forceVertical = False, checkContentVertical = False }) children


{-| A `ParenBlock` with all flags off — formatter-synthesized parens that carry
no author position of their own (pattern/type wrapping, a parenthesized
destructure LHS). Genuine `Src.Parens` and kept call-argument parens set the
flags explicitly at their call sites. -}
syntheticParens : Array LPNode -> LPNode
syntheticParens children =
    lpnNode (ParenBlock { forceVertical = False, checkContentVertical = False, contentAlwaysBreaks = False }) children


{-| True when the author laid these located items out across more than one
source row — i.e. some item starts on a row below where the previous item
ended. This is the "multi-line authored" signal that decides whether a list
literal stays one-per-line regardless of page fit (see `Src.ArrayLiteral` in
`InsertExpressions`). A run that all sits on a single row — `[ 1, 2, 3 ]` — is
False; `[ 1, 2\n, 3 ]` is True. A lone item that is itself multi-line does not
count, since there is no *gap between* items to cross.
-}
itemsSpanRows : Array { r | start : Position, end : Position } -> Bool
itemsSpanRows items =
    Array.foldl
        (\item acc ->
            { prevEndRow = item.end.row
            , spans = acc.spans || (acc.prevEndRow >= 0 && acc.prevEndRow < item.start.row)
            }
        )
        { prevEndRow = -1, spans = False }
        items
        |> .spans


{-| Build a bracketed container node (record/array literal, record/array
pattern) from its already-built item nodes, applying the author-layout shape
choice in one place.

  - No items → `empty`, the caller's own empty-bracket leaf (`EmptyBracketed`
    for literals, a `{}`/`[]` text leaf for patterns). The empty form genuinely
    differs per caller, so it stays a parameter.
  - Some items → an `lpnBracketNode` whose shape is `AlwaysVertical` when the
    author wrote the items across rows (`spans`, from `itemsSpanRows`), else
    `AllAcrossOrAllVertical` (inline unless it carries a comment). `closeEnd` is
    the closing bracket's source position, registered so a line-leading comment
    before the close stays inside the container; `openStart` is the *opening*
    bracket's position, registered so a comment written just after it stays
    inside too (`[ {- c -} 1, 2 ]`), rather than being hoisted above the whole
    container.

This is the single home of the one-line-vs-multi-row shape choice the bracketed
containers share. (Record *updates* use the `RecordUpdate` shape, so they build
their nodes directly rather than through here.)
-}
authoredBracketList : ListBrackets -> Bool -> Position -> Position -> LPNode -> Array LPNode -> LPNode
authoredBracketList brackets spans openStart closeEnd empty itemNodes =
    when Array.popFirst itemNodes is
        Nothing ->
            empty

        Just _ ->
            lpnBracketNode
                (if spans then
                    AlwaysVertical brackets

                 else
                    AllAcrossOrAllVertical brackets
                )
                closeEnd
                itemNodes
                |> lpnWithBracketStart openStart


-- Left-fold that threads a Result through the accumulator, short-circuiting
-- on the first Err. Equivalent to Array.foldl + Result.andThen.


-- Walk to the deepest last UnbreakableText leaf and apply f to it.
-- Returns Nothing if no UnbreakableText leaf is found.
tryMapLastLeaf : (Located String -> LPShape) -> LPNode -> Maybe LPNode
tryMapLastLeaf f node =
    when lpnShape node is
        UnbreakableText loc ->
            Just (lpnNode (f loc) (lpnChildren node))

        _ ->
            when Array.popLast (lpnChildren node) is
                Nothing ->
                    Nothing

                Just { last = lastChild, initial = initialChildren } ->
                    when tryMapLastLeaf f lastChild is
                        Nothing ->
                            Nothing

                        Just updated ->
                            Just (lpnNode (lpnShape node) (Array.pushLast updated initialChildren))


{-| Wrap a non-empty list of nodes in the parens the AUTHOR wrote, whose closing
`)` sits at `closeEnd`. (`ParenBlock` renders `(` and `)` immediately adjacent to
the children, which matters when the first/last child is itself a
bracket-rendered container.)

The `)` has no leaf of its own, so without recording it the node's row range
stops at its last inner token and a comment written between that token and the
`)` reads as being *past* the parens. In a signature that comment then landed on
one side or the other of the `->`'s zero-width anchor depending on where the `)`
happened to be, which flipped on reparse -- a genuine non-idempotency, not just a
placement quirk (`h : (Int -> Int -- c⏎    ) -> Int`). `lpnBracketNode` extends
the range over the `)` and records it as the node's `lastBracketEnd`, which is
what keeps the comment inside the parens where it was written.

The empty case cannot arise for authored parens (`()` is a different type), so it
shares the synthesized fallback.

`spansRows` is the author-layout flag, and a parenthesized TYPE is its only
caller. Nothing recorded it before, so `(Array⏎Int)` lost the break the author
wrote and came back on one line. An expression in parens needs no such flag: its
content carries its own (a binop chain, a call), whereas a type's content is a
bare flow of leaves with nothing to hold one.

The flag has to reach the CONTENT, not just the `ParenBlock`. `ParenBlock`'s own
`forceVertical` decides where the closing `)` goes and nothing else, so setting
only that emitted `(Array Int⏎)` — parens opened, break gone — and the reparse,
seeing the content back on one row, closed it up again. Wrapping the content in
a forced-vertical flow is what makes the break survive its own output. -}
fixupParensChildrenNodesAt : Bool -> Position -> Array LPNode -> Result String (Array LPNode)
fixupParensChildrenNodesAt spansRows closeEnd nodes =
    when Array.popFirst nodes is
        Nothing ->
            Ok [ lpnLeaf (SynthesizedText "()") ]

        Just _ ->
            let
                content =
                    if spansRows then
                        [ lpnNode
                            (AcrossOrVertical { forceVertical = True, checkContentVertical = False })
                            nodes
                        ]

                    else
                        nodes
            in
            Ok
                [ lpnBracketNode
                    -- A parenthesized TYPE: its content is a bare flow of
                    -- leaves, so nothing in it can force a break on its own.
                    (ParenBlock { forceVertical = spansRows, checkContentVertical = True, contentAlwaysBreaks = False })
                    closeEnd
                    content
                ]
