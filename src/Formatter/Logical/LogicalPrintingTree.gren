module Formatter.Logical.LogicalPrintingTree exposing
    ( CommentRole(..)
    , LPBox(..)
    , LPNode
    , ListBrackets(..)
    , PrefixKind(..)
    , RecordKind(..)
    , SyntaxType(..)
    , boxIsComment
    , bracketsToString
    , commentFirstCol
    , commentGluesToPrevious
    , commentLeadsNext
    , commentLeadsOwnLine
    , commentRendersOwnLine
    , commentRidesInline
    , commentRole
    , commentTrailsHead
    , firstRowInSubtree
    , gluesTrailingComment
    , lastRowInSubtree
    , lpnBox
    , lpnBracketEndElastic
    , lpnBracketEndExact
    , lpnBracketNode
    , lpnBracketStart
    , lpnChildren
    , lpnElasticBracketNode
    , lpnExtendElasticBracket
    , lpnFirstPos
    , lpnHasComment
    , lpnLastBracketEnd
    , lpnLastPos
    , lpnLeaf
    , lpnMaxRow
    , lpnNode
    , lpnReplaceChildren
    , lpnSetCommentRole
    , lpnWithBox
    , lpnWithBracketStart
    , prefixGlyph
    , recordKindToString
    , roleGlues
    , roleIs
    , roleToString
    , spanTrailingOwnLine
    , stypeToString
    , subtreeRowRange
    )

{-| The Logical Printing Tree (LPT): the intermediate representation between the
parsed AST and the rendered string. `MakeLogical` builds it, the `Insert*`
modules populate it, `Comments`/`SortSymbols`/`VerticalSpace` transform it, and
`Formatter.Render` turns it into the final string via the `Formatter.Render.Box` backend.

Two core types:

  - `LPNode` — a tree node: a `box` (the rendering shape) plus `children`, with
    seven cached subtree-bounds fields the position-dependent passes read in
    O(1). ALL construction goes through `lpnNode`/`lpnLeaf` so the cache stays
    correct (see the type's own doc).
  - `LPBox` — the shape of one node. The constructors, by category:

**Structural** (only ever direct children of the root)
  - `RootBox` — the tree root.
  - `OriginalRows` — one top-level declaration (or an inserted comment / blank),
    tagged with its source-row range and `SyntaxType`.
  - `EmptyLine` — a blank line inserted by `VerticalSpace`.

**Text leaves**
  - `UnbreakableText` — verbatim text carrying its source location.
  - `SynthesizedText` — elided keyword/punctuation with no source position
    (`=`, `in`, `->`, `(..)`, …); excluded from row-range math.
  - `MultilineString` — a triple-quoted `"""…"""` literal, one line per element.

**Comment leaves**
  - `SingleLineComment` / `BlockComment` / `DocComment`.

**Token flows** (tokens across a line; continuation lines indent)
  - `AcrossOrVertical` — the default flow; continuations +4.
  - `IfCondition` — like above but +8, so an `if` condition's wrap is distinct
    from its branch body.
  - `WhenBranchPattern` — a when-branch's pattern with `->` glued after it.

**Bracketed lists**
  - `AllAcrossOrAllVertical` — author wrote it on one line: inline unless it
    carries a comment.
  - `AlwaysVertical` — author wrote it across rows: one item per line.
  - `EmptyBracketed` — an empty `{}` / `[]` / `()` carrying its full span.
  - `RecordUpdate` — `{ base | … }` (and extensible record types).

**Indented blocks** (body drops to its own indented line)
  - `IndentedBlock` — hard newline, +4.
  - `SoftIndentedBlock` — soft break, can stay inline (lambda/let-def bodies).
  - `BodyBlock` — hard newline at the current indent, no extra nest.
  - `WhenBranch` — one `pattern -> body` branch.

**Pipelines & binops**
  - `Pipeline` / `PipelineStep` — a `|>`/`<|` chain and one of its steps.
  - `Binop` / `OpAndRhs` — a non-pipeline operator chain and one `op rhs` group.

**Wrapping & glue**
  - `ParenBlock` — a parenthesized expression (`( … )`, no inner space).
  - `PrefixGlue` — a prefix glued with no space (`-expr`, `\pat -> …`).
  - `Glue` — children concatenated with no separator (postfix `.field` access).
  - `WhenFlow` — a whole `when … is` expression.

Each constructor's own comment below carries the detailed rationale (much of it
about idempotency); this table is the map, those comments are the territory.
-}

import Math exposing (maxSafeInteger)

import Compiler.SourcePosition exposing (Located, Position)


{-| Which brackets a bracketed list prints, and — for a curly one — whether it
is a record TYPE (`{ a : Int }`) or a record VALUE (`{ a = 1 }`, and the record
pattern, which separates the same way).

The kind rides here because it is known exactly once, at construction, and by
exactly one builder each: `InsertTypes` makes the type, `InsertExpressions` /
`InsertPatterns` / `MakeLogical` make the value. The renderer used to recover it
by scanning a field's children for a `SynthesizedText ":"` — asking the
separator glyph what the construct is, one altitude below where the answer was
already known. -}
type ListBrackets
    = ListParen
    | ListCurly RecordKind
    | ListSquare


{-| Whether a curly bracket list separates its fields with `:` or with `=`. -}
type RecordKind
    = RecordType
    | RecordValue


{-| The record kind for `--lpt` output. `Nothing` for a non-curly bracket, which
has no kind. -}
recordKindToString : ListBrackets -> Maybe String
recordKindToString brackets =
    when brackets is
        ListCurly RecordType ->
            Just "type"

        ListCurly RecordValue ->
            Just "value"

        _ ->
            Nothing


type SyntaxType
    = StModule
    | StImport
    | StSingleLineComment
    | StBlockComment
    | StDocComment
    | StFunctionSignature
    | StFunctionDeclaration
    | StTypeAlias
    | StTypeUnion
    | StPort
    | StInfixDecl


stypeToString : SyntaxType -> String
stypeToString st =
    when st is
        StModule ->
            "module"

        StImport ->
            "import"

        StSingleLineComment ->
            "lineComment"

        StBlockComment ->
            "blockComment"

        StDocComment ->
            "docComment"

        StFunctionSignature ->
            "funcSig"

        StFunctionDeclaration ->
            "funcDecl"

        StTypeAlias ->
            "typeAlias"

        StTypeUnion ->
            "typeUnion"

        StPort ->
            "port"

        StInfixDecl ->
            "infixDecl"


{-| The bracket pair a container is written with. Lives here, beside the type,
because two debuggers now name it -- `--lpt`'s JSON and the decision trace --
and a bracket that spells itself `curly` in one dump and `Curly` in the other is
a diff nobody can read across. -}
bracketsToString : ListBrackets -> String
bracketsToString brackets =
    when brackets is
        ListParen ->
            "paren"

        ListCurly _ ->
            -- The GLYPH, so this stays stable for `--lpt`'s `brackets` field,
            -- `show-tree.py`'s glyph table and `DecisionTrace`'s decision
            -- labels. The record kind is a separate fact, reported separately
            -- (`recordKindToString`).
            "curly"

        ListSquare ->
            "square"


{-| How a comment joins the tokens around it — decided **once**, at
comment-insertion time in `Formatter.Logical.Comments`, from the pristine
parse rows, and stored on the comment leaf. The renderer reads the role and
never re-derives it from source rows.

  - `TrailsPrevious` — glues onto the end of the previous sibling's last
    rendered line, preceded by one space (`<prev-last-line> <comment>`). For a
    `--` this is always safe (it runs to end-of-line); for a `{- -}` it is only
    assigned where the block-glue rules allow.
  - `LeadsOwnLine` — renders on its own line at the current flow/body indent,
    before the next sibling. The default for own-row comments.
  - `LeadsNext` — the comment belongs to the sibling that FOLLOWS it, across a
    separator the parser did not record, and renders glued to the front of that
    sibling's box (`| {- c -} a = 1`, `, {- c -} 2`). This is rule **C2** — "where
    the separator has no source position, the comment leads what follows it" —
    made a stored fact, so no renderer has to re-derive which side of an invisible
    `|` or `,` the author wrote it on. Whether it rides the sibling's first row or
    stands above it is the comment's own shape, not its position, so the renderer
    asks `commentTextCanRide`; everything else is settled here.
  - `TrailsHead` — glues onto the end of a container's **head**: the part of the
    container that is not one of its children, so `TrailsPrevious` has nothing to
    attach to. Today that is exactly a record update's base name
    (`{ rec -- c` ⏎ `| a = 1 }`), whose fields are the children and whose base is
    carried on the `RecordUpdate` box itself. A `--` before a *line-leading*
    separator keeps the row it was written on (see `Comments.gren`'s record-update
    arm), and on the base's row that row belongs to the head.
  - `RidesInline` — an inline `{- -}` that rides in the middle of a flat flow
    without forcing a break (`f {- k -} x`). Only ever a single-line block
    comment. Distinguished from `TrailsPrevious` only by
    `literalCommentsRideFlatLine` (which keeps a bracket/union flat when every
    comment rides); every other consumer glues both alike.
  - `LeadsInline` — a block comment the author glued to the *front* of a
    top-level declaration's line, before its first token (`{- c -} import Qux`).
    The front-of-line mirror of `TrailsPrevious`: it travels with the
    declaration (so it never breaks an import run) and renders glued — the
    comment's last line joined by one space to the declaration's first line, its
    earlier lines above. Only ever a leading block-comment child of a
    declaration's `OriginalRows`; assigned in `Comments.gren` when the comment's
    closing-delimiter end row equals the following declaration's start-token row.
  - `Standalone` — a top-level detached comment: its own `OriginalRows` at
    column 1.

`DocComment` needs no role — doc comments are top-level-only and already
unambiguous. (A comment inside a bracket container is not a distinct role: the
classifier's bracket branch tags it `TrailsPrevious` / `RidesInline` /
`LeadsOwnLine` like any other, which is all `commentBracketListBox` needs.)
-}
type CommentRole
    = TrailsPrevious
    | LeadsOwnLine
    | LeadsNext
    | TrailsHead
    | RidesInline
    | LeadsInline
    | Standalone


{-| The role's name. Lives here for the same reason `roleGlues` does: the answer
is a property of the role and of nothing else, and two debuggers read it back
(`--lpt`'s JSON and the decision trace). -}
roleToString : CommentRole -> String
roleToString role =
    when role is
        TrailsPrevious ->
            "TrailsPrevious"

        LeadsOwnLine ->
            "LeadsOwnLine"

        LeadsNext ->
            "LeadsNext"

        TrailsHead ->
            "TrailsHead"

        RidesInline ->
            "RidesInline"

        LeadsInline ->
            "LeadsInline"

        Standalone ->
            "Standalone"


type LPBox
    -- This is needed just to use as a root node
    = RootBox
    -- Sets the original source row for the children
    | OriginalRows { first : Int, last : Int, stype : SyntaxType }
    -- An empty line inserted after we have grouped everything
    | EmptyLine
    -- Just regular text; printed as-is. Can never be broken.
    -- The location is the original source location, if we have it.
    | UnbreakableText (Located String)
    -- Synthesized keyword or punctuation with no source position
    -- (e.g. "=", "in", "then", "else", "->", "is", "(..)").
    -- Excluded from all row-range computations.
    | SynthesizedText String
    -- For when the line starts with and is only a single-line comment.
    -- `role` (see `CommentRole`) is decided at comment-insertion time and
    -- tells the renderer how the comment joins its neighbours, so no
    -- render-side code re-derives that from source rows.
    | SingleLineComment { loc : Located String, role : CommentRole }
    | BlockComment { loc : Located String, role : CommentRole }
    | DocComment (Located String)
    -- Author-driven binary flow, same as `AllAcrossOrAllVertical` but for a
    -- bare (unbracketed) sequence of tokens rather than a delimited list: all
    -- across on one line if the author wrote it that way (regardless of
    -- length — no page width, no wrapping), or one child per line, indented
    -- +4, if the author wrote it across rows (`forceVertical`) or a child's
    -- own content forces a break.
    --
    --     foo bar baz
    --         qux quux         -- continuation indented +4
    --
    -- `checkContentVertical` opts into the same "content can force
    -- verticality regardless of forceVertical" backstop as `ParenBlock`'s
    -- flag of the same name, but scoped to genuine `Src.Call` (function
    -- call arguments) only -- `AcrossOrVertical` is reused for many other
    -- flows (a function/lambda's own name-args-`=`/`->` head, a record
    -- field's name-`=`-value, an effect-module binding, ...) where the
    -- trailing token must always stay glued to the last item and must NOT
    -- be pushed onto its own line just because an earlier item (e.g. a
    -- comment-bearing pattern) happens to render multi-row. When True and
    -- any argument's content forces a hard break, every argument in the
    -- call renders one-per-line -- not just the triggering one -- so the
    -- call commits to the vertical shape from the first format instead of
    -- only catching up (and flipping non-idempotently) on reparse.
    | AcrossOrVertical { forceVertical : Bool, checkContentVertical : Bool }
    -- Like AcrossOrVertical but with 2× the indent on continuation lines.
    -- Used for if/else if conditions so their continuations are more indented
    -- than the branch body (+8 vs +4), making them visually distinct.
    --
    --     if longCondition
    --             && more then   -- condition wraps at +8
    --         body               -- body at +4
    | IfCondition { forceVertical : Bool }
    -- Lists with surrounding brackets that the author wrote on one line.
    -- Renders inline on one line (regardless of width); the only thing that
    -- forces it one-item-per-line is a contained comment. Lists the author
    -- wrote across rows use `AlwaysVertical` instead.
    --
    --     [ a, b, c ]            or       [ a       -- (only with a comment)
    --                                     , b
    --                                     , c
    --                                     ]
    | AllAcrossOrAllVertical ListBrackets
    -- Always-vertical list: one item per line. Used for array literals and
    -- record literals the author wrote across multiple source rows (see
    -- `Src.ArrayLiteral` / `Src.Record` in InsertExpressions and
    -- `itemsSpanRows`). The one-line-authored counterpart is
    -- `AllAcrossOrAllVertical`; record *updates* use `RecordUpdate`.
    --
    --     { x = 1
    --     , y = 2
    --     }
    | AlwaysVertical ListBrackets
    -- Multi-field record update: base name on first line, fields indented +4.
    --
    --     { pt
    --         | x = pt.x + dx
    --         , y = pt.y + dy
    --     }
    -- The base name carries its own source position so the
    -- comment-placement logic can use the extension variable's column
    -- as the RecordUpdate subtree's "start" — keeping a comment that
    -- sits between the base name and `|` from being treated as
    -- appearing before the whole RecordUpdate.
    --
    -- `forceVertical` is True when the author wrote the fields across
    -- multiple rows: like array/record literals, the update then stays
    -- one-field-per-line. When False (author wrote it on one line) it renders
    -- inline `{ base | a, b }`, regardless of width.
    | RecordUpdate { name : Located String, forceVertical : Bool }
    -- An empty bracketed literal (`{}` / `[]` / `()`). Carries the full
    -- source span so a comment that sits between the opening and
    -- closing bracket (`{ {- c -} }`) can be placed as a child of this
    -- node during comment insertion, instead of falling out to a
    -- sibling slot of the literal.
    | EmptyBracketed (Located ListBrackets)
    -- Children always render on a new indented line (used for then/else bodies, etc.).
    --
    --     parent
    --         child
    | IndentedBlock
    -- One step in a |> or <| pipeline: renders like IndentedBlock but always
    -- hard-breaks before the pipe operator. Adds a blank line before if the
    -- step starts with a comment.
    --
    --     seed
    --         |> step1
    --         |> step2
    | PipelineStep
    -- A whole `|>`/`<|` pipeline: children are the seed node(s) followed by the
    -- `PipelineStep` nodes. `op` is `"|>"` or `"<|"`. Mirrors the author-layout
    -- rule of the bracketed containers: a pipeline written on one line stays
    -- inline (`seed |> a |> b`), regardless of width; one written across rows
    -- gets one step per line. `forceVertical` is True when the
    -- author wrote the seed/steps across rows (signal B). A pipeline carrying any
    -- comment always renders through the `PipelineStep` path (its comment-peeling
    -- / blank-line logic is intricate and stays untouched).
    --
    -- For `|>`: operator leads each step line (`seed\n    |> step`).
    -- For `<|`: operator trails the seed/previous step (`seed <|\n    step`);
    --   when the step body is a lambda, the lambda head also trails
    --   (`seed <| \patterns ->\n    body`).
    | Pipeline { forceVertical : Bool, op : String }
    -- Function body block: forces a hard newline before children, no extra nesting
    -- (the enclosing flow already supplies the 4-space indent).
    --
    --     foo =
    --         body
    | BodyBlock
    -- One branch in a when/is expression.
    --
    --     Pattern ->
    --         body
    | WhenBranch
    -- Pattern nodes for one when-branch. Renders like AcrossOrVertical
    -- (continuation lines +4) but appends " ->" directly after the last token,
    -- so the arrow always trails the pattern on the same line — including after
    -- the closing } of a broken record pattern.
    | WhenBranchPattern
    -- Parenthesized expression: renders children with ( prefix and ) suffix
    -- concatenated with immediate adjacency (no space). Used instead of
    -- text-modification so that bracket-rendered containers (like arrays) render
    -- correctly: ([...] ++ x) not [( ... ] ++ x).
    --
    -- `forceVertical` is True when the author wrote the opening and closing
    -- parens on different source rows (`Src.Parens`'s own start/end row
    -- differ). `checkContentVertical` additionally lets the renderer fall
    -- back to "does the content contain a HardNl regardless of how it was
    -- written" (an if/when/let body, a comment, a multiline string) — needed
    -- for idempotency: content that's *structurally* forced vertical can
    -- have `forceVertical = False` on a first pass (author crammed it onto
    -- one source row) yet render multi-row anyway, and reparsing that output
    -- would then see `forceVertical = True`, flipping the decision. Both are
    -- always False for formatter-synthesized parens (pattern/type wrapping)
    -- that carry no author position of their own — `checkContentVertical`
    -- is False there too so a comment/multiline construct *inside* a
    -- synthesized wrap doesn't unexpectedly pull the closing paren onto its
    -- own line; only genuine `Src.Parens` (expressions) opts in. When either
    -- flag is True and the content isn't already handled by a more specific
    -- paren-block shape (when/if/let, a multiline lambda), the closing `)`
    -- renders on its own line at the opening `(`'s column instead of
    -- trailing the last content token.
    --
    -- `contentAlwaysBreaks` is `InsertExpressions.exprAlwaysBreaks` of the
    -- parenthesized expression, recorded at construction: "this content
    -- renders multi-line however the author laid it out", so the `)` gets a
    -- row of its own even with `forceVertical = False`. It is the same
    -- question `checkContentVertical` makes the RENDERER ask of the rendered
    -- box, answered up front for the LOGICAL stage, which has no box to look
    -- at — `Comments.prevBlockGlueRow` needs it to know whether a trailing
    -- `{- -}` has a `)` row to glue onto. False for synthesized parens
    -- (pattern/type wrapping), whose content is a bare flow of leaves.
    | ParenBlock { forceVertical : Bool, checkContentVertical : Bool, contentAlwaysBreaks : Bool }
    -- One step of a non-pipeline binop chain: children are [op, ...rhsNodes].
    -- Renders the operator immediately adjacent (with a single space) to the
    -- rhs flow, so when the surrounding chain breaks, the operator starts the
    -- new line instead of dangling at the end of the previous one.
    | OpAndRhs
    -- A whole non-pipeline binop chain (`a + b * c`). Children are the nested
    -- `[operand0, OpAndRhs(op1, [operand1, OpAndRhs(op2, …)])]` structure the
    -- chain has always built. Mirrors the author-layout rule: inline when written
    -- on one line and it fits, otherwise **precedence-aware** — broken only at the
    -- chain's lowest-precedence operators (operator-led, one group per line), with
    -- tighter-binding sub-terms kept inline:
    --
    --     baseScore
    --         + bonusPoints * multiplier
    --         - penaltyAmount
    --
    -- `forceVertical` is True when the author wrote the lowest-precedence split
    -- groups across rows. A chain carrying any comment falls back to the existing
    -- `OpAndRhs` fill rendering (children laid out as a plain flow), unchanged.
    | Binop { forceVertical : Bool }
    -- `when … is` expression. Children are:
    --   [whenNode, …scrutineeNodes, isNode, IndentedBlock(branchNodes)]
    -- Flat: "when scrutinee is" on one line (when the author wrote it so).
    -- Broken: `when` then scrutinee indented +4, `is` back at the `when`
    -- column, branches indented +4. This keeps `when` and `is` visually
    -- paired; scrutinee arg-continuation lines land at +8, visually
    -- distinct from branch bodies at +4.
    --
    --     when fn arg1           or    when fn arg1 arg2 is
    --          arg2                        Nothing -> …
    --     is
    --         Nothing -> …
    | WhenFlow { forceVertical : Bool }
    -- Prefix glued (no space) to the rendered children. Used for
    -- prefix-negation `-expr` (`PrefixMinus`) and a lambda's `\`-glued
    -- FIRST parameter — `\pat` in `\pat -> body` (`PrefixLambdaHead`);
    -- the rest of the lambda (further params, `->`, body) are sibling
    -- flow nodes, so this wraps only the head fragment, not the whole
    -- lambda. Mapping the prefix onto the first text leaf instead
    -- descends into nested containers and corrupts the AST (e.g.
    -- `-(n - 1)` would render as `(-n - 1)`); a record/array pattern
    -- would similarly land the prefix *inside* the brackets.
    -- The prefix carries its own source position so the comment-
    -- placement logic can anchor on it (otherwise a comment between
    -- the prefix and its content lands outside the PrefixGlue
    -- entirely). The `PrefixKind` payload — not a bare glyph string —
    -- is what lets `Comments` branch on `gluesTrailingComment` (minus
    -- owns a same-row trailing comment; a lambda head does not, since
    -- `-> body` still follows).
    | PrefixGlue (Located PrefixKind)
    -- Children concatenated with NO separator. Used for a postfix
    -- accessor glued after a bracket-rendered base: `(expr).field`,
    -- `{ a = 1 }.a`, `{ r | a = 1 }.a`. Mapping the accessor onto the
    -- last text leaf would land it *inside* the closing bracket
    -- (`(... b.field)`), and a flow separator would insert a space —
    -- which re-parses as applying the accessor *function* to the base,
    -- a different expression. The accessor is an ordinary positioned
    -- leaf child, so position bookkeeping needs no special casing.
    | Glue
    -- Let-def body: keeps children inline after `=` unless the body itself
    -- breaks. Unlike IndentedBlock (which always forces a hard newline), this
    -- wraps the body in a group (rendered flat, so the soft break before it
    -- collapses to a space). A body that contains its own unflattenable hard
    -- break — a block-style `if`/`let`/lambda body, or a comment — drops to a
    -- new line at +4 from the binding name's column; a simple body stays inline.
    --
    --     name = body                or       name =
    --                                             body
    | SoftIndentedBlock
    -- A triple-quoted (""") multiline string literal.
    -- Each element is one line of content (leading whitespace already stripped by the parser).
    -- Rendered as """ followed by a hard-newline-separated list of lines and a closing """.
    --
    --     """
    --     line 1
    --     line 2
    --     """
    -- Triple-quoted string content. Carries the source positions of
    -- the opening/closing `"""` delimiters so the row range of any
    -- enclosing OriginalRows extends over the whole literal and
    -- adjacent comments can be anchored to it.
    | MultilineString (Located (Array String))


{-| Which prefix a `PrefixGlue` carries. Both render identically (the glyph
glued onto the inner's first line with no space), but they differ in one leaf
property — whether a same-row trailing comment belongs to them — so the two
uses are one constructor with a payload, not two constructors. See
`gluesTrailingComment`.
-}
type PrefixKind
    = PrefixMinus
    | PrefixLambdaHead


{-| The literal glyph a `PrefixGlue` prints: `-` for negation, `\` for a
lambda head. The single source of truth for the emitted character.
-}
prefixGlyph : PrefixKind -> String
prefixGlyph kind =
    when kind is
        PrefixMinus ->
            "-"

        PrefixLambdaHead ->
            "\\"


{-| Does a same-row comment trailing this prefix's content belong to it (glue
onto its last row) rather than lead its own line? A unary minus is a
self-contained unit — nothing follows its operand — so it owns the comment. A
lambda head does not: `-> body` still follows the `\`-glued first parameter, so
a comment there leads its own line (see `KitchenComments`).
-}
gluesTrailingComment : PrefixKind -> Bool
gluesTrailingComment kind =
    when kind is
        PrefixMinus ->
            True

        PrefixLambdaHead ->
            False


{-| The logical-printing-tree node.

The record carries a `box` (the rendering shape) and `children`, plus
seven fields that *cache* subtree bounds so position-dependent passes
can answer "what's the first/last positioned token in this subtree?",
"what's its row range?", and "where does the last bracketed sublist
begin/end?" in O(1) instead of by recursive descent. The heaviest
consumer is the comment-placement heuristic in `Formatter.Logical.Comments`,
but the bounds are shared infrastructure: `MakeRenderBox` also reads
`firstPos`/`lastPos`/`maxRow`/`lastBracketEnd` (and `bracketStart`,
added later for signature-segment row computation, not comments). The
cache is populated bottom-up by `lpnNode` at construction time. ALL
LPT construction must go through `lpnNode` (or `lpnLeaf`) — building
an `LPNode` by direct record syntax would skip the cache and produce
wrong answers from the accessors. The type is exported **opaque** for
exactly that reason: outside this module there is no way to spell the
record, so the rule is a compile error rather than a convention.

`lastBracketEnd` is the source position of the last positioned
descendant of the rightmost bracket-list (`AllAcrossOrAllVertical`,
`AlwaysVertical`, or `EmptyBracketed`) in this subtree, or
`Nothing` if the subtree contains no such bracket. The
comment-placement descent guard uses it to allow descent into an
`AcrossOrVertical` whose last positioned token is before the comment
*when* the comment is on the same row and column-close to the
bracket's closing position — i.e. the user almost certainly wrote
the comment between the bracket's last item and the closing
bracket character.
-}
type LPNode
    = LPNode
        { box : LPBox
        , children : Array LPNode
        , firstPos : Maybe Position
        , lastPos : Maybe Position
        , minRow : Int
        , maxRow : Int
        , lastBracketEnd : Maybe Position
        , bracketEndExact : Bool
        , bracketEndElastic : Bool
        , bracketStart : Maybe Position
        , hasComment : Bool
        }


lpnBox : LPNode -> LPBox
lpnBox node =
    when node is
        LPNode r ->
            r.box


lpnChildren : LPNode -> Array LPNode
lpnChildren node =
    when node is
        LPNode r ->
            r.children


{-| The `CommentRole` of a comment box, or `Nothing` for non-comment boxes
(and `DocComment`, which carries no role). -}
commentRole : LPBox -> Maybe CommentRole
commentRole box =
    when box is
        SingleLineComment c ->
            Just c.role

        BlockComment c ->
            Just c.role

        _ ->
            Nothing


{-| Does this node carry exactly this `CommentRole`? `False` for a non-comment.

The one spelling for the question "what role does this comment have". It used to
have several: four named one-liners in the render layer
(`commentTrailsHead`/`commentLeadsOwnLine`/`commentLeadsNext`/`commentRidesInline`)
and the open-coded `commentRole (lpnBox n) == Just X` in four more modules, none
of which could see the others. This is the vocabulary every comment bugfix
navigates by, so it lives here, beside the type.

Note the near-misses that are deliberately NOT this: `roleGlues` asks about a
CLASS of roles, and `commentRendersOwnLine` is `roleIs LeadsOwnLine` **and** a
shape test -- a role saying own-line is not the same as rendering on one. -}
roleIs : CommentRole -> LPNode -> Bool
roleIs role node =
    commentRole (lpnBox node) == Just role


commentTrailsHead : LPNode -> Bool
commentTrailsHead =
    roleIs TrailsHead


commentLeadsOwnLine : LPNode -> Bool
commentLeadsOwnLine =
    roleIs LeadsOwnLine


commentLeadsNext : LPNode -> Bool
commentLeadsNext =
    roleIs LeadsNext


{-| True when this comment's stored role is exactly `RidesInline`.

**Not the same question as `commentTextCanRide`**, which asks the comment's
SHAPE (is it a single-line `{- … -}`). Every `RidesInline` comment is a
single-line block comment, but not every single-line block comment is
`RidesInline` — one written across a list's unrecorded `,` (`[ 1, {- c -} 2 ]`)
is classified `LeadsNext` by rule C2, so it is shape-ridable but not
role-ridable.

The example this used to give — the second comment of a run just inside an
opening bracket, `[ {- a -} {- b -} 1` — is no longer one: since `f05a4cc` the
whole opener run is one attachment and every member is `RidesInline` (rule C1;
`Comments.inOpenerRun`). It was the split that made a run of two ride
differently from a run of one.

Three stale comments sat on this function until 2026-08-02, one of them
describing `commentTextCanRide`'s rule and asserting that the classifier tags
such a comment `RidesInline`. That conflation is not true of a run, and it is
the likely origin of the two predicates being used in sibling arms of
`commentBracketListBox`. -}
commentRidesInline : LPNode -> Bool
commentRidesInline =
    roleIs RidesInline


{-| Does this role glue the comment onto the end of the previous item's last
rendered line, rather than give it a line of its own?

The one spelling of that question. It had four — `FlowPolicy.roleGlues`,
`CommentBox.commentTrailsRole`, `MakeRenderBox.commentTrailsRole` and
`FlowAssembly.commentGlues` — which is one per module that needed to ask, each
free to drift from the others. It lives here, beside `CommentRole` itself,
because the answer is a property of the role and of nothing else.
-}
roleGlues : CommentRole -> Bool
roleGlues role =
    role == TrailsPrevious || role == RidesInline


{-| `roleGlues` for a comment node: does a comment glue onto what precedes it?
`False` for any non-comment node. -}
commentGluesToPrevious : LPNode -> Bool
commentGluesToPrevious node =
    when commentRole (lpnBox node) is
        Just role ->
            roleGlues role

        Nothing ->
            False


{-| Split off the trailing run of comments the author gave a line of their own:
`{ body, trailing }`, where `trailing` is the trailing comment run **that starts
at an own-line member** and `body` is everything before it.

A comment that RIDES the previous token's line (`module Foo {- c -} exposing`)
stays in the body, where the caller's flow renders it on that line — peeling it
would move it below. That is why the run has to *start* at a `LeadsOwnLine`
comment rather than merely contain one.

**But a comment that glues onto another COMMENT of the run travels with it**,
and until 2026-08-06 it did not: this asked for the maximal suffix of
`LeadsOwnLine` comments, so a run whose last member glues (`{- multi… -}
{- multi… -}`, the second classified `TrailsPrevious` against the first) peeled
**nothing at all** and the whole run stayed behind. That is rule C1 — one gap is
one attachment, and the run moves together — and `Comments.detachOwnLineTrailer`
had already written it down: *"the whole run moves together and only the first
member becomes `Standalone`; a `-- c` glued behind it keeps `TrailsPrevious`,
which is the tree the reparse produces."* The two callers that most needed it are
the pipeline-step pair, whose halves must agree
(`Comments.movePipelineStepTrailers` and `renderPipelineStepChildrenWith`'s
`stopped` peel); with one comment each behaved, with two neither did.

So: scan back over comments, and split at the EARLIEST own-line one. A run with
no own-line member at all peels nothing, exactly as before.

Polymorphic in the element so the pre-rendered `FlowItem` path shares it: pass
`identity` for a plain node array, `.node` for flow items.

**Lives here, beside `CommentRole`, for the reason `roleGlues` does**: which
comments form a trailing own-line run is a property of the role and of nothing
else. It had two implementations — this one and `Comments.spanTrailingOwnLineNodes`
— and the second existed only because `Formatter.Logical.Comments` cannot import
`Formatter.Render.CommentBox` (`Render` depends on `Logical`, not the reverse).
Its docstring said as much and called itself a mirror. A rule that both the
attachment pass and the renderer must agree on, implemented twice by necessity,
is the shape this module exists to dissolve: both import `LogicalPrintingTree`
already, so the necessity was in the placement, not in the rule.
-}
spanTrailingOwnLine : (a -> LPNode) -> Array a -> { body : Array a, trailing : Array a }
spanTrailingOwnLine toNode items =
    let
        -- The original rule, unchanged: the maximal suffix of `LeadsOwnLine`
        -- comments.
        plain remaining acc =
            when Array.popLast remaining is
                Just { last, initial } ->
                    if commentLeadsOwnLine (toNode last) then
                        plain initial (Array.pushFirst last acc)

                    else
                        { body = remaining, trailing = acc }

                Nothing ->
                    { body = [], trailing = acc }

        -- Reached only when the suffix ends in a comment that GLUES, where the
        -- rule above peels nothing at all. Walk back over the trailing comment
        -- run and split at the earliest member that genuinely renders on a line
        -- of its own; the gluing comments after it come with it (rule C1).
        --
        -- `commentRendersOwnLine`, not the role: a single-line `{- c -}` tagged
        -- `LeadsOwnLine` is still rendered inline by the layer below, so
        -- starting a run at one MOVES it — `KitchenComments`' `{-c99-}` glued
        -- onto its pipeline step's line, and peeling it stacked the run below
        -- the step where the reparse detaches it to column 1.
        extended remaining acc best =
            when Array.popLast remaining is
                Just { last, initial } ->
                    when commentRole (lpnBox (toNode last)) is
                        Just _ ->
                            let
                                grown =
                                    Array.pushFirst last acc
                            in
                            if commentRendersOwnLine (toNode last) then
                                extended initial grown (Just { body = initial, trailing = grown })

                            else
                                extended initial grown best

                        Nothing ->
                            best

                Nothing ->
                    best

        first =
            plain items []
    in
    if not (Array.isEmpty first.trailing) then
        first

    else
        when extended items [] Nothing is
            Just split ->
                split

            Nothing ->
                { body = items, trailing = [] }


{-| Does this comment actually RENDER on a line of its own?

**Not the same question as `commentRole == Just LeadsOwnLine`**, and the
difference has cost this repo twice. The render layer keeps a *single-line*
block comment inline whatever its role says — which is why `[ 1 ] {- one -}
{- two -}` stays on its row — so "renders own-line" needs the comment's SHAPE as
well: it must bring its own rows. `Comments.runRendersBelowDeclaration` learned
that first (lifting on the role alone broke nine fixtures), and
`spanTrailingOwnLine`'s run extension learned it again on 2026-08-06.

A `--` also ends its row and is deliberately excluded, for the reason
`runRendersBelowDeclaration` gives: several fixtures pin an own-line `--`
staying at its construct's indent, and whether those should move is a separate
question with its own fixtures. -}
commentRendersOwnLine : LPNode -> Bool
commentRendersOwnLine node =
    commentLeadsOwnLine node
        && (when lpnBox node is
                BlockComment c ->
                    String.contains "\n" c.loc.value

                _ ->
                    False
           )


{-| Rebuild a comment leaf carrying `role`. A no-op on any other node. Role
does not affect the cached position bounds, so they are preserved as-is. -}
lpnSetCommentRole : CommentRole -> LPNode -> LPNode
lpnSetCommentRole role node =
    when node is
        LPNode r ->
            when r.box is
                SingleLineComment c ->
                    LPNode { r | box = SingleLineComment { c | role = role } }

                BlockComment c ->
                    LPNode { r | box = BlockComment { c | role = role } }

                _ ->
                    node


{-| First positioned token of the subtree in depth-first pre-order.
For `PrefixGlue`/`RecordUpdate`/`EmptyBracketed`, the box's own
position takes precedence over the children (the prefix `\`, the
base name, or the opening bracket itself is the earliest position).
-}
lpnFirstPos : LPNode -> Maybe Position
lpnFirstPos node =
    when node is
        LPNode r ->
            r.firstPos


{-| Column of the leftmost token on the earliest row among a node's direct
children — the visible indentation of a comment node's first line.

Reads each comment leaf's source position straight from its box, because
`lpnFirstPos` returns the *first child in array order* (not the minimum
position) and can miss the leading comment when a same-row trailing comment
shares the row (`{-| doc -} {- x -}` reports the trailing block's column
otherwise). Scans for the true minimum `(row, col)`; defaults to 1 for a
childless node.

Column 1 vs. indented is what tells a comment that leads the declaration below
it from one that trailed the construct above — `VerticalSpace.computeGroupStarts`
and `SortSymbols.takeIndentedTrailingIdx` both turn on it, and they must agree.
-}
commentFirstCol : LPNode -> Int
commentFirstCol node =
    let
        leafStart child =
            when lpnBox child is
                SingleLineComment { loc } ->
                    Just loc.start

                BlockComment { loc } ->
                    Just loc.start

                DocComment loc ->
                    Just loc.start

                _ ->
                    lpnFirstPos child
    in
    lpnChildren node
        |> Array.foldl
            (\child acc ->
                when leafStart child is
                    Just p ->
                        when acc is
                            Just best ->
                                if p.row < best.row || (p.row == best.row && p.col < best.col) then
                                    Just p

                                else
                                    acc

                            Nothing ->
                                Just p

                    Nothing ->
                        acc
            )
            Nothing
        |> Maybe.map .col
        |> Maybe.withDefault 1


{-| Last positioned token of the subtree in depth-first post-order.
Children take precedence over the box's own position when both
contribute, mirroring the existing `lpnLastPos` semantics.
-}
lpnLastPos : LPNode -> Maybe Position
lpnLastPos node =
    when node is
        LPNode r ->
            r.lastPos


{-| Smallest source row covered by any positioned descendant, or
`maxSafeInteger` if the subtree has no positioned leaves.
-}
lpnMinRow : LPNode -> Int
lpnMinRow node =
    when node is
        LPNode r ->
            r.minRow


{-| Largest source row covered by any positioned descendant
(BlockComments' end row is widened by the number of newlines in
their content), or `-1` if the subtree has no positioned leaves.
-}
lpnMaxRow : LPNode -> Int
lpnMaxRow node =
    when node is
        LPNode r ->
            r.maxRow


{-| Source position of the last positioned descendant of the
rightmost bracket-list in this subtree, or `Nothing` if no
bracket-list exists. The descent guard pairs this with a column
proximity check to decide whether a same-row trailing comment is
*inside* the bracketed sublist (between its last item and the
closing bracket character) or *outside* (e.g. after `}` and an
`as wholeRecord`, where the closing bracket has long since
appeared in the source).
-}
lpnLastBracketEnd : LPNode -> Maybe Position
lpnLastBracketEnd node =
    when node is
        LPNode r ->
            r.lastBracketEnd


{-| True when `lastBracketEnd` is the container's *exact* closing-bracket
position (set by `lpnBracketNode`), rather than the last item's end used as a
fallback for bracket lists with no represented close (e.g. module `exposing`,
where-blocks, patterns). Callers classifying a trailing comment use strict
"before the close" when exact, and a small slack otherwise. -}
lpnBracketEndExact : LPNode -> Bool
lpnBracketEndExact node =
    when node is
        LPNode r ->
            r.bracketEndExact


{-| True when `lastBracketEnd` is a *derived* close that grows as comments are
placed inside (set by `lpnElasticBracketNode`). See that function. -}
lpnBracketEndElastic : LPNode -> Bool
lpnBracketEndElastic node =
    when node is
        LPNode r ->
            r.bracketEndElastic


{-| True when this node or any descendant is a comment. O(1) — reads the cache
`lpnNode` populates bottom-up, the same way the position bounds are read.

The renderer asks this to route a comment-bearing construct to its
comment-aware layout instead of a comment-oblivious one, so it is asked at
several levels of one descent; recomputing it walked the same subtree once per
level. Caching is safe for the reason the bounds are: `LPNode` is opaque, so
every node in the tree — including the comment nodes `Formatter.Logical.Comments`
splices in afterwards — is built by `lpnNode`, which recomputes this from its
children. -}
lpnHasComment : LPNode -> Bool
lpnHasComment node =
    when node is
        LPNode r ->
            r.hasComment


{-| Whether a box is itself a comment (rather than merely containing one). -}
boxIsComment : LPBox -> Bool
boxIsComment box =
    when box is
        SingleLineComment _ ->
            True

        BlockComment _ ->
            True

        DocComment _ ->
            True

        _ ->
            False


{-| The exact source position of this container's *opening* bracket, when the
builder recorded one (`lpnWithBracketStart`), or `Nothing`. Unlike the row/pos
bounds this is a property of the node itself, not aggregated from children.

The opening bracket has no leaf of its own in the tree, so a container whose
first item dropped to the next input row looks like it *starts* on that row.
`NodeClassify.segFirstRow` uses this to read a signature segment's true
start row (`-> { ⏎ x : Int }` begins at the `{`, not the field), so a break
inside the braces doesn't masquerade as a break between `->` segments.
-}
lpnBracketStart : LPNode -> Maybe Position
lpnBracketStart node =
    when node is
        LPNode r ->
            r.bracketStart


{-| Record `openStart` as the node's opening-bracket position, and extend the
cached start bounds to cover it.

The bracket is part of the node's source extent even though it has no leaf, so
`firstPos` / `minRow` must include it — otherwise a comment written between the
`[` and the first item (`[ {- c -} 1 ]`) reads as starting *before* the whole
container, and every ancestor inherits that lie because the bounds aggregate
from the children's cached values. That is what hoisted such a comment onto its
own line above the container.

Called at construction, before the node is handed to a parent's `lpnNode`, so
the corrected bounds propagate upward for free. -}
lpnWithBracketStart : Position -> LPNode -> LPNode
lpnWithBracketStart openStart node =
    when node is
        LPNode r ->
            LPNode
                { r
                    | bracketStart = Just openStart
                    , firstPos =
                        when r.firstPos is
                            Just p ->
                                if openStart.row < p.row || (openStart.row == p.row && openStart.col < p.col) then
                                    Just openStart

                                else
                                    Just p

                            Nothing ->
                                Just openStart
                    , minRow = min openStart.row r.minRow
                }


{-| Replace a node's box, keeping its children and cached POSITION bounds
as-is. Used to tag an already-built node with context its constructor didn't
have — e.g. shifting an `OriginalRows` node's cached row range after a reorder.

Leaving the position cache untouched is deliberate and load-bearing:
`SortSymbols.rowSpan` documents that it reads a node's TRUE original position
while `origRowsFirst`/`origRowsLast` read the shifted box, and conflating the
two once produced silently-wrong deltas across a whole import group.

`hasComment` is recomputed, because it is not a fact about where the node
started: swap a comment box for a non-comment one and the old answer is simply
wrong. Today's only caller swaps `OriginalRows` for `OriginalRows` and cannot
trip it — which is exactly why it would be found late. -}
lpnWithBox : LPBox -> LPNode -> LPNode
lpnWithBox newBox node =
    when node is
        LPNode r ->
            LPNode
                { r
                    | box = newBox
                    , hasComment = boxIsComment newBox || Array.any lpnHasComment r.children
                }


lpnLeaf : LPBox -> LPNode
lpnLeaf box =
    lpnNode box []


{-| Smart constructor that fills in the cached subtree bounds. The
self-bounds come from `selfBoxBounds`; children's cached bounds are
combined via min/max. -}
lpnNode : LPBox -> Array LPNode -> LPNode
lpnNode box children =
    let
        self =
            selfBoxBounds box

        -- Combine children's cached bounds with self's contribution.
        merged =
            Array.foldl
                (\child acc ->
                    let
                        cfp =
                            lpnFirstPos child

                        clp =
                            lpnLastPos child

                        cbe =
                            lpnLastBracketEnd child
                    in
                    { firstPos =
                        when acc.firstPos is
                            Just _ ->
                                acc.firstPos

                            Nothing ->
                                cfp
                    , lastPos =
                        when clp is
                            Just _ ->
                                clp

                            Nothing ->
                                acc.lastPos
                    , minRow = min (lpnMinRow child) acc.minRow
                    , maxRow = max (lpnMaxRow child) acc.maxRow
                    -- Bracket-end propagates from the LAST child whose
                    -- own subtree contains a bracket. Walking
                    -- left-to-right and replacing on every `Just`
                    -- keeps the rightmost bracket-list's end.
                    , lastBracketEnd =
                        when cbe is
                            Just _ ->
                                cbe

                            Nothing ->
                                acc.lastBracketEnd
                    , bracketEndExact =
                        when cbe is
                            Just _ ->
                                lpnBracketEndExact child

                            Nothing ->
                                acc.bracketEndExact
                    -- Elasticity travels with the bracket-end it describes, so
                    -- it propagates on exactly the same rule.
                    , bracketEndElastic =
                        when cbe is
                            Just _ ->
                                lpnBracketEndElastic child

                            Nothing ->
                                acc.bracketEndElastic
                    , hasComment = acc.hasComment || lpnHasComment child
                    }
                )
                { firstPos = self.firstPos
                , lastPos = self.lastPos
                , minRow = self.minRow
                , maxRow = self.maxRow
                , hasComment = boxIsComment box
                , lastBracketEnd = Nothing
                , bracketEndExact = False
                , bracketEndElastic = False
                }
                children

        -- If THIS node is itself a bracket-list, its own bracket-end
        -- is the lastPos of the contents (= the last positioned
        -- child's end, since bracket-list boxes don't contribute a
        -- selfLastPos). This shadows any deeper bracket's end —
        -- a comment near the outer closing bracket should be
        -- classified relative to THIS bracket, not an inner one.
        bracketEnd =
            if self.isBracket then
                merged.lastPos

            else
                merged.lastBracketEnd

        -- A bracket list built via plain `lpnNode` has no represented close
        -- position, so its `bracketEnd` is the last item (inexact). An exact
        -- close only arrives via `lpnBracketNode` (below) or by propagation
        -- from an inner exact container.
        bracketExact =
            if self.isBracket then
                False

            else
                merged.bracketEndExact

        bracketElastic =
            if self.isBracket then
                False

            else
                merged.bracketEndElastic
    in
    LPNode
        { box = box
        , children = children
        , firstPos = merged.firstPos
        , lastPos = merged.lastPos
        , minRow = merged.minRow
        , maxRow = merged.maxRow
        , lastBracketEnd = bracketEnd
        , bracketEndExact = bracketExact
        , bracketEndElastic = bracketElastic
        , bracketStart = Nothing
        , hasComment = merged.hasComment
        }


{-| Like `lpnNode`, but for a bracketed container (record/array literal,
record pattern/type, …) whose *closing* bracket sits at `closeEnd` — a
position not represented by any child token. It extends the node's row range
to cover the closing bracket and records `closeEnd` as the node's
`lastBracketEnd`, so a comment written on its own line between the last item
and the closing bracket is classified as *inside* the container (and stays
there) instead of falling past the last item's range and escaping. -}
lpnBracketNode : LPBox -> Position -> Array LPNode -> LPNode
lpnBracketNode box closeEnd children =
    when lpnNode box children is
        LPNode r ->
            LPNode
                { r
                    | maxRow = max r.maxRow closeEnd.row
                    , lastBracketEnd = Just closeEnd
                    , bracketEndExact = True
                }


{-| Like `lpnBracketNode`, but for a container whose closing bracket position is
*derived* from its items rather than recorded by the parser — today only the
module header's `exposing ( … )` list (see `MakeLogical.moduleExposingClose`).

A derived close is a guess that "the `)` sits one row below the last item", and
that guess is wrong the moment a comment is placed inside: the `)` is pushed
down by however many rows the comment occupies, but the recorded close does not
move, so the *next* comment falls past it and escapes the container — the
module-header trailing-chain detach bug.

An elastic close says two things:

  - a comment that reaches this container is always *inside* it (there is
    nothing after the list for it to belong to, so proximity to the guessed
    close must not decide);
  - the close row grows as comments land inside, via `lpnExtendElasticBracket`,
    keeping the container's row range — and therefore the enclosing
    declaration's — honest about where the `)` will actually render.

`bracketEndExact` stays False: the recorded position is still not the parser's.
-}
lpnElasticBracketNode : LPBox -> Position -> Array LPNode -> LPNode
lpnElasticBracketNode box closeEnd children =
    when lpnNode box children is
        LPNode r ->
            LPNode
                { r
                    | maxRow = max r.maxRow closeEnd.row
                    , lastBracketEnd = Just closeEnd
                    , bracketEndExact = False
                    , bracketEndElastic = True
                }


{-| Push an elastic container's closing bracket to the row below `contentRow`
(a no-op on any other node, and never shrinks). Called as each comment is
placed inside, so the recorded close keeps pace with the rows the container's
contents will actually render on. -}
lpnExtendElasticBracket : Int -> LPNode -> LPNode
lpnExtendElasticBracket contentRow node =
    when node is
        LPNode r ->
            when r.lastBracketEnd is
                Just closeEnd ->
                    if r.bracketEndElastic && contentRow + 1 > closeEnd.row then
                        LPNode
                            { r
                                | maxRow = max r.maxRow (contentRow + 1)
                                , lastBracketEnd = Just { closeEnd | row = contentRow + 1 }
                            }

                    else
                        node

                Nothing ->
                    node


{-| Rebuild `old` with `newChildren`, preserving an explicit closing-bracket
position carried by `old` (from `lpnBracketNode`). Plain `lpnNode` recomputes
bounds purely from children and would shrink a container's row range back to
its last item — which is wrong when the new children are the *same* code plus
an inserted comment. Comment insertion (`Formatter.Logical.Comments`) uses this so a
container's closing-bracket extent survives every rebuild, keeping subsequent
own-line comments before the bracket inside it. For nodes with no such
extension it is identical to `lpnNode (lpnBox old) newChildren`. -}
lpnReplaceChildren : LPNode -> Array LPNode -> LPNode
lpnReplaceChildren old newChildren =
    let
        rebuilt =
            lpnNode (lpnBox old) newChildren
    in
    let
        -- The opening-bracket position (like the closing one) lives on the
        -- node, not its children, so a rebuild must carry it over.
        withStart =
            when lpnBracketStart old is
                Nothing ->
                    rebuilt

                Just oldStart ->
                    lpnWithBracketStart oldStart rebuilt
    in
    when lpnLastBracketEnd old is
        Nothing ->
            withStart

        Just oldEnd ->
            when withStart is
                LPNode r ->
                    LPNode
                        { r
                            | maxRow = max r.maxRow oldEnd.row
                            , lastBracketEnd = Just oldEnd
                            , bracketEndExact = lpnBracketEndExact old
                            , bracketEndElastic = lpnBracketEndElastic old
                        }


{-| The bounds a box contributes by itself (independent of children).

Inclusion rules match the legacy recursive helpers:

  - `firstPos`: contributes from `UnbreakableText`, `SingleLineComment`,
    `BlockComment`, `PrefixGlue`, `MultilineString`, `RecordUpdate`,
    `EmptyBracketed` (= the union of cases previously listed by
    `lpnFirstPos`).
  - `lastPos`: contributes from `UnbreakableText`, `SingleLineComment`,
    `BlockComment`, `MultilineString` only — for `PrefixGlue`,
    `RecordUpdate`, and `EmptyBracketed`, children's positions take
    precedence (matching `lpnLastPos`).
  - `minRow` / `maxRow`: contribute from `UnbreakableText`,
    `SingleLineComment`, `BlockComment` (widened by content newlines),
    `DocComment`, `MultilineString`, `RecordUpdate`, `EmptyBracketed`,
    and `PrefixGlue` (newly included here — its row was previously
    invisible to `subtreeRowRange`, but including it is safe since
    it equals the row of the immediately-following child).
  - `isBracket`: `AllAcrossOrAllVertical`, `AlwaysVertical`, or
    `EmptyBracketed` (the bracket-list boxes the descent guard cares
    about).
-}
selfBoxBounds :
    LPBox
    ->
        { firstPos : Maybe Position
        , lastPos : Maybe Position
        , minRow : Int
        , maxRow : Int
        , isBracket : Bool
        }
selfBoxBounds box =
    let
        empty =
            { firstPos = Nothing
            , lastPos = Nothing
            , minRow = maxSafeInteger
            , maxRow = -1
            , isBracket = False
            }
    in
    when box is
        UnbreakableText loc ->
            { empty
                | firstPos = Just loc.start
                , lastPos = Just loc.end
                , minRow = loc.start.row
                , maxRow = loc.end.row
            }

        SingleLineComment { loc } ->
            { empty
                | firstPos = Just loc.start
                , lastPos = Just loc.end
                , minRow = loc.start.row
                , maxRow = loc.end.row
            }

        BlockComment { loc } ->
            { empty
                | firstPos = Just loc.start
                , lastPos = Just loc.end
                , minRow = loc.start.row
                -- `loc.end.row` is already the comment's real end row (the parser
                -- records the true multi-line span), so it is the correct maxRow —
                -- matching DocComment / MultilineString below. Adding
                -- `countNewlines` over-counted by the number of content lines,
                -- inflating an enclosing binding's row range past its last token so
                -- a *leading* comment of the next binding was absorbed as a
                -- *trailing* comment of the previous one (blank-line churn).
                , maxRow = loc.end.row
            }

        DocComment loc ->
            { empty
                | minRow = loc.start.row
                , maxRow = loc.end.row
            }

        PrefixGlue loc ->
            { empty
                | firstPos = Just loc.start
                , minRow = loc.start.row
                , maxRow = loc.end.row
            }

        MultilineString loc ->
            { empty
                | firstPos = Just loc.start
                , lastPos = Just loc.end
                , minRow = loc.start.row
                , maxRow = loc.end.row
            }

        RecordUpdate { name } ->
            { empty
                | firstPos = Just name.start
                , minRow = name.start.row
                , maxRow = name.end.row
            }

        EmptyBracketed loc ->
            -- An empty bracket has no children, so — unlike a populated
            -- bracket-list, whose `lastPos` intentionally comes from its last
            -- item — its only meaningful last position is its own closing
            -- bracket (`loc.end`). Leaving `lastPos = Nothing` made any container
            -- wrapping *only* an empty bracket (e.g. `( {} )`, `( [] )`) report
            -- no last position at all, so `subtreeEndsBefore` returned False and
            -- a trailing line comment (`( {} ) -- c`) was pulled *inside* the
            -- parens, where it swallowed the `)` and the output no longer parsed.
            { empty
                | firstPos = Just loc.start
                , lastPos = Just loc.end
                , minRow = loc.start.row
                , maxRow = loc.end.row
                , isBracket = True
            }

        AllAcrossOrAllVertical _ ->
            { empty | isBracket = True }

        AlwaysVertical _ ->
            { empty | isBracket = True }

        _ ->
            empty


-- Source-row range covered by a subtree's positioned leaves.
-- An empty range (minRow = maxSafeInteger, maxRow = -1) means the subtree
-- has no positioned leaves (only synthesized tokens, EmptyLine, etc.).
-- Reads the cached bounds populated by `lpnNode` — O(1).
subtreeRowRange : LPNode -> { minRow : Int, maxRow : Int }
subtreeRowRange node =
    { minRow = lpnMinRow node, maxRow = lpnMaxRow node }


-- First (smallest) positioned row in a subtree, or -1 if no positioned
-- leaves exist. O(1).
firstRowInSubtree : LPNode -> Int
firstRowInSubtree node =
    let
        r =
            subtreeRowRange node
    in
    if r.minRow == maxSafeInteger then
        -1

    else
        r.minRow


-- Last (largest) positioned row in a subtree, or -1 if no positioned
-- leaves exist. O(1).
lastRowInSubtree : LPNode -> Int
lastRowInSubtree node =
    (subtreeRowRange node).maxRow
