module Formatter.Logical.LiteralFormat exposing (multilineContentLines)

{-|
Source-text handling of literals. A literal is written as its author wrote it
(geng-lang D602): the parser keeps each string, character and number
literal's text, quotes and escapes included, and the formatter writes that
text. The one thing it changes is where a multi-line string's lines start,
since the string moves with the code around it.

This module is exposed only so that the unit tests can reach it — `tests/` is
a separate application that depends on this package, so it can import nothing
that is not in `exposed-modules`. An application using the formatter has no
reason to call it; it goes through `Formatter.prettyPrint`, which applies it
for you.

@docs multilineContentLines

-}


{-| The content lines of the multi-line string literal written as `text`,
whose opening quotes are in column `col`, with that indentation taken off.
What is left is written after the indentation of wherever the string goes now,
and the closing quotes in its column.

Every line of the content starts with `col - 1` spaces, except a blank line,
which may have fewer, and those spaces are not part of the string (geng-lang
D603). So moving the string moves them, and nothing else is touched: an escape
stays an escape, and a space the author left at the end of a line stays. A
carriage return before a line break is dropped, since the parser reads `\r\n`
as a line break.

    multilineContentLines 5 "\"\"\"\n    one\n      two\\u{0020}\n    \"\"\""
        == [ "one", "  two\\u{0020}" ]

-}
multilineContentLines : Int -> String -> Array String
multilineContentLines col text =
    text
        |> String.split "\n"
        |> Array.map
            (\line ->
                if String.endsWith "\r" line then
                    String.dropLast 1 line

                else
                    line
            )
        |> Array.dropFirst 1
        |> Array.dropLast 1
        |> Array.map (dropIndentation (col - 1))


dropIndentation : Int -> String -> String
dropIndentation count line =
    if count > 0 && String.startsWith " " line then
        dropIndentation (count - 1) (String.dropFirst 1 line)

    else
        line
