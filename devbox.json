{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.15.0/.schema/devbox.schema.json",
  "packages": [
    "nodejs@22",
    "gren@0.6"
  ],
  "shell": {
    "scripts": {
      "build": [
        "gren make"
      ],
      "build_test": [
        "cd tests/",
        "gren make Main"
      ],
      "test": [
        "cd tests/",
        "gren run Main"
      ],
      "cov": [
        "cd tests/",
        "gren make --output cov-app --sourcemaps Main",
        "mkdir -p out/v8cov",
        "NODE_V8_COVERAGE=out/v8cov node cov-app"
      ]
    }
  }
}
