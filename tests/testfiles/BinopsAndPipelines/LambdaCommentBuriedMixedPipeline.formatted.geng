module LambdaCommentBuriedMixedPipeline exposing (..)


fn y =
    x && 0 >> (\node -> {- k10 -} node |> 0 <| 0 / String.y)


gn y =
    x
        && 0 >> (\node ->
                    {- k11 -}
                    node
                        |> (if y then
                                0

                            else
                                1
                           ) / String.y
                )
