module BlockTailCommentRunEscapes exposing (deep)

-- A run of multi-line `{- … -}`s between a call's function and an argument
-- written left of the call's own column, inside an `if`'s `else` body.
--
-- This fixture was written for a run trailing an `IndentedBlock` that something
-- FOLLOWS, reading the array as an argument to the whole `if`. That reading was
-- compiler-common#14's, and the Haskell parser never had it: it holds an
-- argument to the enclosing indentation, so the array is `String.join`'s. This
-- parser reads it the same way since geng-lang D352 (m1a-fmt.md F13), and the
-- run now sits between the call's arguments, each member on its own row.
--
-- A run is what made the old owner observable, which is why only
-- `fuzz-idempotency.py --run 2` could see it; it is kept for that.


deep flag names =
    let
        inner =
            \x ->
                if flag then
                    "a"

                else
                    String.join " " {- one
   second row -} {- two
   second row -} [ x, names ]
    in
    inner "z"
