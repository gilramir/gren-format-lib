module D33BackPipeLambdaAligned exposing (..)

-- R1: a lambda after `<|` keeps its head on the operator's row.
-- R2: a body that is itself another `… <| \… ->` starts at the same column;
-- any other body starts at +4.
-- R3: the body that closes a chain always takes a row of its own.
-- elm-format staircases all of these.


chain =
    Init.await FileSystem.initialize <| \fsPermission ->
    Init.await ChildProcess.initialize <| \cpPermission ->
    Init.await HttpClient.initialize <| \httpPermission ->
    done fsPermission cpPermission httpPermission


-- The staircase spelling of the same expression. Row placement decides
-- nothing here, so it comes back as the aligned form.


chainWrittenAsStaircase =
    Init.await FileSystem.initialize <|
        \fsPermission ->
            Init.await ChildProcess.initialize <|
                \cpPermission ->
                    done fsPermission cpPermission


-- A single step has nothing to align, so its body just takes the +4.


singleStep =
    Parser <| \s ->
        Good { pred = False, value = a, state = s }


-- A one-row lambda is one row because the author wrote it that way, and R1
-- has no body to move. This is the exemption R3 is bounded by: ONE `<|` keeps
-- the row, a chain of them does not.


oneRow =
    await one <| \a -> done a


-- R3: the closing body takes a row of its own even where it was written on the
-- `->` row -- the +4 is the chain's closing mark, not a record of a body that
-- broke. The boundary is how many `<|`s there are, not how many rows: written
-- on one row, the whole chain still comes back a row per step.


closingBodyOnHeadRow =
    Init.await FileSystem.initialize <| \fsPermission ->
    Init.await Terminal.initialize <| \terminalPermission -> done fsPermission


chainWrittenOnOneRow =
    Init.await FileSystem.initialize <| \fsPermission -> Init.await Terminal.initialize <| \terminalPermission -> done fsPermission


-- A multi-line left-hand side turns R1 off: the staircase is kept.


multilineSeed =
    { fs = fsPermission
    , cp = cpPermission
    } <|
        \a ->
            done a


-- A multi-line lambda HEAD does not turn R1 off. Only a comment can break a
-- head (divergence #32); the head's continuation rows line up under the `\`.


brokenHead =
    withRow row <| \{ quantity -- always >= 1, validated at the door
                    , unitPriceCents } ->
    done (quantity * unitPriceCents)


-- Between the `<|` and the `\`, a comment glues only if it can ride the row.


ridingComment =
    fn <| {- fs -} \a ->
        done a


ownRowComment =
    fn <|
        {- fs -}
        \a ->
            done a


lineComment =
    fn <| -- fs
    \a ->
        done a
-- A comment written beside the `->` leads the BODY. The arrow carries no
-- position, so `] {- c -} ->` and `] -> {- c -}` are the same three facts
-- (divergence #22) and gren snaps the comment to the body's side (#16); the
-- head still glues. Refusing to split the operand over that comment made
-- format 1 DECLINE R1 and format 2 accept it -- format 1 having moved the
-- comment below the arrow, handing format 2 the shape it had just refused.


commentBesideTheArrow =
    fn <| \[ 1 ] {- c -} ->
        [ 0
        , 1
        ]
