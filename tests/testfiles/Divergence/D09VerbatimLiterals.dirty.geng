module D09VerbatimLiterals exposing (..)

-- Divergence #9. Every literal keeps the author's exact spelling: a float, a
-- hex integer, a string, a multi-line string and a character, in expressions
-- and patterns (geng-lang D602). elm-format normalizes scientific-notation
-- floats (`1e5` -> `1.0e5`, `1.5E3` -> `1.5e3`, `1.5e+3` -> `1.5e3`), upper-cases
-- hex, expands named escapes (`\r` -> `\u{000D}`), writes a printable escape as
-- its character and an invisible character as an escape.


sci : Array Float
sci =
    [ 1e5, 1.5E3, 1.5e+3, 2.0e-7 ]


escapes : Array String
escapes =
    [ "\u{000d}", "\r", "\u{1F600}" ]


hexAndChars : Array Int
hexAndChars =
    [ 0xff, 0xFF, 0x00Ff ]


combining : String
combining = "e\u{0301}a\u{0300} o\u{302}"


selector : String
selector = "🏳\u{fe0f}\u{200D}🌈"


accent : Char
accent = '\u{0301}'


both : String
both = "☃ and \u{2603}"


written : String
written = "é 日本 नमस्ते"


spinnerFrames : Array String
spinnerFrames =
    [ "a　　b", "　ab　" ]


pasted : String
pasted =
    "one two\u{2003}three​four"


block : String
block =
  """
  a\u{0301} \"quoted\"
    b\u{000A}c
  """


matches : String -> Bool
matches s =
    when s is
        "n\u{0303}" -> True
        _ -> False


hexPattern : Int -> Bool
hexPattern n =
    when n is
        0x00ff -> True
        _ -> False
