module D26BackPipeLineComment exposing (..)

-- Divergence #26. A comment that cannot ride the flat `<|` layout (`fn <|` /
-- body) rides the OPERATOR's row instead, and the body drops below it.
-- elm-format keeps `<|` on the seed's row too, and re-homes the comment onto
-- the body's row instead. The trade is which of the two moves; what makes this
-- the more consistent answer is `|>`, where both formatters already agree the
-- comment stays on the operator.


backward =
    [ fn <| -- c
            one
    ]


-- The multi-line kind answers the same way, and until 2026-08-08 it did not:
-- it alone moved the `<|` onto a row of its own, which is the shape this entry
-- records as removed for the `--` six days earlier.


backwardMultiline =
    [ fn <| {- c
       second row -}
            one
    ]


forward =
    [ fn |> -- c
            one
    ]
