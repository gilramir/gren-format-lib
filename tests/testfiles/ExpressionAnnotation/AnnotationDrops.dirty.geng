module AnnotationDrops exposing (f, g, h, i, j, m, o, p, q, r, s, t, u)


f = ({ x = 1
     , y = 2
     } : { x : Int, y : Int })


g = (identity : { x : Int
               , y : Int
               } -> { x : Int, y : Int })


i = (if True then 1 else 2 : Int)


j = (if True then
        1
     else
        2 : Int)


m = (foo
    bar : Int)


o = (when x is
        A -> 1
        B -> 2 : Int)


p = (let y = 1 in y : Int)


q = ({ x = if a then 1 else 2 } : R)


r = ([ 1
     , 2
     ] : Array Int)


s = (x |> f
    |> g : Int)


t = (defaults : { x : Int
               , y : Int
               })


u = (Dict.empty : Dict String
    { x : Int
    , y : Int
    })


h = (grow : { r
            | x : Int
            } -> Int)
