module AttributeComments exposing (T, add, now, sub, both, grant, mul, multi)


@prim( {- inside the parentheses -} "i32_add")
add : Int -> Int -> Int


@prim("i32_sub") -- after the attribute
sub : Int -> Int -> Int


@extern(js, "A", "now") {- after the first row -}
@extern(c, {- inside the second -} "a_now")
now : Int -> Task x Int


@extern(js, "B", "both")
-- between the attribute and the annotation
both : Int -> Task x Int


@derive(Eq, {- inside -} Ord) -- after
type T = T


@capability -- after
grant : Task x Permission
grant = Task.succeed Permission


@prim( {- a comment of
   two rows -} "i32_mul")
mul : Int -> Int -> Int


@extern( {- a comment of
   two rows -} js, "C", "multi")
@extern( {- and in the
   second -} c, "c_multi")
multi : Int -> Task x Int
