module PipelineOperatorCommentIndent exposing (..)

-- An operator that LEADS its row is rendered as a Box PREFIX, so an operand
-- pushed below it by a comment lands in the column it would have occupied on the
-- operator's line -- `|> ` is 3 wide, `+ ` is 2, `++ ` is 3. These agree with
-- elm-format.
--
-- `<|` is the exception, and not to this rule: it does not lead its row at all.
-- It stays glued to the seed's last line (divergence #14), so a comment after it
-- rides that line too and the body drops +4 like any other `<|` body -- the same
-- rows the same expression gets with the comment deleted. It used to drop the
-- `<|` below the seed, which is the layout #14 exists to reject.


forwardPipe =
    seed
        |> -- c
           step


backwardPipe =
    fn <| -- c
        step


plus =
    a
        + -- c
          b


append =
    a
        ++ -- c
           b


chain =
    seed
        |> fn
        |> -- c
           gn


-- A single-line block comment still rides the operator's line when the operand
-- fits beside it.
blockRides =
    seed
        |> {- c -} step


-- ... and stacks above the operand when it does not.
blockAboveMultiline =
    seed
        |> {- c -}
           (\r ->
                r
           )


-- A run the author wrote on a row BELOW the operator stays below it: hoisting
-- it up would make the reparse read it as riding the operator's row, which pulls
-- the operand up too, and the file would never settle.
ownRowBelowOperator =
    fn <|
        {- c -} "?"


-- A `<|` step body's own arguments still indent past the operand.
backwardPipeArgs =
    fn <|
        gn one -- c
            two
