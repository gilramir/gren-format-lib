module BackwardPipeCommentNesting exposing (..)

-- A `<|` chain is right-associative, so each step nests one indent deeper than
-- the one above it. A comment at the FRONT of a step that CANNOT ride the
-- operator's row forces the operator-LEADING style, but it must not change the
-- NESTING: the commented chains below step at the same depths as the plain one.
-- The commented path used to apply a flat +4 to every step, so writing a comment
-- anywhere in a chain silently reflowed every step under it.
--
-- One that CAN ride does not force it at all: `blockCommentBetween` keeps the
-- plain chain and puts the comment on the operator's row, which is where the
-- author wrote it and what `++` and `|>` do with the same authoring.
--
-- A comment ending a step's BODY does not force that style. It stops just the
-- next `<|` from gluing onto its row, and that `<|` drops to a row of its own at
-- the body's indent -- every operand stays at the column it has with the comment
-- deleted (`plainChain`). Sending the whole chain operator-leading instead moved
-- the SEED's `<|` off its row over a comment two steps away, which is the C4
-- violation `midChainTrailingComment` pins.


plainChain =
    alpha <|
        beta <|
            gamma <|
                delta


leadingComment =
    alpha
        <|
        -- leads the second step
        beta
            <| gamma
                <| delta


trailingComments =
    alpha
        -- trails the seed
        <| beta -- trails the second step
            <| gamma
                <| delta


blockCommentBetween =
    alpha {- between the seed and the second step -} <|
        beta <|
            gamma


midChainTrailingComment =
    alpha <|
        beta -- trails the second body
        <|
            gamma <|
                delta


midChainBlockComment =
    alpha <|
        beta {- self-terminating, so the next `<|` still glues -} <|
            gamma

-- A comment that cannot ride, in front of a LATER step's `<|`, drops just that
-- operator to a row of its own with the comment above it -- at the previous
-- body's indent, so every operand keeps the column `plainChain` gives it. Only
-- on the FIRST step is it a whole-chain trigger (`leadingCommentFirstStep`),
-- because that operator sits on the seed's own row.


lineCommentBeforeSecondOperator =
    alpha <|
        beta
        -- leads the second operator
        <|
            gamma <|
                delta


leadingCommentFirstStep =
    alpha
        -- leads the first operator
        <| beta
            <| gamma
