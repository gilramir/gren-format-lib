module ElementRefinements exposing (a, b, c, d, e, f)

import Array.Builder


a : (palette : Array Int where Array.length palette == 256) -> Array (c : Int where 0 <= c && c < 256) -> Int
a palette cells =
    0


b : (nodes : Int where 0 <= nodes) -> Array ((e : Int where 0 <= e && e < nodes)) -> Array.Builder.Builder (k : Int where k < nodes) -> Int
b nodes edges builder =
    0


c : (n : Int where 1 <= n) -> Array (k : Int where 0 <= k && k < n) -> Array Nat
c n bins =
    bins


d : (sizes : Array Int) -> (r : Array (c : Int where 0 <= c && c < Array.length sizes {- a live entry -}) where Array.length r <= Array.length sizes) -> Int
d sizes r =
    0


e : Array (x : Int where x == Bitwise.and 255 x) -> Array (y : Int) -> Int
e xs ys =
    0


f : Char -> Maybe (d : Int where 0 <= d && d < 16) -> Maybe ((r : Array Int where Array.length r == 2))
f c m =
    Nothing


type alias Screen =
    { palette : Array Int where Array.length palette == 256
    , cells : Array (c : Int where 0 <= c && c < Array.length palette)
    , live : Array.Builder.Builder (e : Int where 0 <= e)
    , selected : Maybe (i : Int where 0 <= i && i < Array.length cells)
    }
