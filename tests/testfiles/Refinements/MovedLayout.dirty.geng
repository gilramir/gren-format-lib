module MovedLayout exposing (a, b, c, d, e)


a : Int -> (  moved   b:Builder Int ) -> Builder Int
a i b =
    b


b : (i : Int where 0 <= i && i < Builder.length t) -> (moved t : Builder Int) -> (r : Builder Int where Builder.length r == Builder.length t)
b i t =
    t


c :
    (moved {- taken -} t : Builder Int)
    -> Int
    -> Builder Int
c t n =
    t


d : (moved : Int) -> Int
d moved =
    moved


e : (moved
    t : Builder Int) -> Builder Int
e t =
    t
