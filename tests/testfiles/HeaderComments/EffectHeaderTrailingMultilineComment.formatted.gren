effect module EffectHeaderTrailingMultilineComment where
    {- this comment keeps the
       header multi-row -}
    { command = MyCmd } exposing (..)

{- written past the header's last
   token, so it detaches to column 1 -}

import Task


type MyCmd a
    = MyCmd (Task.Task Never a)


cmdMap : (a -> b) -> MyCmd a -> MyCmd b
cmdMap f (MyCmd task) =
    MyCmd (Task.map f task)
