module M exposing (S, T, U, V, W, X, Y)


type alias T =
    Int


type
    {- own row -}
    alias S =
    Int


type {- inline -} alias U =
    Int


type {- union -} V
    = A


type
    alias
    {- below alias -}
    W =
    Int


type
    -- line comment
    alias X =
    Int


type
    alias {- name row -} Y =
    Int
