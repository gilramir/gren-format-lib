module Test.Formatter.Format exposing (suites)

import Bytes
import Expect exposing (Expectation)
import FileSystem
import FileSystem.Path as Path
import Task exposing (Task)
import Test.Runner.UnitNode as U

import Array.Builder as Builder
import Compiler.Ast.Compare as AstCompare
import Compiler.Ast.Source as Src
import Compiler.Parse.Context as Context
import Compiler.Parse.Module as PM
import Formatter as PPrint
import Formatter.Logical.LiteralFormat as LiteralFormat
import String.Parser.Advanced as Parser

import UnifiedDiff exposing (unifiedDiffStrings)


suites : FileSystem.Permission -> Array U.Suite
suites fsPerm =
    [ intToHexSuite
    , importSuite fsPerm
    , coreExpressionsSuite fsPerm
    , binopsAndPipelinesSuite fsPerm
    , patternsAndLiteralsSuite fsPerm
    , recordUpdatesSuite fsPerm
    , declarationSuite fsPerm
    , headerCommentsSuite fsPerm
    , pipelineCommentsSuite fsPerm
    , patternCommentsSuite fsPerm
    , bracketCommentsSuite fsPerm
    , kitchenSinkSuite fsPerm
    , divergenceCatalogueSuite fsPerm
    ]


{-| One fixture per entry in `docs/elmFormatComparison.md`'s divergence
catalogue, built from that entry's own worked example.

Every other suite here tests the formatter. This one tests the **documentation**:
each `.dirty.gren` is the entry's "you wrote" input and each `.formatted.gren` is
the output the entry prints as gren-format's. A divergence that gets fixed, or
whose shape changes under an unrelated fix, breaks its own catalogue entry here
instead of leaving a false claim in the docs — which has happened: #14 described
a flat `<|` chain that had not been the shipped behaviour for two weeks, and
writing this suite found five more (#8, #9, #18, #25, #26), three of them stale
by one day.

The fixtures live in `testfiles/Divergence/` and are named for their entry, so
`#17` is `D17PrecedenceSplit`. Nothing else may be added to that directory: the
suite is a 1:1 index of the catalogue, and its value is that the mapping is
exhaustive in both directions.
-}
divergenceCatalogueSuite : FileSystem.Permission -> U.Suite
divergenceCatalogueSuite fsPerm =
    let
        entry =
            assertPrettyIn fsPerm "Divergence"
    in
    U.suite
        { name = "Divergence catalogue"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = U.noFixture
        , tearDown = U.noTearDown
        , tests =
            [ entry "#1 the 2 blank lines separating declarations go above a leading comment, not between it and the code it documents" "D01BlankLinesAroundComment"
            , entry "#2 a block comment's `-}` keeps the row the author gave it, glued or detached" "D02BlockCommentCloser"
            , entry "#3 the exposing list sorts alphabetically, independent of `@docs`; an import run's sort stops at a blank line and a comment travels with its import" "D03ExposingAndImportOrder"
            , entry "#4 a wrapped import keeps `exposing` as the header's last word with the list at +4" "D04ImportExposingWrap"
            , entry "#5 a single-line comment after a `->` in a wrapped signature is glued to that `->`" "D05SignatureArrowComment"
            , entry "#6 a union written on one row stays on one row" "D06UnionOnOneLine"
            , entry "#7 a record pattern broken across rows stays broken" "D07RecordPatternAuthorDriven"
            , entry "#8 a `--` inside an effect module's `where { }` escapes the block (forced: the two files are byte-identical to the parser)" "D08EffectWhereLineComment"
            , entry "#9 a float literal keeps the author's exact spelling; an int and a string escape are canonicalized by the parser before the formatter sees them" "D09VerbatimLiterals"
            , entry "#10 a redundant paren is kept in every position" "D10RedundantParens"
            , entry "#11 a comment's text is never rewritten, only its placement" "D11DocCommentBody"
            , entry "#12 a comment written after the last code on a row stays beside it" "D12TrailingCommentStays"
            , entry "#13 a comment between an operand and the next operator stays on the operand it trails" "D13BinopOperandTrailingComment"
            , entry "#14 a multi-row seed keeps `<|` glued to its last line" "D14BackPipeMultilineSeed"
            , entry "#15 a comment trailing a pipeline step stays on that step" "D15PipelineStepTrailingComment"
            , entry "#16 a comment after a lambda's `->` stays inline on a one-row body, and goes down with a body that wraps" "D16LambdaArrowComment"
            , entry "#17 an operator chain splits only at its loosest operators, comment or no comment" "D17PrecedenceSplit"
            , entry "#18 a one-line block comment inside a container does not break the container open" "D18InlineCommentInContainer"
            , entry "#19 a broken pipeline puts the seed on its own row and aligns every `|>`" "D19PipelineAlignment"
            , entry "#20 a comment trailing the last `let` binding drops below `in` (forced: `in` has no recorded position)" "D20LetLastBindingComment"
            , entry "#21 a single-item container whose one item fits collapses" "D21SingleItemCollapse"
            , entry "#22 a comment beside punctuation the parser throws away snaps to the later side, except at a line-leading `,`/`|`" "D22UnrecordedPunctuation"
            , entry "#23 a comment never breaks the construct around it further open than the author wrote it" "D23CommentDoesNotOpen"
            , entry "#24 a record update's own-row comment sits at the field indent" "D24RecordUpdateOwnLineComment"
            , entry "#25 a comment occupies the rows the author gave it — nothing is floated to give it air" "D25CommentKeepsItsRows"
            , entry "#26 a `--` trailing a `<|` keeps the operator on the seed's row and rides it" "D26BackPipeLineComment"
            , entry "#27 a parenthesized function type flattens; a parenthesized application keeps its break" "D27ParenFunctionTypeFlattens"
            , entry "#28 a type break gren-format does not record is flattened (bare application, inside one record field, the outer application of a nested one)" "D28TypeBreakNotRecorded"
            , entry "#29 a `let` annotation keeps a broken type on the `name :` line; a dropping record type still lifts" "D29LetAnnotationHeadGlue"
            , entry "#30 a comment RUN keeps the rows the author wrote it on -- one row stays one row, separate rows stay apart -- where elm-format re-decides per context, stacking after a lambda's `->` and joining a split run inside a paren" "D30CommentRunKeepsItsRows"
            , entry "#31 a declaration need not start in column 1: gren parses `{- lead -} foo =` (and keeps the comment's row, so the name stays right of it) where Elm's parser refuses the file outright -- an ACCEPTANCE difference, so there is no elm-format output to compare. The comment is not what gren permits: an indented declaration with no comment anywhere parses too and is normalized back to column 1" "D31DeclarationOffColumnOne"
            , entry "#32 a lambda head broken across rows keeps its `->` on the row of whatever precedes it; elm-format gives the arrow a row of its own. Only a comment can reach the shape -- layout is author-driven, so nothing else breaks a parameter list -- and it is the same rule a one-row head follows, where both formatters agree. The body's own position must not move the head" "D32LambdaHeadKeepsArrow"
            , entry "#33 a lambda after `<|` keeps its head on the operator's row (R1) and a body that is itself another `<| \\p ->` starts at the same column (R2), so a chain of continuations is n rows at one column closed by a body at +4 -- always, even where the author wrote that closing body on the `->` row (R3); elm-format staircases every step by 8. Both spellings normalize to the aligned form, and so does a chain written entirely on one row, the exemption being a SINGLE `<|`. Four boundaries ride on this fixture: a multi-line left-hand side turns R1 off, a one-row lambda is untouched, a comment-broken HEAD still glues, and a comment between the `<|` and the `\\` glues only where it can ride the row. A comment beside the `->` leads the BODY and the head still glues -- refusing the split over it made format 1 decline R1 and format 2 accept it" "D33BackPipeLambdaAligned"
            , entry "#34 a bare (unparenthesized) `|>` operand -- a lambda, an `if`, a `when` or a `let` -- keeps its head on the operator's row; elm-format wraps that operand in parens it ADDS and glues the `(` there instead. gren never introduces a paren (the other side of #10), and gluing is what keeps `|>` off a row of its own. Both spellings the author can write come back glued, and the parenthesized form the author DID write is reproduced identically by both formatters" "D34BarePipeOperandNoParens"
            ]
        }


{-| Pure unit tests for `LiteralFormat.intToHex` (no fixture, no I/O). The large
cases pin the fix for the 32-bit-`//` truncation bug: before it, `intToHex`
corrupted any value >= 2^35 (the first quotient `n // 16` that reaches 2^31
overflowed negative under JS `(a / b) | 0`), so the formatter emitted a wrong
hex literal — e.g. `intToHex (2^35)` returned `"F0"` instead of `"800000000"` —
and the AST check then refused to format valid input like `0x800000000`. These
cases fail on the old code and pass on `floor (toFloat n / 16)`.
-}
intToHexSuite : U.Suite
intToHexSuite =
    U.suite
        { name = "intToHex"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = U.noFixture
        , tearDown = U.noTearDown
        , tests =
            [ hexCase "0" 0 "0"
            , hexCase "single digit 10 uppercases to A" 10 "A"
            , hexCase "15 -> F" 15 "F"
            , hexCase "255 -> FF" 255 "FF"
            , hexCase "0xABCDEF" 11259375 "ABCDEF"
            , hexCase "2^32 - 1 (largest the old code still got right)" 4294967295 "FFFFFFFF"
            , hexCase "2^35 (exact onset of the old bug)" 34359738368 "800000000"
            , hexCase "2^35 + 1" 34359738369 "800000001"
            , hexCase "2^40 - 1 (the reported failure 0xFFFFFFFFFF)" 1099511627775 "FFFFFFFFFF"
            , hexCase "2^53 - 1 (max exact JS integer)" 9007199254740991 "1FFFFFFFFFFFFF"
            -- The parser folds a pattern's leading `-` into the value, so a
            -- negative reaches the formatter as one number. `hexLiteral` is what
            -- callers use; it puts the sign in front of the `0x`. `intToHex`
            -- itself no longer falls through to `hexDigit`'s wildcard (which
            -- printed every negative as "F").
            , hexCase "negative single digit" -1 "-1"
            , hexCase "negative two digits" -255 "-FF"
            , litCase "0" 0 "0x0"
            , litCase "positive" 31 "0x1F"
            , litCase "-0x1 (the reported failure: printed 0xF)" -1 "-0x1"
            , litCase "-0xFF" -255 "-0xFF"
            , litCase "-0xABCDEF" -11259375 "-0xABCDEF"
            ]
        }


litCase : String -> Int -> String -> U.Test {}
litCase name input expected =
    U.test name <|
        \_ ->
            Task.succeed (Expect.equal (LiteralFormat.hexLiteral input) expected)


hexCase : String -> Int -> String -> U.Test {}
hexCase name input expected =
    U.test name <|
        \_ ->
            Task.succeed (Expect.equal (LiteralFormat.intToHex input) expected)


{-| Format a dirty fixture and return the result.

`Task.fail` propagates genuine I/O failures (missing file) → test Errored.
Parse and format failures ride the success channel as `Err message` and become
`Expect.fail` in `assertPrettyIn` → test Failed, with the message printed verbatim.
-}
runPrettyPrinter : FileSystem.Permission -> String -> String -> Task String (Result String { ast : Src.Module, context : Context.Context, rendered : String })
runPrettyPrinter fsPerm dir filename =
    readTestFile fsPerm dir filename
        |> Task.map
            (\fileContent ->
                let
                    parser =
                        Parser.succeed (\ast payload -> { ast = ast, payload = payload })
                            |> Parser.keep PM.parser
                            |> Parser.keep Parser.getPayload
                in
                when Parser.run parser Context.empty fileContent is
                    Ok { ast = ast, payload = payload } ->
                        when PPrint.prettyPrint ast payload is
                            Ok rendered ->
                                Ok { ast = ast, context = payload, rendered = rendered ++ "\n" }

                            Err errorString ->
                                Err errorString

                    Err errorString ->
                        Err (PM.errorsToString fileContent errorString)
            )


readTestFile : FileSystem.Permission -> String -> String -> Task String String
readTestFile fsPerm dir filename =
    (Path.join <| Array.map Path.fromPosixString [ "testfiles", dir, filename ])
        |> FileSystem.readFile fsPerm
        |> Task.mapError (\fsErr -> FileSystem.errorToString fsErr)
        |> Task.map Bytes.toString
        |> Task.andThen
            (\ms ->
                when ms is
                    Just s ->
                        Task.succeed s

                    Nothing ->
                        Task.fail "Failed to decode bytes"
            )


{-| Runs a fixture pair from `testfiles/<dir>/`. The corpus lives in one
directory per suite so a suite can be read on its own; `dir` is the only thing
that varies, and every check below is identical.
-}
assertPrettyIn : FileSystem.Permission -> String -> String -> String -> U.Test {}
assertPrettyIn fsPerm dir testDescription filenameBase =
    U.test testDescription <|
        \_ ->
            runPrettyPrinter fsPerm dir (filenameBase ++ ".dirty.gren")
                |> Task.andThen
                    (\formatResult ->
                        when formatResult is
                            Err message ->
                                Task.succeed (Expect.fail message)

                            Ok { ast = ast1, context = context1, rendered = rendered } ->
                                readTestFile fsPerm dir (filenameBase ++ ".formatted.gren")
                                    |> Task.map
                                        (\expectedFormatting ->
                                            Expect.all
                                                [ \_ ->
                                                    Expect.equal rendered expectedFormatting
                                                        |> Expect.onFail (unifiedDiffStrings expectedFormatting rendered)
                                                , \_ ->
                                                    checkAstEquivalence ast1 rendered
                                                , \_ ->
                                                    checkIdempotent expectedFormatting
                                                , \_ ->
                                                    checkCommentCountPreserved context1 rendered
                                                ]
                                                {}
                                        )
                    )


checkAstEquivalence : Src.Module -> String -> Expectation
checkAstEquivalence ast1 rendered =
    let
        reparser =
            Parser.succeed (\ast payload -> { ast = ast, payload = payload })
                |> Parser.keep PM.parser
                |> Parser.keep Parser.getPayload
    in
    when Parser.run reparser Context.empty rendered is
        Err errs ->
            Expect.fail ("Could not reparse formatted output: " ++ PM.errorsToString rendered errs)

        Ok { ast = ast2, payload = _ } ->
            when AstCompare.compareModules ast1 ast2 is
                Ok {} ->
                    Expect.pass

                Err explanation ->
                    Expect.fail ("AST mismatch: " ++ explanation)


{-| AST equivalence ignores comments entirely, so a formatter bug that drops or
duplicates a comment can slip through it undetected (as happened with the fix-5b
duplication bug, which was only ever caught by the trust-Box fuzzer). This is a
cheap structural guard: reparse the formatted output and require its comment
*count* to match the original's. Position-sensitive full-Context equality is
covered separately by `checkIdempotent`; this only guards the count. -}
checkCommentCountPreserved : Context.Context -> String -> Expectation
checkCommentCountPreserved originalContext rendered =
    when parseModuleAndContext rendered is
        Err err ->
            Expect.fail ("Could not reparse formatted output to count comments: " ++ err)

        Ok { context = renderedContext } ->
            let
                originalCount =
                    Array.length (Builder.toArray originalContext.comments)

                renderedCount =
                    Array.length (Builder.toArray renderedContext.comments)
            in
            if originalCount == renderedCount then
                Expect.pass

            else
                Expect.fail
                    ("Comment count changed after formatting: original had "
                        ++ String.fromInt originalCount
                        ++ ", formatted output has "
                        ++ String.fromInt renderedCount
                        ++ " (a dropped or duplicated comment)"
                    )


-- Parse a source string into its Module AST and parse Context, or an error.
parseModuleAndContext : String -> Result String { ast : Src.Module, context : Context.Context }
parseModuleAndContext source =
    let
        parser =
            Parser.succeed (\ast payload -> { ast = ast, payload = payload })
                |> Parser.keep PM.parser
                |> Parser.keep Parser.getPayload
    in
    when Parser.run parser Context.empty source is
        Ok { ast = ast, payload = payload } ->
            Ok { ast = ast, context = payload }

        Err errs ->
            Err (PM.errorsToString source errs)


-- Two parse Contexts are exactly equal when their indentation state and their
-- full comment streams (position + text) match.
contextsExactlyEqual : Context.Context -> Context.Context -> Bool
contextsExactlyEqual a b =
    a.indent == b.indent
        && a.lineStart == b.lineStart
        && Builder.toArray a.comments == Builder.toArray b.comments


{-| Idempotency check: re-format the already-formatted source and require the
result to be **textually identical**. Formatting must be a true fixed point.

When the text differs we additionally compare the parsed Module and Context to
classify the failure: a Module/Context difference means a declaration moved or a
comment shifted; matching Module+Context but different text means pure-whitespace
non-idempotency. Either way the unified diff is shown.
-}
checkIdempotent : String -> Expectation
checkIdempotent formatted =
    when parseModuleAndContext formatted is
        Err err ->
            Expect.fail ("Could not parse the formatted file: " ++ err)

        Ok first ->
            when PPrint.prettyPrint first.ast first.context is
                Err err ->
                    Expect.fail ("Could not re-format the formatted file: " ++ err)

                Ok reRendered0 ->
                    let
                        reRendered =
                            reRendered0 ++ "\n"
                    in
                    if reRendered == formatted then
                        Expect.pass

                    else
                        let
                            classification =
                                when parseModuleAndContext reRendered is
                                    Err err ->
                                        "re-formatted output no longer parses: " ++ err

                                    Ok second ->
                                        let
                                            moduleOk =
                                                first.ast == second.ast

                                            contextOk =
                                                contextsExactlyEqual first.context second.context
                                        in
                                        if not moduleOk && not contextOk then
                                            "Module and Context differ"

                                        else if not moduleOk then
                                            "Module differs"

                                        else if not contextOk then
                                            "Context differs"

                                        else
                                            "whitespace only (Module and Context unchanged)"
                        in
                        Expect.fail
                            ("Formatting is not idempotent ("
                                ++ classification
                                ++ ") — re-formatting the formatted output changed it:\n"
                                ++ unifiedDiffStrings formatted reRendered
                            )


importSuite : FileSystem.Permission -> U.Suite
importSuite fsPerm =
    U.suite
        { name = "Import Statements"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = U.noFixture
        , tearDown = U.noTearDown
        , tests =
            [ assertPrettyIn fsPerm "ImportStatements" "an INDENTED own-line comment under an import trails that import and is carried along by the sort; a column-1 one in the same place leads the import below it. Reading only row-adjacency re-homed the indented note onto whichever import sorted into its place" "ImportIndentedTrailingComment"
            , assertPrettyIn fsPerm "ImportStatements" "import with comments" "ImportWithComments"
            , assertPrettyIn fsPerm "ImportStatements" "exposed operators wrapped in parens" "ExposedOperator"
            , assertPrettyIn fsPerm "ImportStatements" "module line wraps exposing list to one indented line" "ModuleLineWrap"
            , assertPrettyIn fsPerm "ImportStatements" "module line wraps exposing list to one item per line" "ModuleLineVertical"
            , assertPrettyIn fsPerm "ImportStatements" "import forms: plain, alias, exposing, combined" "Imports"
            , assertPrettyIn fsPerm "ImportStatements" "exposing lists: flat stays flat, vertical stays vertical" "ExposingListLayoutByAuthor"
            , assertPrettyIn fsPerm "ImportStatements" "a module's exposing list sorts operators, then types, then values, alphabetically within each group" "ExposingListSort"
            , assertPrettyIn fsPerm "ImportStatements" "an import's exposing list sorts the same way as a module's" "ImportExposingListSort"
            , assertPrettyIn fsPerm "ImportStatements" "a blank-line-separated leading comment in an exposing list still travels with its name, not treated as a section barrier" "ExposingListSortCommentBarrier"
            , assertPrettyIn fsPerm "ImportStatements" "import statements sort alphabetically within a run; only a blank line is a boundary, and an own-line comment travels with the import below it" "ImportGroupSort"
            , assertPrettyIn fsPerm "ImportStatements" "a comment trailing an import on its own source row travels with it, as does an own-line comment written above one" "ImportGroupSortTrailingComment"
            , assertPrettyIn fsPerm "ImportStatements" "the two comments that do not travel with an import: one with a blank line under it (leads nothing) and one below the run's last import" "ImportRunCommentAnchors"
            , assertPrettyIn fsPerm "ImportStatements" "a block comment the author glued to the front of a top-level declaration (single- and multi-line, one or more) stays glued on that line (LeadsInline); a glued import travels with its module name when the run sorts and never breaks the run" "LeadingGluedComment"
            , assertPrettyIn fsPerm "ImportStatements" "imports of the same module keep their original relative order (stable sort tie-break)" "ImportSameModuleStableSort"
            , assertPrettyIn fsPerm "ImportStatements" "a comment past a flat module exposing list pins above the ), and an out-of-order import carrying a same-row trailing comment still sorts correctly" "SortSymbolsComments"
            , assertPrettyIn fsPerm "ImportStatements" "every comment shape a sorting exposing list or import run can carry, in one module: leading, trailing, own-line, multiline, sort-to-first, run boundaries (see docs/sorting.md)" "SortingCommentZoo"
            , assertPrettyIn fsPerm "ImportStatements" "a <| chain of lambdas aligns every continuation at one column, the closing body at +4 (R1 + R2)" "BackwardPipelineLambda"
            , assertPrettyIn fsPerm "ImportStatements" "a let as a <| body keeps its in and result aligned with let (regression guard: the pipeline-step builder spread the let's nodes into the step's +4 flow, shifting in/result down to the bindings column)" "LetAsBackwardPipeBody"
            , assertPrettyIn fsPerm "ImportStatements" "a multi-line container (array/record/update) directly after |> glues to the operator instead of dropping below a dangling |>, byte-identical to elm-format (the update's field indent used to differ -- the `|>` operator is now a Box prefix, so the fields hang off the `{` the same way in both)" "PipelineContainerOperand"
            , assertPrettyIn fsPerm "ImportStatements" "when/if/let as a binop operand forces the operator onto its own line, matching elm-format" "ParenBlock"
            , assertPrettyIn fsPerm "ImportStatements" "when/if/let inside parens as a call argument: paren-block layout at ( + 4, matching elm-format" "ParenBlockCallArg"
            , assertPrettyIn fsPerm "ImportStatements" "a block comment trailing a (if/when/let) paren glues onto the closing ) whether or not the author broke the paren across rows (regression guard: the classifier read the source row span, so a one-row paren whose content always breaks sent the comment own-line past the declaration's last token, where the reparse re-homed it to column 1)" "ParenBlockTrailingComment"
            ]
        }


coreExpressionsSuite : FileSystem.Permission -> U.Suite
coreExpressionsSuite fsPerm =
    U.suite
        { name = "Core Expressions"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = U.noFixture
        , tearDown = U.noTearDown
        , tests =
            [ assertPrettyIn fsPerm "CoreExpressions" "an `if`/`when` header goes vertical for a row-breaking comment NESTED inside its condition -- in a call, a binop chain, or a paren -- not only for one between the header's own tokens. With a leading comment as well, the binop form used to reach the flow assembler's `unreachable multi-line non-paren unclassified soft-glue item` and refuse the file, and the call form produced output that would not reparse" "HeaderNestedBreakingComment"
            , assertPrettyIn fsPerm "CoreExpressions" "an `else if` condition the author wrote FLAT stays flat however many blank lines precede the `else if`, and a comment under `then` does not stack it either -- `else if` has no AST position, so both proxies for its row have to agree before the condition breaks" "ElseIfBlankLines"
            , assertPrettyIn fsPerm "CoreExpressions" "simple arithmetic" "SimpleArithmetic"
            , assertPrettyIn fsPerm "CoreExpressions" "when expression" "WhenExpression"
            , assertPrettyIn fsPerm "CoreExpressions" "if expression" "IfExpression"
            , assertPrettyIn fsPerm "CoreExpressions" "stacked if predicate wraps precedence-aware" "IfPredicate"
            , assertPrettyIn fsPerm "CoreExpressions" "an else-if written flat stays flat when the previous branch body ends in a pipe to a multi-line record arg followed by a later step (the closing } is not the body's last row) instead of stacking the condition" "ElseIfAfterRecordPipe"
            , assertPrettyIn fsPerm "CoreExpressions" "let expression" "LetExpression"
            , assertPrettyIn fsPerm "CoreExpressions" "records" "Records"
            , assertPrettyIn fsPerm "CoreExpressions" "lambdas and calls" "LambdasAndCalls"
            , assertPrettyIn fsPerm "CoreExpressions" "a lambda body indents +4 in an array item and when nested directly under another lambda's -> (regression guard: the extra AcrossOrVertical item-wrapper used to stack its +4 on the body block's +4, giving +8 — the 'never 8' rule, matches elm-format)" "LambdaBodyIndentInBrackets"
            , assertPrettyIn fsPerm "CoreExpressions" "a lambda whose body is a forced-vertical record/update/array drops its bracket to its own line, matching elm-format" "LambdaBracketBody"
            , assertPrettyIn fsPerm "CoreExpressions" "a lambda's comment-forced-vertical record-update body still drops its bracket when the lambda is itself a call argument (regression guard for a nest/reparse oscillation)" "LambdaBracketBodyNestedInCall"
            , assertPrettyIn fsPerm "CoreExpressions" "a lambda whose body is if/when/let drops the body to its own line under -> (elm-format), and as a call argument the whole (...) relocates onto its own line; a bare paren-lambda pipeline operand stays glued to |>" "CallArgBlockRelocation"
            , assertPrettyIn fsPerm "CoreExpressions" "function calls including wrapping" "FunctionCalls"
            , assertPrettyIn fsPerm "CoreExpressions" "parenthesized expressions" "ParenWrapped"
            , assertPrettyIn fsPerm "CoreExpressions" "closing paren on its own line when parens span multiple rows, incl. content-forced verticality" "ParenClosingLine"
            , assertPrettyIn fsPerm "CoreExpressions" "a multiline record call argument drops to its own line instead of gluing to the function/constructor name" "RecordArgOwnLine"
            , assertPrettyIn fsPerm "CoreExpressions" "redundant parens around a call argument are kept, same as everywhere else (gren-format never strips parens)" "RedundantArgParens"
            , assertPrettyIn fsPerm "CoreExpressions" "nested containers in list" "NestedContainersInList"
            , assertPrettyIn fsPerm "CoreExpressions" "array items that are too long to fit inline" "ArrayLongRecordItems"
            , assertPrettyIn fsPerm "CoreExpressions" "uniform item layout: records in an array all break together or not at all" "UniformRecordArray"
            , assertPrettyIn fsPerm "CoreExpressions" "uniform item layout: record updates couple like record literals" "UniformUpdateArray"
            , assertPrettyIn fsPerm "CoreExpressions" "list layout follows author: one line stays inline, multi-line stays one-per-line" "ListLayoutByAuthor"
            , assertPrettyIn fsPerm "CoreExpressions" "record + record-update layout follows author: one line inline, multi-line one-per-line" "RecordLayoutByAuthor"
            , assertPrettyIn fsPerm "CoreExpressions" "record type (alias, extensible, annotation) layout follows author" "RecordTypeLayoutByAuthor"
            , assertPrettyIn fsPerm "CoreExpressions" "record/array pattern layout follows author" "PatternLayoutByAuthor"
            , assertPrettyIn fsPerm "CoreExpressions" "union variant layout follows author: one line inline, multi-line one-per-line" "UnionLayoutByAuthor"
            , assertPrettyIn fsPerm "CoreExpressions" "pipeline layout follows author: one line inline, multi-line one-per-line" "PipelineLayoutByAuthor"
            , assertPrettyIn fsPerm "CoreExpressions" "a union variant payload that's inherently multi-line even though every | sits on one row falls back to one-variant-per-line" "UnionInlineMultilinePayload"
            , assertPrettyIn fsPerm "CoreExpressions" "a pipeline step argument that's inherently multi-line (a triple-quoted string opened mid-line) even though seed and step share a row" "PipelineInlineMultilineArg"
            , assertPrettyIn fsPerm "CoreExpressions" "an if-condition that's inherently multi-line (a record literal) even though it starts on the same row as if" "IfConditionMultilineSameRow"
            , assertPrettyIn fsPerm "CoreExpressions" "an if-condition whose always-breaking operand is a when, splitting the chain at the loosest operator (the formatterRules.md worked example)" "IfConditionWhenOperand"
            , assertPrettyIn fsPerm "CoreExpressions" "a when-in-parens whose header (scrutinee) is inherently multi-line" "WhenInParenMultilineHeader"
            ]
        }


binopsAndPipelinesSuite : FileSystem.Permission -> U.Suite
binopsAndPipelinesSuite fsPerm =
    U.suite
        { name = "Binops and Pipelines"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = U.noFixture
        , tearDown = U.noTearDown
        , tests =
            [ assertPrettyIn fsPerm "BinopsAndPipelines" "binop layout follows the author: a one-line chain stays inline no matter how long; an author-broken chain stays split" "BinopLayoutByAuthor"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "an author-broken mixed-precedence binop chain breaks only at its lowest-precedence operators; tighter operators stay glued inline" "BinopMixedPrecedenceBroken"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a pipeline seeded by a binop, and a binop chain with a pipeline operand, flatten correctly (mixed |>/<| and +)" "BinopPipelineMix"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a binop whose operand is a multi-line bracket with a leading comment (comment re-homed onto the operator) drops the seed below and breaks stably instead of oscillating" "BinopCommentBracketOperand"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "an operator that leads its row renders as a Box prefix, so an operand a comment pushes below it lands in the column it would have had on the operator's line (`|> ` 3, `+ ` 2, `++ ` 3) rather than at a flat +4 — while `<|`, which stays glued to the seed's last line (#14), keeps its comment on that line and drops the body +4" "PipelineOperatorCommentIndent"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a bare (unparenthesized) multi-line lambda as a pipeline step's only operand keeps its head on the `|>`'s row, like its parenthesized twin and like `>>` / `++` / `<|` -- it is excluded from the trigger split alongside the paren and bracket operands. It used to be the one operand kind missing from that exclusion, so `|>` dangled alone on its row with the lambda a tab stop below (and rendering that empty preamble as a flow had crashed with `box: empty flow`). A bare `if`/`when`/`let` operand glues the same way and for the same reasons -- elm-format reaches that shape by ADDING parens (divergence #34), which gren does not do" "PipelineBareLambdaOperand"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a pipeline step whose call operand the author broke across rows keeps that break: the step carries its own `forceVertical`, because `InsertExpressions` unwraps the call node into the step's children (to avoid a second +4) and that node was the only record of it -- so `seed |> fn one`/`two` used to come back on ONE row while the same call kept its break in a plain body, after `++`, and parenthesized. A comment is no reason to drop that break either -- the call still goes one argument per row and the `--` takes a row of its own, which is what the same call does in a plain body and what elm-format does; and a call broken by a multi-line ARGUMENT still relocates through the trigger split" "PipelineStepAuthorBreak"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a mixed `|>`/`<|` chain the author kept on one row stays on it, and a comment that can RIDE that row is not a second reason to break it (rule C3) -- the all-`|>` branch tries the flat join first and only then asks about comments, while this one asked about comments first, so one authoring came back flat with one operator and across three rows with two. A `--` mid-chain, a multi-line `{- … -}` and an author-broken chain still break" "MixedChainRidingComment"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a broken call keeps its first argument glued to the function name THROUGH a comment written between them (`String.join {- sep -} \" \"`) -- the comment moves neither token's source row, which is what the glue is gated on, and elm-format glues too; a `--` or a multi-line `{- -}` still stands the function up alone" "BrokenCallCommentGlue"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a `--` that ends a row mid-chain breaks the chain where PRECEDENCE says, not where the comment sits: `one + two -- c` / `* three` breaks at the loose `+` and keeps `two * three` as one group, rather than gluing `one + two` and breaking at the tight `*` (which reads as `(one + two) * three`). The chain-level question -- is any more of the CHAIN after the comment -- is what per-operand `commentBreaksFlowRow` could not see" "BinopCommentPrecedenceBreak"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a multi-line block comment inside a binop RHS breaks the chain at its LOWEST-precedence operator (`x` / `+ b {- … -}` / `* 2`), not at whichever operator the comment happens to sit before -- a comment changes where the rows fall, never how the operators group (comment-homing divergence from elm-format, which indents the comment and both operands under the head)" "BinopMultilineCommentRhs"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "pipeline step argument indentation" "PipelineArgIndent"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "once one argument of a pipeline step breaks, the arguments on both sides of it land one per line -- the plain-call rule, which a step lost by having its call container unwrapped (they used to glue as `) z` / `} z` / `|> f z`)" "PipelineStepSuffixArgs"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a comment written past the BODY of a pipeline step's lambda argument is kept -- the relocated-lambda renderer reads only the paren's head and body, so a third child was discarded and the comment vanished with it (an AST-equivalent output that is its own fixed point, so no stability check could see it). Such a paren now relocates through the generic paren box, byte-identical to elm-format for every comment kind" "PipelineLambdaArgTrailingComment"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a multi-line {- -} written past a pipeline step's last token glues onto that token's row instead of stacking below it like an argument -- a comment is not an argument, and stacked below it rendered on a fresh row under the declaration, which the reparse re-homes to column 1. The identical shape as a plain call always glued; a real argument after the trigger still lands on its own line and takes the comment with it" "PipelineTrailingMultilineComment"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a leading single-line {- -} in a broken argument stack rides the next argument's line (elm-format match), in a plain call and a pipeline-step suffix alike; a trailing comment glues onto its argument (catalogue #13), and a comment before a multi-line argument stays on its own row" "StackedArgCommentPairing"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a comment that pushes a later flow item onto a new row makes the call/binop commit to the broken layout on the FIRST format -- `forceVertical` comes from AST source rows, which cannot see a comment, so the flat render broke anyway and the reparse flipped. A single-line {- -} mid-flow, a comment at the end of a flow, and a declaration head (where `=` stays glued) are unaffected" "CommentForcesRowBreak"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a record/update field drops its lambda below `field =` whenever the lambda's BODY renders multi-line -- decided from the rendered box, not from the AST guess that was blind to a comment in the body and to an author-broken body alike; a single-line body still keeps the lambda glued on the `= ` line" "RecordFieldLambdaDrop"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a `--` between a lambda's `->` and a body the author started on the `->` row is redirected INSIDE the body -- it ends its line, so the body drops anyway and a reparse reads the body as an IndentedBlock whose comment sits inside it; leaving it outside oscillated. A {- -} there still rides the `->` row, and a `--` trailing the whole body still trails it" "LambdaBodyLineComment"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a `--` nested inside a container's item keeps the container OPEN -- collapsing to the flat form would put the synthesized `]`/`}` after a comment that runs to end of line, emitting source that does not parse; a nested container (whose last line is its own closing delimiter) and a self-terminating single-line {- -} are not affected" "BracketLineCommentClose"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "the same pairing in a broken BINOP chain: a leading single-line {- -} rides the next operator's line at any position (elm-format match), both authorings converging on it; pairing is all-or-nothing over a run, so a `--` or a multi-line {- -} anywhere in the run keeps every comment of it own-row, as does an operator line that renders multi-line; a trailing comment stays glued to its operand (catalogue #13)" "BinopLeadingCommentPairing"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a pipeline step call with two or more multi-line block arguments after the first stacks each on its own line instead of crashing (soft-glue-after-block)" "PipelineCallMultiBlockArgs"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "multi-line lambda arg in pipeline step uses elm-format style" "PipelineLambdaArg"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "pipeline step made multi-line by a block comment (no relocatable trigger)" "PipelineNoTriggerStep"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "backward pipeline (<|) treated like forward pipeline (|>)" "BackwardPipeline"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "R2's three settled cases, one number each: a multi-step run ending in a lambda is not a continuation (+4), a continuation whose own body fits on its `->` row still is one (+0), and a parenthesized continuation is not (+4, from the body's top node being a paren block). Plus Case 1's rider -- R2 applies unchanged INSIDE a multi-step run, so a chain there restarts at the run's own column rather than starting a second staircase -- and the base column in six positions, the bracket ones not being multiples of four, so it must be read off the rendered box and never computed as depth times four" "BackPipeContinuationAlignment"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a comment in a `<|` chain forces the operator-leading style but must not change the nesting -- every step still steps one indent deeper, exactly as the comment-free chain does (the commented path applied a flat +4 to every step, so adding a comment silently reflowed the whole chain below it)" "BackwardPipeCommentNesting"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a single-line block comment before a backward-pipeline `<|` rides the operator's row, whichever row the author wrote it on -- the same answer `++` and `|>` give for the identical authoring" "BackwardPipelineSeedComment"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a leading comment on a lambda body that BREAKS whatever the author wrote, buried under a tighter operator, drops to its own line from the first format — the body is force-vertical up front (IndentedBlock), not left as a SoftIndentedBlock that oscillates the comment. The mixed |>/<| pipeline beside it is the counterpart: it no longer breaks a flat authoring, so its comment rides and that is a fixed point too" "LambdaCommentBuriedMixedPipeline"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a leading comment on a lambda body whose always-breaking construct is buried inside a BINOP OPERAND drops to its own line from the first format — exprAlwaysBreaks descends both operands of every binop, so a left-spine walk's blind spot (it treats the `+` of `a |> b <| c + d <| e` as an opaque seed) cannot oscillate the comment. The flat mixed pipeline beside it keeps its comment on the row, which is also a fixed point" "LambdaCommentPipelineBinopSeed"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a lambda whose body is a record, used as a record field value, drops the WHOLE lambda (head included) below `field =` from the first format when the record's own field always breaks — exprAlwaysBreaks recognizes the buried construct, so the head does not glue on the `= ` line and oscillate. The mixed |>/<| pipeline beside it no longer always breaks, so that one collapses to a single row" "LambdaRecordFieldValueMixedPipeline"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a pipeline step that is a call whose last argument is a parenthesized multi-line record: the redundant paren is kept as a relocated trigger, its ) on its own line at the ( column (divergence #10; elm-format strips the paren)" "PipelineParenRecordOperand"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a mixed |>/<| pipeline chain follows the author, like every other chain: broken across rows it renders operator-leading, kept on one row it stays there. It used to break a flat authoring, but only in ONE of the two mixing orders -- `a |> b <| c` parses as `(a |> b) <| c` and so is tagged `<|`, while `a <| b |> c` is tagged `|>` and always stayed flat -- so the same tokens came back two ways on parser associativity alone. elm-format keeps both flat" "PipelineMixedOps"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a multi-line record operand breaks the chain at its lowest-precedence operator; the tighter `*` stays glued after the record's closing brace" "BinopTrailingMultilineOperand"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a multi-line record in a tighter-precedence group keeps that group inline (`a * { … }`); the chain breaks only at the looser operator" "BinopLeadingMultilineOperand"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a multi-line record as the first operand breaks the chain at its lowest-precedence operators; the tighter `b * c` stays glued" "BinopMultilineFirstGroup"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a multi-line record in a same-precedence binop chain breaks every operator onto its own line" "BinopMultilineMiddleOperand"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "in a broken chain: an own-line comment sits at the operator indent, an inline comment stays on its operand, a leading comment glues before its operand" "BinopChainMixedComments"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a comment written on a multi-line `{- … -}`'s closing row joins that trailing run in a binop chain, as it already did in every other container -- the chain keyed on the last OPERAND row, so it dropped the second comment below the declaration, where the reparse re-homed it to column 1; a comment on a genuinely later row still keeps its own row at the operator indent" "BinopChainCommentChain"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a binop chain with several multi-line bracket operands breaks fully vertical" "BinopMultipleBracketOperands"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a bracket operand whose comment rides its flat line keeps the binop chain inline, stably across reformats" "BinopCommentFlatBracketOperand"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a parenthesized multi-line operand breaks the binop chain vertically (matches elm-format)" "BinopMultilineParenOperand"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a `{- -}` in front of a `<|` that has dropped to a row of its own stays in front of the operator; one written after it leads the operand instead" "BackwardPipeOperatorRowComment"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a record field's lambda drops below `fld =` as a unit when its body is multi-line, and a comment written between the `->` and the body is not mistaken for the lambda head" "RecordFieldLambdaCommentDrop"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a comment on its own row between a pipeline operator and its operand leads that operand, for a lambda exactly as for every other operand kind" "PipelineOperandLeadingComment"
            , assertPrettyIn fsPerm "BinopsAndPipelines" "a multi-line `{- … -}` written after a `<|` keeps the operator on the seed's row, exactly as a `--` there and as the comment-free twin do -- its own rows are not a reason to move the operator; one written BEFORE the `<|` still sends the chain operator-leading" "BackwardPipeMultilineOperatorRowComment"
            ]
        }


patternsAndLiteralsSuite : FileSystem.Permission -> U.Suite
patternsAndLiteralsSuite fsPerm =
    U.suite
        { name = "Patterns and Literals"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = U.noFixture
        , tearDown = U.noTearDown
        , tests =
            [ assertPrettyIn fsPerm "PatternsAndLiterals" "a NEGATIVE hex literal keeps its sign: the parser folds a pattern's leading `-` into the value, so the sign has to be re-emitted in front of the `0x` -- built as `\"0x\" ++ intToHex n` a negative fell through to the digit function's wildcard and `-0x1` printed as `0xF`" "NegativeHexLiteral"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "a `\\r` inside a triple-quoted string stays escaped: emitted as a raw CR byte before a newline it rendered as CRLF, which the parser folds back to one LF, so the reparsed string had lost the CR" "CarriageReturnMultilineString"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "when branch body indentation" "WhenBranchBody"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "when branch patterns" "WhenPatterns"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "when-branch record-destructuring pattern written flat stays flat" "WhenRecordPatternFlat"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "when-branch record-destructuring pattern written across rows aligns fields under the opening brace (regression guard for the nest/column mismatch fix)" "WhenRecordPatternVertical"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "named wildcard (anything) patterns keep their name" "AnythingPatterns"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "constructor-with-payload argument keeps its parens" "CtorArgPattern"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "constructor application as a record-field value / array element needs no parens (blocked on compiler-common pattern-parser fix, see error0617.md)" "CtorAppNestedPattern"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "record field value indentation" "RecordFieldValue"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "let def body indentation" "LetDefBody"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "let destructure pattern too long to fit on one line" "LetDestructLong"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "let destructure of a ctor-with-payload or as-alias keeps its parens" "LetDestructParens"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "string escape sequences preserved" "StringEscapes"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "non-printable ASCII in strings escaped as \\u{XXXX}" "NonPrintableEscapes"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "string and char escape sequences in when patterns" "StringAndCharPatterns"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "multiline (triple-quoted) strings preserved" "MultilineString"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "lambda with record and array destructure patterns" "LambdaPatterns"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "binary operators, negation, hex literals" "BinaryOps"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "hex literals are reformatted to uppercase across the whole digit table, in expressions and in patterns; a wrong digit trips the AST-equivalence check" "HexLiteralDigits"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "hex literals above 2^35 (up to 2^53 - 1) round-trip in expressions and patterns; before the intToHex `//` 32-bit-truncation fix the formatter corrupted them and refused to format valid input" "HexLiteralLarge"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "extensible record types in signatures and aliases" "ExtensibleRecords"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "an extensible record TYPE carries its closing `}` as `lastBracketEnd` (built via `lpnBracketNode`, like a record-update expression and a plain record type), so a trailing `--` after `}` stays at the declaration column and an own-line comment before `}` stays inside — previously the type path used plain `lpnNode` with no close position and both oscillated" "ExtensibleRecordTypeTrailingComment"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "constructor argument that is an as-alias keeps its parens" "CtorAsPattern"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "multi-line string opened mid-line aligns content to opening column" "MultilineStringInline"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "let-binding type signature is preserved; every binding drops its body to the next line" "LetBindingSignature"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "a comment before a let-binding signature does not insert a blank between the signature and its definition" "LetCommentedSignature"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "block comment or multiple single-line comments before a let-binding signature do not insert a blank between signature and definition" "LetCommentedSignatureVariants"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "one blank line is forced between let bindings regardless of authored blanks; a comment or signature sticks to the binding below it" "LetBlankLines"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "a wrapped infix declaration leaves no phantom row gap below it" "InfixWrapped"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "a signature goes multi-line for a break that SURVIVES rendering (-> parts, between record fields, inside a parenthesized application) and stays flat for one that does not (parenthesized function type #27, a break inside one record field); a comment-forced return record explodes every -> part" "SignatureSegmentBreaks"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "a comment-bearing record type in a signature drops below the `:` head at +4; the author's blank line before an inner comment is dropped (gren keeps no blank lines inside brackets; elm-format keeps one before a comment)" "SignatureRecordTypeComment"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "a single-segment (no ->) signature whose sole type is a multi-line record, plain or extensible, no longer crashes and drops the record below the header" "SignatureSoleRecordType"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "a multi-line record at a segment head with the -> kept on its closing } line forces the whole signature vertical (record stays broken, -> drops to its own line) instead of crashing" "SignatureBrokenRecordArg"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "a multi-line block comment below a declaration detaches to column 1, leaving no trailing-whitespace line" "ClaimedMultilineComment"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "two blank lines are forced before every top-level declaration unit (function/alias/union/port), regardless of authored blanks; the unit begins at its doc comment, else signature, else declaration" "ForcedDeclBlankLines"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "a run of comments floats or attaches as ONE unit: with a gap on both sides of the run the two blank lines go above its first line -- asking each comment alone made a `{-| doc -} -- c` row answer two on the first format (one node, its rows covering both) and one on the reparse (two adjacent nodes). A run LED BY A DOC COMMENT attaches instead of floating, since a doc comment reaches the declaration it documents across a blank" "FloatingCommentRunBlankLines"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "float literals round-trip (decimal stays decimal, scientific stays scientific)" "FloatLiterals"
            , assertPrettyIn fsPerm "PatternsAndLiterals" "only a comment that cannot ride a literal's flat line forces it open: -- , multi-line, and own-row comments break it; an inline block comment does not" "LiteralInlineComment"
            ]
        }


recordUpdatesSuite : FileSystem.Permission -> U.Suite
recordUpdatesSuite fsPerm =
    U.suite
        { name = "Record Updates"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = U.noFixture
        , tearDown = U.noTearDown
        , tests =
            [ assertPrettyIn fsPerm "RecordUpdates" "a record literal field whose value is a multi-line binop chain drops below `name =` like a record update (regression guard: literal path previously hit an unreachable flow-assembler arm)" "RecordLiteralBinopField"
            , assertPrettyIn fsPerm "RecordUpdates" "as-pattern inside record-field destructure keeps its parens" "RecordFieldAsPattern"
            , assertPrettyIn fsPerm "RecordUpdates" "doc comment body with non-BMP code points round-trips" "DocCommentWithEmoji"
            , assertPrettyIn fsPerm "RecordUpdates" "record update base can be a parenthesized call" "RecordUpdateComplexBase"
            , assertPrettyIn fsPerm "RecordUpdates" "record update base can be a binop, negate, nested update, accessor, record literal, or a call with an array arg — previously silently dropped to an empty (unparseable) base" "RecordUpdateExoticBase"
            , assertPrettyIn fsPerm "RecordUpdates" "record update base can be a qualified value reference (VarQual), e.g. a record exported by another module" "RecordUpdateQualifiedBase"
            , assertPrettyIn fsPerm "RecordUpdates" "a comment in a record update's `|` gap keeps the row the author wrote it on, the way `,` and a union's `|` already do — a `--`/multi-line `{- -}` on the base's row trails the base (role `TrailsHead`), one on its own row stays own-row at the `|` column; a single-line `{- -}` still leads the first field on both spellings (rule C2) and keeps the update flat (C3). The opener slot, separated by the base name's recorded position, is unchanged. Extensible record types share the construct and the rule" "RecordUpdatePipeComment"
            , assertPrettyIn fsPerm "RecordUpdates" "record update expands uniformly for single- and multi-field block values (matches elm-format's extensionGroup); a single-field block value no longer stays compact, and the field value anchors at `| ` + 4 not field-content + 4; a multi-line lambda value now drops whole below `field =` like every other value (matches elm-format)" "RecordUpdateExtension"
            , assertPrettyIn fsPerm "RecordUpdates" "an `if`/`when`/`let` record-field value always breaks however the author wrote it, so it drops below `fld =` — written FLAT here on purpose, which used to leave a `when` (and any paren-wrapped block) as a plain flow item whose multi-line box the soft-glue arm could not place, failing the format outright. Paren-free layouts verified byte-identical to elm-format; inline and lambda values are untouched" "BlockRecordFieldValue"
            , assertPrettyIn fsPerm "RecordUpdates" "a paren-wrapped `if`/`when`/`let` as a call argument in a pipeline step: its first branch is an indented block just like a lambda body, so the lambda-paren classifier used to claim it, render it as `[head, body]`, and DROP every later branch (`else` included) — emitting unparseable Gren. Verified byte-identical to elm-format; the lambda it was mistaken for still renders as a lambda" "ParenBlockInPipelineStep"
            , assertPrettyIn fsPerm "RecordUpdates" "a flat record update renders on one line, so nothing around it pre-breaks: each update here formats identically to its record-literal twin. Guards `subtreeHasVerticalBox`, which used to call EVERY update vertical and stranded a `)` in the pipeline-step relocation. The last two cases pin the gate's other half — an author-broken update, and one whose field breaks on its own, both still open" "RecordUpdateFlatInParen"
            , assertPrettyIn fsPerm "RecordUpdates" "a paren-wrapped block (`if`/`let`/`when`/lambda) as a pipeline's DIRECT operand stays glued to the operator and soft-glues: `(` after `|> `, body at the next tab stop from the keyword, `else`/`in` and `)` under the `(` — byte-identical to elm-format" "ParenBlockDirectOperand"
            , assertPrettyIn fsPerm "RecordUpdates" "a paren-wrapped block/broken-binop/broken-record indents its body to the next TAB STOP after whatever precedes `(`, so the offset is emergent, not chosen: `(`+2 after `+ `, `(`+3 after `-`, `(`+4 when `(` starts its line, `(`+5 after `&& `/`++ `/`|> `. Covers a DOUBLED paren (`((if/when/let ...) |> gn)`/`+ rest`, a call argument that's itself a paren-wrapped binop/pipeline operand): `else`/`in` and the inner `)` must anchor to the INNER `(`, not the outer one. Also covers an author-broken binop/record literal glued after a 2-char operator or as a pipeline's direct operand (`|> (aaa\n    ++ bbb)`, `|> ({ a = 1, b = 2 })`): the paren must pad every continuation line, or a 3-char prefix (`&& `/`++ `/`|> `) falls one Tab stop short instead of crossing it. All cases are byte-identical to elm-format (checked with the elm-format binary; the broken-record case differs only by the settled #10 divergence — gren keeps the parens elm-format strips). Formerly PrefixAnchorDivergence: gren deliberately used a uniform indent rather than elm's tab stops, which is why the `&&`/`-(` cases diverged; 2026-07-14 the user chose to match elm-format exactly instead" "ParenBlockTabStops"
            , assertPrettyIn fsPerm "RecordUpdates" "a bare `if` as a direct list item indents its branches +4 with `else` under `if`, matching elm-format (was over-indented +8 until the item-wrapper double-indent fix)" "BareIfListItem"
            , assertPrettyIn fsPerm "RecordUpdates" "a bare `let` as a direct list item indents its bindings +4 with `in`/result under `let`, matching elm-format (same item-wrapper double-indent fix)" "BareLetListItem"
            , assertPrettyIn fsPerm "RecordUpdates" "multi-line string content escapes backslashes and embedded triple quotes but leaves isolated quotes verbatim" "MultilineStringContent"
            , assertPrettyIn fsPerm "RecordUpdates" "trailing whitespace on triple-quoted string content lines is significant and preserved verbatim" "MultilineStringTrailingWhitespace"
            , assertPrettyIn fsPerm "RecordUpdates" "in a triple-quoted string a horizontal tab is preserved verbatim while a non-printable control character is written as a \\u{...} escape" "MultilineStringControlChars"
            , assertPrettyIn fsPerm "RecordUpdates" "a `--` trailing a multi-line string's closing delimiter glues onto that row and stays put (was non-idempotent: prevLineGlueRow/prevBlockGlueRow had no MultilineString case, so it defaulted to -1 and always classified LeadsLine)" "MultilineStringTrailingLineComment"
            , assertPrettyIn fsPerm "RecordUpdates" "a `{- -}` written PAST a record update's `}` stays outside it (glued onto the `}` row), like arrays and record literals — the update's `}` is a real tracked bracket, so a same-row comment past it is not pulled inside onto the last field" "RecordUpdateFieldTrailingComment"
            , assertPrettyIn fsPerm "RecordUpdates" "a `--` written past a single-field record update's `}` stays outside and the update stays flat, like `[ 1 ] -- c` — the comment is not absorbed into the (empty-`[]`) field" "EmptyBracketFieldTrailingLineComment"
            , assertPrettyIn fsPerm "RecordUpdates" "an Int literal as an `as`-alias base keeps its parens (was a real bug: gren-format stripped a semantically required paren, producing `8 as z` which does not parse — not the redundant-parens case, which gren-format never strips)" "AliasPatternIntNeedsParens"
            , assertPrettyIn fsPerm "RecordUpdates" "a 0-argument constructor as an `as`-alias base keeps its parens (same class as AliasPatternIntNeedsParens: `Nothing as whole` does not parse bare, only `(Nothing) as whole` does)" "AliasPatternZeroArgCtorNeedsParens"
            , assertPrettyIn fsPerm "RecordUpdates" "negation of parenthesized expression keeps `-` outside the parens" "NegateParens"
            , assertPrettyIn fsPerm "RecordUpdates" "field access glues directly to a paren/record/qualified-name base with no space (compiler-common#27)" "PostfixAccess"
            ]
        }


declarationSuite : FileSystem.Permission -> U.Suite
declarationSuite fsPerm =
    U.suite
        { name = "Declarations"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = U.noFixture
        , tearDown = U.noTearDown
        , tests =
            [ assertPrettyIn fsPerm "Declarations" "a doc comment reaches the declaration it documents ACROSS an author blank line, closing the gap instead of detaching permanently; a plain `--` still needs adjacency, and the MODULE doc comment -- the one written against the module line -- keeps its one blank" "DocCommentAcrossBlank"
            , assertPrettyIn fsPerm "Declarations" "a comment run that RIDES a doc comment's closing row, with a blank line below it, leaves the group-start chain broken -- the indented run is transparent to that chain only while the declaration below is still row-adjacent, so it cannot leap the blank and turn the doc comment into a unit start on the first pass only" "DocCommentRidingRunBlank"
            , assertPrettyIn fsPerm "Declarations" "a definition sits directly under its signature with no blank line even when a COMMENT separates the two -- the unit is a signature and its definition \"separated only by comments\", and the blank suppression reads that whole span rather than just an adjacent pair" "SignatureCommentDefinitionBlank"
            , assertPrettyIn fsPerm "Declarations" "type aliases" "TypeAlias"
            , assertPrettyIn fsPerm "Declarations" "a type alias whose body is a bare function type renders one `->` segment per row when the author broke it that way (even at only one boundary), with every segment -- including the first -- at the same column, since there's no \"name :\" header to glue it to" "TypeAliasFunctionType"
            , assertPrettyIn fsPerm "Declarations" "a type alias body whose function type carries a multi-line record type commits to the broken layout, so `-> Int` drops below the record's `}` instead of staying glued to it (the same trigger `makeSignatureBox` already had)" "TypeAliasDroppingRecord"
            , assertPrettyIn fsPerm "Declarations" "union types" "TypeUnion"
            , assertPrettyIn fsPerm "Declarations" "type signatures" "TypeSignature"
            , assertPrettyIn fsPerm "Declarations" "a comment written inside a parenthesized type, between the last token and the `)`, stays inside the parens and is a fixed point -- the paren records its closing position, so the comment no longer escapes past `)` and then flips sides of the `->` on reparse" "SignatureParenComment"
            , assertPrettyIn fsPerm "Declarations" "a `--` or multi-line `{- -}` at a type's `->` keeps the row it was written on (C2's line-leading-separator exception); a single-line `{- -}` still lands after the arrow" "SignatureArrowCommentKeepsRow"
            , assertPrettyIn fsPerm "Declarations" "a comment written inside a `let` binding's type annotation stays inside it, wherever in the type it sits -- `DefineRecord` carries only the DEFINITION's name position, so reusing it for the annotation left the signature flow out of source order (`bnd` a row below its own type) and every such comment escaped above or below the whole binding" "LetAnnotationComment"
            , assertPrettyIn fsPerm "Declarations" "a comment between `type` and `alias` has no slot in the header and leads the declaration instead; written on its OWN row it is free-floating and takes two blank lines on each side -- `computeDetachedBelow` used to read the source adjacency the blank-line pass was about to destroy, so the first format emitted one blank above it and every later one two. A union's `type {- c -} V` keeps the comment inline, since only the `alias` keyword is position-less on both sides" "AliasKeywordComment"
            , assertPrettyIn fsPerm "Declarations" "type constructor applied to 2+ argument types" "TypeCtorMultiArg"
            , assertPrettyIn fsPerm "Declarations" "ports" "Ports"
            , assertPrettyIn fsPerm "Declarations" "effect module where { command = ... } renders each binding as one field" "EffectModuleWhere"
            , assertPrettyIn fsPerm "Declarations" "effect module with a named (non-wildcard) exposing list renders it tight" "EffectModuleNamedExposing"
            , assertPrettyIn fsPerm "Declarations" "effect module with an author-broken named exposing list drops it to +4" "EffectModuleNamedExposingVertical"
            , assertPrettyIn fsPerm "Declarations" "subscription-only effect module (the Src.Sub where-block case)" "EffectModuleSubscriptionOnly"
            , assertPrettyIn fsPerm "Declarations" "empty record type `{}` in a type alias and a signature" "EmptyRecordType"
            , assertPrettyIn fsPerm "Declarations" "empty-bodied doc comment `{-| -}`" "EmptyDocComment"
            , assertPrettyIn fsPerm "Declarations" "a comment-bearing signature takes its shape from the rendered box, not a predicate" "SignatureCommentRecordType"
            , assertPrettyIn fsPerm "Declarations" "a multi-line `{- -}` past a declaration's last token renders below it, so it detaches to column 1 like the reparse and elm-format do; a glued or single-line one stays put" "DeclTrailingMultilineComment"
            ]
        }


headerCommentsSuite : FileSystem.Permission -> U.Suite
headerCommentsSuite fsPerm =
    U.suite
        { name = "Header Comments"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = U.noFixture
        , tearDown = U.noTearDown
        , tests =
            [ assertPrettyIn fsPerm "HeaderComments" "an effect module's `where` block written SUBSCRIPTION-first still reports the header's closing row, so a comment past `exposing (..)` stays on the header line. The row bump only recognised the command-first spelling" "EffectHeaderSubscriptionFirst"
            , assertPrettyIn fsPerm "HeaderComments" "two exposing entries whose trailing comments are both pinned above the `)` keep the order they were WRITTEN in; the fold walks the entries in sorted order and printed them reversed" "ExposingPinnedTrailingOrder"
            , assertPrettyIn fsPerm "HeaderComments" "port declarations with comments in every header position" "PortComments"
            , assertPrettyIn fsPerm "HeaderComments" "effect module with comments around top-level decls" "EffectModuleComments"
            , assertPrettyIn fsPerm "HeaderComments" "module/import header keyword-gap comments" "ModuleHeaderComments"
            , assertPrettyIn fsPerm "HeaderComments" "block comment past a flat module exposing list is pinned above the ) instead of riding the last-written name" "ModuleExposingTrailingComment"
            , assertPrettyIn fsPerm "HeaderComments" "block comment past a single-name flat module exposing list is pinned above the )" "ModuleLineFloatingComment"
            , assertPrettyIn fsPerm "HeaderComments" "a comment that makes the module header multi-line still gets the coupled vertical `exposing` layout, so the list's derived `)` stays below its item and a comment pinned above it does not escape" "ModuleHeaderMultilineExposingComment"
            , assertPrettyIn fsPerm "HeaderComments" "comments past a name in a vertical module exposing list stay inside the list however far right they start, and travel with their name through the sort" "ModuleExposingCloseComment"
            , assertPrettyIn fsPerm "HeaderComments" "a comment written past a vertical module exposing list's closing paren moves inside the list (the `)` has no AST position, and rendering it below oscillated)" "ModuleExposingClosePastParen"
            , assertPrettyIn fsPerm "HeaderComments" "a comment past a vertical module exposing list's `)` is pinned above the `)` rather than riding the last-written name, so the output does not depend on the order the names were authored in" "ModuleExposingClosePinned"
            , assertPrettyIn fsPerm "HeaderComments" "a whole CHAIN of comments past a flat module exposing list pins above the `)`, one per line, including a link that spans rows" "ModuleExposingCloseChain"
            , assertPrettyIn fsPerm "HeaderComments" "a whole CHAIN of comments past a vertical module exposing list's `)` pins above it in order, while a name's own trailing comment still travels with that name" "ModuleExposingCloseChainVertical"
            , assertPrettyIn fsPerm "HeaderComments" "a comment the author wrote INLINE in the module header keeps the coupled header/list layout, so a hoisted sort-to-first comment still renders on its own line at +4" "ModuleExposingInlineAndHoistedComment"
            , assertPrettyIn fsPerm "HeaderComments" "a comment written on the row BELOW a flat module exposing list is pinned above the `)` like a same-row one, instead of gluing back onto the header line" "ModuleExposingCommentBelowFlatList"
            , assertPrettyIn fsPerm "HeaderComments" "a single-line block comment on an effect module's header row rides that row, even though the `exposing` before it is position-less (dropping it below made the flat list read as vertical on reparse)" "EffectModuleHeaderInlineComment"
            , assertPrettyIn fsPerm "HeaderComments" "comment after the exposing list of a vertical effect-module where block" "EffectModuleFxWhereComment"
            , assertPrettyIn fsPerm "HeaderComments" "a wrapped effect-module `where` block does not make a one-row exposing list look vertical: a comment past it still pins above the `)`, order-independently" "EffectModuleWrappedWhereClose"
            , assertPrettyIn fsPerm "HeaderComments" "trailing -- line comment after an effect module's open exposing glues onto the header row (internal where comments stay put)" "EffectModuleOpenLineTrailer"
            , assertPrettyIn fsPerm "HeaderComments" "trailing -- line comment after a port module's open exposing glues onto the header row" "PortModuleOpenLineTrailer"
            , assertPrettyIn fsPerm "HeaderComments" "trailing block comment after a port module's open exposing glues onto the header row" "PortModuleOpenBlockTrailer"
            , assertPrettyIn fsPerm "HeaderComments" "trailing block comment after a plain module's open exposing glues onto the header row" "ModuleOpenBlockTrailer"
            , assertPrettyIn fsPerm "HeaderComments" "trailing -- line comment past a plain module's flat named exposing is pinned above the )" "ModuleNamedLineTrailer"
            , assertPrettyIn fsPerm "HeaderComments" "trailing -- line comment past a port module's flat named exposing is pinned above the )" "PortModuleNamedLineTrailer"
            , assertPrettyIn fsPerm "HeaderComments" "trailing -- line comment past an effect module's flat named exposing is pinned above the )" "EffectModuleNamedLineTrailer"
            , assertPrettyIn fsPerm "HeaderComments" "comment spaced too far from the handler name falls out of an effect-module where block" "EffectModuleWideSpacingComment"
            , assertPrettyIn fsPerm "HeaderComments" "comment on an item in a multi-line import exposing list" "ImportExposingMultilineComment"
            , assertPrettyIn fsPerm "HeaderComments" "a comment trailing an import's `exposing (..)` glues onto the import line (line and block; with and without an alias)" "ImportExposingOpenTrailingComment"
            , assertPrettyIn fsPerm "HeaderComments" "a comment trailing the module header's own `exposing (..)` glues onto the header line" "ModuleExposingOpenTrailingComment"
            , assertPrettyIn fsPerm "HeaderComments" "a multi-line block comment past a multi-row effect-module header detaches to column 1" "EffectHeaderTrailingMultilineComment"
            , assertPrettyIn fsPerm "HeaderComments" "the same comment past a one-row header still glues onto it" "HeaderTrailingMultilineCommentGlue"
            , assertPrettyIn fsPerm "HeaderComments" "a `--` on the close row of a where block the renderer flattens glues onto the one-row header (it used to oscillate indent-4 / column-1)" "EffectHeaderCloseRowComment"
            , assertPrettyIn fsPerm "HeaderComments" "a comment ABOVE the where block keeps its own row: the header's tail glue needs nothing recorded after the comment" "EffectHeaderCommentAboveWhere"
            , assertPrettyIn fsPerm "HeaderComments" "a `--` moved to the header's tail pushes the comment written after `exposing (..)` onto a row of its own, so that one detaches to column 1 while the `--` keeps the header's last row" "EffectHeaderLineCommentPushesTrailer"
            , assertPrettyIn fsPerm "HeaderComments" "an exposing-list comment whose name sorts to first place is hoisted onto its own line above `(` (import site)" "ExposingSortCommentToFront"
            , assertPrettyIn fsPerm "HeaderComments" "an exposing-list comment whose name sorts to first place is hoisted onto its own line above `(` (module-header site)" "ModuleExposingSortCommentToFront"
            , assertPrettyIn fsPerm "HeaderComments" "a hoisted comment glues onto an EFFECT header's position-less `exposing` tail, where a plain module keeps it own-line; a multi-line one still takes its own row" "EffectExposingSortCommentToFront"
            , assertPrettyIn fsPerm "HeaderComments" "a hoisted `--` glues onto an effect header's `exposing` tail too" "EffectExposingSortCommentToFrontLine"
            , assertPrettyIn fsPerm "HeaderComments" "the effect-header tail fallback does not override a COMMENT predecessor's own glue row: a comment below a multi-line `{- … -}` keeps its row" "EffectHeaderTailCommentChain"
            , assertPrettyIn fsPerm "HeaderComments" "an inline block comment on the last name of a flat module exposing list pins above the ); on an import's list it still travels with its name" "ExposingInlineComment"
            , assertPrettyIn fsPerm "HeaderComments" "multi-line module-header comment that wraps the module name to a continuation row" "HeaderCommentNameWrap"
            , assertPrettyIn fsPerm "HeaderComments" "comment between a vertical module exposing list and the first declaration" "ModuleVerticalExposingComment"
            , assertPrettyIn fsPerm "HeaderComments" "canonical rendering of comments at elided-token positions" "Ambiguous"
            , assertPrettyIn fsPerm "HeaderComments" "canonical rendering of a comment in an effect-module where block" "AmbiguousEffectModule"
            , assertPrettyIn fsPerm "HeaderComments" "a RUN of comments left of an effect-module handler's constructor travels together to the one slot between `where` and `{`" "EffectWhereCommentRun"
            , assertPrettyIn fsPerm "HeaderComments" "trailing comment below a wrapped import stays at the continuation indent" "ImportTrailingComment"
            , assertPrettyIn fsPerm "HeaderComments" "a `--` note above the module doc does not hide it, so the first declaration's own doc keeps its blank lines" "ModuleDocBelowNote"
            ]
        }


pipelineCommentsSuite : FileSystem.Permission -> U.Suite
pipelineCommentsSuite fsPerm =
    U.suite
        { name = "Pipeline Comments"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = U.noFixture
        , tearDown = U.noTearDown
        , tests =
            [ assertPrettyIn fsPerm "PipelineComments" "comments in pipeliens" "CommentsPipeline"
            , assertPrettyIn fsPerm "PipelineComments" "backward pipeline and operator-rhs gap comments" "PipelineAndGlueComments"
            , assertPrettyIn fsPerm "PipelineComments" "an inline block comment rides a flat `|>` pipeline instead of reflowing it (as it already did in `++`/`&&`/`<|` chains); a `--` line comment, a multi-line block comment, an author-broken chain and a `when` step all still break" "PipelineInlineComment"
            , assertPrettyIn fsPerm "PipelineComments" "a `--` line comment trailing the last operand of a broken binop chain (`// acc -- c`) rides that operand's line instead of detaching at the operator indent and oscillating +N ↔ col-0" "TrailingLineCommentBinopOperand"
            , assertPrettyIn fsPerm "PipelineComments" "a backward `<|` body with inline block comments (`z <| {- a -} 73 {- b -}`) stays flat inline instead of oscillating flat ↔ operator-leading" "BackwardPipeInlineBlockComments"
            , assertPrettyIn fsPerm "PipelineComments" "a broken backward `<|` whose body carries inline block comments keeps `<|` on the seed line with the comment-bearing body dropped +4, a fixed point (not flipping to operator-leading)" "BackwardPipeBrokenInlineBlockComments"
            , assertPrettyIn fsPerm "PipelineComments" "a trailing `--` after a parenthesized empty container at a binop chain's end (`0 >> x <= ( {} ) -- k`) stays outside the parens; putting it inside made a `--` swallow the `)` and the output no longer parsed" "BinopParenEmptyBracketTrailingComment"
            , assertPrettyIn fsPerm "PipelineComments" "a paren operand that renders multi-line (a record update with an `if` inside) breaks its binop chain consistently on both formats, not gluing then breaking on reparse" "BinopParenBlockMultilineOperand"
            , assertPrettyIn fsPerm "PipelineComments" "a multi-line `{- … -}` past the LAST thing a paren wraps belongs to the paren, not to that content: it renders at `(`+1 where the reparse reads it, instead of at the lambda body's or branch's own indent. A `when` in a paren keeps it too -- that arm rendered only its first child and dropped the comment outright. Comments that RIDE the content's last row (a single-line `{- -}`, a `--`) still stay inside" "ParenTailMultilineComment"
            , assertPrettyIn fsPerm "PipelineComments" "a paren binop operand breaks the chain only when it renders multi-line: an inline `{- k -}` rides and the chain stays flat (elm-format match), while a `--` forces the `)` down and breaks it" "BinopParenOperandCommentKind"
            -- Regression guards for the 2026-06-06 column-attachment fixes.
            , assertPrettyIn fsPerm "PipelineComments" "a long author-broken binop chain breaks every operator onto its own line; a trailing comment stays inline on the last operand" "BinopChainTrailingComment"
            , assertPrettyIn fsPerm "PipelineComments" "trailing comments below a pipeline's last step stay at the step indent" "PipelineTrailingComment"
            , assertPrettyIn fsPerm "PipelineComments" "a multi-line block comment trailing a `|>` step renders at the step column, not the operand flow's +4 -- it lands above the next `|>`, which is the only thing a reparse can read it as; a run written after it comes down with it, and single-line ones still glue" "PipelineStepTrailingMultilineComment"
            , assertPrettyIn fsPerm "PipelineComments" "a SINGLE-LINE `{- -}` written after a single-line paren rides that paren's row wherever the comment attaches: in a plain call its predecessor is the whole call flow, in a pipeline step it is the paren itself, and that arm used to answer \"no glue row\" -- so the same authoring classified `LeadsLine`, rendered on its own row at the argument indent, and the reparse re-homed it to column 1. A multi-line `{- … -}` keeps its own answer and still moves to the step column" "StepParenTrailingComment"
            , assertPrettyIn fsPerm "PipelineComments" "a RUN of multi-line comments trailing a `|>` step moves to the step column together (rule C1) -- the peel took the maximal suffix of `LeadsLine` comments, so a run whose last member glues onto the one before it peeled NOTHING and the whole run stayed in the operand flow at +4; the run starts at a comment that RENDERS own-line, which a single-line `{- c -}` does not" "PipelineStepTrailingCommentRun"
            , assertPrettyIn fsPerm "PipelineComments" "a `|>` step's trailing own-line comment run is OWNED by the next step, not just rendered there -- the owner decides `glueLeading`, so a split run made the two formats disagree about whether a ridable comment rides its operator's row" "PipelineStepTrailerRehomed"
            -- Regression guard for the Cluster B fix: a *multi-line* block comment
            -- glued same-row onto a preceding construct's last line (previously
            -- crashed; now padded under its start via B.addSuffixBox).
            , assertPrettyIn fsPerm "PipelineComments" "multi-line block comment trailing a backward-pipeline step glues onto its last line, and the body keeps the `<|`'s row -- the comment's own rows are not a reason to move the code" "BackwardPipeMultilineTrailingComment"
            , assertPrettyIn fsPerm "PipelineComments" "a `<|` body written on the operator's row stays there for all three comment kinds and for none, while a body that is multi-line in its own right still drops below the operator" "BackwardPipeBodyKeepsOperatorRow"
            -- Regression guards for the multiline-string `--`-swallow fix
            -- (now `B.endsOpen`). A `--` comment buried at the end of a
            -- multi-line-string operand's subtree must NOT let the following
            -- operator/step glue onto its line (a `--` runs to EOL, swallowing the
            -- operator into the comment — an ast-mismatch). Two code paths:
            -- the backward-pipeline seed (Site A) and the binop precedence group
            -- (Site B).
            , assertPrettyIn fsPerm "PipelineComments" "backward `<|` whose seed ends in a `\"\"\"…\"\"\" -- c` operand stacks `<|` below the comment, not glued onto it" "MultilineStringCommentBackwardPipeSeed"
            , assertPrettyIn fsPerm "PipelineComments" "backward `<|` seed `0 + \"\"\"…\"\"\" -- c` stacks `<| rhs` below the comment line" "MultilineStringCommentBackwardPipeBinop"
            , assertPrettyIn fsPerm "PipelineComments" "binop precedence chain around a `<|`-pipeline operand ending `\"\"\"…\"\"\" -- c` breaks the next operator below, not onto the comment" "MultilineStringCommentBinopPrecedence"
            -- Regression guards for the C/D/E stale-assumption fixes (previously
            -- crashed with a `box: … not ported` Err).
            , assertPrettyIn fsPerm "PipelineComments" "an inline lambda body in a backward `<|` pipeline stays inline" "BackwardPipeInlineLambda"
            , assertPrettyIn fsPerm "PipelineComments" "a multi-line seed in a backward `<|` pipeline glues `<|` onto its last line; a multi-step chain that goes vertical nests each step one tab stop deeper than the last (elm-format's nested-application shape, not a flat list of same-depth steps); a step body that's a call with a broken argument relocates (call/args one per line at +4) the same way a single-step `<|` body already did, with the trailing `<|` on its own line rather than glued to the last argument" "BackwardPipeMultilineSeed"
            -- gen-random.py seed 21546 (comment-rate 0.6): a comment right after
            -- a lambda `->`, same row as everything, whose body is a mixed
            -- `|>`/`<|` pipeline (unconditionally multi-line regardless of the
            -- author's row layout) oscillated between gluing to `->` (the body's
            -- SoftIndentedBlock, chosen because the body sat on the same source
            -- row as the pattern) and leading its own line (IndentedBlock, chosen
            -- on reparse once the body rendered onto a later row) — fixed by
            -- picking IndentedBlock up front for a body that structurally always
            -- breaks, in InsertExpressions.gren.
            , assertPrettyIn fsPerm "PipelineComments" "a leading comment before a lambda body leads its own line even when written on the arrow's row, once the body breaks whatever the author wrote; a mixed `|>`/`<|` pipeline the author kept on one row is not that, so its comment rides the row instead" "LambdaMixedPipelineCommentBody"
            -- The same "structurally always breaks" question, asked of a PAREN
            -- rather than a lambda body: a trailing `{- -}` after a paren the
            -- author wrote on one row glues onto the `)` only if that `)` gets a
            -- row of its own. `parenContentAlwaysBreaks` used to look at the
            -- paren's FIRST CHILD, which sees `( if … )` but not a mixed
            -- `|>`/`<|` chain and not an `if` buried under a call or a lambda —
            -- there the comment took its own row BELOW the declaration's last
            -- token, which reparses as a top-level comment at column 1.
            , assertPrettyIn fsPerm "PipelineComments" "a trailing `{- -}` glues onto the `)` of a one-row paren whose content breaks anyway — a pipeline with an `if` buried in a step, or an `if` under a call or a lambda — not only when the paren's first child is the block construct" "ParenAlwaysBreaksTrailingComment"
            -- The same class as the three fixtures above, but the body wraps
            -- for a reason NO AST-level predicate can see: a comment inside it
            -- (a trailing `--` on the last operand / array item), or plain
            -- author layout (the broken call). `InsertExpressions` runs before
            -- `Comments`, so `exprAlwaysBreaks` cannot pick `IndentedBlock` up
            -- front here — the leading comment instead drops WITH the body in
            -- the renderer, where the body's rendered box answers "did it
            -- wrap?" (`pairLeadingComments` / `BlockJoin`'s `withLeading`).
            -- `flatBodyKeepsCommentInline` is the counterweight: a body that
            -- stays on one line keeps its comment glued to the `->`.
            , assertPrettyIn fsPerm "PipelineComments" "a leading comment on a lambda body that wraps drops to its own line WITH the body, whatever forced the wrap (a `--` inside a binop chain or array, an author-broken call) — leaving it glued to the `->` while the body drops below oscillates on reparse" "LambdaLeadingCommentDroppedBody"
            , assertPrettyIn fsPerm "PipelineComments" "a comment that opened a row of its own does not take the next TOKEN onto that row -- gluing a broken call's function name right, while its arguments keep their column, reparses the arguments as applied to the enclosing lambda (an AST change, not just a layout one)" "OwnLineCommentBreaksBeforeToken"
            , assertPrettyIn fsPerm "PipelineComments" "a lambda whose PATTERN breaks, in a relocated `( … )` argument: the head box's own padding is relative to where the head STARTS, so gluing the `(` on the first line alone left the pattern's items and its `]` a column short of the `\\` they hang off. The two authorings differ only in where the BODY sits -- which changes its container and must not move the head -- and each was stable alone, so only a shape that flips the container between passes made it oscillate. A comment written BETWEEN the parameters still sits at the align level, which is what the first-line-only glue is for" "LambdaBrokenPatternHead"
            ]
        }


patternCommentsSuite : FileSystem.Permission -> U.Suite
patternCommentsSuite fsPerm =
    U.suite
        { name = "Pattern Comments"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = U.noFixture
        , tearDown = U.noTearDown
        , tests =
            [ assertPrettyIn fsPerm "PatternComments" "consecutive comments in when branch" "ConsecutiveCommentsInBranch"
            , assertPrettyIn fsPerm "PatternComments" "type union variant comments and type-syntax positions in signatures" "TypeComments"
            , assertPrettyIn fsPerm "PatternComments" "array patterns, ctor patterns, and when-branch pattern comments" "PatternComments"
            , assertPrettyIn fsPerm "PatternComments" "standalone block comment before a non-first let binding" "LetBindingComments"
            , assertPrettyIn fsPerm "PatternComments" "a RUN of single-line block comments glued onto a multi-line comment's `-}` row does not pull the next token up onto that row -- with one comment the token already went below, and for a `let` binding the glued form does not even parse (a binding must start at the block's column)" "CommentRunAfterBlockComment"
            , assertPrettyIn fsPerm "PatternComments" "a record field (literal or update) whose value is a multi-line binop led by a block comment drops the comment then value below `name =` (was an unreachable soft-glue crash)" "RecordFieldLeadingCommentBinop"
            , assertPrettyIn fsPerm "PatternComments" "a `--` line comment trailing a parenthesized `when`-branch body (`(0) -- c`) rides the `)` line instead of oscillating +N ↔ col-0" "TrailingLineCommentParenWhenBody"
            , assertPrettyIn fsPerm "PatternComments" "a record field (literal or update) whose value is a lambda with an always-breaking body (`\\n -> 0 // 0 * (if …)`) drops the whole `\\… ->` below `field =` on the first format instead of gluing then dropping on reparse" "RecordFieldLambdaParenIfValue"
            , assertPrettyIn fsPerm "PatternComments" "a record-update field with a comment-led multi-line binop value (`{ x | f = {- c -} 31 >= 0 >= (let … in …) }`) keeps each comment on the side it was written: the value-leading `{- k0 -}` stays inside, and the `{- k7 -}` written past the `}` stays outside on the `}` row (was pulled onto its own row inside the update)" "RecordUpdateCommentBinopValue"
            , assertPrettyIn fsPerm "PatternComments" "a `--` written past a flat single-field record update whose value is a lambda (`{ z | apply = \\x -> x + 1 } -- c`) stays outside the `}` and the update stays flat, like arrays — the pre-fix crash sank the comment before `}` where it swallowed the closing brace and failed to reparse" "RecordUpdateLambdaFieldTrailingComment"
            , assertPrettyIn fsPerm "PatternComments" "comment trailing a signature's last token stays glued inline" "SignatureTrailingComment"
            , assertPrettyIn fsPerm "PatternComments" "a comment leading a multi-line type record drops onto its own line above the record (elm-format match)" "TypeRecordLeadingComment"
            , assertPrettyIn fsPerm "PatternComments" "comment trailing the last let binding routes after `in` (which is where it stays -- keeping it with the bindings oscillates)" "LetInTrailingComment"
            , assertPrettyIn fsPerm "PatternComments" "comment trailing a non-last let binding's value sits at the bindings-block indent" "BetweenLetBindingsComment"
            , assertPrettyIn fsPerm "PatternComments" "comment trailing a non-last when-branch body (nested in if/let) sits between branches, no blank" "BetweenWhenBranchesComment"
            -- Regression guards for the 2026-05-24 fuzzer-found idempotency fixes.
            , assertPrettyIn fsPerm "PatternComments" "trailing comment after a multi-line union variant stays on the variant's last row" "UnionVariantTrailingComment"
            , assertPrettyIn fsPerm "PatternComments" "own-line comment below the last union variant detaches to column 1 (matches elm-format)" "UnionTrailingOwnLineComment"
            -- Option C: every own-line comment below a top-level declaration
            -- detaches to column 1 (matches elm-format). A following declaration
            -- is separated from it by a blank line so it does not re-read as that
            -- declaration's leading comment.
            , assertPrettyIn fsPerm "PatternComments" "own-line comment below a multi-line function type detaches to column 1" "TrailingCommentMultilineType"
            , assertPrettyIn fsPerm "PatternComments" "trailing comment on the closing `}` of a record-payload union variant stays there across reformats" "UnionRecordPayloadTrailingComment"
            , assertPrettyIn fsPerm "PatternComments" "comments inside a record update and before its closing brace" "RecordUpdateFieldComment"
            , assertPrettyIn fsPerm "PatternComments" "trailing comment on a long when-branch body glues inline regardless of length" "WhenBranchTrailingComment"
            , assertPrettyIn fsPerm "PatternComments" "single-line comment around the arrow of a wrapping signature soft-breaks" "SignatureArrowLineComment"
            -- Regression guards for the 2026-06-06 column-attachment fixes.
            , assertPrettyIn fsPerm "PatternComments" "comment trailing the then-body routes to leading the else-body" "ThenElseBoundaryComment"
            , assertPrettyIn fsPerm "PatternComments" "own-line comment before a record pattern's closing brace stays inside" "RecordPatternTrailingComment"
            -- Regression guards for the Cluster B fix: a *multi-line* block comment
            -- glued same-row onto a preceding construct's last line (previously
            -- crashed; now padded under its start via B.addSuffixBox).
            , assertPrettyIn fsPerm "PatternComments" "multi-line block comment trailing a union variant glues onto its last line" "UnionVariantMultilineTrailingComment"
            , assertPrettyIn fsPerm "PatternComments" "multi-line block comment trailing a when-branch body glues onto its last line" "WhenBranchMultilineTrailingComment"
            -- Regression guard for the broken/blockrec oscillation fix: a multi-line
            -- comment trailing a dropped EXPRESSION block (list / record, incl. under
            -- a call) glues onto its closing bracket instead of dropping own-line and
            -- detaching (+4 ↔ col-0). Fixed via the closing-row carry in FlowPolicy
            -- (bracket literals) + factsFor (bracket-ending calls).
            , assertPrettyIn fsPerm "PatternComments" "multi-line comment trailing a dropped type-record block glues onto its `}`" "TypeRecordMultilineTrailingComment"
            -- Regression guard for the C/D/E stale-assumption fixes (previously
            -- crashed with a `box: … not ported` Err).
            , assertPrettyIn fsPerm "PatternComments" "an `if`/lambda-valued field in a comment-bearing record update renders (drops the block)" "RecordUpdateCommentBlockValue"
            , assertPrettyIn fsPerm "PatternComments" "a multi-line call as an inline lambda body drops to its own line at +4" "LambdaMultilineCallBody"
            , assertPrettyIn fsPerm "PatternComments" "a multi-line triple-quoted string as an inline lambda body drops to its own line" "LambdaMultilineStringBody"
            , assertPrettyIn fsPerm "PatternComments" "a multi-line `{- … -}` past the LAST `when` branch's bracketed body detaches to column 1, as it already did past any other declaration tail -- rendering it at the branch indent left the reparse to re-home it, since a `when` has no closing delimiter after that body. A comment glued to a bare literal body still rides its row, and one past a NON-last branch stays where the author put it" "WhenLastBranchTrailingMultiline"
            , assertPrettyIn fsPerm "PatternComments" "a `{- c -}` past a lambda's `->` leads the body own-line when the body breaks, whether or not the lambda's PATTERN ends in a bracket -- the pattern's `]` is the rightmost bracket in the head's subtree but the `->` still renders after it, so it is no closing bracket for the comment to glue onto. A one-row body still rides the arrow's row in both spellings, and a call flow that genuinely ends in its bracket still keeps its same-row comment" "LambdaBracketPatternArrowComment"
            , assertPrettyIn fsPerm "PatternComments" "a comment leading a `let` binding whose PATTERN the author broke across rows stacks above it, exactly as it does above a one-row pattern -- the soft-glue fast path used to take any single-line `{- … -}` as a gluable prefix, asking the comment's shape rather than its role, and a `let` binding that is not the first cannot begin with a comment on its row at all (both compiler-common and `gren make` refuse it). The no-comment soft glue still applies" "LetBrokenPatternLeadingComment"
            ]
        }


bracketCommentsSuite : FileSystem.Permission -> U.Suite
bracketCommentsSuite fsPerm =
    U.suite
        { name = "Bracket Comments"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = U.noFixture
        , tearDown = U.noTearDown
        , tests =
            [ assertPrettyIn fsPerm "BracketComments" "comments everywhere" "CommentsEverywhere"
            , assertPrettyIn fsPerm "BracketComments" "when expressions as items in a commented array are preserved" "WhenInCommentedArray"
            , assertPrettyIn fsPerm "BracketComments" "doc/line/block adjacency and inter-declaration comments" "EdgeCaseComments"
            , assertPrettyIn fsPerm "BracketComments" "previously-mishandled comment placements (bugs A–K)" "TrickyComments"
            , assertPrettyIn fsPerm "BracketComments" "multiple comments sharing a top-level comment line" "AdjacentTopLevelComments"
            , assertPrettyIn fsPerm "BracketComments" "a comment (line, block, or multi-line block) on the closing `-}` row of a multi-line block comment glues onto that row instead of dropping to its own line (which, inside a declaration body, would detach on reparse and oscillate col 4 ↔ col 0)" "MultilineCommentTrailedByComment"
            , assertPrettyIn fsPerm "BracketComments" "the same rule for a run of comments standing on its own at TOP level, where a different renderer applies it: every member keeps the row the author gave it and a multi-line member's continuation pads under its own `{-`. This path used to refuse the file outright (`box: multi-line comment cannot space-join`) whenever a glued member was multi-line" "TopLevelMultilineCommentRun"
            , assertPrettyIn fsPerm "BracketComments" "a RUN of leading block comments before a block that drops to its own line (a lambda body, a multi-line record value) drops WITH it, keeping the rows the AUTHOR wrote it on -- one row here, since these are written on one. `pairLeadingComments` looked only at the immediately following item, so a second comment in the gap broke the pairing and the whole run glued onto the preceding row instead. The last two cases pin the boundary: a run before a block that does NOT drop stays inline" "LeadingCommentRunBeforeBlock"
            , assertPrettyIn fsPerm "BracketComments" "a comment run inside an `if`/`else if` condition that ends a line breaks the condition open on the FIRST format. `forceVertical` is read off source rows that hold no comments, so the inline arm was chosen, `joinInline` then failed, and the stacked fallback left the run on the condition row -- which the reparse re-read as vertical and split. The block-comment-only cases pin that a run which CAN ride still rides" "IfConditionCommentRun"
            , assertPrettyIn fsPerm "BracketComments" "own-line comment before a container's closing bracket stays inside" "BracketTrailingComments"
            , assertPrettyIn fsPerm "BracketComments" "a comment written just past a container's opening `{`/`[` stays INSIDE it, on the first item's line, and one written past the closing bracket stays outside -- the brackets are among the few tokens whose position the parser records, so which side the author chose is a fact rather than a guess. A record update shows both halves: its `{` AND its base name are recorded, so an opener comment is placed exactly, while one past the base (where only the unrecorded `|` is left) goes to the field after it (rule C2)" "ContainerOpenerComment"
            , assertPrettyIn fsPerm "BracketComments" "a RUN of single-line block comments just inside an opening bracket rides the first item's line all-or-nothing, exactly as the identical run in a `,` gap does -- only the FIRST comment of an opener run is classified `RidesInline` (a second is `LeadsNext`), so testing the ROLE rather than the comment's shape broke the run after one comment while the comma slot rode all of it. A `--` or a multi-line `{- -}` in the run still cannot ride, and takes the whole run to its own rows" "OpenerCommentRun"
            , assertPrettyIn fsPerm "BracketComments" "a comment never glues onto the FRONT of an item holding a `\"\"\"...\"\"\"` -- the glue would shift the item's first row by the comment's width while the string's own content rows move by a different amount, and Gren requires them indented equally, so the output would stop parsing. Both the opener slot and rule C2's leads-the-next-item slot give way to an own-line comment; a comment gluing onto the item BEFORE it is a suffix landing after the closing `\"\"\"` and is unaffected" "MultilineStringItemComment"
            , assertPrettyIn fsPerm "BracketComments" "an indented comment written below a bracketed container (list/record/update) at a declaration's end detaches to a top-level column-1 comment in a single format, instead of drifting one column left per reformat" "TrailingCommentAfterContainer"
            , assertPrettyIn fsPerm "BracketComments" "a `--` line comment trailing a declaration body (call / single-line record / array / `{}` / `[]`) rides the body's last line instead of oscillating +4 ↔ col-0" "TrailingLineCommentBodyEnd"
            , assertPrettyIn fsPerm "BracketComments" "a trailing comment (line or block) on a paren-based postfix access `(x).name` rides the glued line (was a `comment never reaches makePBox` crash)" "PostfixAccessTrailingComment"
            , assertPrettyIn fsPerm "BracketComments" "a `--` line comment trailing a plain token that follows a bracket in a broken call (`y (0)`⏎`0 -- c`) rides that token's line instead of oscillating +N ↔ col-0" "TrailingLineCommentAfterBracketArg"
            -- Option C: every own-line comment below a top-level declaration
            -- detaches to column 1 (matches elm-format). A following declaration
            -- is separated from it by a blank line so it does not re-read as that
            -- declaration's leading comment.
            , assertPrettyIn fsPerm "BracketComments" "own-line comment below a flat binop detaches to column 1" "TrailingCommentFlatBinop"
            , assertPrettyIn fsPerm "BracketComments" "own-line comment below a multi-line call detaches to column 1" "TrailingCommentMultilineCall"
            , assertPrettyIn fsPerm "BracketComments" "detached trailing comment is separated from the following declaration by a blank line" "TrailingCommentThenDecl"
            , assertPrettyIn fsPerm "BracketComments" "long trailing comment in a bracket list glues inline regardless of length" "BracketListOverflowComment"
            , assertPrettyIn fsPerm "BracketComments" "comment in an empty-bracket body slot is not absorbed into the brackets" "EmptyBracketTrailingComment"
            , assertPrettyIn fsPerm "BracketComments" "an empty bracket holding a multi-line block comment or a line comment can't render inline, so it drops to a vertical layout" "EmptyBracketNonInlineComment"
            , assertPrettyIn fsPerm "BracketComments" "a leading binding comment above an empty bracket that itself holds a comment: the leading comment leads the value (own line under `=`), the inside comment stays inside" "EmptyBracketLeadingAndInsideComment"
            , assertPrettyIn fsPerm "BracketComments" "a comment between a declaration's `=` and its body leads the body on its own line -- a `{- -}` exactly like a `--`, a top-level `BodyBlock` exactly like a `let` binding's `IndentedBlock`, and whichever row the author wrote it on (a `BodyBlock` always starts its own line, so there is no flat line to ride)" "DeclBodyLeadingBlockComment"
            -- Regression guard for the Cluster B fix: a *multi-line* block comment
            -- glued same-row onto a preceding construct's last line (previously
            -- crashed; now padded under its start via B.addSuffixBox).
            , assertPrettyIn fsPerm "BracketComments" "multi-line block comment trailing a bracket-list item glues onto its last line" "ListItemMultilineTrailingComment"
            , assertPrettyIn fsPerm "BracketComments" "multi-line block comment trailing a multi-line item in a broken call glues onto its last line" "BrokenCallMultilineTrailingComment"
            -- Regression guards for the broken/blockrec oscillation fix: a multi-line
            -- comment trailing a dropped EXPRESSION block (list / record, incl. under
            -- a call) glues onto its closing bracket instead of dropping own-line and
            -- detaching (+4 ↔ col-0). Fixed via the closing-row carry in FlowPolicy
            -- (bracket literals) + factsFor (bracket-ending calls).
            , assertPrettyIn fsPerm "BracketComments" "multi-line comment trailing a dropped list under a call glues onto its `]`" "CallListMultilineTrailingComment"
            , assertPrettyIn fsPerm "BracketComments" "multi-line comment trailing a dropped record under a call glues onto its `}`" "CallRecordMultilineTrailingComment"
            , assertPrettyIn fsPerm "BracketComments" "multi-line comment trailing a list-body glues onto its `]`" "ListBodyMultilineTrailingComment"
            -- matrix-syntax.py --comments, first run that swept the multi-line
            -- kind (2026-08-05): a multi-line `{- .. -}` past a bracketed
            -- container's ITEM belongs to the container, not to the item's last
            -- token. Visible only through a lambda item, whose `SoftIndentedBlock`
            -- body nothing was guarding; pins the boundary too (a `--` and a
            -- single-line `{- -}` ride the item's row and stay its own, and a
            -- nested container's own brackets still take their comment).
            , assertPrettyIn fsPerm "BracketComments" "multi-line comment past a container item belongs to the container, not to the item's lambda body" "ContainerTailMultilineComment"
            , assertPrettyIn fsPerm "BracketComments" "a multi-line comment run past an IndentedBlock that something FOLLOWS stays outside the block, where the reparse puts it, so the run does not half-glue -- a block closes with a dedent, not a delimiter" "BlockTailCommentRunEscapes"
            , assertPrettyIn fsPerm "BracketComments" "a lambda field of a comment-opened record update takes renderRecordFieldBox's glued-lambda arm too: a multi-line body drops the whole lambda, a single-line one keeps its head on the `= ` line" "RecordUpdateVerticalLambdaField"
            , assertPrettyIn fsPerm "BracketComments" "a comment before a record field holding a LAMBDA stays a child of the record: the field is an `IndentedBlock`, but inside a bracket that box is an ITEM and renders after the `, ` -- redirected inside it, the comment stacked above `fld =` and the reparse moved it in front of the separator. Both the `,`-gap and the own-line authorings now match their non-lambda twins" "RecordLambdaFieldSeparatorComment"
            -- The other half of the same sweep: "does this container render
            -- multi-line" is its stored box type, not its source row span. The
            -- two disagree exactly where the container COLLAPSES (a single item
            -- has no between-item gap, #21), so the row span promised a glue row
            -- the output did not have. Pins both sides -- a collapsed container's
            -- trailing comment takes its own row, a genuinely broken one still
            -- glues onto the closing bracket.
            , assertPrettyIn fsPerm "BracketComments" "a trailing block comment glues onto a container's close only when the container really renders across rows" "CollapsedContainerTrailingComment"
            -- gen-random.py seed 108 (comment-rate 0.6, v1.6's new Neg/unary-minus
            -- grammar): a `--` trailing a unary-minus (`-expr`) body glues onto
            -- that row and stays put (was non-idempotent: prevLineGlueRow/
            -- prevBlockGlueRow had no PrefixGlue case, so a same-row comment
            -- after `-expr` always classified LeadsLine — same bug shape as
            -- MultilineStringTrailingLineComment above, reached for the first
            -- time via a construct this generator had never produced before).
            -- PrefixGlue is shared with a lambda's `\`-glued parameter head,
            -- where a same-row `--` deliberately stays own-line
            -- (KitchenComments) — the fix branches on the prefix string
            -- ("-" glues, "\\" doesn't) rather than gluing unconditionally.
            , assertPrettyIn fsPerm "BracketComments" "a `--` trailing a unary-minus expression glues onto that row and stays put" "NegateTrailingLineComment"
            , assertPrettyIn fsPerm "BracketComments" "a `{- -}` trailing a unary-minus expression glues onto that row unconditionally, bracket-free and call operand alike (a unary minus is a self-contained unit, unlike a call flow, which only glues after a bracket)" "NegateTrailingBlockComment"
            , assertPrettyIn fsPerm "BracketComments" "a comment run in a separator gap crosses that separator only if every member would -- a run mixing a single-line `{- -}` with a `--` or a multi-line `{- -}` used to tear in half and come out REVERSED" "CommentRunCrossesSeparator"
            , assertPrettyIn fsPerm "BracketComments" "a ridable comment run after a bracket opener stays on one row when the item cannot join it -- the flat and comment-bearing container paths stacked it differently, so the two spellings of the same list rendered each other's output for ever" "OpenerRunStaysOneRow"
            -- The bracket half of the same question. `bracketRendersMultiline`
            -- reads the stored box (`AlwaysVertical` vs `AllAcrossOrAllVertical`)
            -- and `prevBlockGlueRow` had no `RecordUpdate` arm at all, so a
            -- container the author wrote on one row whose ITEM breaks anyway —
            -- and a record update broken across rows, with no always-breaking
            -- content at all — gave a trailing `{- -}` no closing-bracket row to
            -- glue onto, and it dropped below the declaration's last token.
            , assertPrettyIn fsPerm "BracketComments" "a trailing `{- -}` glues onto the `]`/`}` of a container that renders vertical — a one-row list or record whose item breaks on its own, and an author-broken record update, whose closing row the block-comment glue rule could not see at all" "ContainerAlwaysBreaksTrailingComment"
            ]
        }


kitchenSinkSuite : FileSystem.Permission -> U.Suite
kitchenSinkSuite fsPerm =
    U.suite
        { name = "Kitchen sink"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = U.noFixture
        , tearDown = U.noTearDown
        , tests =
            [ assertPrettyIn fsPerm "KitchenSink" "every AST construct in one file" "KitchenSink"
            , assertPrettyIn fsPerm "KitchenSink" "comments at every position in one file" "KitchenComments"
            , assertPrettyIn fsPerm "KitchenSink" "3-line block comments at every round-tripping position" "MultilineBlockComments"
            , assertPrettyIn fsPerm "KitchenSink" "3-line block comment in an effect-module where block" "MultilineEffectModule"
            , assertPrettyIn fsPerm "KitchenSink" "block comment body re-indented from its own structure, not the open column" "BlockCommentBodyIndent"
            , assertPrettyIn fsPerm "KitchenSink" "block comment with closing -} on its own line aligns -} with the opening {-" "BlockCommentClosingAlign"
            , assertPrettyIn fsPerm "KitchenSink" "block comment closing -} indented at body level (l == base) is re-anchored to the {- column" "BlockCommentCloserIndented"
            , assertPrettyIn fsPerm "KitchenSink" "trailing comment placement (inline vs own line) is preserved, not normalized" "CommentPlacement"
            , assertPrettyIn fsPerm "KitchenSink" "a variety of constructs near, at, and past the 100-column page width" "PageWidth"
            , assertPrettyIn fsPerm "KitchenSink" "empty literal ([] / {}) as an item inside a bracketed list" "EmptyBracketInList"
            , assertPrettyIn fsPerm "KitchenSink" "block-bodied record field values all drop whole below `field =` when multi-line (lambda, if, let, when) — matching elm-format; a single-line lambda stays glued on the `= ` line" "RecordFieldBlockValues"
            , assertPrettyIn fsPerm "KitchenSink" "a `--` breaking a glued-lambda field's flow drops the lambda 4 past the `{`, like every other field value — not 2, aligned under the field name" "RecordLambdaFieldCommentIndent"
            , assertPrettyIn fsPerm "KitchenSink" "a single-line block comment between an operator and its operand does not displace the operand: a `<|` body stays at `<|`+4, and a paren-wrapped lambda keeps `)` under its own `(`" "PipeCommentOperandIndent"
            , assertPrettyIn fsPerm "KitchenSink" "a single-line `{- -}` before a lambda rides the lambda's row — in an array item, a `<|` body, a `|>` operand — and stacks above it only where the row it would ride is gone" "LambdaLeadingBlockCommentRides"
            , assertPrettyIn fsPerm "KitchenSink" "a single-line `{- -}` in front of an operator rides that operator's row -- one rule at `++`, `|>` and `<|`, and both author spellings collapse to it; a `--` or a multi-line `{- -}` still takes a row of its own" "OperatorLeadingCommentRides"
            , assertPrettyIn fsPerm "KitchenSink" "`port module` with no ports loses the keyword — the header follows the body" "PortModuleKeywordDropped"
            , assertPrettyIn fsPerm "KitchenSink" "plain `module` that declares a port gains the keyword — the header follows the body" "PortModuleKeywordAdded"
            ]
        }
